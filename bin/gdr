#!/usr/bin/env sh
# gdr — gaduri harness CLI.
#
# Every file in bin/ becomes a bare command on the Bash tool's PATH while the
# plugin is enabled, so `gdr` is the ONE entry point that belongs here.
# Subcommands live in libexec/ (off PATH) and are reached as `gdr <name>`.
set -eu

# CLAUDE_PLUGIN_ROOT is set by Claude Code when the plugin is loaded. The
# fallback keeps `gdr` runnable from a plain shell during development.
GADURI_ROOT=${CLAUDE_PLUGIN_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}
export GADURI_ROOT

GADURI_VERSION=$(
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$GADURI_ROOT/.claude-plugin/plugin.json" 2>/dev/null | head -1
)
GADURI_VERSION=${GADURI_VERSION:-unknown}

usage() {
  cat <<EOF
gdr — gaduri harness CLI (v${GADURI_VERSION})

Usage:
  gdr <command> [args...]
  gdr help
  gdr version

Commands:
$(list_commands)
EOF
}

list_commands() {
  found=0
  for f in "$GADURI_ROOT"/libexec/gdr-*; do
    [ -x "$f" ] || continue
    found=1
    name=${f##*/gdr-}
    # First `#:` comment line in a subcommand is its one-line summary.
    summary=$(sed -n 's/^#:[[:space:]]*//p' "$f" 2>/dev/null | head -1)
    printf '  %-12s %s\n' "$name" "$summary"
  done
  [ "$found" -eq 1 ] || printf '  (none yet — add an executable at libexec/gdr-<name>)\n'
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
  help | -h | --help)
    usage
    ;;
  version | -v | --version)
    printf '%s\n' "$GADURI_VERSION"
    ;;
  *)
    sub="$GADURI_ROOT/libexec/gdr-$cmd"
    if [ -x "$sub" ]; then
      exec "$sub" "$@"
    fi
    printf 'gdr: unknown command '\''%s'\''\n\n' "$cmd" >&2
    usage >&2
    exit 1
    ;;
esac
