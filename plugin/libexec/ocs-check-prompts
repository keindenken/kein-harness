#!/usr/bin/env sh
#: Fail when the rendered role prompts have drifted from canonical.
#
# The rendered copy exists so the harness is self-contained.
# That only holds if staleness is loud, so this exits non-zero and names every role that moved.
set -eu

source_dir=${KEIN_CANONICAL_PROMPTS:-$HOME/.codex-orca/foundation/prompts}
destination="$KEIN_ROOT/prompts"
record="$destination/canonical.sha256"

if [ ! -f "$record" ]; then
  printf 'ocs check-prompts: no rendered copy. Run `ocs sync-prompts` first.\n' >&2
  exit 1
fi

drifted=''
missing=''

# Recorded roles: compare the rendered copy against canonical, so an edit to either side is caught.
while read -r expected name; do
  [ -n "$name" ] || continue
  rendered="$destination/$name"
  canonical="$source_dir/$name"

  if [ ! -f "$rendered" ]; then
    missing="$missing $name(rendered)"
    continue
  fi
  if [ ! -f "$canonical" ]; then
    missing="$missing $name(canonical)"
    continue
  fi

  actual_rendered=$(shasum -a 256 "$rendered" | cut -d' ' -f1)
  actual_canonical=$(shasum -a 256 "$canonical" | cut -d' ' -f1)

  if [ "$actual_rendered" != "$expected" ] || [ "$actual_canonical" != "$expected" ]; then
    drifted="$drifted $name"
  fi
done < "$record"

# Roles added to canonical since the last sync are drift too: the rendered copy is incomplete, and nothing in the recorded hashes would reveal that.
if [ -d "$source_dir" ]; then
  for canonical in "$source_dir"/*.md; do
    [ -e "$canonical" ] || continue
    name=$(basename "$canonical")
    grep -q " $name\$" "$record" || drifted="$drifted $name(unrendered)"
  done
fi

if [ -n "$drifted" ] || [ -n "$missing" ]; then
  printf 'ocs check-prompts: rendered prompts are out of date\n' >&2
  [ -n "$drifted" ] && printf '  drifted:%s\n' "$drifted" >&2
  [ -n "$missing" ] && printf '  missing:%s\n' "$missing" >&2
  printf '  run `ocs sync-prompts` and review the diff\n' >&2
  exit 1
fi

# agents/ is a deterministic function of prompts/, so re-render and diff.
# This catches a hand-edit to a generated agent, which the hash record above cannot see because it only covers the library.
scratch=$(mktemp -d "${TMPDIR:-/tmp}/ocs-check.XXXXXX")
trap 'rm -rf "$scratch"' EXIT INT TERM
"$KEIN_ROOT/libexec/ocs-render-agents" "$scratch" >/dev/null

agents_drifted=''
for expected in "$scratch"/*.md; do
  [ -e "$expected" ] || continue
  name=$(basename "$expected")
  cmp -s "$expected" "$KEIN_ROOT/agents/$name" || agents_drifted="$agents_drifted $name"
done
for existing in "$KEIN_ROOT/agents"/*.md; do
  [ -e "$existing" ] || continue
  name=$(basename "$existing")
  [ -f "$scratch/$name" ] || agents_drifted="$agents_drifted $name(orphan)"
done

if [ -n "$agents_drifted" ]; then
  printf 'ocs check-prompts: generated agents are out of date\n' >&2
  printf '  drifted:%s\n' "$agents_drifted" >&2
  printf '  run `ocs render-agents`; agents/ is generated, edit the canonical prompt\n' >&2
  exit 1
fi

printf 'prompts match canonical, agents match prompts (%s roles)\n' \
  "$(wc -l < "$record" | tr -d ' ')"
