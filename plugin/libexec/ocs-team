#!/usr/bin/env sh
#: Add one supervised teammate from another vendor's CLI as a canonical role.
#
# Usage:
#   ocs team <provider> --agent <role> [--worktree new|<path>] [--check] [--model M] [--effort E] [--timeout S] [--keep] (<task...> | --task-file <path>)
#
# This is the write-capable half of the bridge; `ocs ask` is the read-only half.
#
# The role prompt goes in as `developer_instructions`, not into the task text.
# Orca's `--inject` has exactly one slot, and everything put there lands under its `=== TASK ===` heading — so a role prompt sent that way tells the worker that its identity is part of the job.
# `developer_instructions` appends to the developer message instead, which leaves identity, reporting rules, and the task each in their own layer.
# Orca owns the Run, Task, Dispatch, completion signal, and recovery, and none of that is reimplemented here.
# What this command owns is the execution environment: which model, which reasoning effort, which sandbox, and which vendor home.
# Orca's own agent launch cannot vary any of those per dispatch — they come from one global setting in its client — so composing the terminal ourselves is the only way a role's tier can decide its model.
set -eu

# Adding a provider is one entry here and no change at any call site.
PROVIDERS='codex'

# The Codex half of the canonical tier, identical to the table in `ocs ask`.
TIER_DEEP_MODEL='gpt-5.6-sol'
TIER_STANDARD_MODEL='gpt-5.6-terra'
TIER_FAST_MODEL='gpt-5.6-luna'
DEFAULT_EFFORT='medium'

# A worker reports by calling Orca from inside its own sandbox.
# Under `read-only`, and under a plain `workspace-write`, that call fails with the app unreachable while the binary itself runs fine, so the lane completes its work and its verdict is never delivered.
# Enabling network access for workspace-write is the narrowest setting measured to let the report through; Orca's own agent launch bypasses the sandbox entirely instead.
SANDBOX='workspace-write'
SANDBOX_CONFIG='sandbox_workspace_write.network_access=true'

# `workspace-write` does not cover dot-directories under the workspace, which is where the state root lives.
# Measured: `touch .agents/...` exits 10 under the sandbox while a file at the repository root exits 0, so a worker completes its work and then cannot write the report it was asked for.
# Naming the state root as a writable root is narrower than widening the sandbox mode, and it is the only extra path the worker is granted.
# Git state stays unwritable under this mode -- index and refs live under `.git`, which the seatbelt denies in a checkout and in a worktree alike -- so a codex worker cannot commit, stash or check out; `kein-dev check-codex-git-sandbox` measures that rather than assuming it.
STATE_DIRNAME='.agents'

usage() {
  cat >&2 <<EOF
usage: ocs team <provider> --agent <role> [--worktree new|<path>] [--check] [--model M] [--effort E] [--timeout S] [--keep] (<task...> | --task-file <path>)

  providers: $PROVIDERS
  roles:     write-capable roles only; run with an unknown role to list them
  --worktree: where the worker writes. Default is here. \`new\` creates an
              Orca-managed worktree for this lane; a path uses an existing one.
  --model:   override the model the role's tier resolves to
  --effort:  override the reasoning effort (default: $DEFAULT_EFFORT)
  --timeout: seconds to wait for the worker (default: 3600)
  --keep:    leave the worker terminal open after it completes
  --check:   run every precondition, print what would be sent, and stop before
             anything is created. Nothing is spent and no file is written.

One invocation is one worker, and it blocks. Run several in the background for
several lanes: every artifact is persisted, so nothing is lost when the caller
is not waiting. Backgrounded lanes that share a worktree also share every
file in it, so give each one \`--worktree new\` unless they are meant to collide.

example:
  ocs team codex --agent executor "Implement the bounded change in src/foo.ts"
EOF
}

provider=''
role=''
model=''
effort=''
timeout=3600
keep=0
check=0
worktree_arg=''
task=''
task_file=''

while [ $# -gt 0 ]; do
  case "$1" in
    --agent) role=${2:-}; [ -n "$role" ] || { printf 'ocs team: missing role after --agent\n' >&2; exit 1; }; shift 2 ;;
    --agent=*) role=${1#--agent=}; shift ;;
    --keep) keep=1; shift ;;
    --check) check=1; shift ;;
    --worktree) worktree_arg=${2:-}; [ -n "$worktree_arg" ] || { printf 'ocs team: missing value after --worktree\n' >&2; exit 1; }; shift 2 ;;
    --worktree=*) worktree_arg=${1#--worktree=}; shift ;;
    --model) model=${2:-}; [ -n "$model" ] || { printf 'ocs team: missing value after --model\n' >&2; exit 1; }; shift 2 ;;
    --model=*) model=${1#--model=}; shift ;;
    --effort) effort=${2:-}; [ -n "$effort" ] || { printf 'ocs team: missing value after --effort\n' >&2; exit 1; }; shift 2 ;;
    --task-file) task_file=${2:-}; [ -n "$task_file" ] || { printf 'ocs team: missing path after --task-file\n' >&2; exit 1; }; shift 2 ;;
    --task-file=*) task_file=${1#--task-file=}; shift ;;
    --effort=*) effort=${1#--effort=}; shift ;;
    --timeout) timeout=${2:-}; shift 2 ;;
    --timeout=*) timeout=${1#--timeout=}; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) printf "ocs team: unknown option '%s'\n" "$1" >&2; usage; exit 1 ;;
    *)
      if [ -z "$provider" ]; then provider=$1
      elif [ -z "$task" ]; then task=$1
      else task="$task $1"
      fi
      shift ;;
  esac
done

[ -n "$provider" ] || { printf 'ocs team: no provider given\n' >&2; usage; exit 1; }
[ -n "$role" ]     || { printf 'ocs team: no role given (--agent <role>)\n' >&2; usage; exit 1; }
# A lane package is a document, not a shell word. The first measured cross-vendor round wrote a
# 646-line package and a wrapper script to get it through `argv`; `--task-file` is that wrapper.
if [ -n "$task_file" ]; then
  [ -z "$task" ] || { printf 'ocs team: pass a task or --task-file, not both\n' >&2; exit 1; }
  if [ "$task_file" = "-" ]; then task=$(cat)
  else
    [ -r "$task_file" ] || { printf "ocs team: cannot read '%s'\n" "$task_file" >&2; exit 1; }
    task=$(cat "$task_file")
  fi
fi
[ -n "$task" ]     || { printf 'ocs team: no task given\n' >&2; usage; exit 1; }

case " $PROVIDERS " in
  *" $provider "*) ;;
  *) printf "ocs team: provider '%s' is not enabled. Enabled: %s\n" "$provider" "$PROVIDERS" >&2
     exit 1 ;;
esac

roles="$KEIN_ROOT/agents"
manifest="$KEIN_ROOT/agents.json"

[ -f "$manifest" ] || { printf 'ocs team: no rendered agents. Run `kein-dev render-agents`.\n' >&2; exit 1; }

. "$KEIN_ROOT/libexec/lib/role-prompt.sh"
. "$KEIN_ROOT/libexec/lib/vendor-home.sh"

# The five write-capable roles, and the exact complement of what `ocs ask` serves.
# A read-only role reached through here would spend a supervised session and a worktree on work a one-shot already does more cheaply and with guaranteed freshness.
write_roles=$(
  python3 -c '
import json, sys
manifest = json.load(open(sys.argv[1]))
print(" ".join(sorted(k for k, v in manifest.items() if v["sandbox_mode"] != "read-only")))
' "$manifest"
)

case " $write_roles " in
  *" $role "*) ;;
  *)
    if [ -f "$roles/$role.md" ]; then
      printf 'ocs team: role %s is read-only. Use `ocs ask %s --agent %s` instead.\n' "$role" "$provider" "$role" >&2
      printf '  A supervised session buys nothing for a lane that only reads.\n' >&2
    else
      printf "ocs team: unknown role '%s'\n" "$role" >&2
    fi
    printf '  available: %s\n' "$write_roles" >&2
    exit 1 ;;
esac

if [ -z "$model" ]; then
  tier=$(python3 -c '
import json, sys
print(json.load(open(sys.argv[1]))[sys.argv[2]]["tier"])
' "$manifest" "$role")
  case "$tier" in
    deep)     model=$TIER_DEEP_MODEL ;;
    standard) model=$TIER_STANDARD_MODEL ;;
    fast)     model=$TIER_FAST_MODEL ;;
    *) printf "ocs team: role '%s' has unknown tier '%s'\n" "$role" "$tier" >&2; exit 1 ;;
  esac
fi
[ -n "$effort" ] || effort=$DEFAULT_EFFORT

# The vanilla home is pinned, never inherited, exactly as `ocs ask` does it.
# Orca launches whatever command its client is configured with, which on this machine was a launcher pointing at the tuned home; a lane answering as the operator's own tuned lead is not the canonical role.
codex_home=${KEIN_CODEX_HOME:-$HOME/.codex}

stamp=$(date +%y%m%d-%H%M%S)
lead_main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" 2>/dev/null || true)
[ "$lead_main" = "." ] && lead_main=''

# Resolved before the trust check and before the run directory, because both have to name the tree the
# worker will actually hold rather than the one the lead is standing in.
here=$PWD
case "$worktree_arg" in
  ''|current|.) worktree=$here ;;
  new)
    # Refused rather than quietly downgraded to `current`: the two run in different trees, so a check
    # that silently swapped them would be answering about an invocation the caller did not make.
    [ "$check" -eq 0 ] || { printf 'ocs team: --check cannot be combined with `--worktree new`, which would create one.\n' >&2; printf '  Check against the tree the lane would branch from, or name an existing worktree.\n' >&2; exit 1; }
    command -v orca >/dev/null 2>&1 || { printf 'ocs team: `orca` is not on PATH, so `--worktree new` cannot create one.\n' >&2; exit 1; }
    # Orca's own command rather than `git worktree add`: a worktree it did not create is one it asks the
    # operator to adopt, and a lane should not open a dialog. It also runs the project's setup hook, which
    # is what leaves the worker able to run gates instead of landing in a tree with no dependencies.
    repo_selector="path:${lead_main:-$here}"
    base_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    worktree=$(
      orca worktree create --name "kein-$role-$stamp" --repo "$repo_selector" \
        ${base_branch:+--base-branch "$base_branch"} --setup run --json 2>/dev/null |
      python3 -c 'import json,sys; d=json.load(sys.stdin); print((d.get("result") or d).get("worktree",{}).get("path",""))' 2>/dev/null
    )
    [ -n "$worktree" ] && [ -d "$worktree" ] || {
      printf 'ocs team: `orca worktree create` returned no usable path for %s\n' "$repo_selector" >&2
      printf '  Check `orca worktree list` and that the Orca app is reachable.\n' >&2
      exit 1
    }
    printf 'ocs team: lane worktree %s\n' "$worktree" >&2 ;;
  /*) worktree=$worktree_arg
      [ -d "$worktree" ] || { printf 'ocs team: --worktree %s is not a directory\n' "$worktree" >&2; exit 1; }
      git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
        printf 'ocs team: --worktree %s is not a git worktree\n' "$worktree" >&2; exit 1; } ;;
  *) printf 'ocs team: --worktree takes `new`, `current`, or an absolute path (got %s)\n' "$worktree_arg" >&2; exit 1 ;;
esac

# A linked worktree inherits the main worktree's trust record, measured 2026-08-19: codex opened without a
# prompt in a worktree that had no record of its own, and prompted again the moment the record for the
# repository it was linked to was removed. So the key is the main worktree, which is the parent of the shared
# git directory -- and for the main worktree itself that is the same path, so there is no second case.
# Checking `$PWD` alone refused every worktree the provider would in fact have opened.
# `--path-format` is git 2.31+; anything older or non-git leaves this empty and only `$PWD` is checked.
main_worktree=$(dirname "$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" 2>/dev/null || true)
[ "$main_worktree" = "." ] && main_worktree=''

# Codex keeps its project trust records per home, so a directory trusted in one is not trusted in the other.
# An untrusted directory stops the interactive agent at a prompt. Orca catches that for its own launch path and reports `codex-interactive-prompt`, but a terminal we created ourselves gets no such check: the brief would be typed into the trust prompt and the lane would hang with no timeout of its own.
# Refuse before creating anything, and do not write the operator's config to make the problem go away.
trusted=$(
  python3 - "$codex_home/config.toml" "$worktree" "$main_worktree" <<'PY'
import re, sys
path = sys.argv[1]
roots = {root for root in sys.argv[2:] if root}
try:
    lines = open(path, encoding="utf-8").read().splitlines()
except OSError:
    print("no")
    raise SystemExit
wanted = {f'[projects."{root}"]' for root in roots}
inside = False
for line in lines:
    stripped = line.strip()
    if stripped.startswith("["):
        inside = stripped in wanted
        continue
    if inside and re.match(r'trust_level\s*=\s*"trusted"', stripped):
        print("yes")
        raise SystemExit
print("no")
PY
)
if [ "$trusted" != "yes" ]; then
  printf 'ocs team: %s is not trusted in %s\n' "$worktree" "$codex_home" >&2
  if [ -n "$main_worktree" ] && [ "$main_worktree" != "$worktree" ]; then
    printf '  Its main worktree %s carries no record either, and a linked worktree inherits that one.\n' "$main_worktree" >&2
  fi
  printf '  A worker launched there would stall at the trust prompt with no brief delivered.\n' >&2
  printf '  Open the provider once in that directory and accept, or add to %s/config.toml:\n' "$codex_home" >&2
  printf '    [projects."%s"]\n    trust_level = "trusted"\n' "${main_worktree:-$worktree}" >&2
  exit 1
fi

command -v orca >/dev/null 2>&1 || { printf 'ocs team: `orca` is not on PATH.\n' >&2; exit 1; }
orca status --json >/dev/null 2>&1 || { printf 'ocs team: the Orca app is not reachable. Start it with `orca open`.\n' >&2; exit 1; }

# Resolved from the worker's worktree, not the lead's: `workspace-write` is scoped to the tree the worker
# holds, so a report path anywhere else is one the worker cannot write and the lane would complete silently.
dir="$(cd "$worktree" && "$KEIN_ROOT/libexec/ocs-state-dir" runs/team)/$stamp-$role"

# The report is the deliverable and does not belong in the tree the repository ignores. `runs/` is
# declared transient in `.gitignore` and everything else under `.agents/kein/` is a kept record, so a
# report written into `runs/` is the one file there worth keeping -- and the only reason the directory
# cannot simply be deleted when it looks cluttered.
reports="$(cd "$worktree" && "$KEIN_ROOT/libexec/ocs-state-dir" reports)"
report="$reports/$stamp-$role.md"

# The role is a file the worker's shell reads at launch, so a multi-kilobyte prompt never has to survive being typed into a terminal.
role_file="$dir/role.md"

# `developer_instructions` is a Codex configuration field, and an unrecognized field is ignored rather than refused.
# A version that dropped it would leave a worker running with no role at all and nothing in the output to say so, so prove the injection lands before spending a session on it.
# `debug prompt-input` renders the model-visible prompt without calling the model, which makes this about a second and free.
if ! CODEX_HOME="$codex_home" codex debug prompt-input -c 'developer_instructions=KEIN_ROLE_INJECTION_PROBE' x 2>/dev/null | grep -q KEIN_ROLE_INJECTION_PROBE; then
  printf 'ocs team: this provider build no longer accepts `developer_instructions`.\n' >&2
  printf '  A worker would start with no role prompt and nothing would report the omission.\n' >&2
  printf '  Re-check which field carries developer instructions before using this command.\n' >&2
  exit 1
fi

# The spec carries the task and what to produce, and nothing about identity.
# The output contract is here because Orca's preamble already offers `--report-path`, and requiring it is what replaces the transcript this launch path cannot produce.
spec=$(
  printf '%s\n\n## Output contract\n\nWrite your full report to `%s` before finishing: what you changed, what you verified and how, and what remains.\nThen report completion with `--report-path %s`.\nThe file is the deliverable; the completion body is a summary of it.\n' \
    "$task" "$report" "$report"
)

# KEIN_STATE_ROOT pins the worker's own ledger to this worktree instead of wherever it wanders.
# The writable-roots value is single-quoted because the terminal runs this through a shell, and `[` opens a glob pattern there.
# Unquoted, zsh fails the whole line with `no matches found` before codex ever starts.
# The role is substituted by the shell that launches the worker, so the command line stays short and the prompt's own quoting never reaches a tokenizer.
# CODEX_HOME travels with the worker, not just with the trust check.
# Resolving it here and then letting the worker inherit whatever the shell had would make the pinned home a fiction: it worked only because the tuned home is reached through a shell function rather than an exported variable.
plugin_flags=''
for override in $(codex_plugin_overrides "$codex_home"); do
  plugin_flags="$plugin_flags -c '$override'"
done
launch="CODEX_HOME=$codex_home KEIN_STATE_ROOT=$worktree codex -m $model -c model_reasoning_effort=$effort -s $SANDBOX -c $SANDBOX_CONFIG -c 'sandbox_workspace_write.writable_roots=[\"$worktree/$STATE_DIRNAME\"]'$plugin_flags -c developer_instructions=\"\$(cat '$role_file')\""

json_field() { python3 -c 'import json,sys; d=json.load(sys.stdin); v=d.get("result") or {}
for k in sys.argv[1].split("."):
    v = (v or {}).get(k) if isinstance(v, dict) else None
print(v or "")' "$1"; }

# A live worker holding this worktree is the one precondition nothing looked for. `lanes.md` says a
# single vendor is what keeps the ledger serial, and that is enforced at the flag: one `--executor`
# names one vendor and says nothing about a second dispatch. The first measured run made the second
# one while the first still held its terminal.
#
# Every dispatch this command makes records its own id, so the sibling run directories are the
# roster. A dispatch settles when its terminal dies -- both of that run's did, once they were killed
# -- so a stale record cannot lock the worktree, and an id Orca cannot resolve is a purged dispatch
# rather than evidence of a worker, which is why only a present-and-unsettled status refuses.
occupant=''
for prior in "$(dirname "$dir")"/*/command.txt; do
  [ -r "$prior" ] || continue
  grep -qxF "cwd=$worktree" "$prior" || continue
  prior_dispatch=$(sed -n 's/^dispatch=//p' "$prior" | tail -1)
  [ -n "$prior_dispatch" ] || continue
  prior_status=$(orca orchestration worker-show --dispatch "$prior_dispatch" --json 2>/dev/null | json_field dispatch.status)
  case "$prior_status" in
    ''|completed|failed) continue ;;
  esac
  occupant="$prior_dispatch (status=$prior_status, $(dirname "$prior"))"
  break
done
if [ -n "$occupant" ]; then
  printf 'ocs team: a worker still holds this worktree — %s\n' "$occupant" >&2
  printf '  settle or close it before dispatching another; the task ledger is serial.\n' >&2
  exit 1
fi

if [ "$check" -eq 1 ]; then
  # Everything above this line is a precondition; everything below creates something. So this is the
  # only place a check can stop and still have answered the question it was asked.
  #
  # Not "nothing was created": resolving a path through `ocs state-dir` creates it, as that command's
  # own summary says, so `runs/team/` and `reports/` exist after this runs. Both are stable rather
  # than per-invocation -- the run directory is composed from the resolved root and is not created
  # here -- so repeated checks add nothing further. What a check promises is that nothing was spent.
  printf 'ocs team: preconditions pass, and no worker holds this worktree. Nothing was spent.\n' >&2
  printf '\nrole      %s\nworktree  %s\nreport    %s\nrun dir   %s\n' "$role" "$worktree" "$report" "$dir"
  printf '\n--- launch ---\n%s\n' "$launch"
  printf '\n--- spec ---\n%s\n' "$spec"
  exit 0
fi

# Created here rather than where their paths were resolved, so that a check leaves the filesystem as
# it found it and can be run as often as it is useful.
mkdir -p "$dir" "$reports"
role_prompt_body "$roles/$role.md" > "$role_file"


fail() { printf 'ocs team: %s\n' "$1" >&2; exit 1; }

# One Run per invocation, so two backgrounded lanes never share a coordinator inbox.
# Completion is read from the dispatch and the report file rather than from that inbox, which is what keeps concurrent invocations from consuming each other's mail.
# No flag. The command already writes the role prompt and creates this directory unconditionally, so
# the marginal cost is two small files -- roughly 2 KB against the role prompt's 5 to 8 -- and what
# they hold is the only record of which home, model and sandbox a lane actually received. A record
# that depends on remembering a flag is the failure mode `execute`'s lane reference already cites for
# deleting the Executor-vendor requirement: written by the mechanism rather than by a lead who forgets.
printf '%s' "$spec" > "$dir/spec.txt"

run_id=$(orca orchestration run-create --objective "kein $role lane: $(printf '%s' "$task" | cut -c1-80)" --json 2>/dev/null | json_field run.id)
[ -n "$run_id" ] || fail 'could not create an Orca run. Is orchestration enabled in Settings > Experimental?'

task_id=$(orca orchestration task-create --spec "$spec" --json 2>/dev/null | json_field task.id)
[ -n "$task_id" ] || fail 'could not create the Orca task'

# The terminal must land where the caller is, not where the operator's Orca window happens to be focused.
# `--worktree current` reads Orca's own selection, so a lead working in one checkout could dispatch a worker into another: the sandbox roots and KEIN_STATE_ROOT above are built from $PWD and would then describe a directory the worker is not in.
# That is the same defect shape as the model and CODEX_HOME ones — a value that looks pinned and is actually inherited from the environment.
{
  printf 'CODEX_HOME=%s\n' "$codex_home"
  printf 'cwd=%s\n' "$worktree"
  printf '%s\n' "$launch"
} > "$dir/command.txt"

handle=$(orca terminal create --worktree "path:$worktree" --title "kein-$role" --command "$launch" --json 2>/dev/null | json_field terminal.handle)
if [ -z "$handle" ]; then
  printf 'ocs team: could not create a worker terminal in %s\n' "$worktree" >&2
  printf '  Orca addresses terminals by worktree; this path must be one Orca knows.\n' >&2
  printf '  Check `orca worktree list`, and open the directory in Orca once if it is absent.\n' >&2
  exit 1
fi

orca terminal wait --terminal "$handle" --for tui-idle --timeout-ms 120000 --json >/dev/null 2>&1 || true

dispatch=$(orca orchestration worker-start --task "$task_id" --terminal "$handle" --json 2>/dev/null | json_field dispatchId)
if [ -z "$dispatch" ]; then
  printf 'ocs team: the worker started but could not be attached to a dispatch.\n' >&2
  printf '  terminal=%s left open for inspection.\n' "$handle" >&2
  exit 1
fi

# Written here rather than after the dispatch attaches, which is where it used to be. The lane that
# most needs a record is the one that failed, and every failure path above this point exited before
# reaching it -- so the flag that was supposed to make a lane recoverable produced nothing in exactly
# the case it was for.
printf 'run=%s\ntask=%s\ndispatch=%s\nterminal=%s\n' "$run_id" "$task_id" "$dispatch" "$handle" >> "$dir/command.txt"

# Poll the dispatch rather than wait on the Run mailbox.
# `worker-show` takes the dispatch id directly, so nothing here depends on which Run this terminal happens to be bound to.
elapsed=0
status=''
said_unsignalled=0
while [ "$elapsed" -lt "$timeout" ]; do
  status=$(orca orchestration worker-show --dispatch "$dispatch" --json 2>/dev/null | json_field dispatch.status)
  case "$status" in
    completed|failed) break ;;
  esac
  # The report is the deliverable and `worker_done` is the signal, and a worker can produce one
  # without the other -- the first measured run wrote its report and then narrated its stop in prose,
  # so this loop had nothing to break on and held the terminal for the rest of the timeout. Say it
  # once when it happens: no further waiting can settle a dispatch the worker never signalled.
  if [ "$said_unsignalled" -eq 0 ] && [ -s "$report" ]; then
    said_unsignalled=1
    printf 'ocs team: the report exists and the dispatch has not settled.\n' >&2
    printf '  the worker wrote %s without signalling completion; waiting cannot settle that.\n' "$report" >&2
  fi
  sleep 10
  elapsed=$((elapsed + 10))
done

if [ "$status" != "completed" ]; then
  [ -n "$status" ] || status='unknown'
  # Written to the run record as well as stderr. A backgrounded caller sees no stderr until the
  # command returns, which on this path is the whole timeout, so the file is the copy that is there
  # when someone finally looks.
  {
    printf 'ocs team: worker did not complete (status=%s after %ss)\n' "$status" "$elapsed"
    printf '  terminal=%s is now yours to close: orca terminal close --terminal %s\n' "$handle" "$handle"
    printf '  dispatch=%s -- inspect: orca orchestration worker-read --dispatch %s --json\n' "$dispatch" "$dispatch"
  } | tee -a "$dir/command.txt" >&2
  exit 1
fi

[ "$keep" -eq 1 ] || orca terminal close --terminal "$handle" --json >/dev/null 2>&1 || true

if [ ! -s "$report" ]; then
  printf 'ocs team: the worker completed without writing %s\n' "$report" >&2
  printf '  The completion signal arrived, so the work may be done, but the deliverable is missing.\n' >&2
  exit 1
fi

printf 'report: %s\n' "$report"
printf 'trace: %s\n' "$dir" >&2
cat "$report"
