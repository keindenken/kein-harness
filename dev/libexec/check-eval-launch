#!/usr/bin/env python3
#: Prove an arm's command line carries exactly what the run asked for and nothing by default.
#
# Every flag `launch_command` adds is a variable in the comparison, and the expensive failure is not
# a crash. It is a flag that starts appearing by default: every past run stays on disk, keeps saying
# `kein-dev eval` at the top, and quietly stops being comparable to anything run afterwards. Nothing
# else here reads a command line, so a change of that kind would surface only as a result nobody
# could explain.
import importlib.util
import json
import os
import sys
import tempfile
from pathlib import Path
from types import SimpleNamespace

DEV_ROOT = Path(os.environ["KEIN_DEV_ROOT"])
spec = importlib.util.spec_from_file_location("kein_eval_run", DEV_ROOT / "eval" / "run.py")
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)

failures = []


def flag_value(command, flag):
    return command[command.index(flag) + 1] if flag in command else None


# --- the default is bare, which is what every run so far measured -----------------------------
bare = module.launch_command("do the task", "sonnet", False, None, 500)
if "--append-system-prompt-file" in bare:
    failures.append("a lead prompt reached an arm that did not ask for one, which silently reprices every past run")
if "--plugin-dir" in bare:
    failures.append("the control arm was given the harness")
if flag_value(bare, "--permission-mode") != "bypassPermissions":
    failures.append("a task arm cannot write, so it cannot produce the artifact it is graded on")

# A probe asks what reached the session and writes nothing, so it must not be handed bypass.
probe = module.launch_command("what reached you", "sonnet", True, None, 500)
if "--permission-mode" in probe:
    failures.append("a probe was given a permission mode it has no use for")

# --- resolution ------------------------------------------------------------------------------
if module.resolve_lead_prompt("none") is not None:
    failures.append("'none' resolved to something, so the default side of the axis is not reachable")
if module.resolve_lead_prompt(None) is not None:
    failures.append("an absent value resolved to something")

with tempfile.TemporaryDirectory() as tmp:
    lead = Path(tmp) / "lead.md"
    lead.write_text("# Lead\n")

    resolved = module.resolve_lead_prompt(str(lead))
    if resolved != lead.resolve():
        failures.append(f"a lead prompt path did not resolve to itself: {resolved}")

    # A run that looks like it carried a lead prompt and did not is the failure worth refusing for.
    # Skipping a missing file would produce exactly that, and it would report as a normal run.
    try:
        module.resolve_lead_prompt(str(Path(tmp) / "absent.md"))
        failures.append("a missing lead prompt was accepted, so a run could report carrying one it never had")
    except SystemExit:
        pass

    # Both arms or neither. The lead prompt is the axis; giving it to one side would put two
    # variables between the arms and leave the difference unattributable to either.
    for plugin_dir in (None, Path(tmp) / "plugin"):
        command = module.launch_command("do the task", "sonnet", False, plugin_dir, 500, (), resolved)
        if flag_value(command, "--append-system-prompt-file") != str(resolved):
            failures.append(f"the lead prompt did not reach the arm with plugin_dir={plugin_dir}")

    # A denied tool is the one case-level flag that changes what an arm can find out for itself.
    denied = module.launch_command("do the task", "sonnet", False, None, 500, ("Bash(sqlite3:*)",))
    if flag_value(denied, "--disallowedTools") != "Bash(sqlite3:*)":
        failures.append("a denied tool did not reach the arm, so a case could settle its own question")

# --- plugins a case chooses, and the findings store an arm must never inherit ---------------------
with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    one = module.launch_command("do the task", "sonnet", False, root / "kein", 500)
    if one.count("--plugin-dir") != 1:
        failures.append("a single plugin did not produce exactly one --plugin-dir")
    chosen = [path for _, path in module.plugin_sources(["kein-findings"], root)]
    only = module.launch_command("do the task", "sonnet", False, chosen, 500)
    if only.count("--plugin-dir") != 1 or flag_value(only, "--plugin-dir") != str(root / "plugin-findings"):
        failures.append("a case that chose only kein-findings did not get exactly that plugin")
    both = module.launch_command("do the task", "sonnet", False, [p for _, p in module.plugin_sources(["kein", "kein-findings"], root)], 500)
    if both.count("--plugin-dir") != 2:
        failures.append("two chosen plugins did not produce two --plugin-dir flags")
    if "--plugin-dir" in module.launch_command("do the task", "sonnet", False, [], 500):
        failures.append("an empty plugin list still handed the arm a plugin")
    try:
        module.plugin_sources(["no-such-plugin"], root)
        failures.append("an unknown plugin name was accepted instead of refused before the run")
    except SystemExit:
        pass

    home = root / "config-homes" / "with-skill-0"
    home.mkdir(parents=True)
    os.environ["KEIN_FINDINGS_DIR"] = str(root / "operator-findings")
    pinned = module.arm_environment(root / "worktree", home)["KEIN_FINDINGS_DIR"]
    if pinned == os.environ["KEIN_FINDINGS_DIR"] or Path(pinned).exists():
        failures.append(f"an arm without supplied findings inherited or could reach a real store: {pinned}")
    supplied = root / "run" / "findings" / "with-skill-0"
    if module.arm_environment(root / "worktree", home, supplied)["KEIN_FINDINGS_DIR"] != str(supplied):
        failures.append("an arm's supplied findings copy did not reach it")

# --- an arm inherits no plugin bin/ from the operator's session ----------------------------------
# A run launched from a session with the harness would otherwise put that session's `ocs` ahead of the arm's own, and `ocs` refuses two harness trees.
with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    plugin_bin = root / "operator-plugin" / "bin"
    plugin_bin.mkdir(parents=True)
    (root / "operator-plugin" / ".claude-plugin").mkdir()
    (root / "operator-plugin" / ".claude-plugin" / "plugin.json").write_text('{"name": "kein"}')
    plain_bin = root / "tools" / "bin"
    plain_bin.mkdir(parents=True)
    kept = module.without_plugin_bins(os.pathsep.join([str(plain_bin), str(plugin_bin), "/usr/bin"]))
    if str(plugin_bin) in kept.split(os.pathsep):
        failures.append("an operator plugin's bin/ reached the arm's PATH")
    if kept.split(os.pathsep) != [str(plain_bin), "/usr/bin"]:
        failures.append(f"stripping plugin bins disturbed the rest of PATH: {kept}")
    saved_path = os.environ.get("PATH", "")
    os.environ["PATH"] = os.pathsep.join([str(plain_bin), str(plugin_bin)])
    try:
        if str(plugin_bin) in module.arm_environment(root / "worktree", root / "home")["PATH"].split(os.pathsep):
            failures.append("arm_environment passed an operator plugin's bin/ through to the arm")
    finally:
        os.environ["PATH"] = saved_path

# --- the default pair records the harness commit it ran, and whether it was dirty --------------
# A `--variant` arm names the commit it pins in its own spec; the built-in pair copies whatever
# the harness repository holds right now, which is exactly what a default run is usually
# measuring, and until `resolve_arms` set it, nothing recorded which commit that was.
with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    repo = root / "harness"
    repo.mkdir()
    module.run(["git", "init", "--quiet", "--initial-branch", "main"], cwd=repo)
    (repo / "marker.md").write_text("one\n")
    module.run(["git", "add", "-A"], cwd=repo)
    module.run(["git", "-c", "user.email=c@k", "-c", "user.name=c", "commit", "--quiet", "-m", "one"], cwd=repo)
    head = module.run(["git", "rev-parse", "HEAD"], cwd=repo).stdout.decode().strip()

    real_repo_root, real_prepare_plugin = module.KEIN_REPO_ROOT, module.prepare_plugin
    module.KEIN_REPO_ROOT = repo
    # `prepare_plugin` copies the real plugin tree and re-renders every agent, which this check
    # has no need to pay for -- it is testing what `resolve_arms` records about the commit, not
    # the copy itself, and `check-eval-launch` already runs without launching `claude`.
    module.prepare_plugin = lambda path, model, source=None: Path(path)
    try:
        options = SimpleNamespace(variant=None, arm=None)

        clean = module.resolve_arms(options, root / "clean-run", "sonnet")
        if clean["with-skill"]["commit"] != head:
            failures.append(f"the default pair did not record the harness commit: {clean['with-skill']}")
        if clean["with-skill"]["dirty"] is not False:
            failures.append(f"a clean harness tree was not recorded as clean: {clean['with-skill']}")
        if clean["without-skill"]["commit"] is not None or clean["without-skill"]["dirty"] is not None:
            failures.append("the control arm, which carries no plugin, claimed a harness commit anyway")

        (repo / "marker.md").write_text("two\n")
        dirty = module.resolve_arms(options, root / "dirty-run", "sonnet")
        if dirty["with-skill"]["dirty"] is not True:
            failures.append(f"an uncommitted change in the harness tree was not recorded as dirty: {dirty['with-skill']}")
        if dirty["with-skill"]["commit"] != head:
            failures.append("a dirty tree changed which commit was recorded, rather than only the dirty flag")

        # The manifest-writing path itself: `records[arm]` pulls these two fields straight off
        # the resolved arm spec (see `dev/eval/run.py`'s `main`), so proving that assignment
        # round-trips through JSON is proving what the manifest will actually carry.
        record = {"harness_commit": dirty["with-skill"].get("commit"), "harness_dirty": dirty["with-skill"].get("dirty")}
        written_back = json.loads(json.dumps(record))
        if written_back != {"harness_commit": head, "harness_dirty": True}:
            failures.append(f"the harness commit/dirty fields did not survive a manifest round-trip: {written_back}")
    finally:
        module.KEIN_REPO_ROOT, module.prepare_plugin = real_repo_root, real_prepare_plugin

if failures:
    for failure in failures:
        print(f"check-eval-launch: {failure}", file=sys.stderr)
    raise SystemExit(1)
print("check-eval-launch: the default arm is bare, a lead prompt reaches every arm or none, a case gets exactly the plugins it chose, no arm inherits the operator's findings, the default pair records the harness commit and dirty flag it ran, and no arm inherits the operator's plugin bin/ directories")
