        "--why-irreversible", "list item 4", "--parks", "whole run"))
    gap_answered_ref_plus_whole_run = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_answered_ref_plus_whole_run["gap"]:
        failures.append(f"gap reported true for a parked task whose own ref is answered alongside an unrelated, unanswered whole-run question: {gap_answered_ref_plus_whole_run}")

