# Scenario 15: the retrospective location is enforced mechanically, not left to the caller's discipline -- `close` refuses a `--retro` path outside `.agents/kein/runs/` while pausing over an unanswered question with execute still nonterminal.

def _section_scenario15_retro_location_enforced():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-retroloc.md"
        write_plan(plan_path, "Approved")
