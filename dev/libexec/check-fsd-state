# ---------------------------------------------------------------------------
# Scenario 29b: a hand-authored completed ledger that genuinely carries this flow's own `repository` and an `output_path` resolving inside this flow's own worktree -- the two fields `_interview_candidate_belongs` checks once its own live-only gate is passed -- is still refused, because it is terminal: `post-bash` links a stage's run at creation, while it is still live, so a ledger that completed before this flow ever attached it has nothing left here to rescue it, whatever its own surviving fields say. An ordinary `write_completed_ledger` fixture drops both fields entirely, so an ordinary completed-ledger case already fails the repository/output_path checks on its own, whether or not the live-only gate is even there -- that would not actually isolate it. This one is hand-authored to carry both fields through anyway, isolating the live-only gate the same way scenario 28 does for ralplan. Required case: deleting that gate turns this one, and only this one among the interview cases, from refused to accepted.

def _section_scenario29b_interview_completed_matching_ledger_refused():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

        result = must("starting the completed-matching-ledger case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario29b", "--input", "an idea", "--worktree", str(work)))
        state_path = require_path(result)
        must("entering interview for the completed-matching-ledger case", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-scenario29b"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / "req-scenario29b.md"
        output_path = interview_dir / "output.md"
        output_path.write_text("placeholder")
        # Hand-authored straight to its completed shape, but carrying `repository` and `output_path` -- the two fields an ordinary `write_completed_ledger` drops entirely -- so both genuinely match this flow's own worktree, and the live-only status check is the only thing left refusing it.
        ledger.write_text(
            "---\n"
            "status: completed\n"
            f'requirements_path: "{requirements_path}"\n'
            f'repository: "{work}"\n'
            f'output_path: "{output_path}"\n'
            f'completed_at: "{STAMP}"\n'
            "---\n"
        )

        refuse("attaching a completed ledger whose own repository and output_path both genuinely match this flow",
               fsd(work, "attach", str(state_path), "interview", str(ledger)), reason="does not belong")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["interview"]["association"] != "none" or status_after["stages"]["interview"]["run"] is not None:
            failures.append(f"attach accepted a completed ledger merely because its own repository and output_path matched: {status_after['stages']['interview']}")

# ---------------------------------------------------------------------------
# Scenario 30: once an interview stage has a kept link, a second active ledger in the same repository never replaces it -- `attach` refuses a different path outright, and re-attaching the exact same already-kept path is a harmless no-op that writes nothing. Required case: a same-repository second ledger does not replace the kept interview link.

def _section_scenario30_interview_second_ledger_never_replaces_kept_link():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

        result = must("starting the second-ledger case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario30", "--input", "an idea", "--worktree", str(work)))
        state_path = require_path(result)
        must("entering interview for the second-ledger case", fsd(work, "enter", str(state_path), "interview"))

        interview_run_root = work / ".agents" / "kein" / "runs" / "interview"
        first_ledger = interview_run_root / "260101-000000-scenario30-first" / "ledger.md"
        first_ledger.parent.mkdir(parents=True)
        write_active_ledger(first_ledger, "260101-000000-scenario30-first", work, work, work / "req-scenario30-first.md")
        must("attaching the first ledger while active", fsd(work, "attach", str(state_path), "interview", str(first_ledger)))

        second_ledger = interview_run_root / "260101-000000-scenario30-second" / "ledger.md"
        second_ledger.parent.mkdir(parents=True)
        write_active_ledger(second_ledger, "260101-000000-scenario30-second", work, work, work / "req-scenario30-second.md")

        refuse("attaching a second, equally well-formed active ledger in the same repository",
               fsd(work, "attach", str(state_path), "interview", str(second_ledger)), reason="a kept link is never replaced")
        status_after_second = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after_second["stages"]["interview"]["run"] != str(first_ledger):
            failures.append(f"a refused second attach still moved the kept link off the first ledger: {status_after_second['stages']['interview']}")

        must("attaching the first ledger again, the exact same path, is a no-op", fsd(work, "attach", str(state_path), "interview", str(first_ledger)))
        status_after_repeat = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after_repeat["stages"]["interview"]["run"] != str(first_ledger):
            failures.append(f"attaching the exact same already-kept path moved the association: {status_after_repeat['stages']['interview']}")

# ---------------------------------------------------------------------------
# Scenario 31: a ralplan run started with `--repository` left to default to `Path.cwd()`, from a subdirectory of the repository rather than its root, still links -- `_same_plan_reference` canonicalizes the candidate's own root through `_execute.canonical_worktree` before comparing it to this flow's own (already-canonical) worktree, rather than comparing raw paths. Required case: ralplan started from a subdirectory cwd links.

def _section_scenario31_ralplan_subdirectory_cwd_links():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        subdir = work / "sub"
        subdir.mkdir()
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"

        approved_requirements = work / "req-scenario31.md"
        write_requirements(approved_requirements, "Approved")
        result = must("starting the ralplan-subdirectory case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario31", "--input", str(approved_requirements), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering ralplan for the subdirectory case", fsd(work, "enter", str(state_path), "ralplan"))

        plan_path = work / "plan-scenario31.md"
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_dest = ralplan_run_root / "260101-000000-scenario31" / "state.json"
        # cwd is the subdirectory, and --repository is left unset, so ralplan's own `start` stores it exactly as `Path.cwd()` returns there: the subdirectory, not the repository root.
        must("starting the ralplan run from a subdirectory cwd, --repository left to default",
             ralplan(subdir, "start", str(ralplan_dest), "--input", str(approved_requirements), "--plan", str(plan_path), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        if read_json(ralplan_dest)["repository"] != str(subdir):
            failures.append("the subdirectory-cwd fixture did not actually store the subdirectory as its own repository; this case proves nothing")

        must("attaching the subdirectory-started ralplan run", fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)))
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["ralplan"]["association"] != "kept" or status_after["stages"]["ralplan"]["run"] != str(ralplan_dest):
            failures.append(f"attach refused a ralplan run whose own repository was an unresolved subdirectory of this flow's worktree: {status_after['stages']['ralplan']}")

# ---------------------------------------------------------------------------
# Scenario 32: a resumed, pending execute stage whose kept link is also the worktree's own current occupant -- the ordinary shape a parked task's own pause/answer/resume cycle leaves behind -- must not read as a mismatched stranger to abort even when the strict belonging test on it would newly fail (a transient read problem, or evidence the run's own file no longer carries the way it did when it was first attached): `_execute_occupant_block` trusts an occupant equal to the kept link outright, the identical shortcut `enter` already takes, without ever re-running `_execute_candidate_belongs` on it. Required case: the occupant-abort row does not fire over the flow's own kept, still-live run.

def _section_scenario32_resumed_kept_occupant_strict_test_failure_no_occupant_row():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

        plan_path = work / "plan-scenario32.md"
        write_plan(plan_path, "Approved")
        result = must("starting the resumed-kept-occupant case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario32", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        if read_json(state_path)["entry"] != "execute":
            failures.append("the scenario32 fixture did not enter directly at execute; this case proves nothing")
        must("entering execute for scenario32", fsd(work, "enter", str(state_path), "execute"))

        execute_state = execute_start(work, execute_run_root, "scenario32", [execute_task("task-001", ["README.md"])], plan_path=plan_path)
        must("attaching the execute run while still nonterminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))

        must("dispatching task-001 for scenario32", execute(work, "dispatch", str(execute_state), "task-001"))
        q = must("recording the irreversible question for scenario32",
                 fsd(work, "question", str(state_path), "--stage", "execute", "--question", "which persisted format?",
                     "--options", "json,csv", "--recommended", "json", "--why-irreversible", "list item 1: a persisted format read outside the repo",
                     "--parks", "task-001"))
        question_id = q.stdout.strip()
        must("parking task-001 for scenario32", execute(work, "park", str(execute_state), "task-001", "--question", "which format?", "--ref", question_id))
        must("checkpointing execute to blocked for scenario32", execute_checkpoint(work, execute_state, lambda s: s.update(
            {"lifecycle": "blocked", "phase": "blocked", "next_action": f"blocked on {question_id}: task-001 parked"})))

        must("entering closeout for scenario32", fsd(work, "closeout", str(state_path)))
        draft_retro = state_path.parent / "retro-draft-scenario32.md"
        draft_retro.write_text(f"# Retrospective\n\n{question_id}: parked.\n")
        must("closing while unanswered for scenario32", fsd(work, "close", str(state_path), "--retro", str(draft_retro)))
        must("answering the question for scenario32", fsd(work, "answer", str(state_path), question_id, "--text", "json"))
        must("resuming for scenario32", fsd(work, "resume", str(state_path)))
        resumed = read_json(state_path)
        if resumed["stages"]["execute"]["status"] != "pending" or resumed["stages"]["execute"]["run"] != str(execute_state):
            failures.append(f"the scenario32 fixture did not land on a resumed, pending, kept execute run; this case proves nothing: {resumed['stages']['execute']}")

        # The kept run is still the worktree's own current occupant -- nothing else is live -- so `_execute_occupant_block` is asked about exactly the flow's own run. Hand-corrupt its own `input.reference` directly on disk, bypassing `execute`'s own checkpoint validation entirely, so the strict belonging test would now read it as a stranger if it were ever re-run on it.
        corrupted = read_json(execute_state)
        corrupted["input"]["reference"] = str(work / "plan-scenario32-not-this-flow.md")
        write(execute_state, corrupted)

        gap_after = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if not gap_after["gap"] or gap_after["next"] != "execute":
            failures.append(f"gap did not report the ordinary resumed execute-pending row: {gap_after}")
        action = gap_after.get("action", "")
        if "occupies the worktree" in action or "abort it" in action or "python3 -c" in action:
            failures.append(f"gap treated the flow's own kept, still-live execute run as a mismatched occupant to abort, once its own strict test would newly fail: {action!r}")
        if "invoke /kein:execute" not in action or str(plan_path) not in action:
            failures.append(f"gap did not print the ordinary invoke-execute action for the resumed, still-blocked run: {action!r}")

# ---------------------------------------------------------------------------
# Scenario 33: re-attaching a stage's own already-kept path, after the run behind it has gone terminal (completed, here), is a harmless no-op -- exit 0, nothing written -- the same promise scenario 30 above proves while the kept run is still live. `attach` checks the exact-same-resolved-path case before it ever asks the strict belonging test (`_candidate_belongs`) about the candidate, which is what keeps that check from refusing the very run whose kept link already answers the question: `_candidate_belongs` refuses any terminal candidate outright, live-only being the whole point of the strict test, so asking it first would turn this into a refusal instead of the no-op the kept link's own presence already settles. Required case: attach of the kept path after its own run went terminal is a no-op.

def _section_scenario33_attach_same_kept_path_after_terminal_is_noop():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

        plan_path = work / "plan-scenario33.md"
        write_plan(plan_path, "Approved")
        result = must("starting the terminal-reattach case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario33", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute for scenario33", fsd(work, "enter", str(state_path), "execute"))

        execute_state = execute_start(work, execute_run_root, "scenario33", [execute_task("task-001", ["README.md"])], plan_path=plan_path)
        must("attaching the execute run while still nonterminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        before = read_json(state_path)
        if before["stages"]["execute"]["run"] != str(execute_state):
            failures.append(f"the scenario33 fixture did not actually pin the kept link before completing the run; this case proves nothing: {before['stages']['execute']}")

        drive_task_to_acceptance(work, execute_state, "task-001")
        must("entering final_audit for scenario33", execute_to_final_audit(work, execute_state))
        must("completing execute for scenario33", execute_complete(work, execute_state, ["task-001"]))
        if read_json(execute_state)["lifecycle"] != "completed":
            failures.append("the scenario33 fixture's own execute run did not actually reach a completed, terminal lifecycle; this case proves nothing")

        must("re-attaching the exact same already-kept path after its own run went terminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        after = read_json(state_path)
        if after["stages"]["execute"]["run"] != str(execute_state):
            failures.append(f"re-attaching the exact same already-kept path after its run went terminal moved the association: {after['stages']['execute']}")
        if after != before:
            failures.append(f"re-attaching the exact same already-kept path after its run went terminal wrote something to fsd's own state: before={before['stages']['execute']} after={after['stages']['execute']}")

# ---------------------------------------------------------------------------
# Scenario 34: a ralplan run started from a subdirectory of the repository, with `--input` and `--plan` given relative to that subdirectory's own cwd rather than absolute -- the ordinary way a lead standing in a subdirectory would type them -- still links. Scenario 31 above proves the subdirectory-root canonicalization alone; it types `--input` absolute, so a relative reference resolved against the wrong root never shows up. This scenario is what actually exercises `_same_plan_reference` resolving a ralplan candidate's own relative reference against the run's own `working_directory` rather than against the candidate's canonicalized repository root: a relative `--input` typed from `sub/` points at a file one level up, and only resolving it against `sub/` itself (not against the canonicalized repository root, a different directory the file is not relative to) lands back on the same file the flow's own absolute reference names. Required case: a subdirectory-started ralplan run with relative --input and --plan links.

def _section_scenario34_ralplan_subdirectory_relative_input_links():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        subdir = work / "sub"
        subdir.mkdir()
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"

        approved_requirements = work / "req-scenario34.md"
        write_requirements(approved_requirements, "Approved")
        result = must("starting the ralplan-subdirectory-relative case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario34", "--input", str(approved_requirements), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering ralplan for the subdirectory-relative case", fsd(work, "enter", str(state_path), "ralplan"))

        plan_path = work / "plan-scenario34.md"
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_dest = ralplan_run_root / "260101-000000-scenario34" / "state.json"
        # cwd is the subdirectory; --input and --plan are typed relative to it, exactly as a lead standing there would type them, and --repository/--working-directory are both left unset so they default to that same subdirectory.
        relative_input = os.path.relpath(approved_requirements, subdir)
        relative_plan = os.path.relpath(plan_path, subdir)
        must("starting the ralplan run from a subdirectory cwd with relative --input and --plan",
             ralplan(subdir, "start", str(ralplan_dest), "--input", relative_input, "--plan", relative_plan, "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        stored = read_json(ralplan_dest)
        if stored["repository"] != str(subdir) or stored["working_directory"] != str(subdir):
            failures.append(f"the subdirectory-relative fixture did not actually store the subdirectory as its own repository and working_directory; this case proves nothing: {stored}")
        if stored["input"]["reference"] != relative_input:
            failures.append(f"the subdirectory-relative fixture did not store --input exactly as typed; this case proves nothing: {stored['input']}")

        must("attaching the subdirectory-started ralplan run with a relative --input", fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)))
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["ralplan"]["association"] != "kept" or status_after["stages"]["ralplan"]["run"] != str(ralplan_dest):
            failures.append(f"attach refused a ralplan run started from a subdirectory with a relative --input typed relative to that same subdirectory: {status_after['stages']['ralplan']}")

# ---------------------------------------------------------------------------
# Scenario 35: the chain breaking one stage later. Scenario 34 proves the ralplan stage's own belonging test accepts a subdirectory-started run with a relative --input/--plan; this scenario carries that same run through to completion, where its own completed receipt keeps `plan.path` exactly as typed -- relative to a `working_directory` the completed shape drops entirely -- and proves the fix survives past that point: `attach` (scenario 34's own call) already stored the plan's resolved absolute path on `stages.ralplan.resolved_reference`, computed while the run was still live and its own `working_directory` still readable, so `gap`'s own printed action and `_expected_execute_plan_reference` both read that stored absolute rather than re-resolving the completed receipt's own relative `plan.path` against the wrong root (this flow's worktree, not the subdirectory). An execute run started against the plan's own absolute spelling -- exactly what a lead copying gap's own corrected action would type -- therefore still strictly belongs: it links via `attach`, and `_execute_occupant_block` never mistakes it for a foreign occupant once it already occupies the worktree unattached. Required case: a subdirectory-started ralplan run completes, and an execute run started with the plan's absolute path links, with gap naming no occupant.

def _section_scenario35_ralplan_subdirectory_completes_execute_links():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        subdir = work / "sub"
        subdir.mkdir()
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

        approved_requirements = work / "req-scenario35.md"
        write_requirements(approved_requirements, "Approved")
        result = must("starting the scenario35 case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario35", "--input", str(approved_requirements), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering ralplan for scenario35", fsd(work, "enter", str(state_path), "ralplan"))

        plan_path = work / "plan-scenario35.md"
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_dest = ralplan_run_root / "260101-000000-scenario35" / "state.json"
        # cwd is the subdirectory; --input and --plan are typed relative to it, and --repository/--working-directory are both left unset so they default to that same subdirectory -- the ordinary way a lead standing in `sub/` would type them.
        relative_input = os.path.relpath(approved_requirements, subdir)
        relative_plan = os.path.relpath(plan_path, subdir)
        must("starting the ralplan run from a subdirectory cwd with relative --input and --plan for scenario35",
             ralplan(subdir, "start", str(ralplan_dest), "--input", relative_input, "--plan", relative_plan, "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        must("attaching the subdirectory-started ralplan run for scenario35", fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)))

        stored_reference = read_json(state_path)["stages"]["ralplan"].get("resolved_reference")
        if stored_reference != str(plan_path.resolve()):
            failures.append(f"attach did not store ralplan's own plan path resolved absolute against its working_directory: {stored_reference!r} != {plan_path.resolve()}")

        must("opening ralplan round 1 for scenario35", ralplan(subdir, "open", str(ralplan_dest)))
        write_plan(plan_path, "Approved", "good", "v0")
        must("approving ralplan round 1 for scenario35", ralplan(subdir, "approve", str(ralplan_dest)))
        must("completing ralplan for scenario35", ralplan(subdir, "complete", str(ralplan_dest)))
        completed_ralplan = read_json(ralplan_dest)
        if "working_directory" in completed_ralplan:
            failures.append("ralplan's own completed receipt unexpectedly still carries working_directory; this case's premise (the completed shape drops it) no longer holds")

        gap_before_execute = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if not gap_before_execute["gap"] or gap_before_execute["next"] != "execute" or gap_before_execute["completed"] != "ralplan":
            failures.append(f"gap did not report the ralplan -> execute row for scenario35: {gap_before_execute}")
        expected_action = f"invoke /kein:execute {shlex.quote(str(plan_path.resolve()))}"
        if gap_before_execute["action"] != expected_action:
            failures.append(f"gap's own printed action did not name the plan's resolved absolute path: {gap_before_execute['action']!r} != {expected_action!r}")

        # The execute run is started against the plan's own absolute spelling, from the repository root -- not the subdirectory ralplan itself ran from -- exactly how a lead invoking /kein:execute with gap's own printed path would. Not attached yet, so this occupies the worktree's own per-worktree claim while execute's own fsd stage is still `pending`, which is exactly the moment `_execute_occupant_block` gets asked about it.
        execute_state = execute_start(work, execute_run_root, "scenario35", [execute_task("task-001", ["README.md"])], plan_path=plan_path)

        gap_with_unattached_occupant = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_with_unattached_occupant["action"] != expected_action:
            failures.append(f"gap treated the genuinely-belonging, not-yet-attached execute run as a foreign occupant: {gap_with_unattached_occupant}")

        must("entering execute for scenario35", fsd(work, "enter", str(state_path), "execute"))
        must("attaching the scenario35 execute run started with the plan's absolute path", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        status_execute = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_execute["stages"]["execute"]["association"] != "kept" or status_execute["stages"]["execute"]["run"] != str(execute_state):
            failures.append(f"attach refused an execute run started with the plan's own absolute path, once the ralplan stage that produced it was started from a subdirectory: {status_execute['stages']['execute']}")

        gap_after_execute = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_after_execute["gap"]:
            failures.append(f"gap reported a gap while execute is genuinely running with no evidence yet: {gap_after_execute}")

# ---------------------------------------------------------------------------
# Scenario 36: `enter execute` links a belonging occupant that has no kept link yet -- a resumed occupant (a prior session's own `execute start` already claimed the worktree against this flow's own plan, but no `post-bash` call in this session ever saw that `start` to attach it) is linked in the very same commit that marks execute entered, without a separate `attach` call. Required case: enter links a belonging occupant with no kept link.

def _section_scenario36_enter_links_belonging_occupant_no_kept_link():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-scenario36.md"
        write_plan(plan_path, "Approved")
        result = must("starting scenario36", fsd(work, "start", "--run-root", str(run_root), "--slug", "scenario36", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)

        # An execute run against this same plan already occupies the worktree -- e.g. a prior session's own `execute start` that no post-bash hook in this session ever attached -- so the worktree's own per-worktree claim is held while fsd's own kept link is still null.
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        occupant = execute_start(work, execute_run_root, "scenario36", [execute_task("task-001", ["README.md"])], plan_path=plan_path)
        before = read_json(state_path)
        if before["stages"]["execute"]["run"] is not None:
            failures.append("the scenario36 fixture already carries a kept execute link; this case proves nothing")

        must("entering execute for scenario36, with a belonging occupant and no kept link", fsd(work, "enter", str(state_path), "execute"))
        after = read_json(state_path)
        if after["stages"]["execute"]["status"] != "entered":
            failures.append(f"enter did not mark execute entered: {after['stages']['execute']}")
        if after["stages"]["execute"]["run"] != str(occupant):
            failures.append(f"enter did not link the belonging occupant in the same commit that marked execute entered: {after['stages']['execute']}")

        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["execute"]["association"] != "kept" or status_after["stages"]["execute"]["run"] != str(occupant):
            failures.append(f"the association after enter did not read as kept: {status_after['stages']['execute']}")

# ---------------------------------------------------------------------------
# Scenario 37: `ocs state fsd checkpoint` refuses a candidate that changes a stage's own `run` -- the escape hatch is not a second way to pin an association, bypassing the belonging test `attach` and `post-bash` always run first. Required case: checkpoint refuses a run change.

def _section_scenario37_checkpoint_refuses_run_change():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        result = must("starting scenario37", fsd(work, "start", "--run-root", str(run_root), "--slug", "scenario37", "--input", "an idea", "--worktree", str(work)))
        state_path = require_path(result)

        fake_ledger = work / "fake-ledger.md"
        fake_ledger.write_text("not a real ledger\n")
        candidate = read_json(state_path)
        candidate["stages"]["interview"]["run"] = str(fake_ledger)
        candidate_path = state_path.parent / "candidate-run-change.json"
        write(candidate_path, candidate)

        refuse("checkpointing a candidate that changes a stage's run directly", fsd(work, "checkpoint", str(state_path), str(candidate_path)),
               reason="checkpoint cannot change stage")
        unchanged = read_json(state_path)
        if unchanged["stages"]["interview"]["run"] is not None:
            failures.append("checkpoint applied a run change it should have refused")

# ---------------------------------------------------------------------------
# Scenario 38: `ocs state fsd checkpoint` refuses a candidate that appends an `agents_md` span on a transition other than `paused -> active` -- an active -> active checkpoint here, the ordinary shape of every other fsd write -- so a hand-authored candidate cannot fabricate a span with a hash `close`'s own AGENTS.md comparison would then trust. Required case: checkpoint refuses an added span on active -> active.

def _section_scenario38_checkpoint_refuses_added_span_not_paused_to_active():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        result = must("starting scenario38", fsd(work, "start", "--run-root", str(run_root), "--slug", "scenario38", "--input", "an idea", "--worktree", str(work)))
        state_path = require_path(result)

        candidate = read_json(state_path)
        if candidate["lifecycle"] != "active":
            failures.append("the scenario38 fixture is not active; this case proves nothing")
        candidate["agents_md"] = list(candidate["agents_md"]) + [{"span_started_at": STAMP, "sha256": None}]
        candidate_path = state_path.parent / "candidate-span-active.json"
        write(candidate_path, candidate)

        refuse("checkpointing a candidate that appends an agents_md span on an active -> active transition",
               fsd(work, "checkpoint", str(state_path), str(candidate_path)), reason="paused -> active")
        unchanged = read_json(state_path)
        if len(unchanged["agents_md"]) != 1:
            failures.append("checkpoint applied an agents_md span addition it should have refused")

# ---------------------------------------------------------------------------
# Scenario 39: `resolved_reference` is written the moment `attach` links ralplan, while that run is still live, not only once it completes -- so `_expected_execute_plan_reference` must still gate on the kept ralplan run's own current lifecycle before ever trusting the stored value, exactly as it gated on a raw re-read before `resolved_reference` existed. An execute run started against the same plan while ralplan is still open (Draft, not yet approved) must not belong, regardless of how confidently the absolute reference was already computed and stored. Required case: an execute run started/attached while its own ralplan is still live is refused.

def _section_scenario39_execute_refused_while_ralplan_live():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

        approved_requirements = work / "req-scenario39.md"
        write_requirements(approved_requirements, "Approved")
        result = must("starting scenario39", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario39", "--input", str(approved_requirements), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering ralplan for scenario39", fsd(work, "enter", str(state_path), "ralplan"))

        plan_path = work / "plan-scenario39.md"
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_dest = ralplan_run_root / "260101-000000-scenario39" / "state.json"
        must("starting the ralplan run for scenario39", ralplan(work, "start", str(ralplan_dest), "--input", str(approved_requirements), "--plan", str(plan_path), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        must("attaching the still-live ralplan run for scenario39", fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)))

        stored_reference = read_json(state_path)["stages"]["ralplan"].get("resolved_reference")
        if not stored_reference:
            failures.append("attach did not store ralplan's own resolved_reference while linking; this case proves nothing")
        if read_json(ralplan_dest)["lifecycle"] == "completed":
            failures.append("the scenario39 fixture's own ralplan run is already completed; this case proves nothing")

        # An execute run against the same plan, started (but never attached) while ralplan is still Draft -- not yet approved, let alone completed.
        execute_state = execute_start(work, execute_run_root, "scenario39", [execute_task("task-001", ["README.md"])], plan_path=plan_path)
        refuse("attaching an execute run while its own ralplan is still live", fsd(work, "attach", str(state_path), "execute", str(execute_state)),
               reason="does not belong")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["execute"]["association"] != "not entered":
            failures.append(f"an execute run started while ralplan is still live somehow read as associated: {status_after['stages']['execute']}")

# ---------------------------------------------------------------------------
# Scenario 40: the identical gate one stage earlier -- `resolved_reference` is written the moment `attach` links interview, while the ledger is still `active`, not only once it completes, so `_expected_ralplan_reference` must gate on the kept ledger's own current `status` before trusting the stored value. A ralplan run started against the same requirements path while interview is still active must not belong. Required case: a ralplan run attached while its own interview is still active is refused.

def _section_scenario40_ralplan_refused_while_interview_active():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"

        result = must("starting scenario40", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario40", "--input", "an idea", "--worktree", str(work)))
        state_path = require_path(result)
        must("entering interview for scenario40", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-scenario40"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / ".agents" / "kein" / "requirements" / "scenario40.md"
        requirements_path.parent.mkdir(parents=True)
        write_active_ledger(ledger, "260101-000000-scenario40", work, work, requirements_path)
        must("attaching the still-active interview ledger for scenario40", fsd(work, "attach", str(state_path), "interview", str(ledger)))

        stored_reference = read_json(state_path)["stages"]["interview"].get("resolved_reference")
        if not stored_reference:
            failures.append("attach did not store interview's own resolved_reference while linking; this case proves nothing")
        if read_json(state_path)["stages"]["interview"]["status"] != "entered":
            failures.append("the scenario40 fixture's own interview stage was not entered; this case proves nothing")

        # The requirements document is written well-formed enough for ralplan's own artifact validator, but the interview ledger itself stays `active`, never `completed` -- ralplan must not belong yet, however confidently `resolved_reference` was already computed at attach time.
        write_requirements(requirements_path, "Approved")
        must("entering ralplan for scenario40", fsd(work, "enter", str(state_path), "ralplan"))
        plan_path = work / "plan-scenario40.md"
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_dest = ralplan_run_root / "260101-000000-scenario40" / "state.json"
        must("starting the ralplan run for scenario40", ralplan(work, "start", str(ralplan_dest), "--input", str(requirements_path), "--plan", str(plan_path), "--summary", "check", "--lanes", "architect@claude,critic@claude"))

        scenario40_refused = refuse("attaching a ralplan run while its own interview is still active", fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)),
               reason="does not belong")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["ralplan"]["association"] != "none":
            failures.append(f"a ralplan run started while interview is still active somehow read as associated: {status_after['stages']['ralplan']}")
        # Finding 3(b): this candidate is live, not terminal, so it must keep the cause-only text -- asserting only the cause (as this section always has) leaves the consequence-and-way-forward sentence unasserted on its *absence* side, and the whole suite stays green even if `_candidate_terminal_but_matches`'s own ralplan liveness gate were deleted entirely. Mutation proof: removing the `if payload.get("lifecycle") != "completed": return False` gate from `_candidate_terminal_but_matches`'s ralplan branch turns this assertion RED, since the live Draft plan above still carries `plan.path` and sits inside this flow's own worktree with no `resolved_reference` yet pinned -- exactly what the gate alone stands between it and the sentence.
        scenario40_message = scenario40_refused.stderr
        if "unlinked for the rest of this run" in scenario40_message or "invoke the next stage directly" in scenario40_message:
            failures.append(f"a live ralplan candidate refused only because its own interview link is not yet completed wrongly carried the consequence-and-way-forward sentence: {scenario40_message!r}")

# ---------------------------------------------------------------------------
# Scenario 41: `checkpoint`'s own per-stage `run`/`resolved_reference` guard (scenario 37) only has a `previous` state to compare against once `destination` already exists -- a first candidate to a destination `start` never created has nothing to compare against, and would otherwise commit whatever `run` it named exactly as given: the identical bypass scenario 37 closes, reached by never having a destination instead of by changing one on an existing run. `start` is the one builder of a new fsd run, so `checkpoint` refuses a nonexistent destination outright, before ever loading the candidate for anything but that check, and points at `start`. Required case: checkpoint to a new destination carrying a run is refused.

def _section_scenario41_checkpoint_refuses_new_destination_with_run():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        result = must("starting scenario41's own template run", fsd(work, "start", "--run-root", str(run_root), "--slug", "scenario41-template", "--input", "an idea", "--worktree", str(work)))
        template_path = require_path(result)
        template = read_json(template_path)

        # A hand-authored candidate, shaped like a legitimate initial checkpoint (lifecycle active, one agents_md span) but carrying a stage `run` no `start` ever produced -- exactly what `checkpoint` must refuse to promote onto a destination `start` never created.
        fake_ledger = work / "fake-ledger-scenario41.md"
        fake_ledger.write_text("not a real ledger\n")
        candidate = json.loads(json.dumps(template))
        candidate["run_id"] = "260101-000000-scenario41-new"
        candidate["stages"]["interview"]["run"] = str(fake_ledger)
        candidate_path = template_path.parent / "candidate-new-destination.json"
        write(candidate_path, candidate)

        new_destination = run_root / "260101-000000-scenario41-new" / "state.json"
        if new_destination.exists():
            failures.append("the scenario41 fixture's own new destination already exists; this case proves nothing")

        refuse("checkpointing a run field straight onto a destination start never created", fsd(work, "checkpoint", str(new_destination), str(candidate_path)),
               reason="does not exist")
        if new_destination.exists():
            failures.append("checkpoint created a new destination it should have refused to create")

# ---------------------------------------------------------------------------
# Section "gap" (issue 1a): an entered stage whose association still reads "none" now carries a diagnosis on gap's own no-gap result -- the stage's name paired with the identical reason text `status` already shows beside it (`_none_association_reason`, read once and reused, never re-derived) -- so a lead no longer has to read `status` by hand to learn what `gap` itself could already see. `gap` still reports no gap throughout: a stage that is merely still running, with its ledger not yet completed, must never read as a gap of its own. Once the only entered stage is linked, the diagnosis clears to null. Registered under the literal name "gap" so `--only gap` runs just this section.

def _section_gap_diagnosis_field():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

        result = must("starting the gap-diagnosis case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "gapdiag", "--input", "an idea", "--worktree", str(work)))
        state_path = require_path(result)

        # Finding 4: `diagnosis` is a fixed key on every return `gap()` makes, `gap: True` rows included, even though every `gap: True` row commits it `null`. Nothing above ever checked the key was actually there on a `gap: True` row -- dropping it entirely would still leave every existing assertion here green, since none of them ever read `"diagnosis" in result` on this branch. The entry-stage pending row (idea input, interview not yet entered) is the first `gap: True` row this flow ever produces.
        gap_pending_entry = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if not gap_pending_entry.get("gap"):
            failures.append(f"the entry-stage row was not a gap before interview was ever entered: {gap_pending_entry}")
        if "diagnosis" not in gap_pending_entry:
            failures.append(f"a gap: True row carried no diagnosis key at all: {gap_pending_entry}")
        elif gap_pending_entry["diagnosis"] is not None:
            failures.append(f"a gap: True row's diagnosis was not null: {gap_pending_entry}")

        must("entering interview for the gap-diagnosis case", fsd(work, "enter", str(state_path), "interview"))

        gap_unlinked = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_unlinked["gap"]:
            failures.append(f"gap fired for an entered-but-unlinked interview stage, which is not a gap on its own: {gap_unlinked}")
        status_unlinked = json.loads(fsd(work, "status", str(state_path)).stdout)
        expected_reason = status_unlinked["stages"]["interview"].get("association_reason")
        if not expected_reason:
            failures.append(f"status carried no association_reason to compare gap's diagnosis against: {status_unlinked['stages']['interview']}")
        if gap_unlinked.get("diagnosis") != {"interview": expected_reason}:
            failures.append(f"gap's no-gap diagnosis did not name the entered-but-unlinked interview stage with status's own reason text: {gap_unlinked.get('diagnosis')!r} vs {{'interview': {expected_reason!r}}}")
        # `status` computes its own diagnosis field by merging `gap(state)` over the same state, so comparing `status_unlinked["diagnosis"]` against `gap_unlinked["diagnosis"]` is one expression checked twice and cannot fail. What the merge actually introduces is redundancy between two fields that now say the same thing on the same response: `status`'s own per-stage `association_reason` and its merged `diagnosis`.
        diagnosis_reason = (status_unlinked.get("diagnosis") or {}).get("interview")
        if not expected_reason or not diagnosis_reason or expected_reason != diagnosis_reason:
            failures.append(f"status's own per-stage association_reason and its merged diagnosis diverged, though both describe the identical fact: {expected_reason!r} vs {diagnosis_reason!r}")

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-gapdiag"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        write_active_ledger(ledger, "260101-000000-gapdiag", work, work, work / "req-gapdiag.md")
        must("attaching the interview ledger for the gap-diagnosis case", fsd(work, "attach", str(state_path), "interview", str(ledger)))

        gap_linked = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_linked["gap"]:
            failures.append(f"gap fired while interview is a running, now-linked stage with no completed evidence: {gap_linked}")
        if gap_linked.get("diagnosis") is not None:
            failures.append(f"gap's diagnosis was not null once the only entered stage was linked: {gap_linked.get('diagnosis')!r}")
        status_linked = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_linked.get("diagnosis") is not None:
            failures.append(f"status's own merged diagnosis was not null once the only entered stage was linked: {status_linked.get('diagnosis')!r}")

        # Finding 4's other unasserted behaviour: `gap`'s own early return (any lifecycle other than `active`) only ever carries a diagnosis for `paused` -- a `completed`, `halted`, or `aborted` run is terminal, and making that unconditional (handing a diagnosis to a terminal run's own lead) would leave the whole suite green, since nothing above ever drove a run past `active` while a stage was still entered and unlinked. A fresh flow, own temp directory, proves both ends of that split for real: interview entered and never linked (unanswered `resolved_reference`, exactly the incident's own shape), paused over an unrelated whole-run question -- `diagnosis` must still name interview -- then aborted from there -- `diagnosis` must clear to null even though the very same entered-but-unlinked stage is still sitting there, since a terminal lifecycle's own lead has no door left to act through.
        with tempfile.TemporaryDirectory() as tmp2:
            tmp2 = Path(tmp2)
            work2 = (tmp2 / "repo").resolve()
            init_repo(work2)
            fsd_run_root2 = work2 / ".agents" / "kein" / "runs" / "fsd"

            result2 = must("starting the paused/terminal diagnosis case", fsd(work2, "start", "--run-root", str(fsd_run_root2), "--slug", "gapdiaglife", "--input", "an idea", "--worktree", str(work2)))
            state_path2 = require_path(result2)
            must("entering interview for the paused/terminal diagnosis case", fsd(work2, "enter", str(state_path2), "interview"))

            status_unlinked2 = json.loads(fsd(work2, "status", str(state_path2)).stdout)
            expected_reason2 = status_unlinked2["stages"]["interview"].get("association_reason")
            if not expected_reason2:
                failures.append(f"the paused/terminal diagnosis case carried no association_reason to compare against: {status_unlinked2['stages']['interview']}")

            qid = must("recording a whole-run question for the paused/terminal diagnosis case", fsd(work2, "question", str(state_path2),
                "--stage", "interview", "--question", "does this idea still need interview?", "--options", "yes,no",
                "--recommended", "yes", "--why-irreversible", "the owner's ruling is not something the flow can infer",
                "--parks", "whole run")).stdout.strip()
            retro_path2 = state_path2.parent / "retro.md"
            retro_path2.write_text(f"{qid} pending; the flow paused before interview ever linked.\n")
            must("closing over an unanswered whole-run question to reach paused", fsd(work2, "close", str(state_path2), "--retro", str(retro_path2)))
            paused_state2 = read_json(state_path2)
            if paused_state2["lifecycle"] != "paused":
                failures.append(f"close did not pause over an unanswered whole-run question: {paused_state2['lifecycle']}")

            gap_paused = json.loads(fsd(work2, "gap", str(state_path2)).stdout)
            if gap_paused["gap"]:
                failures.append(f"gap fired for a paused run: {gap_paused}")
            if gap_paused.get("diagnosis") != {"interview": expected_reason2}:
                failures.append(f"a paused run's own diagnosis did not name its entered-but-unlinked interview stage: {gap_paused.get('diagnosis')!r} vs {{'interview': {expected_reason2!r}}}")

            must("aborting the paused run to reach a terminal lifecycle", fsd(work2, "abort", str(state_path2), "--reason", "the paused/terminal diagnosis case is done with this run"))
            aborted_state2 = read_json(state_path2)
            if aborted_state2["lifecycle"] != "aborted":
                failures.append(f"abort did not reach the aborted lifecycle from paused: {aborted_state2['lifecycle']}")

            gap_aborted = json.loads(fsd(work2, "gap", str(state_path2)).stdout)
            if gap_aborted["gap"]:
                failures.append(f"gap fired for a terminal (aborted) run: {gap_aborted}")
            if gap_aborted.get("diagnosis") is not None:
                failures.append(f"a terminal (aborted) run's own diagnosis was not null, though the same entered-but-unlinked interview stage was still sitting there: {gap_aborted.get('diagnosis')!r}")

        # Finding 6: `diagnosis` is a fixed key on every `gap()` return, `gap: True` rows included, though every `gap: True` row commits it `null` -- asserted above only for the entry-stage pending row, which leaves every other `gap: True` row's own key unproven. The aborted-stage closeout row is exactly the one finding 6 found unproven: dropping the key from that one return statement alone left the whole suite green, since nothing anywhere already read `"diagnosis" in result` on it. A third, separate worktree, since `state_path`'s own flow above stays active throughout the rest of this section and `work2` has already been driven to aborted for a different row.
        with tempfile.TemporaryDirectory() as tmp3:
            tmp3 = Path(tmp3)
            work3 = (tmp3 / "repo").resolve()
            init_repo(work3)
            fsd_run_root3 = work3 / ".agents" / "kein" / "runs" / "fsd"

            result3 = must("starting the aborted-stage-closeout-row diagnosis case", fsd(work3, "start", "--run-root", str(fsd_run_root3), "--slug", "gapdiagcloseout", "--input", "an idea", "--worktree", str(work3)))
            state_path3 = require_path(result3)
            must("entering interview for the aborted-stage-closeout-row diagnosis case", fsd(work3, "enter", str(state_path3), "interview"))
            interview_dir3 = work3 / ".agents" / "kein" / "runs" / "interview" / "260101-000000-gapdiagcloseout"
            interview_dir3.mkdir(parents=True)
            ledger3 = interview_dir3 / "ledger.md"
            write_active_ledger(ledger3, "260101-000000-gapdiagcloseout", work3, work3, work3 / "req-gapdiagcloseout.md")
            must("attaching the interview ledger while still active for the aborted-stage-closeout-row diagnosis case",
                 fsd(work3, "attach", str(state_path3), "interview", str(ledger3)))
            write_aborted_ledger(ledger3)

            gap_closeout_row = json.loads(fsd(work3, "gap", str(state_path3)).stdout)
            if not gap_closeout_row["gap"] or gap_closeout_row["next"] != "closeout" or gap_closeout_row["completed"] != "interview":
                failures.append(f"the aborted-stage-closeout-row diagnosis fixture did not reach the row this case needs; this case proves nothing: {gap_closeout_row}")
            if "diagnosis" not in gap_closeout_row:
                failures.append(f"the aborted-stage closeout row carried no diagnosis key at all: {gap_closeout_row}")
            elif gap_closeout_row["diagnosis"] is not None:
                failures.append(f"the aborted-stage closeout row's diagnosis was not null: {gap_closeout_row}")

        # Finding 1 (a regression this run introduced): `_gap_diagnosis` used to tolerate a malformed `stages` map the same way every other row past `gap`'s own first reads its evidence -- a read failure answers "nothing to report," not "raise out of `gap` itself." Four shapes probe that: `stages` absent entirely, `stages: null`, a stage key removed from an otherwise-present `stages` dict, and a stage value that is a bare string rather than a dict -- each raises a `KeyError`, `TypeError`, or `AttributeError` out of `state["stages"][stage]` or `stage_state.get("run")` inside `_flow_stage_run`, none of which `main`'s own `gap` command catches (it only ever catches `OSError`, `UnicodeError`, `json.JSONDecodeError`, and `ValueError`), so a crash here means an uncaught traceback and a nonzero exit rather than a clean refusal. `_load` only requires the file to parse as a JSON object, so a minimal hand-authored `{"lifecycle": "paused", "stages": ...}` is enough to reach `gap`'s own paused branch without going through a full valid state at all. Mutation proof: reverting `_gap_diagnosis` to the unwrapped loop it used to be turns every one of the four cases below RED, since `fsd gap` would then exit on an uncaught exception instead of printing `{"gap": false, ..., "diagnosis": null}`.
        malformed_stages_shapes = {
            "stages absent": {"lifecycle": "paused"},
            "stages null": {"lifecycle": "paused", "stages": None},
            "a stage key removed": {
                "lifecycle": "paused",
                "stages": {
                    "interview": {"status": "pending", "run": None, "resolved_reference": None},
                    "ralplan": {"status": "pending", "run": None, "resolved_reference": None},
                    "closeout": {"status": "pending", "run": None, "resolved_reference": None},
                },
            },
            "a stage value a string": {
                "lifecycle": "paused",
                "stages": {
                    "interview": "not a dict",
                    "ralplan": {"status": "pending", "run": None, "resolved_reference": None},
                    "execute": {"status": "pending", "run": None, "resolved_reference": None},
                    "closeout": {"status": "pending", "run": None, "resolved_reference": None},
                },
            },
        }
        for label, malformed_payload in malformed_stages_shapes.items():
            malformed_path = tmp / f"malformed-{label.replace(' ', '-')}.json"
            write(malformed_path, malformed_payload)
            malformed_result = fsd(work, "gap", str(malformed_path))
            if malformed_result.returncode != 0:
                failures.append(f"gap over a paused state with {label} did not tolerate the malformed stages map -- it exited {malformed_result.returncode} instead of reporting no gap: {malformed_result.stderr!r}")
            else:
                malformed_gap = json.loads(malformed_result.stdout)
                if malformed_gap.get("gap") is not False or malformed_gap.get("diagnosis") is not None:
                    failures.append(f"gap over a paused state with {label} did not read as gap: false with a null diagnosis: {malformed_gap}")

# ---------------------------------------------------------------------------
# Section "attach" (issue 1a, corrected on review round 3, and again on round 4): attaching a terminal -- already-completed -- candidate still refuses, exactly as before, but when that candidate is genuinely this flow's own, the refusal now names the consequence alongside the cause: the stage stays unlinked for the rest of this run, so the lead's actual way forward is to invoke the next stage directly rather than retry attach against a candidate that will never pass -- this is the fixture the live incident actually left behind: the interview ledger's own validation had already completed by the time anything tried to link it, so the only candidate ever available to attach was this one. Finding 1 (blocking, corrected on round 3): the ledger below is now the real compact shape `ocs validate interview ledger` accepts -- {status, requirements_path, completed_at} only -- not the five-key shape this section used to hand-author, which that same validator refuses and which no real interview run could ever produce (a completed ledger drops `repository` and `output_path` entirely). Round 3 gates the sentence on `status`/`lifecycle == "completed"` explicitly rather than on "not live", so an *aborted* ledger or receipt -- genuinely this flow's own file, genuinely under its worktree, but never a run this flow finished -- is now asserted to keep the cause-only text too, alongside the completed candidate that does get the sentence. Round 3 also asserts the `resolved_reference` cross-check both ways, once a prior live attach has actually pinned one. Every other belonging failure -- unreadable, or a candidate whose own file lives outside this flow's canonical worktree -- keeps the cause-only text it always had, proven here by a genuine completed ledger sitting under a different repository entirely, and by one sitting under a git repository nested inside this flow's own worktree (round 4, finding 2). Round 4's finding 1 also adds a subdirectory-started completed ralplan receipt, whose own `plan.path` survives compaction as a bare relative spelling with no `working_directory` left to resolve it against -- the refusal must fall back to the pathless prose rather than confidently naming a path that does not exist. Registered under the literal name "attach" so `--only attach` runs just this section.

def _section_attach_terminal_candidate_message():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

        result = must("starting the attach-terminal-candidate case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "attachterm", "--input", "an idea", "--worktree", str(work)))
        state_path = require_path(result)
        must("entering interview for the attach-terminal-candidate case", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-attachterm"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / "req-attachterm.md"
        # The real compact shape a completed ledger actually has -- {status, requirements_path, completed_at} only. This is what makes it "genuinely this flow's own" for the corrected `_candidate_terminal_but_matches`: the ledger file itself sits under this flow's own worktree (`work`), which is all that function has left to ask once `repository` and `output_path` are gone -- this stage was never linked before this call, so there is no `resolved_reference` on record yet to cross-check a named document against either.
        write_completed_ledger(ledger, requirements_path)
        must("validating the completed ledger this section attaches, the same validator post-bash relies on",
             interview_validate(work, "ledger", ledger))

        attach_refused = refuse("attaching a completed interview ledger", fsd(work, "attach", str(state_path), "interview", str(ledger)), reason="does not belong")
        message = attach_refused.stderr
        if "unlinked for the rest of this run" not in message:
            failures.append(f"the terminal-candidate refusal did not name the consequence -- the stage staying unlinked for the rest of this run: {message!r}")
        if "invoke the next stage directly" not in message:
            failures.append(f"the terminal-candidate refusal did not point at invoking the next stage directly: {message!r}")
        # Finding 2 (corrected on round 3): a real completed ledger drops `repository`, so `_resolved_reference_for_attach` can never resolve `output_path` from it -- but it does still carry `requirements_path`, the same field `_candidate_terminal_but_matches` already reads off this exact candidate, so the refusal now falls back to naming that surviving field, resolved against this flow's own worktree, rather than the wordier prose that names no path at all. This branch used to be dead for every genuine candidate on the false premise that a completed ledger carries nothing usable; it is not dead once the fallback reads the field the compact shape actually keeps.
        expected_document = str(requirements_path.resolve())
        if f"invoke the next stage directly with {expected_document}, the document this run produced" not in message:
            failures.append(f"the terminal-candidate refusal over a genuine completed ledger did not name its own surviving requirements_path as the document: {message!r}")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["interview"]["association"] != "none" or status_after["stages"]["interview"]["run"] is not None:
            failures.append(f"attach linked a terminal candidate despite refusing it: {status_after['stages']['interview']}")

        # Finding 1 (blocking) + finding 3(a): an *aborted* ledger must not get the sentence either -- it was never this flow's completed run, and pointing the lead at "invoke the next stage" over one would send them to a document that run never produced. Mutation proof: reverting `_candidate_terminal_but_matches`'s interview gate from `status == "completed"` back to `status != "active"` turns this assertion RED, since an aborted ledger clears "not active" just as readily as a completed one does.
        aborted_interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-attachterm-aborted"
        aborted_interview_dir.mkdir(parents=True)
        aborted_ledger = aborted_interview_dir / "ledger.md"
        write_aborted_ledger(aborted_ledger)
        aborted_ledger_refused = refuse("attaching an aborted interview ledger", fsd(work, "attach", str(state_path), "interview", str(aborted_ledger)), reason="does not belong")
        aborted_ledger_message = aborted_ledger_refused.stderr
        if "unlinked for the rest of this run" in aborted_ledger_message or "invoke the next stage directly" in aborted_ledger_message:
            failures.append(f"an aborted interview ledger wrongly carried the consequence-and-way-forward sentence, though it was never this flow's own completed run: {aborted_ledger_message!r}")

        # Finding 1 (blocking) + finding 3(a), the ralplan half: an aborted ralplan receipt commits no `plan` key at all (`ABORTED_FIELDS`), so it must not get the sentence either. Mutation proof: reverting the same gate for ralplan back to `lifecycle not in NONTERMINAL_LIFECYCLES` turns this assertion RED.
        aborted_ralplan_requirements = work / "req-attachterm-ralplan-aborted.md"
        write_requirements(aborted_ralplan_requirements, "Approved")
        aborted_ralplan_plan = work / "plan-attachterm-ralplan-aborted.md"
        write_plan(aborted_ralplan_plan, "Draft", "first cut", "v0")
        aborted_ralplan_dest = work / ".agents" / "kein" / "runs" / "ralplan" / "260101-000000-attachterm-ralplan-aborted" / "state.json"
        must("starting the ralplan run to abort for the attach-terminal-candidate case",
             ralplan(work, "start", str(aborted_ralplan_dest), "--input", str(aborted_ralplan_requirements), "--plan", str(aborted_ralplan_plan), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        must("aborting the ralplan run for the attach-terminal-candidate case",
             ralplan(work, "abort", str(aborted_ralplan_dest), "--reason", "cancelled"))
        aborted_ralplan_refused = refuse("attaching an aborted ralplan receipt", fsd(work, "attach", str(state_path), "ralplan", str(aborted_ralplan_dest)), reason="does not belong")
        aborted_ralplan_message = aborted_ralplan_refused.stderr
        if "unlinked for the rest of this run" in aborted_ralplan_message or "invoke the next stage directly" in aborted_ralplan_message:
            failures.append(f"an aborted ralplan receipt wrongly carried the consequence-and-way-forward sentence, though it commits no plan key at all and was never this flow's own completed run: {aborted_ralplan_message!r}")

        # Finding 2 (corrected, round 4): the worktree-location check had no oracle of its own -- deleting it, or weakening it to a textual `Path.relative_to`, left the whole suite green, because the one fixture exercising it (the other-repository case below) used to run after the crosscheck block past this point had already pinned interview's own `resolved_reference`, so a location failure and a stored-document mismatch were confounded on the same assertion. Both cases here run first, against this same `state_path` while `stages.interview.resolved_reference` is still null -- the `pre_pin` check just below proves that -- so `stored` reads falsy inside `_candidate_terminal_but_matches` and the worktree-location check alone decides the outcome, with nothing left to confound it. Mutation proof: deleting the corrected `_candidate_terminal_but_matches`'s own worktree-location check (folding it back to "always true once terminal and readable") turns both refusals below from cause-only to carrying the sentence. The nested-repository case adds what the other-repository case alone cannot prove: weakening the check to a plain `Path.relative_to` in place of `_execute.canonical_worktree` would still refuse a genuinely different repository (its path is not textually inside `work` at all), but would wrongly accept a git repository nested inside this flow's own worktree, since `<work>/vendor/nested` is textually relative to `work` even though its own git toplevel is not the same canonical root.
        pre_pin = read_json(state_path)["stages"]["interview"].get("resolved_reference")
        if pre_pin:
            failures.append(f"interview's own resolved_reference was already pinned before the location checks ran; this case proves nothing: {pre_pin!r}")

        other = (tmp / "other-repo").resolve()
        init_repo(other)
        other_interview_dir = other / ".agents" / "kein" / "runs" / "interview" / "260101-000000-attachterm-other"
        other_interview_dir.mkdir(parents=True)
        mismatched_ledger = other_interview_dir / "ledger.md"
        mismatched_requirements_path = other / "req-attachterm-other.md"
        write_completed_ledger(mismatched_ledger, mismatched_requirements_path)
        must("validating the other-repository completed ledger", interview_validate(other, "ledger", mismatched_ledger))
        mismatch_refused = refuse("attaching a completed ledger whose own file lives under a genuinely different repository",
                                   fsd(work, "attach", str(state_path), "interview", str(mismatched_ledger)), reason="does not belong")
        mismatch_message = mismatch_refused.stderr
        if "unlinked for the rest of this run" in mismatch_message or "invoke the next stage directly" in mismatch_message:
            failures.append(f"a location-mismatch refusal carried the consequence-and-way-forward sentence, which belongs only to a candidate whose own file lives inside this flow's worktree: {mismatch_message!r}")

        nested = work / "vendor" / "nested"
        init_repo(nested)
        nested_interview_dir = nested / ".agents" / "kein" / "runs" / "interview" / "260101-000000-attachterm-nested"
        nested_interview_dir.mkdir(parents=True)
        nested_ledger = nested_interview_dir / "ledger.md"
        nested_requirements_path = nested / "req-attachterm-nested.md"
        write_completed_ledger(nested_ledger, nested_requirements_path)
        must("validating the nested-repository completed ledger", interview_validate(nested, "ledger", nested_ledger))
        nested_refused = refuse("attaching a completed ledger whose own file lives under a git repository nested inside this flow's worktree",
                                 fsd(work, "attach", str(state_path), "interview", str(nested_ledger)), reason="does not belong")
        nested_message = nested_refused.stderr
        if "unlinked for the rest of this run" in nested_message or "invoke the next stage directly" in nested_message:
            failures.append(f"a nested-repository refusal carried the consequence-and-way-forward sentence, though its own file's git toplevel is a different, nested repository rather than this flow's own worktree: {nested_message!r}")

        # Finding 4: an absolute document path is not enough on its own to earn the follow-up sentence's confidence -- it also has to resolve inside this flow's own worktree, or resolve to a file that genuinely exists; a hand-authored completed ledger is free to name any absolute path at all, real or not, and the old check trusted the spelling alone. This candidate's own file lives inside `work` (so it clears `_candidate_terminal_but_matches`'s worktree-location check the same way the genuine completed ledger at the top of this section does -- interview's own `resolved_reference` is still null at this point in the section, the same `pre_pin` fact the location checks above already proved), but the document it names is an absolute path under a sibling directory outside `work` entirely, and this fixture never writes anything there. Mutation proof: reverting the trustworthiness check in `_attach_refusal_follow_up` back to `Path(raw_document).is_absolute() or (resolved is not None and resolved.is_file())` turns this assertion RED, naming the outside-worktree path below as though this flow's own interview stage had produced it.
        untrusted_interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-attachterm-untrusted"
        untrusted_interview_dir.mkdir(parents=True)
        untrusted_ledger = untrusted_interview_dir / "ledger.md"
        outside_document = (tmp / "outside-attachterm-untrusted.md").resolve()
        if outside_document.exists():
            failures.append(f"the untrustworthy-absolute-document fixture's own outside path unexpectedly exists on disk; this case proves nothing: {outside_document}")
        write_completed_ledger(untrusted_ledger, outside_document)
        must("validating the untrustworthy-absolute-document ledger", interview_validate(work, "ledger", untrusted_ledger))
        untrusted_refused = refuse("attaching a completed ledger naming an absolute, nonexistent, out-of-worktree document",
                                    fsd(work, "attach", str(state_path), "interview", str(untrusted_ledger)), reason="does not belong")
        untrusted_message = untrusted_refused.stderr
        if "unlinked for the rest of this run" not in untrusted_message:
            failures.append(f"the untrustworthy-absolute-document refusal did not name the consequence -- the stage staying unlinked for the rest of this run: {untrusted_message!r}")
        if "invoke the next stage directly with the document this run produced, not this run's own path" not in untrusted_message:
            failures.append(f"the untrustworthy-absolute-document refusal did not fall back to the pathless prose, though its own named document neither exists nor lives inside this flow's own worktree: {untrusted_message!r}")
        if str(outside_document) in untrusted_message:
            failures.append(f"the untrustworthy-absolute-document refusal confidently named a document outside this flow's own worktree that nothing on disk backs: {untrusted_message!r}")

        # Finding 3(c) (corrected, finding 2): the `resolved_reference` cross-check, both ways. Once interview is genuinely linked and `resolved_reference` is pinned at one requirements path, a second completed ledger naming that exact path is a `_candidate_terminal_but_matches` yes (it is, as far as the evidence goes, the same document this run already produced), and one naming a different path is not -- sharing the worktree alone is not enough once a sharper answer is on record. Interview is already linked here, so a `_candidate_terminal_but_matches` yes reaches `_attach_refusal_follow_up`'s kept-link branch, not its unlinked one -- the mismatch case's own refusal is plain cause-only text either way this comparison comes out, ending "...in this flow's own canonical worktree." exactly like every other belonging refusal in this section, and neither "unlinked for the rest of this run" nor "invoke the next stage directly" ever appears on it whether the comparison holds or not, so an assertion that checks only for those two strings proves nothing here: it stayed green when this comparison was folded away to "worktree location alone decides" during review, because the wrongly-admitted mismatch candidate would then reach the *kept-link* branch, not the unlinked one. The string that actually discriminates is "stays linked to the run already kept at", the one the match case above already asserts it earns for the identical document -- the mismatch case must never earn it too. Mutation proof: making `_candidate_terminal_but_matches` return `True` as soon as the completed and worktree-location gates pass -- folding the `stored`/`resolved_document` comparison away -- turns the assertion below RED, since the mismatched ledger then also reaches the kept-link branch and its message picks up that same sentence. A later class of defect lives right here, not in that comparison: `_candidate_terminal_but_matches` says yes for exactly this match case precisely because interview is *alr