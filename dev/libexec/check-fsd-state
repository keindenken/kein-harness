#!/usr/bin/env python3
#: Drive the fsd state machine through real fixture states -- built with the real interview, ralplan, and execute state commands -- and fail if any invariant stops holding.
#
# fsd chains three workflows it does not own, so this check builds fixtures the same way a live run would produce them: an interview ledger written by hand (interview has no state.py to call), a ralplan run driven through its own CLI, and an execute run driven through its own CLI plus a few hand-authored checkpoints for the transitions execute has no builder for.
# Nothing here weakens a case to make it pass; a failure here means `state.py` is wrong, not the fixture.
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

ROOT = Path(os.environ["KEIN_ROOT"])
FSD = ROOT / "skills" / "fsd" / "scripts" / "state.py"
EXECUTE = ROOT / "skills" / "execute" / "scripts" / "state.py"
RALPLAN = ROOT / "skills" / "ralplan" / "scripts" / "state.py"
failures = []
STAMP = "2026-01-01T00:00:00+09:00"

REQUIREMENTS_HEADINGS = (
    "## Context", "## Desired outcome", "## Scope", "### In scope", "### Out of scope",
    "## Requirements", "## Constraints", "## Decision boundaries", "## Acceptance criteria",
    "## Decisions and rationale", "## Relevant system evidence", "## Assumptions and risks", "## Deferred items",
)


def _run(script, work, *args):
    return subprocess.run([sys.executable, str(script), *args], cwd=str(work), capture_output=True, text=True)


def fsd(work, *args):
    return _run(FSD, work, *args)


def execute(work, *args):
    return _run(EXECUTE, work, *args)


def ralplan(work, *args):
    return _run(RALPLAN, work, *args)


def git(work, *args):
    subprocess.run(["git", *args], cwd=str(work), check=True, capture_output=True)


def read_json(path):
    return json.loads(Path(path).read_text())


def write(path, payload):
    Path(path).write_text(json.dumps(payload))


def must(label, result):
    if result.returncode != 0:
        failures.append(f"{label} was refused and should not be: {result.stderr.strip()}")
    return result


def refuse(label, result, reason=None):
    if result.returncode == 0:
        failures.append(f"{label} was accepted and must not be")
    elif reason and reason not in result.stderr:
        failures.append(f"{label} was refused for the wrong reason: {result.stderr.strip()}")
    return result


def require_path(result):
    # A setup call this scenario depends on (a `must(...)` immediately before this) is expected to print exactly one absolute path on success.
    # `Path("")` resolves to `.`, the process's cwd -- so silently continuing past a failure here would turn every later fixture path in this scenario into one relative to wherever the check happened to be invoked from, rather than the temp directory it belongs under.
    # This stops the whole check immediately instead, after printing every failure accumulated so far.
    text = result.stdout.strip()
    if result.returncode != 0 or not text:
        for failure in failures:
            print(f"check-fsd-state: {failure}", file=sys.stderr)
        print("check-fsd-state: a setup call this scenario depends on did not print a path; stopping before any fixture path could resolve relative to the process's cwd", file=sys.stderr)
        raise SystemExit(1)
    return Path(text)


def init_repo(work):
    work.mkdir(parents=True, exist_ok=True)
    git(work, "init", "-q")
    git(work, "config", "user.email", "check@example.invalid")
    git(work, "config", "user.name", "check")
    (work / "AGENTS.md").write_text("# AGENTS\n")
    (work / "README.md").write_text("hello\n")
    git(work, "add", "-A")
    git(work, "commit", "-qm", "first")


def write_requirements(path, status):
    lines = ["# Check requirements", "", f"Status: {status}", "Date: 2026-01-01", ""]
    for heading in REQUIREMENTS_HEADINGS:
        lines += [heading, "", "- item", ""]
    if status == "Draft":
        lines += ["## Blocking gaps", "", "- something unresolved", ""]
    Path(path).write_text("\n".join(lines) + "\n")


def write_plan(path, status, reason="reason", body="body"):
    Path(path).write_text(f"# Check plan\n\nStatus: {status} — {reason}\n\n---\n\n{body}\n")


def write_active_ledger(path, run_id, working_directory, repository, output_path):
    Path(path).write_text(
        "---\n"
        "status: active\n"
        f'run_id: "{run_id}"\n'
        f'working_directory: "{working_directory}"\n'
        f'repository: "{repository}"\n'
        f'output_path: "{output_path}"\n'
        "---\n\n"
        "# Interview Ledger: check\n\n"
        "## Original request\n\nrequest\n\n"
        "## Confirmed decisions\n\n- d\n\n"
        "## Constraints and non-goals\n\n- c\n\n"
        "## Decision boundaries\n\n- b\n\n"
        "## Repository evidence\n\n- e\n\n"
        "## Open questions\n\n- q\n\n"
        "## Explicit deferrals\n\n- f\n"
    )


def write_completed_ledger(path, requirements_path):
    Path(path).write_text(
        "---\n"
        "status: completed\n"
        f'requirements_path: "{requirements_path}"\n'
        f'completed_at: "{STAMP}"\n'
        "---\n"
    )


def write_aborted_ledger(path):
    Path(path).write_text(f'---\nstatus: aborted\naborted_at: "{STAMP}"\nreason: "cancelled"\n---\n')


def execute_task(task_id, scope):
    return {"id": task_id, "title": task_id, "scope": scope, "completion_condition": f"{task_id} done",
            "verification_path": ["true"], "rationale": "fixture"}


def execute_start(work, run_root, slug, tasks, worktree=None, plan_path=None):
    # `plan_path`, when given, starts the run against that plan (`--kind plan --input <plan_path>`) instead of the ordinary brief fixture input -- needed only where a test means the run's own `input.reference` to line up with an fsd run's plan, e.g. proving `enter` adopts a pre-existing execute run over a matching plan.
    tasks_path = Path(tempfile.mkdtemp()) / "tasks.json"
    tasks_path.write_text(json.dumps(tasks))
    input_args = ["--kind", "plan", "--input", str(plan_path)] if plan_path is not None else ["--kind", "brief", "--summary", f"check {slug}"]
    result = must(f"starting execute run {slug}",
                  execute(work, "start", "--run-root", str(run_root), "--slug", slug, *input_args,
                          "--worktree", str(worktree or work), "--tasks", str(tasks_path)))
    return require_path(result)


def by_id(state, task_id):
    return next(t for t in state["tasks"] if t["id"] == task_id)


def verdict(role, word, task_id, round_number, fingerprint="auto"):
    return {"reviewer_role": role, "verdict": word, "task_id": task_id, "round": round_number,
            "worktree_fingerprint": fingerprint, "reviewed_at": STAMP, "fresh": True, "independent": True}


def verification(command, round_number, fingerprint="auto"):
    return {"command": command, "exit_code": 0, "observed_at": STAMP, "round": round_number, "worktree_fingerprint": fingerprint}


def execute_checkpoint(work, state_path, mutate):
    state = read_json(state_path)
    state["revision"] = "auto"
    state["worktree"]["observed"] = "auto"
    mutate(state)
    candidate_path = Path(tempfile.mkdtemp()) / "candidate.json"
    write(candidate_path, state)
    return execute(work, "checkpoint", str(state_path), str(candidate_path))


def durable_retro_path(state):
    worktree = Path(state["worktree"])
    slug = state["run_id"].split("-", 2)[2]
    today = datetime.now().astimezone().strftime("%y%m%d")
    return worktree / ".agents" / "kein" / "retros" / f"{today}-{slug}.md"


def execute_complete(work, state_path, task_ids):
    state = read_json(state_path)
    receipt = {
        "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": state["run_id"],
        "lifecycle": "completed", "completed_at": STAMP,
        "input": {"reference": None, "sha256": state["input"]["sha256"]},
        "worktree": {"root": state["worktree"]["root"], "final_fingerprint": "auto"},
        "accepted_tasks": [{"id": t["id"], "title": t["title"], "completion_condition": t["completion_condition"], "carried_findings": []}
                           for t in state["tasks"] if t["id"] in task_ids],
        "final_verification": state["latest_verification"], "final_audit": state["final_audit"],
        "carried_findings": [],
    }
    candidate_path = Path(tempfile.mkdtemp()) / "receipt.json"
    write(candidate_path, receipt)
    return execute(work, "checkpoint", str(state_path), str(candidate_path))


def drive_task_to_acceptance(work, state_path, task_id):
    # `dispatch` (the CLI builder) does not touch `round` -- it stays at the task's opening 0, and nothing in the ordinary verify/review/accept run moves it either: only an initial dispatch or a correction round is allowed to advance it.
    # So this drive stays at round 0 throughout.
    must(f"dispatching {task_id}", execute(work, "dispatch", str(state_path), task_id))
    must(f"verifying {task_id}", execute_checkpoint(work, state_path, lambda s: by_id(s, task_id).update(
        {"status": "verifying", "round": 0, "latest_verification": [verification("true", 0)]})))
    must(f"reviewing {task_id}", execute_checkpoint(work, state_path, lambda s: by_id(s, task_id).update({"status": "reviewing"})))
    must(f"accepting {task_id}", execute_checkpoint(work, state_path, lambda s: by_id(s, task_id).update(
        {"status": "accepted", "acceptance": {"round": 0, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "PASS", task_id, 0)]}})))


def execute_to_final_audit(work, state_path):
    def mutate(state):
        state["phase"] = "final_audit"
        state["latest_verification"] = [verification("true", state["current_round"])]
        state["final_audit"] = [verdict("code-reviewer", "PASS", "whole-change", state["current_round"])]
    return execute_checkpoint(work, state_path, mutate)


# ---------------------------------------------------------------------------
# Scenario 1: the five input classifications, `start`'s refusal over an existing nonterminal run, and `report`'s `None.` sections on a freshly started run.

with tempfile.TemporaryDirectory() as tmp:
    work = (Path(tmp) / "repo").resolve()
    init_repo(work)
    run_root = work / ".agents" / "kein" / "runs" / "fsd"

    result = must("starting the idea case", fsd(work, "start", "--run-root", str(run_root), "--slug", "idea", "--input", "add a --verbose flag", "--worktree", str(work)))
    idea_state = require_path(result)
    if read_json(idea_state)["entry"] != "interview":
        failures.append("free-text idea input did not classify to interview")

    report_text = fsd(work, "report", str(idea_state)).stdout
    if report_text.count("None.") != 4:
        failures.append(f"report on a fresh run did not print four `None.` sections: {report_text!r}")
    if "## Halted" in report_text:
        failures.append("report printed a Halted section for a non-halted run")

    refuse("starting a second fsd run for an occupied worktree", fsd(work, "start", "--run-root", str(run_root), "--slug", "idea2", "--input", "another idea", "--worktree", str(work)),
           reason="a nonterminal fsd run already exists")
    must("aborting the idea case to free the worktree", fsd(work, "abort", str(idea_state), "--reason", "onto the next classification case"))
    gap_aborted = json.loads(fsd(work, "gap", str(idea_state)).stdout)
    if gap_aborted["gap"]:
        failures.append(f"gap reported true on an aborted run: {gap_aborted}")

    approved_requirements = work / "req-approved.md"
    write_requirements(approved_requirements, "Approved")
    result = must("starting the approved-requirements case",
                  fsd(work, "start", "--run-root", str(run_root), "--slug", "reqok", "--input", str(approved_requirements), "--worktree", str(work)))
    reqok_state = require_path(result)
    if read_json(reqok_state)["entry"] != "ralplan":
        failures.append("an approved requirements input did not classify to ralplan")
    must("aborting the reqok case", fsd(work, "abort", str(reqok_state), "--reason", "onto the next classification case"))

    draft_requirements = work / "req-draft.md"
    write_requirements(draft_requirements, "Draft")
    result = must("starting the draft-requirements case",
                  fsd(work, "start", "--run-root", str(run_root), "--slug", "reqdraft", "--input", str(draft_requirements), "--worktree", str(work)))
    reqdraft_state = require_path(result)
    if read_json(reqdraft_state)["entry"] != "interview":
        failures.append("a draft requirements input did not classify to interview")
    must("aborting the reqdraft case", fsd(work, "abort", str(reqdraft_state), "--reason", "onto the next classification case"))

    approved_plan = work / "plan-approved.md"
    write_plan(approved_plan, "Approved")
    result = must("starting the approved-plan case",
                  fsd(work, "start", "--run-root", str(run_root), "--slug", "planok", "--input", str(approved_plan), "--worktree", str(work)))
    planok_state = require_path(result)
    if read_json(planok_state)["entry"] != "execute":
        failures.append("an approved plan input did not classify to execute")
    must("aborting the planok case", fsd(work, "abort", str(planok_state), "--reason", "onto the next classification case"))

    draft_plan = work / "plan-draft.md"
    write_plan(draft_plan, "In Review")
    result = must("starting the in-review-plan case",
                  fsd(work, "start", "--run-root", str(run_root), "--slug", "plandraft", "--input", str(draft_plan), "--worktree", str(work)))
    plandraft_state = require_path(result)
    if read_json(plandraft_state)["entry"] != "ralplan":
        failures.append("an in-review plan input did not classify to ralplan")

# ---------------------------------------------------------------------------
# Scenario 1b: `classify_input` resolves a relative `--input` against `--worktree`, not against the process's own current working directory, which `start --worktree X` may point somewhere else entirely.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    elsewhere = (tmp / "elsewhere").resolve()
    elsewhere.mkdir()
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    (work / "plans").mkdir()
    relative_plan = work / "plans" / "p.md"
    write_plan(relative_plan, "Approved")
    result = must("starting with a relative --input from a cwd other than --worktree",
                  fsd(elsewhere, "start", "--run-root", str(fsd_run_root), "--slug", "relinput",
                      "--input", "plans/p.md", "--worktree", str(work)))
    relinput_state = require_path(result)
    relinput_payload = read_json(relinput_state)
    if relinput_payload["entry"] != "execute":
        failures.append(f"a relative --input resolved against the process cwd instead of --worktree and misclassified: {relinput_payload}")
    if relinput_payload["input"]["reference"] != str(relative_plan):
        failures.append(f"a relative --input's stored reference was not resolved against the worktree: {relinput_payload['input']}")

# ---------------------------------------------------------------------------
# Scenario 2: the full drive -- idea -> interview -> ralplan -> execute, a task parked on an irreversible decision, close pausing with the retrospective kept under runs/fsd (settlement 4), the resumed execute run's reconcile proving no drift, resume/close precedence once the question is answered but execute is still blocked (settlement 3), then driving the task to acceptance and closing the run completed.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)

    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    result = must("starting the full-flow run", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "flow", "--input", "do the thing", "--worktree", str(work)))
    fsd_state = require_path(result)
    fsd_run_dir = fsd_state.parent

    gap0 = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if not gap0["gap"] or gap0["next"] != "interview":
        failures.append(f"gap did not fire for the not-yet-entered entry stage: {gap0}")

    must("entering interview", fsd(work, "enter", str(fsd_state), "interview"))
    before_reenter = read_json(fsd_state)
    must("entering interview a second time is idempotent", fsd(work, "enter", str(fsd_state), "interview"))
    if read_json(fsd_state) != before_reenter:
        failures.append("entering an already-entered stage a second time changed the state")
    gap1 = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if gap1["gap"]:
        failures.append("gap fired while interview is a running stage with no evidence")

    interview_run_root = work / ".agents" / "kein" / "runs" / "interview"
    interview_dir = interview_run_root / "260101-000000-flow"
    interview_dir.mkdir(parents=True)
    ledger = interview_dir / "ledger.md"
    requirements_path = work / ".agents" / "kein" / "requirements" / "flow.md"
    requirements_path.parent.mkdir(parents=True)
    write_active_ledger(ledger, "260101-000000-flow", work, work, requirements_path)
    status1 = json.loads(fsd(work, "status", str(fsd_state)).stdout)
    if status1["stages"]["interview"]["association"] != "resolved" or status1["stages"]["interview"]["run"] != str(ledger):
        failures.append(f"interview association did not resolve to the new ledger: {status1['stages']['interview']}")

    write_requirements(requirements_path, "Draft")
    gap2 = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if gap2["gap"]:
        failures.append("gap fired before the interview ledger was completed")

    write_requirements(requirements_path, "Approved")
    write_completed_ledger(ledger, requirements_path)
    gap3 = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if not gap3["gap"] or gap3["next"] != "ralplan" or gap3["completed"] != "interview":
        failures.append(f"gap did not report the interview -> ralplan row: {gap3}")

    must("entering ralplan", fsd(work, "enter", str(fsd_state), "ralplan"))
    gap4 = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if gap4["gap"]:
        failures.append("gap fired while ralplan is a running stage with no evidence")

    plan_path = work / ".agents" / "kein" / "plans" / "flow.md"
    plan_path.parent.mkdir(parents=True)
    write_plan(plan_path, "Draft", "first cut", "v0")
    ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
    ralplan_dest = ralplan_run_root / "260101-000000-flow" / "state.json"
    must("starting the ralplan run", ralplan(work, "start", str(ralplan_dest), "--plan", str(plan_path), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
    status2 = json.loads(fsd(work, "status", str(fsd_state)).stdout)
    if status2["stages"]["ralplan"]["run"] != str(ralplan_dest):
        failures.append(f"ralplan association did not resolve: {status2['stages']['ralplan']}")

    must("opening ralplan round 1", ralplan(work, "open", str(ralplan_dest)))
    write_plan(plan_path, "Approved", "good", "v0")
    must("approving ralplan round 1", ralplan(work, "approve", str(ralplan_dest)))
    must("completing ralplan", ralplan(work, "complete", str(ralplan_dest)))

    gap5 = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if not gap5["gap"] or gap5["next"] != "execute" or gap5["completed"] != "ralplan":
        failures.append(f"gap did not report the ralplan -> execute row: {gap5}")

    must("entering execute", fsd(work, "enter", str(fsd_state), "execute"))
    gap6 = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if gap6["gap"]:
        failures.append("gap fired while execute is a running stage with no evidence")

    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    execute_state = execute_start(work, execute_run_root, "flow", [execute_task("task-001", ["README.md"])])
    status3 = json.loads(fsd(work, "status", str(fsd_state)).stdout)
    if status3["stages"]["execute"]["run"] != str(execute_state):
        failures.append(f"execute association did not resolve: {status3['stages']['execute']}")

    must("dispatching task-001", execute(work, "dispatch", str(execute_state), "task-001"))
    q1 = must("recording the irreversible question", fsd(work, "question", str(fsd_state), "--stage", "execute",
              "--question", "which persisted format does task-001 write?", "--options", "json,csv",
              "--recommended", "json", "--why-irreversible", "list item 1: a persisted format read outside the repo",
              "--parks", "task-001"))
    question_id = q1.stdout.strip()
    if question_id != "Q1":
        failures.append(f"the first question was not minted Q1: {question_id!r}")
    must("parking task-001", execute(work, "park", str(execute_state), "task-001", "--question", "which format?", "--ref", question_id))
    must("checkpointing execute to blocked", execute_checkpoint(work, execute_state, lambda s: s.update(
        {"lifecycle": "blocked", "phase": "blocked", "next_action": f"blocked on {question_id}: task-001 parked"})))

    gap7 = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if not gap7["gap"] or gap7["next"] != "closeout" or gap7["completed"] != "execute":
        failures.append(f"gap did not report the blocked-with-parked-unanswered row: {gap7}")

    must("entering closeout", fsd(work, "closeout", str(fsd_state)))
    gap_closeout_entered = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if gap_closeout_entered["gap"]:
        failures.append(f"gap reported true right after closeout was entered, though it is now the running stage: {gap_closeout_entered}")
    draft_retro = fsd_run_dir / "retro-draft.md"
    draft_retro.write_text(f"# Retrospective\n\n{question_id}: which persisted format does task-001 write? Parked.\n")
    must("closing while a question is unanswered", fsd(work, "close", str(fsd_state), "--retro", str(draft_retro)))
    paused_state = read_json(fsd_state)
    if paused_state["lifecycle"] != "paused":
        failures.append(f"close did not pause the run while a question was unanswered: {paused_state['lifecycle']}")
    if paused_state["retrospective"] != str(draft_retro):
        failures.append("close moved the draft retrospective although the run only paused")
    if not draft_retro.is_file():
        failures.append("close removed the draft retrospective although the run only paused")

    reconciled = json.loads(execute(work, "reconcile", str(execute_state)).stdout)
    if reconciled.get("required_action") != f"blocked on {question_id}: task-001 parked":
        failures.append(f"execute reconcile on the resumed run reported drift instead of the blocked run's own next_action: {reconciled}")
    if not reconciled.get("worktree_matches"):
        failures.append("the draft retrospective under runs/fsd polluted execute's own worktree fingerprint")

    refuse("resuming while a question is unanswered", fsd(work, "resume", str(fsd_state)), reason="unanswered")
    must("answering the question", fsd(work, "answer", str(fsd_state), question_id, "--text", "json"))
    must("resuming once answered", fsd(work, "resume", str(fsd_state)))
    resumed_state = read_json(fsd_state)
    if resumed_state["lifecycle"] != "active":
        failures.append(f"resume did not move the run back to active: {resumed_state['lifecycle']}")
    if resumed_state["stages"]["execute"]["run"] != str(execute_state):
        failures.append("resume did not keep execute's association to the same run path")
    if resumed_state["stages"]["execute"]["status"] != "pending":
        failures.append("resume did not reset the still-blocked execute stage back to pending")
    if resumed_state["stages"]["closeout"]["status"] != "pending":
        failures.append("resume did not reset closeout back to pending")
    if len(resumed_state["agents_md"]) != 2:
        failures.append(f"resume did not open a second agents_md span: {len(resumed_state['agents_md'])}")

    must("re-entering execute after resume", fsd(work, "enter", str(fsd_state), "execute"))
    status4 = json.loads(fsd(work, "status", str(fsd_state)).stdout)
    if status4["stages"]["execute"]["run"] != str(execute_state) or status4["stages"]["execute"]["association"] != "kept":
        failures.append(f"the association after resume + enter execute did not stay the same run path, kept: {status4['stages']['execute']}")

    # Repeat the reconcile assertion after resume + enter execute: the fresh agents_md span and the fsd state.json writes resume itself made are also outside execute's tracked scope, so the still-blocked execute run must still reconcile clean, reporting its own next_action.
    reconciled_after_resume = json.loads(execute(work, "reconcile", str(execute_state)).stdout)
    if reconciled_after_resume.get("required_action") != f"blocked on {question_id}: task-001 parked":
        failures.append(f"execute reconcile after resume + enter execute reported drift instead of the blocked run's own next_action: {reconciled_after_resume}")
    if not reconciled_after_resume.get("worktree_matches"):
        failures.append("resume's own writes (a fresh agents_md span, fsd's state.json) polluted execute's worktree fingerprint")

    gap8 = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if gap8["gap"]:
        failures.append(f"gap stayed true after the question was answered, though execute is still blocked: {gap8}")

    refuse("closing while execute is still blocked with nothing left unanswered", fsd(work, "close", str(fsd_state), "--retro", str(draft_retro)),
           reason="execute is blocked, not completed")

    must("checkpointing execute back to task phase", execute_checkpoint(work, execute_state, lambda s: s.update(
        {"lifecycle": "active", "phase": "task", "next_action": "resume task-001"})))
    must("unparking task-001", execute(work, "unpark", str(execute_state), "task-001"))
    drive_task_to_acceptance(work, execute_state, "task-001")
    must("entering final_audit", execute_to_final_audit(work, execute_state))
    must("completing the execute run", execute_complete(work, execute_state, ["task-001"]))

    gap9 = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if not gap9["gap"] or gap9["next"] != "closeout" or gap9["completed"] != "execute":
        failures.append(f"gap did not report the execute-completed -> closeout row: {gap9}")

    must("re-entering closeout after execute completed", fsd(work, "closeout", str(fsd_state)))
    gap_closeout_entered_again = json.loads(fsd(work, "gap", str(fsd_state)).stdout)
    if gap_closeout_entered_again["gap"]:
        failures.append(f"gap reported true right after closeout was re-entered following execute's completion: {gap_closeout_entered_again}")
    must("recording an assumption", fsd(work, "assume", str(fsd_state), "--stage", "execute", "--decision", "log format",
         "--chosen", "json lines", "--alternatives", "csv,xml", "--reversal-cost", "rewrite one module", "--where", "src/thing.py"))
    must("recording a lesson", fsd(work, "lesson", str(fsd_state), "--line", "run check-fsd-state before every fsd change",
         "--why", "nothing else exercises this file"))

    # Halt is refused here: AGENTS.md is unchanged, guard is clean, execute is completed, and every question is answered, so close would succeed given any valid retrospective.
    refuse("halting a run close would complete", fsd(work, "halt", str(fsd_state), "--reason", "premature"), reason="close would succeed")

    no_id_retro = fsd_run_dir / "retro-no-id.md"
    no_id_retro.write_text("# Retrospective\n\nProse that cites no recorded decision by its identifier.\n")
    refuse("closing with a retrospective that cites no id", fsd(work, "close", str(fsd_state), "--retro", str(no_id_retro)),
           reason="does not cite every assumption, question, and lesson id")

    # The retrospective is the durable copy of every id this run minted, not just one of them: with three ids on record (A1, Q1, L1), a retro citing only one of them is refused the same way, and the refusal names the ones it left out.
    partial_id_retro = fsd_run_dir / "retro-partial-id.md"
    partial_id_retro.write_text("# Retrospective\n\nOnly A1 is mentioned here.\n")
    partial_result = refuse("closing with a retrospective that cites only one of three recorded ids", fsd(work, "close", str(fsd_state), "--retro", str(partial_id_retro)),
                            reason="does not cite every assumption, question, and lesson id")
    if "Q1" not in partial_result.stderr or "L1" not in partial_result.stderr:
        failures.append(f"the partial-id refusal did not name the ids it was missing: {partial_result.stderr.strip()}")

    final_retro = fsd_run_dir / "retro-final.md"
    final_retro.write_text("# Retrospective\n\nA1, Q1, L1 all covered.\n")
    must("closing the completed flow", fsd(work, "close", str(fsd_state), "--retro", str(final_retro)))
    completed_state = read_json(fsd_state)
    if completed_state["lifecycle"] != "completed":
        failures.append(f"close did not complete the fully-answered, fully-accepted run: {completed_state['lifecycle']}")
    if not completed_state["retrospective"] or "retros" not in completed_state["retrospective"]:
        failures.append(f"close did not relocate the retrospective to the durable retros/ path: {completed_state['retrospective']}")
    if not Path(completed_state["retrospective"]).is_file():
        failures.append("the durable retrospective file does not exist")
    if final_retro.exists():
        failures.append("close left the retrospective at its draft path as well as the durable one")

    report_text = fsd(work, "report", str(fsd_state)).stdout
    for needed in ("A1", "Q1", "L1"):
        if needed not in report_text:
            failures.append(f"report did not print {needed}")

# ---------------------------------------------------------------------------
# Scenario 3: AGENTS.md drift across a pause. Edited while paused, then resume: close succeeds and both spans survive. Edited after resume: close refuses.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    tasks = [execute_task("task-001", ["README.md"])]
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

    # entry=execute directly, via an approved plan, keeps the fixture short.
    approved_plan = work / f"plan-agentsmd.md"
    write_plan(approved_plan, "Approved")
    result = must("starting agentsmd-a", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "agentsmd-a", "--input", str(approved_plan), "--worktree", str(work)))
    state_a = require_path(result)
    must("entering execute for agentsmd-a", fsd(work, "enter", str(state_a), "execute"))
    execute_state_a = execute_start(work, execute_run_root, "agentsmd-a", tasks)
    drive_task_to_acceptance(work, execute_state_a, "task-001")
    must("entering final_audit for agentsmd-a", execute_to_final_audit(work, execute_state_a))
    must("completing agentsmd-a", execute_complete(work, execute_state_a, ["task-001"]))
    must("recording a whole-run question for agentsmd-a", fsd(work, "question", str(state_a), "--stage", "closeout",
         "--question", "does this lesson belong in AGENTS.md?", "--options", "yes,no", "--recommended", "yes",
         "--why-irreversible", "an AGENTS.md edit is never taken by the flow itself", "--parks", "whole run"))
    must("entering closeout for agentsmd-a", fsd(work, "closeout", str(state_a)))
    retro_a = state_a.parent / "retro.md"
    retro_a.write_text("Q1 pending.\n")
    must("pausing agentsmd-a on the whole-run question", fsd(work, "close", str(state_a), "--retro", str(retro_a)))
    if read_json(state_a)["lifecycle"] != "paused":
        failures.append("agentsmd-a did not pause on its whole-run question")

    (work / "AGENTS.md").write_text("# AGENTS\n\nedited while paused\n")
    must("answering agentsmd-a's question", fsd(work, "answer", str(state_a), "Q1", "--text", "yes"))
    must("resuming agentsmd-a after an AGENTS.md edit taken while paused", fsd(work, "resume", str(state_a)))
    resumed_a = read_json(state_a)
    if len(resumed_a["agents_md"]) != 2:
        failures.append("resume did not open a fresh span over the AGENTS.md edit taken while paused")
    # Settlement 3's execute-completed branch: execute's associated run is a completed receipt, so resume leaves its stage exactly as it was (still `entered`, its association untouched) rather than resetting it to `pending` -- there is nothing left there to re-enter -- and only `closeout` resets, so the next gap reads the execute-completed -> closeout row again rather than sending the flow back into execute.
    if resumed_a["stages"]["execute"]["status"] != "entered":
        failures.append(f"resume reset execute's stage even though its associated run is a completed receipt: {resumed_a['stages']['execute']}")
    status_after_resume_a = json.loads(fsd(work, "status", str(state_a)).stdout)
    if status_after_resume_a["stages"]["execute"]["run"] != str(execute_state_a):
        failures.append(f"the association after resume did not still resolve to the completed execute run: {status_after_resume_a['stages']['execute']}")
    if resumed_a["stages"]["closeout"]["status"] != "pending":
        failures.append("resume did not reset closeout back to pending")
    gap_after_resume_a = json.loads(fsd(work, "gap", str(state_a)).stdout)
    if not gap_after_resume_a["gap"] or gap_after_resume_a["next"] != "closeout" or gap_after_resume_a["completed"] != "execute":
        failures.append(f"gap after resume did not read the execute-completed -> closeout row again: {gap_after_resume_a}")

    retro_a2 = state_a.parent / "retro2.md"
    retro_a2.write_text("Q1 answered.\n")
    must("closing agentsmd-a after resume", fsd(work, "close", str(state_a), "--retro", str(retro_a2)))
    closed_a = read_json(state_a)
    if closed_a["lifecycle"] != "completed":
        failures.append(f"agentsmd-a did not complete once resumed over the paused-time edit: {closed_a['lifecycle']}")
    if len(closed_a["agents_md"]) != 2:
        failures.append("the completed state did not keep both agents_md spans")

    # agentsmd-b: the same shape, but AGENTS.md is edited AFTER resume -- close must refuse.
    result = must("starting agentsmd-b", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "agentsmd-b", "--input", str(approved_plan), "--worktree", str(work)))
    state_b = require_path(result)
    must("entering execute for agentsmd-b", fsd(work, "enter", str(state_b), "execute"))
    execute_state_b = execute_start(work, execute_run_root, "agentsmd-b", tasks)
    drive_task_to_acceptance(work, execute_state_b, "task-001")
    must("entering final_audit for agentsmd-b", execute_to_final_audit(work, execute_state_b))
    must("completing agentsmd-b", execute_complete(work, execute_state_b, ["task-001"]))
    must("recording a whole-run question for agentsmd-b", fsd(work, "question", str(state_b), "--stage", "closeout",
         "--question", "does this lesson belong in AGENTS.md?", "--options", "yes,no", "--recommended", "yes",
         "--why-irreversible", "an AGENTS.md edit is never taken by the flow itself", "--parks", "whole run"))
    must("entering closeout for agentsmd-b", fsd(work, "closeout", str(state_b)))
    retro_b = state_b.parent / "retro.md"
    retro_b.write_text("Q1 pending.\n")
    must("pausing agentsmd-b", fsd(work, "close", str(state_b), "--retro", str(retro_b)))
    must("answering agentsmd-b's question", fsd(work, "answer", str(state_b), "Q1", "--text", "yes"))
    must("resuming agentsmd-b", fsd(work, "resume", str(state_b)))
    (work / "AGENTS.md").write_text("# AGENTS\n\nedited after resume\n")
    retro_b2 = state_b.parent / "retro2.md"
    retro_b2.write_text("Q1 answered.\n")
    refuse("closing agentsmd-b after an AGENTS.md edit taken after resume", fsd(work, "close", str(state_b), "--retro", str(retro_b2)),
           reason="AGENTS.md changed")

# ---------------------------------------------------------------------------
# Scenario 4: guard -- a root-normalizing scope and a literal AGENTS.md scope both fail it, a docs/ scope passes; guard's failure names the lead's action; close refuses and halt then sets halted; report opens with the Halted section naming the task.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    (work / "docs").mkdir()
    (work / "docs" / "x.md").write_text("x\n")
    git(work, "add", "-A")
    git(work, "commit", "-qm", "docs")

    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    plan_path = work / "plan-guard.md"
    write_plan(plan_path, "Approved")
    result = must("starting the guard case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "guard", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering execute for the guard case", fsd(work, "enter", str(state_path), "execute"))

    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    tasks = [
        execute_task("task-a", ["AGENTS.md"]),
        execute_task("task-b", ["."]),
        execute_task("task-c", ["docs/"]),
        execute_task("task-d", ["agents.md"]),
    ]
    execute_state = execute_start(work, execute_run_root, "guard", tasks)
    result = fsd(work, "guard", str(state_path))
    guard_result = json.loads(result.stdout)
    if result.returncode == 0:
        failures.append("guard exited 0 although task-a, task-b, and task-d scope AGENTS.md")
    guarded_tasks = {v["task"] for v in guard_result["violations"]}
    if guarded_tasks != {"task-a", "task-b", "task-d"}:
        failures.append(f"guard did not flag exactly task-a (literal AGENTS.md scope), task-b (root scope), and task-d (case-variant agents.md scope): {guarded_tasks}")
    if "action" not in guard_result or "park" not in guard_result["action"] or "abort" not in guard_result["action"]:
        failures.append(f"guard's failure output did not state the lead's action: {guard_result}")

    refuse("closing while guard fails", fsd(work, "close", str(state_path), "--retro", str(work / "no-such-retro.md")), reason="guard failed")
    must("halting once guard fails", fsd(work, "halt", str(state_path), "--reason", "guard failed: task-a and task-b scope AGENTS.md"))
    halted_state = read_json(state_path)
    if halted_state["lifecycle"] != "halted":
        failures.append("halt did not set the halted lifecycle")
    gap_halted = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_halted["gap"]:
        failures.append(f"gap reported true on a halted run: {gap_halted}")
    report_text = fsd(work, "report", str(state_path)).stdout
    if not report_text.startswith("## Halted") or "task-a" not in report_text:
        failures.append(f"report on a halted run did not open with a Halted section naming the task: {report_text[:200]!r}")
    refuse("halting an already-halted run", fsd(work, "halt", str(state_path), "--reason", "again"))

# ---------------------------------------------------------------------------
# Scenario 5: a blocked run with a parked task whose decision_ref is null gives no gap (no positive evidence); ambiguous stage association gives no gap either, and `status` reports it as ambiguous; `attach` pins an association past that ambiguity.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

    # An approved-plan input classifies straight to execute, with interview and ralplan already `skipped` from `start` -- this case is about the blocked-row evidence, not about re-proving the classification path already covered in scenario 1.
    approved_plan = work / "plan-nullref.md"
    write_plan(approved_plan, "Approved")
    result = must("starting the null-ref case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "nullref", "--input", str(approved_plan), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering execute for the null-ref case", fsd(work, "enter", str(state_path), "execute"))

    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    execute_state = execute_start(work, execute_run_root, "nullref", [execute_task("task-001", ["README.md"])])
    must("dispatching task-001 for the null-ref case", execute(work, "dispatch", str(execute_state), "task-001"))
    must("parking task-001 with no ref", execute(work, "park", str(execute_state), "task-001", "--question", "an unrecorded decision"))
    must("checkpointing to blocked for the null-ref case", execute_checkpoint(work, execute_state, lambda s: s.update(
        {"lifecycle": "blocked", "phase": "blocked", "next_action": "blocked, no ref recorded"})))
    gap_null = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_null["gap"]:
        failures.append(f"gap fired for a parked task whose decision_ref names no fsd question: {gap_null}")

# Ambiguous association, and `attach` past it.
with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    result = must("starting the ambiguous case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "ambiguous", "--input", "an idea", "--worktree", str(work)))
    state_path = require_path(result)
    must("entering interview for the ambiguous case", fsd(work, "enter", str(state_path), "interview"))
    interview_run_root = work / ".agents" / "kein" / "runs" / "interview"
    for name in ("260101-000000-one", "260101-000001-two"):
        run_dir = interview_run_root / name
        run_dir.mkdir(parents=True)
        write_active_ledger(run_dir / "ledger.md", name, work, work, work / "req.md")
    status_amb = json.loads(fsd(work, "status", str(state_path)).stdout)
    if status_amb["stages"]["interview"]["association"] != "ambiguous":
        failures.append(f"two new run directories did not read as an ambiguous association: {status_amb['stages']['interview']}")
    write_requirements(work / "req.md", "Approved")
    write_completed_ledger(interview_run_root / "260101-000000-one" / "ledger.md", work / "req.md")
    gap_amb = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_amb["gap"]:
        failures.append(f"gap fired over an ambiguous association: {gap_amb}")

    must("attaching past the ambiguity", fsd(work, "attach", str(state_path), "interview", str(interview_run_root / "260101-000000-one" / "ledger.md")))
    status_att = json.loads(fsd(work, "status", str(state_path)).stdout)
    if status_att["stages"]["interview"]["association"] != "kept" or status_att["stages"]["interview"]["run"] != str(interview_run_root / "260101-000000-one" / "ledger.md"):
        failures.append(f"attach did not pin the interview association: {status_att['stages']['interview']}")
    gap_att = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if not gap_att["gap"] or gap_att["next"] != "ralplan":
        failures.append(f"gap did not read the attached, completed interview run: {gap_att}")

# ---------------------------------------------------------------------------
# Scenario 6: at `enter`, a stage run that already exists, nonterminal, for the worktree is resumed rather than snapshotted -- the settlement-2 case, proven for execute (whose worktree claim makes it unique) since that is what the state shape names explicitly. Adoption only happens because the pre-existing run's own `input.reference` matches the plan this fsd run executes; scenario 6b below proves the opposite when it does not.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    approved_plan = work / "plan-resumed.md"
    write_plan(approved_plan, "Approved")
    pre_existing = execute_start(work, execute_run_root, "preexisting", [execute_task("task-001", ["README.md"])], plan_path=approved_plan)

    result = must("starting the resumed-run case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "resumed", "--input", str(approved_plan), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering execute over a pre-existing run whose input matches this flow's own plan", fsd(work, "enter", str(state_path), "execute"))
    status_res = json.loads(fsd(work, "status", str(state_path)).stdout)
    if status_res["stages"]["execute"]["run"] != str(pre_existing) or status_res["stages"]["execute"]["association"] != "kept":
        failures.append(f"enter did not associate the pre-existing nonterminal execute run directly: {status_res['stages']['execute']}")
    if read_json(state_path)["stages"]["execute"]["snapshot"]:
        failures.append("enter snapshotted the run root even though a unique nonterminal run was already there to resume")

# ---------------------------------------------------------------------------
# Scenario 6b: the reverse of scenario 6 -- an unrelated nonterminal execute run occupies the worktree (an operator's own `/kein:execute`, or a stray run left over from something else entirely), its `input.reference` names a different plan than the one this fsd run executes, and `enter execute` must refuse rather than silently adopt it, naming the occupant.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

    other_plan = work / "plan-unrelated.md"
    write_plan(other_plan, "Approved", "someone else's work")
    other_run = execute_start(work, execute_run_root, "unrelated", [execute_task("task-x", ["README.md"])], plan_path=other_plan)

    fsd_plan = work / "plan-occupied.md"
    write_plan(fsd_plan, "Approved", "this flow's own plan")
    result = must("starting the occupied-worktree case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "occupied", "--input", str(fsd_plan), "--worktree", str(work)))
    state_path = require_path(result)
    if read_json(state_path)["entry"] != "execute":
        failures.append("an approved plan input did not classify to execute for the occupied-worktree case")

    # Both references are known here and genuinely differ, so this is the "plans differ" case: the refusal names both references and says to finish or abort the occupying run -- it does not offer `attach`, since a confirmed mismatch (not merely a spelling the comparison failed to resolve) is not what `attach` is for.
    occupied_result = refuse("entering execute while an unrelated nonterminal execute run occupies the worktree",
                              fsd(work, "enter", str(state_path), "execute"), reason=str(other_run))
    if str(fsd_plan) not in occupied_result.stderr or str(other_plan) not in occupied_result.stderr:
        failures.append(f"the plans-differ refusal did not name both references: {occupied_result.stderr.strip()}")
    if "attach" in occupied_result.stderr:
        failures.append(f"the plans-differ refusal offered attach, which is not the fix for a confirmed mismatch: {occupied_result.stderr.strip()}")
    if "finish or abort" not in occupied_result.stderr:
        failures.append(f"the plans-differ refusal did not tell the lead to finish or abort the occupying run: {occupied_result.stderr.strip()}")
    stage_after_refusal = read_json(state_path)["stages"]["execute"]
    if stage_after_refusal["status"] != "pending" or stage_after_refusal["run"] is not None:
        failures.append(f"a refused enter still recorded an association: {stage_after_refusal}")

# ---------------------------------------------------------------------------
# Scenario 6c: the ralplan-led half of `_expected_execute_plan_reference` -- fsd reaches `execute` through a completed `ralplan` run rather than directly, and `enter execute` compares a pre-existing occupant's `input.reference` against ralplan's own completed receipt's `plan.path`. A matching occupant is adopted; a mismatched one is refused.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

    approved_requirements = work / "req-viaralplan.md"
    write_requirements(approved_requirements, "Approved")
    result = must("starting the ralplan-led occupant case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "viaralplan", "--input", str(approved_requirements), "--worktree", str(work)))
    state_path = require_path(result)
    if read_json(state_path)["entry"] != "ralplan":
        failures.append("approved requirements did not classify to ralplan for the ralplan-led occupant case")

    must("entering ralplan for the ralplan-led occupant case", fsd(work, "enter", str(state_path), "ralplan"))
    ralplan_plan_path = work / ".agents" / "kein" / "plans" / "viaralplan.md"
    ralplan_plan_path.parent.mkdir(parents=True, exist_ok=True)
    write_plan(ralplan_plan_path, "Draft", "first cut", "v0")
    ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
    ralplan_dest = ralplan_run_root / "260101-000000-viaralplan" / "state.json"
    must("starting the ralplan run", ralplan(work, "start", str(ralplan_dest), "--plan", str(ralplan_plan_path), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
    must("opening ralplan round 1", ralplan(work, "open", str(ralplan_dest)))
    write_plan(ralplan_plan_path, "Approved", "good", "v0")
    must("approving ralplan round 1", ralplan(work, "approve", str(ralplan_dest)))
    must("completing ralplan", ralplan(work, "complete", str(ralplan_dest)))
    if read_json(ralplan_dest).get("plan", {}).get("path") != str(ralplan_plan_path):
        failures.append("the completed ralplan receipt's plan.path was not the plan this fixture drove through it; this case proves nothing")

    # A matching occupant, started against the same plan path ralplan's own receipt carries, is adopted directly.
    matching_run = execute_start(work, execute_run_root, "viaralplan-match", [execute_task("task-x", ["README.md"])], plan_path=ralplan_plan_path)
    must("entering execute over an occupant matching ralplan's own plan.path", fsd(work, "enter", str(state_path), "execute"))
    status_match = json.loads(fsd(work, "status", str(state_path)).stdout)
    if status_match["stages"]["execute"]["association"] != "kept" or status_match["stages"]["execute"]["run"] != str(matching_run):
        failures.append(f"enter did not adopt the occupant matching ralplan's plan.path: {status_match['stages']['execute']}")

# A mismatched occupant -- a different plan than the one ralplan's own completed receipt carries -- is refused.
with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

    approved_requirements = work / "req-viaralplan2.md"
    write_requirements(approved_requirements, "Approved")
    result = must("starting the ralplan-led mismatch case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "viaralplan2", "--input", str(approved_requirements), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering ralplan for the ralplan-led mismatch case", fsd(work, "enter", str(state_path), "ralplan"))
    ralplan_plan_path = work / ".agents" / "kein" / "plans" / "viaralplan2.md"
    ralplan_plan_path.parent.mkdir(parents=True, exist_ok=True)
    write_plan(ralplan_plan_path, "Draft", "first cut", "v0")
    ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
    ralplan_dest = ralplan_run_root / "260101-000000-viaralplan2" / "state.json"
    must("starting the ralplan run", ralplan(work, "start", str(ralplan_dest), "--plan", str(ralplan_plan_path), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
    must("opening ralplan round 1", ralplan(work, "open", str(ralplan_dest)))
    write_plan(ralplan_plan_path, "Approved", "good", "v0")
    must("approving ralplan round 1", ralplan(work, "approve", str(ralplan_dest)))
    must("completing ralplan", ralplan(work, "complete", str(ralplan_dest)))

    other_plan = work / "plan-other-viaralplan2.md"
    write_plan(other_plan, "Approved", "unrelated")
    mismatched_run = execute_start(work, execute_run_root, "viaralplan2-mismatch", [execute_task("task-y", ["README.md"])], plan_path=other_plan)
    mismatch_result = refuse("entering execute over an occupant that does not match ralplan's plan.path",
                              fsd(work, "enter", str(state_path), "execute"), reason=str(mismatched_run))
    if str(ralplan_plan_path) not in mismatch_result.stderr or str(other_plan) not in mismatch_result.stderr:
        failures.append(f"the ralplan-led plans-differ refusal did not name both references: {mismatch_result.stderr.strip()}")
    if "attach" in mismatch_result.stderr:
        failures.append(f"the ralplan-led plans-differ refusal offered attach, which is not the fix for a confirmed mismatch: {mismatch_result.stderr.strip()}")

# ---------------------------------------------------------------------------
# Scenario 6d: `enter` compares occupant and expected plan references as resolved paths, not the raw strings each side happened to store -- `execute start` keeps a relative `--input` exactly as given, and `classify_input` joins a relative one onto the worktree root without ever calling `.resolve()` -- so the same plan, spelled two different ways (relative here, absolute there), still reads as a match.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

    plan_path = work / "plan-pathspell.md"
    write_plan(plan_path, "Approved")

    # The occupant's own execute run is started with a *relative* --input, read and stored exactly as given -- an unresolved spelling of the very same file fsd's own --input below names absolutely.
    tasks_path = Path(tempfile.mkdtemp()) / "tasks.json"
    tasks_path.write_text(json.dumps([execute_task("task-z", ["README.md"])]))
    result = must("starting the pathspell occupant with a relative --input",
                  execute(work, "start", "--run-root", str(execute_run_root), "--slug", "pathspell",
                          "--kind", "plan", "--input", "plan-pathspell.md", "--worktree", str(work), "--tasks", str(tasks_path)))
    pathspell_run = require_path(result)
    if read_json(pathspell_run)["input"]["reference"] != "plan-pathspell.md":
        failures.append("the pathspell occupant fixture did not actually store an unresolved relative reference; this case proves nothing")

    result = must("starting fsd with the same plan's absolute spelling",
                  fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "pathspell", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering execute over an occupant naming the same plan, spelled relatively", fsd(work, "enter", str(state_path), "execute"))
    status_spell = json.loads(fsd(work, "status", str(state_path)).stdout)
    if status_spell["stages"]["execute"]["association"] != "kept" or status_spell["stages"]["execute"]["run"] != str(pathspell_run):
        failures.append(f"enter refused a matching occupant spelled differently (relative vs absolute): {status_spell['stages']['execute']}")

# ---------------------------------------------------------------------------
# Scenario 6e: `enter` refuses a pre-existing occupant with a distinct message when the plan this flow executes cannot be established at all yet -- ralplan has not completed -- naming ralplan and `attach`, not "plans differ", since there is nothing yet to compare the occupant against.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

    approved_requirements = work / "req-noexpected.md"
    write_requirements(approved_requirements, "Approved")
    result = must("starting the no-expected-reference case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "noexpected", "--input", str(approved_requirements), "--worktree", str(work)))
    state_path = require_path(result)
    if read_json(state_path)["entry"] != "ralplan":
        failures.append("approved requirements did not classify to ralplan for the no-expected-reference case")

    unrelated_plan = work / "plan-noexpected-occupant.md"
    write_plan(unrelated_plan, "Approved")
    occupant_run = execute_start(work, execute_run_root, "noexpected-occupant", [execute_task("task-q", ["README.md"])], plan_path=unrelated_plan)

    # `enter execute` is called directly, out of the flow's own order, before ralplan has ever even started -- the only way to observe `_expected_execute_plan_reference` return `None` for a genuinely pre-existing occupant.
    noexpected_result = refuse("entering execute directly, out of order, before ralplan has ever completed",
                                fsd(work, "enter", str(state_path), "execute"), reason=str(occupant_run))
    if "ralplan" not in noexpected_result.stderr:
        failures.append(f"the no-expected-reference refusal did not name ralplan: {noexpected_result.stderr.strip()}")
    if "attach" not in noexpected_result.stderr:
        failures.append(f"the no-expected-reference refusal did not offer attach for the case the occupant genuinely is this flow's own run: {noexpected_result.stderr.strip()}")

# ---------------------------------------------------------------------------
# Scenario 6f: `_same_plan_reference` resolves an unresolved worktree spelling, not just a relative-vs-absolute one -- on macOS a TemporaryDirectory sits under `/var/...`, itself a symlink to `/private/var/...` (scenario 21's own technique), and the occupant's own reference may use one spelling of the root while fsd's own --input uses the other. Both name the same file once resolved, and `enter` must still adopt.

with tempfile.TemporaryDirectory() as tmp:
    unresolved_work = Path(tmp) / "repo"
    unresolved_work.mkdir()
    if str(unresolved_work) == str(unresolved_work.resolve()):
        failures.append("this platform's TemporaryDirectory did not exercise the symlink case scenario 6f needs, so it proves nothing here")
    init_repo(unresolved_work)
    resolved_work = unresolved_work.resolve()

    fsd_run_root = unresolved_work / ".agents" / "kein" / "runs" / "fsd"
    execute_run_root = unresolved_work / ".agents" / "kein" / "runs" / "execute"
    plan_name = "plan-unresolved-spelling.md"
    write_plan(unresolved_work / plan_name, "Approved")

    # The occupant's own execute run is started with the unresolved spelling of the worktree root.
    occupant_run = execute_start(unresolved_work, execute_run_root, "unresolvedspelling",
                                  [execute_task("task-w", ["README.md"])],
                                  plan_path=unresolved_work / plan_name)
    if read_json(occupant_run)["input"]["reference"] != str(unresolved_work / plan_name):
        failures.append("the unresolved-spelling occupant fixture did not actually store the unresolved spelling; this case proves nothing")

    # fsd itself is started with the resolved spelling of the very same file.
    result = must("starting fsd with the resolved spelling of the same plan",
                  fsd(unresolved_work, "start", "--run-root", str(fsd_run_root), "--slug", "unresolvedspelling",
                      "--input", str(resolved_work / plan_name), "--worktree", str(unresolved_work)))
    state_path = require_path(result)
    if read_json(state_path)["input"]["reference"] != str(resolved_work / plan_name):
        failures.append("fsd's own input.reference was not actually stored in the resolved spelling; this case proves nothing")

    must("entering execute over an occupant naming the same plan through the worktree's unresolved spelling",
         fsd(unresolved_work, "enter", str(state_path), "execute"))
    status_unresolved = json.loads(fsd(unresolved_work, "status", str(state_path)).stdout)
    # `find_occupying_run`'s own claim file always records a *resolved* destination path (`_record_claim`), so the association `enter` keeps may be spelled differently from `occupant_run` (built from the unresolved run root) even once adoption succeeds; both name the same file, so the comparison resolves both sides.
    kept_run = status_unresolved["stages"]["execute"].get("run")
    if status_unresolved["stages"]["execute"]["association"] != "kept" or kept_run is None or Path(kept_run).resolve() != occupant_run.resolve():
        failures.append(f"enter refused a matching occupant spelled through the worktree's unresolved root: {status_unresolved['stages']['execute']}")

# ---------------------------------------------------------------------------
# Scenario 7: the ralplan non-convergence exit needs no ralplan change -- five official rounds each blocked then revised, round 6 approved with two deferrals (an architecture ground and a safety ground), the receipt completes carrying both, and approve immediately after block in the same round is refused.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    plan_path = work / "plan.md"
    state_path = work / "state.json"
    F = '"lane":"critic@claude","claim":"c","evidence":"e","impact":"i","required_correction":"r"'

    def header(status, reason, body):
        write_plan(plan_path, status, reason, body)

    header("Draft", "drafted", "v0")
    must("starting the non-convergence ralplan run", ralplan(work, "start", str(state_path), "--plan", str(plan_path), "--summary", "s", "--lanes", "architect@claude,critic@claude"))
    body_version = 0
    for round_number in range(1, 6):
        header("In Review", f"reviewing round {round_number}", f"v{body_version}")
        must(f"opening round {round_number}", ralplan(work, "open", str(state_path)))
        findings_path = tmp / f"f{round_number}.json"
        findings_path.write_text(f"[{{{F},\"blocking\":\"safety\"}}]")
        must(f"blocking round {round_number}", ralplan(work, "block", str(state_path), "--findings", str(findings_path)))
        refuse(f"approving right after block in round {round_number}", ralplan(work, "approve", str(state_path)), reason="official reviewing round")
        body_version += 1
        header("In Review", "revised", f"v{body_version}")
        must(f"revising round {round_number}", ralplan(work, "revised", str(state_path)))

    header("In Review", "reviewing round 6", f"v{body_version}")
    must("opening round 6", ralplan(work, "open", str(state_path)))
    deferred_path = tmp / "f6.json"
    deferred_path.write_text(json.dumps([
        {"lane": "architect@claude", "claim": "c1", "evidence": "e1", "impact": "i1", "required_correction": "r1",
         "blocking": "architecture", "deferral": {"reason": "does not hold for an unattended run", "caught_by": "fsd assumption A1; execute final audit"}},
        {"lane": "critic@claude", "claim": "c2", "evidence": "e2", "impact": "i2", "required_correction": "r2",
         "blocking": "safety", "deferral": {"reason": "the ground names an irreversible decision", "caught_by": "fsd question Q1; tasks from story U-1 start parked"}},
    ]))
    header("Approved", "approved at round 6 with deferrals", f"v{body_version}")
    must("approving round 6 with deferrals", ralplan(work, "approve", str(state_path), "--findings", str(deferred_path)))
    must("completing the non-convergence run", ralplan(work, "complete", str(state_path)))
    receipt = read_json(state_path)
    if receipt.get("lifecycle") != "completed":
        failures.append("the non-convergence receipt did not complete")
    grounds = {f.get("blocking") for f in receipt.get("findings", [])}
    if grounds != {"architecture", "safety"}:
        failures.append(f"the completed receipt did not carry both deferred grounds: {grounds}")
    if any(not f.get("deferral") for f in receipt.get("findings", [])):
        failures.append("the completed receipt lost a deferral")

# ---------------------------------------------------------------------------
# Scenario 8: guard's action actually clears the failure.
# Parking the offending task does not, since its scope is unchanged while parked and guard reads every task regardless of status; the fix is to abort the execute run (its own escape hatch, `checkpoint`, since execute has no `abort` builder), start a new one without the task, and `attach` fsd's association to it before rerunning guard.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    plan_path = work / "plan-restart.md"
    write_plan(plan_path, "Approved")
    result = must("starting the restart case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "restart", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)

    # The execute run starts against the same plan fsd is executing (`plan_path=plan_path`) before `enter` runs, so `enter` adopts it directly and `stages.execute.run` becomes a *kept* association -- the shape items 2 and 3 below need stale, rather than one `_stage_association_detail` would re-resolve fresh by snapshot diff every time.
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    bad_tasks = [execute_task("task-good", ["README.md"]), execute_task("task-bad", ["AGENTS.md"])]
    execute_state_1 = execute_start(work, execute_run_root, "restart-1", bad_tasks, plan_path=plan_path)
    must("entering execute for the restart case, adopting the matching pre-existing run", fsd(work, "enter", str(state_path), "execute"))
    status_kept = json.loads(fsd(work, "status", str(state_path)).stdout)
    if status_kept["stages"]["execute"]["association"] != "kept" or status_kept["stages"]["execute"]["run"] != str(execute_state_1):
        failures.append(f"enter did not adopt the pre-existing execute run whose input matches this flow's plan: {status_kept['stages']['execute']}")

    guard_1 = json.loads(fsd(work, "guard", str(state_path)).stdout)
    if guard_1["clean"]:
        failures.append("guard reported clean over a task scoped to AGENTS.md")

    must("dispatching task-bad before parking it", execute(work, "dispatch", str(execute_state_1), "task-bad"))
    must("parking task-bad", execute(work, "park", str(execute_state_1), "task-bad", "--question", "does this belong in the ledger at all?"))
    guard_2 = json.loads(fsd(work, "guard", str(state_path)).stdout)
    if guard_2["clean"]:
        failures.append("guard reported clean over a parked task whose scope still names AGENTS.md; parking does not clear a scope violation")

    aborted_source = read_json(execute_state_1)
    aborted_candidate = {
        "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": aborted_source["run_id"],
        "lifecycle": "aborted", "aborted_at": STAMP,
        "worktree_root": aborted_source["worktree"]["root"], "reason": "task-bad scopes AGENTS.md; restarting without it",
    }
    aborted_path = tmp / "aborted.json"
    write(aborted_path, aborted_candidate)
    must("aborting the bad execute run through checkpoint (execute has no abort builder)", execute(work, "checkpoint", str(execute_state_1), str(aborted_path)))

    # The replacement still carries a task scoped to AGENTS.md (task-still-bad) -- the lead's first restart attempt did not actually fix the problem -- deliberately, so the window below can tell "guard read the live run" apart from "guard read nothing": `checkpoint ... aborted` compacted run-1 to a receipt with no `tasks` field at all, so a guard that blindly trusts the stale kept link reads zero tasks and is vacuously clean, the same wrong answer a genuinely fixed replacement would also give it. Only reading run-2's own tasks tells the two apart. `plan_path=plan_path` is what makes run-2 read as *this flow's own* replacement rather than an unrelated occupant guard, gap, and close must now leave alone.
    execute_state_2 = execute_start(work, execute_run_root, "restart-2",
                                     [execute_task("task-good", ["README.md"]), execute_task("task-still-bad", ["AGENTS.md"])],
                                     plan_path=plan_path)

    # Between starting the replacement run and the `attach` below repointing fsd's own association, `stages.execute.run` still names the just-aborted run-1 while run-2 already holds the worktree's claim -- exactly the window `_guard_action` opens. `gap` must read no gap off the stale aborted link (it would otherwise fire the execute -> closeout row), and `guard` must read run-2's own tasks rather than vacuously reading run-1's now-compact, tasks-less aborted receipt.
    gap_between_abort_and_attach = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_between_abort_and_attach["gap"]:
        failures.append(f"gap reported a gap between abort and attach, off the stale aborted link: {gap_between_abort_and_attach}")
    guard_stale_link = json.loads(fsd(work, "guard", str(state_path)).stdout)
    if guard_stale_link["clean"]:
        failures.append(f"guard read the stale aborted link (a compact receipt with no tasks at all) as vacuously clean instead of the live replacement run's own task-still-bad, which still scopes AGENTS.md: {guard_stale_link}")
    else:
        guarded_live = {v["task"] for v in guard_stale_link["violations"]}
        if guarded_live != {"task-still-bad"}:
            failures.append(f"guard did not read exactly the live replacement run's own violation while the kept link was still stale: {guarded_live}")

    aborted_source_2 = read_json(execute_state_2)
    aborted_candidate_2 = {
        "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": aborted_source_2["run_id"],
        "lifecycle": "aborted", "aborted_at": STAMP,
        "worktree_root": aborted_source_2["worktree"]["root"], "reason": "task-still-bad also scopes AGENTS.md; restarting again without it",
    }
    aborted_path_2 = tmp / "aborted-2.json"
    write(aborted_path_2, aborted_candidate_2)
    must("aborting the second bad execute run", execute(work, "checkpoint", str(execute_state_2), str(aborted_path_2)))

    execute_state_3 = execute_start(work, execute_run_root, "restart-3", [execute_task("task-good", ["README.md"])], plan_path=plan_path)
    must("attaching the restarted execute run", fsd(work, "attach", str(state_path), "execute", str(execute_state_3)))
    status_restart = json.loads(fsd(work, "status", str(state_path)).stdout)
    if status_restart["stages"]["execute"]["run"] != str(execute_state_3):
        failures.append(f"attach did not repoint execute's association at the restarted run: {status_restart['stages']['execute']}")

    guard_3 = json.loads(fsd(work, "guard", str(state_path)).stdout)
    if not guard_3["clean"]:
        failures.append(f"guard did not read clean once attached to the restarted run without the bad task: {guard_3}")

# ---------------------------------------------------------------------------
# Scenario 8b: `close` must not read a stale *completed* kept link as execute's side being done while a different, matching, nonterminal execute run still occupies the worktree. This is distinct from scenario 8's aborted-link window: an aborted receipt already answers `_execute_side_done` False on its own (its own `lifecycle` is not `completed`), so that window alone does not prove the occupying-run check inside `_execute_side_done` does anything -- only a *completed* stale link does, since `payload.get("lifecycle") == "completed"` is the one reading that check actually guards.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    plan_path = work / "plan-completed-then-replaced.md"
    write_plan(plan_path, "Approved")
    result = must("starting the completed-then-replaced case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "replaced", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)

    execute_state_a = execute_start(work, execute_run_root, "replaced-a", [execute_task("task-a", ["src/a.txt"])])
    must("attaching execute run A", fsd(work, "attach", str(state_path), "execute", str(execute_state_a)))
    drive_task_to_acceptance(work, execute_state_a, "task-a")
    must("entering final_audit for run A", execute_to_final_audit(work, execute_state_a))
    must("completing run A", execute_complete(work, execute_state_a, ["task-a"]))
    if read_json(execute_state_a)["lifecycle"] != "completed":
        failures.append("execute run A did not reach a completed receipt")

    # A second, matching execute run (same plan, via plan_path=plan_path) starts once A's own claim is released by completion. fsd's own kept association still names A, now a completed receipt -- exactly the shape that would (without the occupying-run check) read as execute's side being done.
    execute_state_b = execute_start(work, execute_run_root, "replaced-b", [execute_task("task-b", ["src/b.txt"])], plan_path=plan_path)

    gap_completed_replaced = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_completed_replaced["gap"]:
        failures.append(f"gap reported a gap off a completed kept link while a matching replacement run is still live: {gap_completed_replaced}")

    guard_completed_replaced = json.loads(fsd(work, "guard", str(state_path)).stdout)
    if not guard_completed_replaced["clean"]:
        failures.append(f"guard was not clean over run B's own untouched scope: {guard_completed_replaced}")

    retro_path = tmp / "retro-replaced.md"
    retro_path.write_text("# Retrospective\n\nNothing recorded; this run mints no assumptions, questions, or lessons.\n")
    close_replaced_result = refuse("closing while a matching replacement execute run is still live, off a completed kept link",
                                    fsd(work, "close", str(state_path), "--retro", str(retro_path)), reason="not completed")
    if str(execute_state_b) not in close_replaced_result.stderr or "attach" not in close_replaced_result.stderr:
        failures.append(f"close's refusal did not name the live replacement run and attach: {close_replaced_result.stderr.strip()}")
    if read_json(state_path)["lifecycle"] != "active":
        failures.append("close moved the run out of active despite a live, matching replacement execute run still occupying the worktree")

# ---------------------------------------------------------------------------
# Scenario 8c: the reverse of 8b -- an unrelated nonterminal execute run (a different plan entirely) occupies the worktree alongside a genuinely completed, matching kept link. Guard, gap, and close must all read the kept link on its own terms rather than the unrelated occupant's: gap still reports the execute-completed -> closeout row, guard is unaffected by the unrelated run's own AGENTS.md-scoped task, and close still completes.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    plan_path = work / "plan-completed-then-unrelated.md"
    write_plan(plan_path, "Approved")
    result = must("starting the completed-then-unrelated case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "unrelated2", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)

    execute_state_a = execute_start(work, execute_run_root, "unrelated2-a", [execute_task("task-a", ["src/a.txt"])])
    must("attaching execute run A", fsd(work, "attach", str(state_path), "execute", str(execute_state_a)))
    drive_task_to_acceptance(work, execute_state_a, "task-a")
    must("entering final_audit for run A", execute_to_final_audit(work, execute_state_a))
    must("completing run A", execute_complete(work, execute_state_a, ["task-a"]))
    if read_json(execute_state_a)["lifecycle"] != "completed":
        failures.append("execute run A did not reach a completed receipt")

    # A wholly unrelated execute run -- a different plan, an operator's own `/kein:execute` -- starts once A's claim is released. Its own task is deliberately scoped to AGENTS.md, so a `guard` that mistakenly read it as this flow's replacement would be caught failing here.
    other_plan = work / "plan-unrelated2-other.md"
    write_plan(other_plan, "Approved", "an unrelated operator run")
    unrelated_run = execute_start(work, execute_run_root, "unrelated2-b", [execute_task("task-b", ["AGENTS.md"])], plan_path=other_plan)

    gap_unrelated = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if not gap_unrelated["gap"] or gap_unrelated["next"] != "closeout" or gap_unrelated["completed"] != "execute":
        failures.append(f"gap did not report the execute-completed row while an unrelated occupant sits in the worktree: {gap_unrelated}")

    guard_unrelated = json.loads(fsd(work, "guard", str(state_path)).stdout)
    if not guard_unrelated["clean"]:
        failures.append(f"guard read the unrelated occupant's own AGENTS.md-scoped task as though it belonged to this flow: {guard_unrelated}")

    must("entering closeout for the completed-then-unrelated case", fsd(work, "closeout", str(state_path)))
    retro_path2 = tmp / "retro-unrelated2.md"
    retro_path2.write_text("# Retrospective\n\nNothing recorded.\n")
    must("closing despite an unrelated occupant elsewhere in the worktree", fsd(work, "close", str(state_path), "--retro", str(retro_path2)))
    if read_json(state_path)["lifecycle"] != "completed":
        failures.append("close did not complete over a genuinely completed execute stage, confused by an unrelated occupant")

# ---------------------------------------------------------------------------
# Scenario 8d: `guard`'s own recovery text (`_guard_action`) prints `--kind plan --input <the actual plan path>` rather than a `<plan|brief>` placeholder -- a `--kind brief` replacement stores a `null` input.reference, which the matching rule can never call a match, reopening exactly the gap/guard misreading the abort-then-restart window exists to close. This follows the recovery exactly as printed: the restart's `--input` is read straight out of the action text's own claim (the plan fsd itself was started with), not assumed.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    plan_path = work / "plan-literal-recovery.md"
    write_plan(plan_path, "Approved")
    result = must("starting the literal-recovery case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "literalrecovery", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)

    # The execute run starts against the same plan fsd is executing, before `enter` runs, so `enter` adopts it directly and `stages.execute.run` becomes a *kept* association -- otherwise `_stage_association_detail`'s snapshot-diff would read two new directories as ambiguous once the restart below mints a second one.
    bad_tasks = [execute_task("task-good", ["README.md"]), execute_task("task-bad", ["AGENTS.md"])]
    execute_state_1 = execute_start(work, execute_run_root, "literalrecovery-1", bad_tasks, plan_path=plan_path)
    must("entering execute for the literal-recovery case, adopting the matching pre-existing run", fsd(work, "enter", str(state_path), "execute"))
    guard_failed = json.loads(fsd(work, "guard", str(state_path)).stdout)
    if guard_failed["clean"]:
        failures.append("guard reported clean over a task scoped to AGENTS.md for the literal-recovery case")
    action_text = guard_failed.get("action", "")
    if "--kind plan" not in action_text or "brief" in action_text:
        failures.append(f"guard's action did not name --kind plan and drop brief entirely: {action_text!r}")
    if str(plan_path) not in action_text:
        failures.append(f"guard's action did not print the actual plan path this flow executes: {action_text!r}")

    # Parse the restart's own `--input` and `--worktree` straight out of the printed action text -- proving the command as printed is actually complete and runnable, not merely containing the right substrings -- rather than reusing this fixture's own `plan_path`/`work` variables to build the restart below.
    argv_match = re.search(r"--kind plan --input (\S+) --worktree (\S+) --tasks", action_text)
    if argv_match is None:
        failures.append(f"could not parse --input and --worktree out of guard's own action text: {action_text!r}")
        parsed_input, parsed_worktree = str(plan_path), str(work)
    else:
        parsed_input, parsed_worktree = argv_match.group(1), argv_match.group(2)

    aborted_source = read_json(execute_state_1)
    aborted_candidate = {
        "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": aborted_source["run_id"],
        "lifecycle": "aborted", "aborted_at": STAMP,
        "worktree_root": aborted_source["worktree"]["root"], "reason": "task-bad scopes AGENTS.md; restarting without it",
    }
    aborted_path = tmp / "aborted-literal.json"
    write(aborted_path, aborted_candidate)
    must("aborting through checkpoint, as the action names", execute(work, "checkpoint", str(execute_state_1), str(aborted_path)))

    # The restart is built from the parsed `--input`/`--worktree`, not from this fixture's own `plan_path`/`work` -- exactly the argv guard's own action text names, typed as printed.
    literal_tasks_path = Path(tempfile.mkdtemp()) / "tasks.json"
    literal_tasks_path.write_text(json.dumps([execute_task("task-good", ["README.md"])]))
    literal_result = must("restarting exactly as guard's own action prints it",
                          execute(work, "start", "--run-root", str(execute_run_root), "--slug", "literalrecovery-2",
                                  "--kind", "plan", "--input", parsed_input, "--worktree", parsed_worktree,
                                  "--tasks", str(literal_tasks_path)))
    execute_state_2 = require_path(literal_result)

    gap_literal = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_literal["gap"]:
        failures.append(f"gap fired between abort and attach after following the recovery exactly as printed: {gap_literal}")
    guard_literal = json.loads(fsd(work, "guard", str(state_path)).stdout)
    if not guard_literal["clean"]:
        failures.append(f"guard did not read the replacement started with the recovery's own --kind plan --input: {guard_literal}")

    must("attaching the restarted execute run", fsd(work, "attach", str(state_path), "execute", str(execute_state_2)))

# ---------------------------------------------------------------------------
# Scenario 8e: `close`'s retrospective-location rule also reads the live, matching replacement rather than a stale *completed* kept link -- the same substitution its refusal text and `guard` make (`_close_execute_run`). With a question left unanswered (forcing the `paused` outcome) and a live, matching replacement genuinely still nonterminal, a `--retro` outside `.agents/kein/runs/` is still refused, even though the kept link's own lifecycle reads `completed`.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    plan_path = work / "plan-retro-location-replaced.md"
    write_plan(plan_path, "Approved")
    result = must("starting the retro-location-replaced case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "retroloc2", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)
    fsd_run_dir = state_path.parent

    q = must("recording a question that will stay unanswered",
             fsd(work, "question", str(state_path), "--stage", "execute", "--question", "does this need a follow-up plan?",
                 "--options", "yes,no", "--recommended", "no", "--why-irreversible", "list item 4: an externally visible action",
                 "--parks", "whole run"))
    question_id = q.stdout.strip()

    execute_state_a = execute_start(work, execute_run_root, "retroloc2-a", [execute_task("task-a", ["src/a.txt"])])
    must("attaching execute run A", fsd(work, "attach", str(state_path), "execute", str(execute_state_a)))
    drive_task_to_acceptance(work, execute_state_a, "task-a")
    must("entering final_audit for run A", execute_to_final_audit(work, execute_state_a))
    must("completing run A", execute_complete(work, execute_state_a, ["task-a"]))
    if read_json(execute_state_a)["lifecycle"] != "completed":
        failures.append("execute run A did not reach a completed receipt for the retro-location-replaced case")

    # A second, matching execute run starts once A's claim is released -- genuinely nonterminal, though the kept association still names A, now a completed receipt.
    execute_state_b = execute_start(work, execute_run_root, "retroloc2-b", [execute_task("task-b", ["src/b.txt"])], plan_path=plan_path)

    outside_retro = tmp / "retro-outside.md"
    outside_retro.write_text(f"# Retrospective\n\n{question_id}: parked as whole run.\n")
    refuse("pausing with a retrospective outside runs/ while a live, matching replacement is genuinely still nonterminal, off a completed kept link",
           fsd(work, "close", str(state_path), "--retro", str(outside_retro)), reason="must be a path under")

    inside_retro = fsd_run_dir / "retro-inside.md"
    inside_retro.write_text(f"# Retrospective\n\n{question_id}: parked as whole run.\n")
    must("pausing with a retrospective under runs/fsd, off a completed kept link with a live matching replacement", fsd(work, "close", str(state_path), "--retro", str(inside_retro)))
    if read_json(state_path)["lifecycle"] != "paused":
        failures.append("close did not pause despite an unanswered question, with a live matching replacement still nonterminal")

# ---------------------------------------------------------------------------
# Scenario 9: guard is clean while execute is entered but has no run there yet (the ordinary window before `execute start` runs), and not clean -- pointing at `attach` -- once its association is ambiguous.
# `_stage_association_detail` only needs two new directories with a `state.json` inside to read as ambiguous; their content is irrelevant to that check, so placeholders are enough here.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    plan_path = work / "plan-guardassoc.md"
    write_plan(plan_path, "Approved")
    result = must("starting the guard-association case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "guardassoc", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering execute with no run there yet", fsd(work, "enter", str(state_path), "execute"))
    guard_none = json.loads(fsd(work, "guard", str(state_path)).stdout)
    if not guard_none["clean"]:
        failures.append(f"guard was not clean while execute is entered with no run there yet: {guard_none}")

    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    for slug in ("one", "two"):
        run_dir = execute_run_root / f"260101-000000-{slug}"
        run_dir.mkdir(parents=True)
        write(run_dir / "state.json", {"placeholder": True})
    guard_ambiguous = json.loads(fsd(work, "guard", str(state_path)).stdout)
    if guard_ambiguous["clean"]:
        failures.append("guard was clean over an ambiguous execute association")
    if "reason" not in guard_ambiguous or "attach" not in guard_ambiguous["reason"]:
        failures.append(f"guard's ambiguous-association failure did not point at attach: {guard_ambiguous}")
    refuse("closing while execute's association is ambiguous", fsd(work, "close", str(state_path), "--retro", str(work / "no-such.md")),
           reason="ambiguous")

