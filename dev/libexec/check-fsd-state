        state_path = require_path(result)
        must("entering execute for the retro-location case", fsd(work, "enter", str(state_path), "execute"))
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "retroloc", [execute_task("task-001", ["README.md"])], plan_path=plan_path)
        must("attaching the retro-location case's execute run while still nonterminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        must("dispatching task-001 for the retro-location case", execute(work, "dispatch", str(execute_state), "task-001"))
        qid = must("recording the parking question for the retro-location case", fsd(work, "question", str(state_path),
            "--stage", "execute", "--question", "q", "--options", "a,b", "--recommended", "a",
            "--why-irreversible", "list item 1", "--parks", "task-001")).stdout.strip()
        must("parking task-001 for the retro-location case", execute(work, "park", str(execute_state), "task-001", "--question", "q", "--ref", qid))
        must("checkpointing to blocked for the retro-location case", execute_checkpoint(work, execute_state, lambda s: s.update(
            {"lifecycle": "blocked", "phase": "blocked", "next_action": f"blocked on {qid}"})))

        outside_retro = work / "retro-outside.md"
        outside_retro.write_text(f"{qid} pending.\n")
        refuse("pausing with a retrospective outside .agents/kein/runs/ while execute is still blocked",
               fsd(work, "close", str(state_path), "--retro", str(outside_retro)), reason="must be a path under")
        if read_json(state_path)["lifecycle"] != "active":
            failures.append("the refused close still moved the run out of active")

        inside_retro = state_path.parent / "retro-inside.md"
        inside_retro.write_text(f"{qid} pending.\n")
        must("pausing with a retrospective under runs/fsd", fsd(work, "close", str(state_path), "--retro", str(inside_retro)))

# ---------------------------------------------------------------------------
# Scenario 16: the precedence settlement's "execute never started" branch.
# `ralplan` aborts before `execute` is ever entered; a whole-run question is recorded; `close` pauses on it (not "execute is not started, not completed" -- unanswered is checked first); after answer + resume the association fsd keeps for `execute` is untouched (there was never one), only `closeout` resets, and `gap` reads the same interview/ralplan-aborted row again; `close` then reaches `completed` once nothing is unanswered, since `ralplan` aborting first means the flow was never going to reach `execute` at all.

def _section_scenario16_execute_never_started_precedence():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_requirements = work / "req-neverexec.md"
        write_requirements(approved_requirements, "Approved")
        result = must("starting the execute-never-started case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "neverexec", "--input", str(approved_requirements), "--worktree", str(work)))
        state_path = require_path(result)
        if read_json(state_path)["entry"] != "ralplan":
            failures.append("the execute-never-started fixture did not enter at ralplan")
        must("entering ralplan for the execute-never-started case", fsd(work, "enter", str(state_path), "ralplan"))

        plan_path = work / "plan-neverexec.md"
        write_plan(plan_path, "Draft", "drafted", "v0")
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
        ralplan_dest = ralplan_run_root / "260101-000000-neverexec" / "state.json"
        must("starting the ralplan run for the execute-never-started case",
             ralplan(work, "start", str(ralplan_dest), "--input", str(approved_requirements), "--plan", str(plan_path), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        # Pinned explicitly while still nonterminal: ralplan's own aborted receipt drops `input` (and everything else but the reason) entirely, so nothing would otherwise confirm this same run belongs once it aborts.
        must("attaching the ralplan run while still nonterminal", fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)))
        must("aborting the ralplan run", ralplan(work, "abort", str(ralplan_dest), "--reason", "a blocking ground the owner has to rule on"))

        gap_ralplan_aborted = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if not gap_ralplan_aborted["gap"] or gap_ralplan_aborted["next"] != "closeout" or gap_ralplan_aborted["completed"] != "ralplan":
            failures.append(f"gap did not report the ralplan-aborted -> closeout row: {gap_ralplan_aborted}")
        if read_json(state_path)["stages"]["execute"]["status"] != "pending":
            failures.append("execute's stage status moved even though it was never entered")

        must("entering closeout for the execute-never-started case", fsd(work, "closeout", str(state_path)))
        gap_neverexec_closeout_entered = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_neverexec_closeout_entered["gap"]:
            failures.append(f"gap reported true right after closeout was entered in the execute-never-started case: {gap_neverexec_closeout_entered}")
        qid = must("recording the whole-run question before execute ever started", fsd(work, "question", str(state_path),
            "--stage", "closeout", "--question", "does the owner want to retry with different constraints?",
            "--options", "retry,abandon", "--recommended", "retry",
            "--why-irreversible", "the owner's ruling is not something the flow can infer", "--parks", "whole run")).stdout.strip()

        draft_retro = state_path.parent / "retro-draft.md"
        draft_retro.write_text(f"{qid} pending; execute never started.\n")
        must("pausing on the whole-run question with execute never started", fsd(work, "close", str(state_path), "--retro", str(draft_retro)))
        paused = read_json(state_path)
        if paused["lifecycle"] != "paused":
            failures.append(f"close did not pause with execute never started and a question unanswered: {paused['lifecycle']}")

        must("answering the whole-run question", fsd(work, "answer", str(state_path), qid, "--text", "retry"))
        must("resuming with execute never started", fsd(work, "resume", str(state_path)))
        resumed = read_json(state_path)
        if resumed["lifecycle"] != "active":
            failures.append(f"resume did not move the run back to active: {resumed['lifecycle']}")
        if resumed["stages"]["execute"] != {"status": "pending", "run": None}:
            failures.append(f"resume touched execute's stage even though its association was absent: {resumed['stages']['execute']}")
        if resumed["stages"]["closeout"]["status"] != "pending":
            failures.append("resume did not reset closeout back to pending")
        if len(resumed["agents_md"]) != 2:
            failures.append("resume did not open a second agents_md span")

        gap_after_resume = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if not gap_after_resume["gap"] or gap_after_resume["next"] != "closeout" or gap_after_resume["completed"] != "ralplan":
            failures.append(f"gap after resume did not read the same ralplan-aborted -> closeout row: {gap_after_resume}")

        must("re-entering closeout after resume", fsd(work, "closeout", str(state_path)))
        gap_neverexec_closeout_reentered = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_neverexec_closeout_reentered["gap"]:
            failures.append(f"gap reported true right after closeout was re-entered in the execute-never-started case: {gap_neverexec_closeout_reentered}")
        final_retro = state_path.parent / "retro-final.md"
        final_retro.write_text(f"{qid} answered retry; execute was never reached.\n")
        must("closing now that nothing is unanswered and execute was never reached", fsd(work, "close", str(state_path), "--retro", str(final_retro)))
        closed = read_json(state_path)
        if closed["lifecycle"] != "completed":
            failures.append(f"close did not complete once ralplan aborted, execute was never reached, and nothing was left unanswered: {closed['lifecycle']}")
        if not closed["retrospective"] or "retros" not in closed["retrospective"]:
            failures.append(f"close did not relocate the retrospective on this completion: {closed['retrospective']}")
        gap_after_completed = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_after_completed["gap"]:
            failures.append(f"gap reported true on a completed run: {gap_after_completed}")

# ---------------------------------------------------------------------------
# Scenario 17: `close` treats a `--retro` path that already is the durable path as already relocated, rather than refusing it as a pre-existing collision or trying to replace it with itself.

def _section_scenario17_retro_already_at_durable_path():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-alreadydurable.md"
        write_plan(plan_path, "Approved")
        result = must("starting the already-durable case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "alreadydurable", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute for the already-durable case", fsd(work, "enter", str(state_path), "execute"))
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "alreadydurable", [execute_task("task-001", ["README.md"])], plan_path=plan_path)
        # Attached while the run is still nonterminal -- the completed receipt this drives toward next is free to leave `input.reference` null, so nothing would otherwise confirm this same run belongs afterward.
        must("attaching the already-durable case's execute run while still nonterminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        drive_task_to_acceptance(work, execute_state, "task-001")
        must("entering final_audit for the already-durable case", execute_to_final_audit(work, execute_state))
        must("completing the already-durable case's execute run", execute_complete(work, execute_state, ["task-001"]))
        must("recording an assumption for the already-durable case", fsd(work, "assume", str(state_path),
             "--stage", "execute", "--decision", "d", "--chosen", "c", "--alternatives", "x", "--reversal-cost", "r", "--where", "w"))

        durable = durable_retro_path(read_json(state_path))
        durable.parent.mkdir(parents=True, exist_ok=True)
        durable.write_text("A1 covered, written straight to the durable path.\n")
        must("closing with --retro already at the durable path", fsd(work, "close", str(state_path), "--retro", str(durable)))
        closed = read_json(state_path)
        if closed["lifecycle"] != "completed":
            failures.append(f"close did not complete with --retro already at the durable path: {closed['lifecycle']}")
        if closed["retrospective"] != str(durable):
            failures.append(f"close did not record the durable path as the retrospective: {closed['retrospective']}")
        if not durable.is_file():
            failures.append("close removed the retrospective instead of leaving it at the durable path it already was")

# ---------------------------------------------------------------------------
# Scenario 18: the blocked-with-no-parked-task, whole-run-question row and the blocked-with-parked-tasks row are mutually exclusive.
# A parked task present (whatever its decision_ref) must keep the whole-run-question clause from firing on its own -- dropping `and not parked` from that clause would let a parked task coexist with an unrelated whole-run question and still report a gap, which is not positive evidence for either of the two named rows.

def _section_scenario18_blocked_rows_mutually_exclusive_a():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-rowexcl.md"
        write_plan(plan_path, "Approved")
        result = must("starting the row-exclusivity case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "rowexcl", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute for the row-exclusivity case", fsd(work, "enter", str(state_path), "execute"))
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "rowexcl", [execute_task("task-001", ["README.md"])])
        must("dispatching task-001 for the row-exclusivity case", execute(work, "dispatch", str(execute_state), "task-001"))
        must("parking task-001 with no ref", execute(work, "park", str(execute_state), "task-001", "--question", "an unrecorded decision"))
        must("checkpointing to blocked for the row-exclusivity case", execute_checkpoint(work, execute_state, lambda s: s.update(
            {"lifecycle": "blocked", "phase": "blocked", "next_action": "blocked, task-001 parked with no ref, and a whole-run question also stands"})))
        must("recording an unrelated whole-run question", fsd(work, "question", str(state_path),
            "--stage", "closeout", "--question", "an unrelated whole-run decision", "--options", "a,b", "--recommended", "a",
            "--why-irreversible", "list item 4", "--parks", "whole run"))
        gap_null_ref_plus_whole_run = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_null_ref_plus_whole_run["gap"]:
            failures.append(f"gap reported true for a parked task with no ref alongside an unrelated whole-run question: {gap_null_ref_plus_whole_run}")

def _section_scenario18_blocked_rows_mutually_exclusive_b():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-rowexcl2.md"
        write_plan(plan_path, "Approved")
        result = must("starting the second row-exclusivity case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "rowexcl2", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute for the second row-exclusivity case", fsd(work, "enter", str(state_path), "execute"))
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "rowexcl2", [execute_task("task-001", ["README.md"])])
        must("dispatching task-001 for the second row-exclusivity case", execute(work, "dispatch", str(execute_state), "task-001"))
        qid = must("recording task-001's own parking question", fsd(work, "question", str(state_path),
            "--stage", "execute", "--question", "does task-001 depend on the format decision?", "--options", "a,b", "--recommended", "a",
            "--why-irreversible", "list item 1", "--parks", "task-001")).stdout.strip()
        must("parking task-001 against its own question", execute(work, "park", str(execute_state), "task-001", "--question", "q", "--ref", qid))
        must("answering task-001's own parking question", fsd(work, "answer", str(state_path), qid, "--text", "a"))
        must("checkpointing to blocked for the second row-exclusivity case", execute_checkpoint(work, execute_state, lambda s: s.update(
            {"lifecycle": "blocked", "phase": "blocked", "next_action": "blocked, task-001's own question answered but an unrelated whole-run question also stands"})))
        must("recording an unrelated, still-unanswered whole-run question", fsd(work, "question", str(state_path),
            "--stage", "closeout", "--question", "a second, unrelated whole-run decision", "--options", "a,b", "--recommended", "a",
            "--why-irreversible", "list item 4", "--parks", "whole run"))
        gap_answered_ref_plus_whole_run = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_answered_ref_plus_whole_run["gap"]:
            failures.append(f"gap reported true for a parked task whose own ref is answered alongside an unrelated, unanswered whole-run question: {gap_answered_ref_plus_whole_run}")

# ---------------------------------------------------------------------------
# Scenario 19: a pre-existing ralplan run is never associated on its own, matching or not -- `enter` no longer discovers or adopts anything at all; only `attach` (or, in the ordinary path, `post-bash`, proven in check-fsd-hooks) records an association. A matching run still needs an explicit `attach` before it counts.

def _section_scenario19_ralplan_pre_existing_run_never_auto_associated():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_requirements = work / "req-preexisting.md"
        write_requirements(approved_requirements, "Approved")

        # The pre-existing ralplan run is started against the *same* requirements document this fsd run is about to classify (`--input approved_requirements`) -- its own `input.reference` is what `_ralplan_candidate_belongs` would match against the fsd input, if anything ever checked.
        matching_plan = work / "plan-preexisting.md"
        write_plan(matching_plan, "Draft", "drafted", "v0")
        matching_dest = ralplan_run_root / "260101-000000-preexisting" / "state.json"
        must("starting the matching pre-existing ralplan run", ralplan(work, "start", str(matching_dest), "--plan", str(matching_plan),
             "--input", str(approved_requirements), "--summary", "check", "--lanes", "architect@claude,critic@claude"))

        result = must("starting the ralplan-pre-existing-run case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "ralplanpre", "--input", str(approved_requirements), "--worktree", str(work)))
        state_path = require_path(result)
        if read_json(state_path)["entry"] != "ralplan":
            failures.append("the ralplan-pre-existing-run fixture did not enter at ralplan")
        must("entering ralplan over a matching pre-existing run", fsd(work, "enter", str(state_path), "ralplan"))
        status_before_attach = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_before_attach["stages"]["ralplan"]["association"] != "none" or status_before_attach["stages"]["ralplan"]["run"] is not None:
            failures.append(f"enter associated a pre-existing ralplan run on its own, without any attach: {status_before_attach['stages']['ralplan']}")

        must("attaching the matching pre-existing run explicitly", fsd(work, "attach", str(state_path), "ralplan", str(matching_dest)))
        status_after_attach = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after_attach["stages"]["ralplan"]["run"] != str(matching_dest) or status_after_attach["stages"]["ralplan"]["association"] != "kept":
            failures.append(f"attach did not pin the matching pre-existing ralplan run: {status_after_attach['stages']['ralplan']}")

# Scenario 19b: a mismatched pre-existing ralplan run -- for the same repository, but started against a different requirements document entirely -- is refused by `attach`'s own strict check (still applicable: the run is nonterminal and this flow's own expected reference, its own `--input`, is already known), and stays wholly unassociated either way. This is one of the required cases: a non-matching pre-existing ralplan run is never associated.

def _section_scenario19b_ralplan_mismatched_run_never_associated():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

        other_requirements = work / "req-other.md"
        write_requirements(other_requirements, "Approved")
        mismatched_plan = work / "plan-mismatched.md"
        write_plan(mismatched_plan, "Draft", "drafted", "v0")
        mismatched_dest = ralplan_run_root / "260101-000000-mismatched" / "state.json"
        must("starting the mismatched pre-existing ralplan run", ralplan(work, "start", str(mismatched_dest), "--plan", str(mismatched_plan),
             "--input", str(other_requirements), "--summary", "check", "--lanes", "architect@claude,critic@claude"))

        approved_requirements = work / "req-scenario19b.md"
        write_requirements(approved_requirements, "Approved")
        result = must("starting the ralplan-mismatched-run case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "ralplanmismatched", "--input", str(approved_requirements), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering ralplan over a mismatched pre-existing run", fsd(work, "enter", str(state_path), "ralplan"))
        status_before_attach = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_before_attach["stages"]["ralplan"]["association"] != "none" or status_before_attach["stages"]["ralplan"]["run"] is not None:
            failures.append(f"enter associated a mismatched pre-existing ralplan run on its own: {status_before_attach['stages']['ralplan']}")

        refuse("attaching a pre-existing ralplan run started against a different requirements document",
               fsd(work, "attach", str(state_path), "ralplan", str(mismatched_dest)), reason="does not belong")
        status_after_refusal = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after_refusal["stages"]["ralplan"]["association"] != "none" or status_after_refusal["stages"]["ralplan"]["run"] is not None:
            failures.append(f"a refused attach still recorded an association: {status_after_refusal['stages']['ralplan']}")

# ---------------------------------------------------------------------------
# Scenario 20: guard normalizes an absolute-path scope entry and a `..`-bearing relative one before checking whether they cover AGENTS.md -- both forms `execute start` itself accepts.

def _section_scenario20_guard_normalizes_scope_entries():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        (work / "docs").mkdir()
        (work / "docs" / "x.md").write_text("x\n")
        git(work, "add", "-A")
        git(work, "commit", "-qm", "docs")

        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-normalize.md"
        write_plan(plan_path, "Approved")
        result = must("starting the scope-normalization case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "normalize", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute for the scope-normalization case", fsd(work, "enter", str(state_path), "execute"))

        # AGENTS.md itself may be a symlink -- `os.path.realpath` on the whole absolute entry would follow it to its target instead of staying "AGENTS.md" relative to the worktree, which is exactly why `_normalize_scope_entry` resolves only the entry's parent and leaves its own final component (the symlink itself) unresolved.
        (work / "AGENTS-target.md").write_text("the real content behind the symlink\n")
        (work / "AGENTS.md").unlink()
        os.symlink(work / "AGENTS-target.md", work / "AGENTS.md")

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        tasks = [
            execute_task("task-abs-root", [str(work)]),
            execute_task("task-abs-agents", [str(work / "AGENTS.md")]),
            execute_task("task-dotdot", ["docs/../AGENTS.md"]),
            execute_task("task-docs", ["docs/"]),
        ]
        execute_state = execute_start(work, execute_run_root, "normalize", tasks, plan_path=plan_path)
        must("attaching the scope-normalization case's execute run while still nonterminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        result = fsd(work, "guard", str(state_path))
        guard_result = json.loads(result.stdout)
        if result.returncode == 0:
            failures.append("guard exited 0 although an absolute-path and a `..`-relative scope both name AGENTS.md")
        guarded_tasks = {v["task"] for v in guard_result["violations"]}
        if guarded_tasks != {"task-abs-root", "task-abs-agents", "task-dotdot"}:
            failures.append(f"guard did not normalize the absolute-path and `..`-relative scope entries correctly, including an absolute path to a symlinked AGENTS.md: {guarded_tasks}")

# ---------------------------------------------------------------------------
# Scenario 21: an absolute scope entry may use an unresolved spelling of the worktree root -- on macOS a TemporaryDirectory sits under `/var/...`, itself a symlink to `/private/var/...`, and `execute start` accepts and stores a scope entry exactly as given, unresolved, while `state["worktree"]` is always the resolved form.
# This fixture deliberately does not call `.resolve()` on the fixture path before building the scope entries from it, so it fails without `_normalize_scope_entry`'s `os.path.realpath` step even where the earlier scenario (whose `work` is pre-resolved) would not catch the gap.

def _section_scenario21_unresolved_worktree_symlink_scope():
    with tempfile.TemporaryDirectory() as tmp:
        unresolved_work = Path(tmp) / "repo"
        unresolved_work.mkdir()
        if str(unresolved_work) == str(unresolved_work.resolve()):
            failures.append("this platform's TemporaryDirectory did not exercise the symlink case scenario 21 needs, so it proves nothing here")
        init_repo(unresolved_work)

        fsd_run_root = unresolved_work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = unresolved_work / "plan-symlink.md"
        write_plan(plan_path, "Approved")
        result = must("starting the symlinked-tempdir case", fsd(unresolved_work, "start", "--run-root", str(fsd_run_root), "--slug", "symlink", "--input", str(plan_path), "--worktree", str(unresolved_work)))
        state_path = require_path(result)
        must("entering execute for the symlinked-tempdir case", fsd(unresolved_work, "enter", str(state_path), "execute"))
        stored_worktree = read_json(state_path)["worktree"]
        if stored_worktree == str(unresolved_work):
            failures.append("this fixture's worktree was not actually resolved, so it cannot exercise the mismatch scenario 21 needs")

        execute_run_root = unresolved_work / ".agents" / "kein" / "runs" / "execute"
        tasks = [
            execute_task("task-unresolved-root", [str(unresolved_work)]),
            execute_task("task-unresolved-root-slash", [str(unresolved_work) + "/"]),
            execute_task("task-unresolved-agents", [str(unresolved_work / "AGENTS.md")]),
        ]
        execute_state = execute_start(unresolved_work, execute_run_root, "symlink", tasks, plan_path=plan_path)
        must("attaching the symlinked-tempdir case's execute run while still nonterminal", fsd(unresolved_work, "attach", str(state_path), "execute", str(execute_state)))
        result = fsd(unresolved_work, "guard", str(state_path))
        guard_result = json.loads(result.stdout)
        if result.returncode == 0:
            failures.append("guard exited 0 over unresolved-tempdir-spelling scope entries naming the repository root and AGENTS.md")
        guarded_tasks = {v["task"] for v in guard_result["violations"]}
        if guarded_tasks != {"task-unresolved-root", "task-unresolved-root-slash", "task-unresolved-agents"}:
            failures.append(f"guard did not normalize the unresolved tempdir spelling of the root and of AGENTS.md: {guarded_tasks}")

# ---------------------------------------------------------------------------
# Scenario 22: an execute run that itself aborted, with an fsd question still unanswered, still pauses rather than completing or refusing -- mirroring scenarios 3 and 16's absent/completed cases, but for the third case `_execute_side_done` treats as genuinely unfinished (aborted, upstream never aborted).
# Unanswered is checked first regardless of execute's own state.

def _section_scenario22_execute_aborted_unanswered_question_pauses():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-execaborted-unanswered.md"
        write_plan(plan_path, "Approved")
        result = must("starting the execute-aborted-unanswered case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "execabortedq", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute for the execute-aborted-unanswered case", fsd(work, "enter", str(state_path), "execute"))
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "execabortedq", [execute_task("task-001", ["README.md"])])
        aborted_source = read_json(execute_state)
        aborted_candidate = {
            "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": aborted_source["run_id"],
            "lifecycle": "aborted", "aborted_at": STAMP,
            "worktree_root": aborted_source["worktree"]["root"], "reason": "the fixture aborts this run while a question is still open",
        }
        aborted_path = tmp / "aborted.json"
        write(aborted_path, aborted_candidate)
        must("aborting the execute run while a question is unanswered", execute(work, "checkpoint", str(execute_state), str(aborted_path)))
        qid = must("recording an unanswered question for the execute-aborted-unanswered case", fsd(work, "question", str(state_path),
            "--stage", "closeout", "--question", "does the aborted attempt need a different approach?", "--options", "retry,abandon",
            "--recommended", "retry", "--why-irreversible", "the owner's ruling is not something the flow can infer", "--parks", "whole run")).stdout.strip()
        must("entering closeout for the execute-aborted-unanswered case", fsd(work, "closeout", str(state_path)))
        retro_path = state_path.parent / "retro.md"
        retro_path.write_text(f"{qid} pending; the execute run aborted.\n")
        must("closing over an aborted execute run while a question is unanswered", fsd(work, "close", str(state_path), "--retro", str(retro_path)))
        paused_state = read_json(state_path)
        if paused_state["lifecycle"] != "paused":
            failures.append(f"close did not pause over an aborted execute run with an unanswered question: {paused_state['lifecycle']}")

# ---------------------------------------------------------------------------
# Scenario 23: an execute run that appears in the run root after `enter`, but that nothing ever attached, is never associated -- there is no snapshot-diff left to accidentally adopt it, live or once it reaches a terminal receipt of its own. This is one of the required cases: an unrelated run appearing after `enter` is never associated.

def _section_scenario23_unrelated_run_never_associated():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        plan_path = work / "plan-scenario23.md"
        write_plan(plan_path, "Approved")
        result = must("starting the unrelated-run case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario23", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute", fsd(work, "enter", str(state_path), "execute"))
        if read_json(state_path)["stages"]["execute"]["run"] is not None:
            failures.append("enter associated a run on its own; this fixture proves nothing")

        other_plan = work / "plan-scenario23-other.md"
        write_plan(other_plan, "Approved", "an unrelated run")
        unrelated_run = execute_start(work, execute_run_root, "scenario23-other", [execute_task("task-x", ["README.md"])], plan_path=other_plan)

        # A live, plan-kind run for a different plan is refused by `attach`'s own strict check (still applicable: the run is nonterminal and this flow's own expected reference, its own `--input`, is already known) -- required case: an unrelated run (plan-kind, another plan) started in the worktree is never attached.
        refuse("attaching a live, unrelated plan-kind run for a different plan", fsd(work, "attach", str(state_path), "execute", str(unrelated_run)),
               reason="does not belong")

        status_unrelated_live = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_unrelated_live["stages"]["execute"]["association"] != "none" or status_unrelated_live["stages"]["execute"]["run"] is not None:
            failures.append(f"status associated an unrelated, still-live run that appeared after enter, though nothing ever attached it: {status_unrelated_live['stages']['execute']}")
        gap_unrelated_live = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_unrelated_live["gap"] and gap_unrelated_live.get("completed") == "execute":
            failures.append(f"gap treated a still-live, unrelated, never-attached run as this flow's own execute stage: {gap_unrelated_live}")

        # The unrelated run reaches a completed receipt of its own, with its own `input.reference` deliberately preserved (unlike `execute_complete`'s own fixture, which nulls it) rather than nulled out -- a real completed receipt is free to keep it, and this is the one shape that lets a terminal, compacted receipt still prove a mismatch instead of merely lacking evidence, so the case actually exercises the mismatch rather than the ordinary "compaction erased it" tolerance every other completed-execute scenario here relies on.
        drive_task_to_acceptance(work, unrelated_run, "task-x")
        must("entering final_audit for the unrelated run", execute_to_final_audit(work, unrelated_run))
        unrelated_source = read_json(unrelated_run)
        unrelated_completed = {
            "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": unrelated_source["run_id"],
            "lifecycle": "completed", "completed_at": STAMP,
            "input": {"reference": str(other_plan), "sha256": unrelated_source["input"]["sha256"]},
            "worktree": {"root": unrelated_source["worktree"]["root"], "final_fingerprint": "auto"},
            "accepted_tasks": [{"id": "task-x", "title": "task-x", "completion_condition": "task-x done", "carried_findings": []}],
            "final_verification": unrelated_source["latest_verification"], "final_audit": unrelated_source["final_audit"], "carried_findings": [],
        }
        unrelated_completed_path = tmp / "unrelated-completed.json"
        write(unrelated_completed_path, unrelated_completed)
        must("completing the unrelated run, its own mismatched reference preserved", execute(work, "checkpoint", str(unrelated_run), str(unrelated_completed_path)))

        status_unrelated_completed = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_unrelated_completed["stages"]["execute"]["association"] != "none" or status_unrelated_completed["stages"]["execute"]["run"] is not None:
            failures.append(f"status associated an unrelated run's own completed receipt as this flow's own execute run: {status_unrelated_completed['stages']['execute']}")
        gap_unrelated_completed = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_unrelated_completed["gap"] and gap_unrelated_completed.get("completed") == "execute":
            failures.append(f"gap read an unrelated run's own completed receipt as this flow's own execute stage ending: {gap_unrelated_completed}")

        retro_path = tmp / "retro-scenario23.md"
        retro_path.write_text("# Retrospective\n\nNothing recorded.\n")
        refuse("closing while execute has no association at all, only an unrelated run's own completed receipt elsewhere",
               fsd(work, "close", str(state_path), "--retro", str(retro_path)), reason="not completed")

# ---------------------------------------------------------------------------
# Scenario 23b: a `--kind brief` stranger -- a run whose own `input.reference` is `null` from the moment it starts, never a present-but-differing value the way scenario 23's above does -- never belongs to a plan-driven flow, live or once it has aborted or completed, and `attach` refuses it outright. This is the literal case the strict rule names: "a run with no reference never belongs, live or terminal" -- and one of the required cases: an unrelated (brief-kind) run started in the worktree is never attached.

def _section_scenario23b_brief_kind_stranger_never_belongs():
    def check_terminal_shape(label, build_terminal_candidate):
        with tempfile.TemporaryDirectory() as tmp:
            tmp = Path(tmp)
            work = (tmp / "repo").resolve()
            init_repo(work)
            fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
            execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
            plan_path = work / "plan-scenario23b.md"
            write_plan(plan_path, "Approved")
            result = must(f"starting the brief-kind-stranger case ({label})", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", f"scenario23b-{label}", "--input", str(plan_path), "--worktree", str(work)))
            state_path = require_path(result)
            must(f"entering execute ({label})", fsd(work, "enter", str(state_path), "execute"))

            # No `plan_path=` at all -- a `--kind brief` run, whose own `input.reference` is `null` from the start.
            brief_run = execute_start(work, execute_run_root, f"scenario23b-{label}-brief", [execute_task("task-x", ["README.md"])])
            if read_json(brief_run)["input"]["reference"] is not None:
                failures.append(f"the brief-kind fixture ({label}) carries a reference; this case proves nothing")

            refuse(f"attaching a live --kind brief stranger with no reference at all ({label})",
                   fsd(work, "attach", str(state_path), "execute", str(brief_run)), reason="does not belong")
            status_live = json.loads(fsd(work, "status", str(state_path)).stdout)
            if status_live["stages"]["execute"]["association"] != "none" or status_live["stages"]["execute"]["run"] is not None:
                failures.append(f"status associated a live --kind brief stranger with no reference at all ({label}): {status_live['stages']['execute']}")
            gap_live = json.loads(fsd(work, "gap", str(state_path)).stdout)
            if gap_live["gap"] and gap_live.get("completed") == "execute":
                failures.append(f"gap treated a live --kind brief stranger as this flow's own execute stage ({label}): {gap_live}")

            build_terminal_candidate(work, brief_run)

            status_terminal = json.loads(fsd(work, "status", str(state_path)).stdout)
            if status_terminal["stages"]["execute"]["association"] != "none" or status_terminal["stages"]["execute"]["run"] is not None:
                failures.append(f"status associated a --kind brief stranger's own terminal receipt ({label}): {status_terminal['stages']['execute']}")
            gap_terminal = json.loads(fsd(work, "gap", str(state_path)).stdout)
            if gap_terminal["gap"] and gap_terminal.get("completed") == "execute":
                failures.append(f"gap read a --kind brief stranger's own terminal receipt as this flow's own execute stage ending ({label}): {gap_terminal}")

            retro_path = work.parent / f"retro-scenario23b-{label}.md"
            retro_path.write_text("# Retrospective\n\nNothing recorded.\n")
            refuse(f"closing while execute has no association at all, only a --kind brief stranger's own terminal receipt elsewhere ({label})",
                   fsd(work, "close", str(state_path), "--retro", str(retro_path)), reason="not completed")

    def abort_it(work, brief_run):
        source = read_json(brief_run)
        aborted_candidate = {
            "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": source["run_id"],
            "lifecycle": "aborted", "aborted_at": STAMP,
            "worktree_root": source["worktree"]["root"], "reason": "unrelated to this flow",
        }
        aborted_path = work.parent / "aborted-scenario23b.json"
        write(aborted_path, aborted_candidate)
        must("aborting the brief-kind stranger", execute(work, "checkpoint", str(brief_run), str(aborted_path)))

    def complete_it(work, brief_run):
        drive_task_to_acceptance(work, brief_run, "task-x")
        must("entering final_audit for the brief-kind stranger", execute_to_final_audit(work, brief_run))
        must("completing the brief-kind stranger", execute_complete(work, brief_run, ["task-x"]))

    check_terminal_shape("aborted", abort_it)
    check_terminal_shape("completed", complete_it)

# ---------------------------------------------------------------------------
# Scenario 24: a completed execute receipt is refused by `attach` outright, terminal alone being reason enough -- and this one also carries a surviving `input.reference` that names a different, real plan this flow never asked for, so it would still be refused even by the reference comparison alone. Required case: attach of a completed foreign-plan receipt is refused.

def _section_scenario24_attach_refuses_completed_foreign_plan_receipt():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

        this_plan = work / "plan-scenario24-this.md"
        write_plan(this_plan, "Approved")
        result = must("starting the foreign-plan-receipt case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario24", "--input", str(this_plan), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute for the foreign-plan-receipt case", fsd(work, "enter", str(state_path), "execute"))

        # A genuinely different plan, driven to a real completed receipt in the same worktree -- its own `input.reference` still names that other plan.
        foreign_plan = work / "plan-scenario24-foreign.md"
        write_plan(foreign_plan, "Approved", "a foreign plan entirely")
        foreign_run = execute_start(work, execute_run_root, "scenario24-foreign", [execute_task("task-f", ["README.md"])], plan_path=foreign_plan)
        drive_task_to_acceptance(work, foreign_run, "task-f")
        must("entering final_audit for the foreign plan", execute_to_final_audit(work, foreign_run))
        must("completing the foreign plan's own run", execute_complete(work, foreign_run, ["task-f"]))
        if read_json(foreign_run)["input"]["reference"] != str(foreign_plan):
            failures.append("the foreign-plan-receipt fixture did not actually preserve a contradicting reference; this case proves nothing")

        refuse("attaching a completed receipt whose own reference names a different, real plan",
               fsd(work, "attach", str(state_path), "execute", str(foreign_run)), reason="does not belong")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["execute"]["association"] != "none" or status_after["stages"]["execute"]["run"] is not None:
            failures.append(f"attach accepted a completed foreign-plan receipt: {status_after['stages']['execute']}")

# ---------------------------------------------------------------------------
# Scenario 24b: unlike scenario 24's foreign-plan receipt, this one is driven to completion against *this flow's own plan* -- its own surviving `input.reference` and `worktree.root` both genuinely match what `_execute_candidate_belongs` expects -- so the terminal/live-only check is the only thing left standing between this candidate and a match. Required case: deleting that check turns this one, and only this one among the execute cases, from refused to accepted.

def _section_scenario24b_attach_refuses_completed_matching_plan_receipt():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

        plan_path = work / "plan-scenario24b.md"
        write_plan(plan_path, "Approved")
        result = must("starting the matching-plan-receipt case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario24b", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute for the matching-plan-receipt case", fsd(work, "enter", str(state_path), "execute"))

        # Driven to a real completed receipt against the *same* plan this flow itself executes, never attached while live.
        own_run = execute_start(work, execute_run_root, "scenario24b-own", [execute_task("task-m", ["README.md"])], plan_path=plan_path)
        drive_task_to_acceptance(work, own_run, "task-m")
        must("entering final_audit for scenario24b", execute_to_final_audit(work, own_run))
        must("completing scenario24b's own run", execute_complete(work, own_run, ["task-m"]))
        completed = read_json(own_run)
        if completed["input"]["reference"] != str(plan_path):
            failures.append("the scenario24b fixture did not preserve a genuinely matching input.reference on its own completed receipt; this case proves nothing")
        if completed["worktree"]["root"] != str(work):
            failures.append("the scenario24b fixture did not preserve a genuinely matching worktree.root on its own completed receipt; this case proves nothing")

        refuse("attaching a completed receipt whose own reference and worktree root both genuinely match this flow's plan",
               fsd(work, "attach", str(state_path), "execute", str(own_run)), reason="does not belong")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["execute"]["association"] != "none" or status_after["stages"]["execute"]["run"] is not None:
            failures.append(f"attach accepted a completed receipt merely because its own reference and root matched: {status_after['stages']['execute']}")

# ---------------------------------------------------------------------------
# Scenario 25: an aborted execute receipt from a genuinely different repository is refused -- terminal alone already refuses it, before its own `worktree_root` (the flat field an aborted receipt carries in place of the nested `worktree.root` every other execute shape uses) is ever read at all. Required case: attach of an aborted receipt from another repository is refused.

def _section_scenario25_attach_refuses_aborted_receipt_other_repository():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        other = (tmp / "other-repo").resolve()
        init_repo(other)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        other_execute_run_root = other / ".agents" / "kein" / "runs" / "execute"

        this_plan = work / "plan-scenario25.md"
        write_plan(this_plan, "Approved")
        result = must("starting the aborted-other-repository case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario25", "--input", str(this_plan), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute for the aborted-other-repository case", fsd(work, "enter", str(state_path), "execute"))

        other_plan = other / "plan-scenario25-other.md"
        write_plan(other_plan, "Approved", "a plan in a different repository")
        other_run = execute_start(other, other_execute_run_root, "scenario25-other", [execute_task("task-o", ["README.md"])], plan_path=other_plan)
        other_source = read_json(other_run)
        aborted_candidate = {
            "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": other_source["run_id"],
            "lifecycle": "aborted", "aborted_at": STAMP,
            "worktree_root": other_source["worktree"]["root"], "reason": "cancelled",
        }
        aborted_path = tmp / "aborted-scenario25.json"
        write(aborted_path, aborted_candidate)
        must("aborting the other-repository run through checkpoint", execute(other, "checkpoint", str(other_run), str(aborted_path)))
        if read_json(other_run)["worktree_root"] == str(work):
            failures.append("the aborted-other-repository fixture's own worktree_root coincides with this flow's worktree; this case proves nothing")

        refuse("attaching an aborted receipt whose own worktree_root names a different repository",
               fsd(work, "attach", str(state_path), "execute", str(other_run)), reason="does not belong")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["execute"]["association"] != "none" or status_after["stages"]["execute"]["run"] is not None:
            failures.append(f"attach accepted an aborted receipt from a different repository: {status_after['stages']['execute']}")

# ---------------------------------------------------------------------------
# Scenario 26: `_same_plan_reference` resolves each side against its own root, not both against the flow's own worktree. A ralplan run started in a second repository, against a plan with the identical *relative* filename this flow's own plan happens to have, must not read as a match purely because a relative candidate reference used to get joined onto the flow's own worktree root regardless of where the run that produced it actually lived.

def _section_scenario26_ralplan_same_relative_name_second_repository():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        other = (tmp / "other-repo").resolve()
        init_repo(other)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        ralplan_run_root = other / ".agents" / "kein" / "runs" / "ralplan"

        # A Draft-status plan as fsd's own --input: entry lands on ralplan with input.kind "plan", so `_expected_ralplan_field` compares `plan.path`, the field a candidate's own relative spelling is joined onto its own root to resolve.
        (work / "plan-samename.md").write_text("placeholder")
        write_plan(work / "plan-samename.md", "Draft", "first cut", "v0")
        result = must("starting fsd with a relative-spelling --input", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario26", "--input", "plan-samename.md", "--worktree", str(work)))
        state_path = require_path(result)
        if read_json(state_path)["entry"] != "ralplan" or read_json(state_path)["input"]["kind"] != "plan":
            failures.append("the same-relative-name fixture did not enter ralplan over a plan-kind input; this case proves nothing")

        # A different repository, holding a *different* file that happens to share the same relative filename.
        write_plan(other / "plan-samename.md", "Draft", "an unrelated plan in a different repository", "v0")
        ralplan_dest = ralplan_run_root / "260101-000000-scenario26" / "state.json"
        must("starting a ralplan run in the second repository with the same relative plan filename",
             ralplan(other, "start", str(ralplan_dest), "--plan", "plan-samename.md", "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        if read_json(ralplan_dest)["plan"]["path"] != "plan-samename.md":
            failures.append("the second-repository fixture did not actually store an unresolved relative plan.path; this case proves nothing")

        must("entering ralplan over the second repository's own run", fsd(work, "enter", str(state_path), "ralplan"))
        refuse("attaching a second repository's own ralplan run over the identical relative plan filename",
               fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)), reason="does not belong")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["ralplan"]["association"] != "none" or status_after["stages"]["ralplan"]["run"] is not None:
            failures.append(f"attach matched a second repository's own run purely on an identical relative plan filename: {status_after['stages']['ralplan']}")

# ---------------------------------------------------------------------------
# Scenario 27: a ralplan run started with no --input at all has a permanently null input.reference, so post-bash's own strict check can never link it when this flow's own expected field is `input` -- the lead has to `attach` it explicitly. `status` names which stage has no association and what would have linked it, so a lead reading status after compaction (with no memory of which stage never got auto-linked) knows to attach rather than wait.

def _section_scenario27_ralplan_no_input_status_names_association_reason():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"

        approved_requirements = work / "req-scenario27.md"
        write_requirements(approved_requirements, "Approved")
        result = must("starting the ralplan-no-input case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario27", "--input", str(approved_requirements), "--worktree", str(work)))
        state_path = require_path(result)
        if read_json(state_path)["entry"] != "ralplan":
            failures.append("the ralplan-no-input fixture did not enter at ralplan; this case proves nothing")
        must("entering ralplan for the no-input case", fsd(work, "enter", str(state_path), "ralplan"))

        no_input_plan = work / "plan-scenario27.md"
        write_plan(no_input_plan, "Draft", "drafted", "v0")
        no_input_dest = ralplan_run_root / "260101-000000-scenario27" / "state.json"
        # No --input at all: its own input.reference is null from the start, not merely unconfirmed, so the strict test can never match it against a requirements-kind expected reference no matter which requirements document it actually concerns.
        must("starting a ralplan run with no --input at all", ralplan(work, "start", str(no_input_dest), "--plan", str(no_input_plan), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        if read_json(no_input_dest)["input"]["reference"] is not None:
            failures.append("the no-input ralplan fixture carries a reference; this case proves nothing")

        status_result = json.loads(fsd(work, "status", str(state_path)).stdout)
        ralplan_status = status_result["stages"]["ralplan"]
        if ralplan_status["association"] != "none":
            failures.append(f"the no-input ralplan case's own association was not 'none': {ralplan_status}")
        reason = ralplan_status.get("association_reason", "")
        if "ralplan start" not in reason or "attach" not in reason:
            failures.append(f"status did not explain what would have linked ralplan or name the attach command: {ralplan_status}")

        # The live candidate's own `input` key is present but null (not dropped), so the strict test still applies and still refuses it as a confirmed mismatch -- attach is not a way past that, even called explicitly. This is what actually makes the run unlinkable while live, which is exactly the situation `status` has to explain.
        refuse("attaching the no-input ralplan run explicitly while it is still live",
               fsd(work, "attach", str(state_path), "ralplan", str(no_input_dest)), reason="does not belong")

# ---------------------------------------------------------------------------
# Scenario 28: a completed ralplan receipt that genuinely carries this flow's own plan path on `plan.path` -- the exact field the old strict test used to accept once completed -- is still refused, because it is terminal: `post-bash` links a stage's run at creation, while it is still live, so a receipt that completed before this flow ever attached it has nothing left here to rescue it, whatever its own surviving fields say. Required case: attach of any terminal run is refused, even one whose own surviving reference matches.
# `complete()` drops `repository` from its own compact field set entirely, so an *ordinary* completed receipt already fails the root check inside `_same_plan_reference` on its own, whether or not the terminal/live-only check in `_ralplan_candidate_belongs` is even there -- that would not actually isolate the lifecycle gate this case exists to prove. The receipt below is hand-patched, straight on disk (bypassing `ralplan`'s own checkpoint validation, which enforces the exact compact field set and would refuse an extra key), to carry `repository` through anyway, so `plan.path` and `repository` both genuinely match this flow and the terminal check is the only thing left standing between this candidate and a match.

def _section_scenario28_ralplan_completed_matching_receipt_refused():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"

        plan_path = work / "plan-scenario28.md"
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_dest = ralplan_run_root / "260101-000000-scenario28" / "state.json"
        must("starting a ralplan run against the plan this flow will later classify, never attached while live",
             ralplan(work, "start", str(ralplan_dest), "--plan", str(plan_path), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        must("opening round 1 for scenario28", ralplan(work, "open", str(ralplan_dest)))
        write_plan(plan_path, "Approved", "good", "v0")
        must("approving round 1 for scenario28", ralplan(work, "approve", str(ralplan_dest)))
        must("completing the matching ralplan run before this flow ever attaches it", ralplan(work, "complete", str(ralplan_dest)))
        if read_json(ralplan_dest)["plan"]["path"] != str(plan_path):
            failures.append("the scenario28 fixture did not preserve a genuinely matching plan.path on its own completed receipt; this case proves nothing")
        if "repository" in read_json(ralplan_dest):
            failures.append("the scenario28 fixture's own completed receipt already carries repository; the hand-patch below proves nothing")

        # Hand-patched, not through `ralplan checkpoint`: a completed receipt carrying `repository` fails `ralplan`'s own exact-field-set validation, so this writes the extra field straight to the file the way a strict-test-only comparison (fsd's own unvalidated `_load`) would still read it.
        patched = read_json(ralplan_dest)
        patched["repository"] = str(work)
        write(ralplan_dest, patched)

        # fsd classifies the identical plan path, re-written Draft so entry lands on ralplan rather than execute.
        write_plan(plan_path, "Draft", "second cut", "v1")
        result = must("starting the scenario28 case against the same plan path",
                      fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario28", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        if read_json(state_path)["entry"] != "ralplan" or read_json(state_path)["input"]["kind"] != "plan":
            failures.append("the scenario28 fixture did not enter ralplan over a plan-kind input; this case proves nothing")
        must("entering ralplan over the matching-but-already-completed receipt", fsd(work, "enter", str(state_path), "ralplan"))

        refuse("attaching a completed ralplan receipt whose own plan.path and repository both genuinely match this flow",
               fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)), reason="does not belong")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["ralplan"]["association"] != "none" or status_after["stages"]["ralplan"]["run"] is not None:
            failures.append(f"attach accepted a terminal ralplan receipt merely because its own reference and root matched: {status_after['stages']['ralplan']}")

# ---------------------------------------------------------------------------
# Scenario 29: an active interview ledger whose own `repository` names a different repository entirely is never linked -- interview carries fsd no reference of its own to compare a candidate against, so the worktree check is the only thing standing between "the first well-formed ledger attach sees" and "this flow's own ledger". Required case: another repository's active interview ledger not linked.

def _section_scenario29_interview_other_repository_not_linked():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        other = (tmp / "other-repo").resolve()
        init_repo(other)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

        result = must("starting the interview-other-repository case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario29", "--input", "an idea", "--worktree", str(work)))
        state_path = require_path(result)
        must("entering interview for the other-repository case", fsd(work, "enter", str(state_path), "interview"))

        other_interview_dir = other / ".agents" / "kein" / "runs" / "interview" / "260101-000000-scenario29"
        other_interview_dir.mkdir(parents=True)
        other_ledger = other_interview_dir / "ledger.md"
        # A genuinely well-formed active ledger -- its own repository just names the other repository, not this flow's.
        write_active_ledger(other_ledger, "260101-000000-scenario29", other, other, other / "req-scenario29.md")

        refuse("attaching an active ledger from a different repository", fsd(work, "attach", str(state_path), "interview", str(other_ledger)),
               reason="does not belong")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["interview"]["association"] != "none" or status_after["stages"]["interview"]["run"] is not None:
            failures.append(f"attach linked an active ledger from a different repository: {status_after['stages']['interview']}")

# ---------------------------------------------------------------------------
# Scenario 29b: a hand-authored completed ledger that genuinely carries this flow's own `repository` and an `output_path` resolving inside this flow's own worktree -- the two fields `_interview_candidate_belongs` checks once its own live-only gate is passed -- is still refused, because it is terminal: `post-bash` links a stage's run at creation, while it is still live, so a ledger that completed before this flow ever attached it has nothing left here to rescue it, whatever its own surviving fields say. An ordinary `write_completed_ledger` fixture drops both fields entirely, so an ordinary completed-ledger case already fails the repository/output_path checks on its own, whether or not the live-only gate is even there -- that would not actually isolate it. This one is hand-authored to carry both fields through anyway, isolating the live-only gate the same way scenario 28 does for ralplan. Required case: deleting that gate turns this one, and only this one among the interview cases, from refused to accepted.

def _section_scenario29b_interview_completed_matching_ledger_refused():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

        result = must("starting the completed-matching-ledger case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario29b", "--input", "an idea", "--worktree", str(work)))
        state_path = require_path(result)
        must("entering interview for the completed-matching-ledger case", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-scenario29b"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / "req-scenario29b.md"
        output_path = interview_dir / "output.md"
        output_path.write_text("placeholder")
        # Hand-authored straight to its completed shape, but carrying `repository` and `output_path` -- the two fields an ordinary `write_completed_ledger` drops entirely -- so both genuinely match this flow's own worktree, and the live-only status check is the only thing left refusing it.
        ledger.write_text(
            "---\n"
            "status: completed\n"
            f'requirements_path: "{requirements_path}"\n'
            f'repository: "{work}"\n'
            f'output_path: "{output_path}"\n'
            f'completed_at: "{STAMP}"\n'
            "---\n"
        )

        refuse("attaching a completed ledger whose own repository and output_path both genuinely match this flow",
               fsd(work, "attach", str(state_path), "interview", str(ledger)), reason="does not belong")
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["interview"]["association"] != "none" or status_after["stages"]["interview"]["run"] is not None:
            failures.append(f"attach accepted a completed ledger merely because its own repository and output_path matched: {status_after['stages']['interview']}")

# ---------------------------------------------------------------------------
# Scenario 30: once an interview stage has a kept link, a second active ledger in the same repository never replaces it -- `attach` refuses a different path outright, and re-attaching the exact same already-kept path is a harmless no-op that writes nothing. Required case: a same-repository second ledger does not replace the kept interview link.

def _section_scenario30_interview_second_ledger_never_replaces_kept_link():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

        result = must("starting the second-ledger case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario30", "--input", "an idea", "--worktree", str(work)))
        state_path = require_path(result)
        must("entering interview for the second-ledger case", fsd(work, "enter", str(state_path), "interview"))

        interview_run_root = work / ".agents" / "kein" / "runs" / "interview"
        first_ledger = interview_run_root / "260101-000000-scenario30-first" / "ledger.md"
        first_ledger.parent.mkdir(parents=True)
        write_active_ledger(first_ledger, "260101-000000-scenario30-first", work, work, work / "req-scenario30-first.md")
        must("attaching the first ledger while active", fsd(work, "attach", str(state_path), "interview", str(first_ledger)))

        second_ledger = interview_run_root / "260101-000000-scenario30-second" / "ledger.md"
        second_ledger.parent.mkdir(parents=True)
        write_active_ledger(second_ledger, "260101-000000-scenario30-second", work, work, work / "req-scenario30-second.md")

        refuse("attaching a second, equally well-formed active ledger in the same repository",
               fsd(work, "attach", str(state_path), "interview", str(second_ledger)), reason="a kept link is never replaced")
        status_after_second = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after_second["stages"]["interview"]["run"] != str(first_ledger):
            failures.append(f"a refused second attach still moved the kept link off the first ledger: {status_after_second['stages']['interview']}")

        must("attaching the first ledger again, the exact same path, is a no-op", fsd(work, "attach", str(state_path), "interview", str(first_ledger)))
        status_after_repeat = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after_repeat["stages"]["interview"]["run"] != str(first_ledger):
            failures.append(f"attaching the exact same already-kept path moved the association: {status_after_repeat['stages']['interview']}")

# ---------------------------------------------------------------------------
# Scenario 31: a ralplan run started with `--repository` left to default to `Path.cwd()`, from a subdirectory of the repository rather than its root, still links -- `_same_plan_reference` canonicalizes the candidate's own root through `_execute.canonical_worktree` before comparing it to this flow's own (already-canonical) worktree, rather than comparing raw paths. Required case: ralplan started from a subdirectory cwd links.

def _section_scenario31_ralplan_subdirectory_cwd_links():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        subdir = work / "sub"
        subdir.mkdir()
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"

        approved_requirements = work / "req-scenario31.md"
        write_requirements(approved_requirements, "Approved")
        result = must("starting the ralplan-subdirectory case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario31", "--input", str(approved_requirements), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering ralplan for the subdirectory case", fsd(work, "enter", str(state_path), "ralplan"))

        plan_path = work / "plan-scenario31.md"
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_dest = ralplan_run_root / "260101-000000-scenario31" / "state.json"
        # cwd is the subdirectory, and --repository is left unset, so ralplan's own `start` stores it exactly as `Path.cwd()` returns there: the subdirectory, not the repository root.
        must("starting the ralplan run from a subdirectory cwd, --repository left to default",
             ralplan(subdir, "start", str(ralplan_dest), "--input", str(approved_requirements), "--plan", str(plan_path), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        if read_json(ralplan_dest)["repository"] != str(subdir):
            failures.append("the subdirectory-cwd fixture did not actually store the subdirectory as its own repository; this case proves nothing")

        must("attaching the subdirectory-started ralplan run", fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)))
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["ralplan"]["association"] != "kept" or status_after["stages"]["ralplan"]["run"] != str(ralplan_dest):
            failures.append(f"attach refused a ralplan run whose own repository was an unresolved subdirectory of this flow's worktree: {status_after['stages']['ralplan']}")

# ---------------------------------------------------------------------------
# Scenario 32: a resumed, pending execute stage whose kept link is also the worktree's own current occupant -- the ordinary shape a parked task's own pause/answer/resume cycle leaves behind -- must not read as a mismatched stranger to abort even when the strict belonging test on it would newly fail (a transient read problem, or evidence the run's own file no longer carries the way it did when it was first attached): `_execute_occupant_block` trusts an occupant equal to the kept link outright, the identical shortcut `enter` already takes, without ever re-running `_execute_candidate_belongs` on it. Required case: the occupant-abort row does not fire over the flow's own kept, still-live run.

def _section_scenario32_resumed_kept_occupant_strict_test_failure_no_occupant_row():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

        plan_path = work / "plan-scenario32.md"
        write_plan(plan_path, "Approved")
        result = must("starting the resumed-kept-occupant case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario32", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        if read_json(state_path)["entry"] != "execute":
            failures.append("the scenario32 fixture did not enter directly at execute; this case proves nothing")
        must("entering execute for scenario32", fsd(work, "enter", str(state_path), "execute"))

        execute_state = execute_start(work, execute_run_root, "scenario32", [execute_task("task-001", ["README.md"])], plan_path=plan_path)
        must("attaching the execute run while still nonterminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))

        must("dispatching task-001 for scenario32", execute(work, "dispatch", str(execute_state), "task-001"))
        q = must("recording the irreversible question for scenario32",
                 fsd(work, "question", str(state_path), "--stage", "execute", "--question", "which persisted format?",
                     "--options", "json,csv", "--recommended", "json", "--why-irreversible", "list item 1: a persisted format read outside the repo",
                     "--parks", "task-001"))
        question_id = q.stdout.strip()
        must("parking task-001 for scenario32", execute(work, "park", str(execute_state), "task-001", "--question", "which format?", "--ref", question_id))
        must("checkpointing execute to blocked for scenario32", execute_checkpoint(work, execute_state, lambda s: s.update(
            {"lifecycle": "blocked", "phase": "blocked", "next_action": f"blocked on {question_id}: task-001 parked"})))

        must("entering closeout for scenario32", fsd(work, "closeout", str(state_path)))
        draft_retro = state_path.parent / "retro-draft-scenario32.md"
        draft_retro.write_text(f"# Retrospective\n\n{question_id}: parked.\n")
        must("closing while unanswered for scenario32", fsd(work, "close", str(state_path), "--retro", str(draft_retro)))
        must("answering the question for scenario32", fsd(work, "answer", str(state_path), question_id, "--text", "json"))
        must("resuming for scenario32", fsd(work, "resume", str(state_path)))
        resumed = read_json(state_path)
        if resumed["stages"]["execute"]["status"] != "pending" or resumed["stages"]["execute"]["run"] != str(execute_state):
            failures.append(f"the scenario32 fixture did not land on a resumed, pending, kept execute run; this case proves nothing: {resumed['stages']['execute']}")

        # The kept run is still the worktree's own current occupant -- nothing else is live -- so `_execute_occupant_block` is asked about exactly the flow's own run. Hand-corrupt its own `input.reference` directly on disk, bypassing `execute`'s own checkpoint validation entirely, so the strict belonging test would now read it as a stranger if it were ever re-run on it.
        corrupted = read_json(execute_state)
        corrupted["input"]["reference"] = str(work / "plan-scenario32-not-this-flow.md")
        write(execute_state, corrupted)

        gap_after = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if not gap_after["gap"] or gap_after["next"] != "execute":
            failures.append(f"gap did not report the ordinary resumed execute-pending row: {gap_after}")
        action = gap_after.get("action", "")
        if "occupies the worktree" in action or "abort it" in action or "python3 -c" in action:
            failures.append(f"gap treated the flow's own kept, still-live execute run as a mismatched occupant to abort, once its own strict test would newly fail: {action!r}")
        if "invoke /kein:execute" not in action or str(plan_path) not in action:
            failures.append(f"gap did not print the ordinary invoke-execute action for the resumed, still-blocked run: {action!r}")

# ---------------------------------------------------------------------------
# Scenario 33: re-attaching a stage's own already-kept path, after the run behind it has gone terminal (completed, here), is a harmless no-op -- exit 0, nothing written -- the same promise scenario 30 above proves while the kept run is still live. `attach` checks the exact-same-resolved-path case before it ever asks the strict belonging test (`_candidate_belongs`) about the candidate, which is what keeps that check from refusing the very run whose kept link already answers the question: `_candidate_belongs` refuses any terminal candidate outright, live-only being the whole point of the strict test, so asking it first would turn this into a refusal instead of the no-op the kept link's own presence already settles. Required case: attach of the kept path after its own run went terminal is a no-op.

def _section_scenario33_attach_same_kept_path_after_terminal_is_noop():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

        plan_path = work / "plan-scenario33.md"
        write_plan(plan_path, "Approved")
        result = must("starting the terminal-reattach case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario33", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering execute for scenario33", fsd(work, "enter", str(state_path), "execute"))

        execute_state = execute_start(work, execute_run_root, "scenario33", [execute_task("task-001", ["README.md"])], plan_path=plan_path)
        must("attaching the execute run while still nonterminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        before = read_json(state_path)
        if before["stages"]["execute"]["run"] != str(execute_state):
            failures.append(f"the scenario33 fixture did not actually pin the kept link before completing the run; this case proves nothing: {before['stages']['execute']}")

        drive_task_to_acceptance(work, execute_state, "task-001")
        must("entering final_audit for scenario33", execute_to_final_audit(work, execute_state))
        must("completing execute for scenario33", execute_complete(work, execute_state, ["task-001"]))
        if read_json(execute_state)["lifecycle"] != "completed":
            failures.append("the scenario33 fixture's own execute run did not actually reach a completed, terminal lifecycle; this case proves nothing")

        must("re-attaching the exact same already-kept path after its own run went terminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        after = read_json(state_path)
        if after["stages"]["execute"]["run"] != str(execute_state):
            failures.append(f"re-attaching the exact same already-kept path after its run went terminal moved the association: {after['stages']['execute']}")
        if after != before:
            failures.append(f"re-attaching the exact same already-kept path after its run went terminal wrote something to fsd's own state: before={before['stages']['execute']} after={after['stages']['execute']}")

# ---------------------------------------------------------------------------
# Scenario 34: a ralplan run started from a subdirectory of the repository, with `--input` and `--plan` given relative to that subdirectory's own cwd rather than absolute -- the ordinary way a lead standing in a subdirectory would type them -- still links. Scenario 31 above proves the subdirectory-root canonicalization alone; it types `--input` absolute, so a relative reference resolved against the wrong root never shows up. This scenario is what actually exercises `_same_plan_reference` resolving a ralplan candidate's own relative reference against the run's own `working_directory` rather than against the candidate's canonicalized repository root: a relative `--input` typed from `sub/` points at a file one level up, and only resolving it against `sub/` itself (not against the canonicalized repository root, a different directory the file is not relative to) lands back on the same file the flow's own absolute reference names. Required case: a subdirectory-started ralplan run with relative --input and --plan links.

def _section_scenario34_ralplan_subdirectory_relative_input_links():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        subdir = work / "sub"
        subdir.mkdir()
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"

        approved_requirements = work / "req-scenario34.md"
        write_requirements(approved_requirements, "Approved")
        result = must("starting the ralplan-subdirectory-relative case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "scenario34", "--input", str(approved_requirements), "--worktree", str(work)))
        state_path = require_path(result)
        must("entering ralplan for the subdirectory-relative case", fsd(work, "enter", str(state_path), "ralplan"))

        plan_path = work / "plan-scenario34.md"
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_dest = ralplan_run_root / "260101-000000-scenario34" / "state.json"
        # cwd is the subdirectory; --input and --plan are typed relative to it, exactly as a lead standing there would type them, and --repository/--working-directory are both left unset so they default to that same subdirectory.
        relative_input = os.path.relpath(approved_requirements, subdir)
        relative_plan = os.path.relpath(plan_path, subdir)
        must("starting the ralplan run from a subdirectory cwd with relative --input and --plan",
             ralplan(subdir, "start", str(ralplan_dest), "--input", relative_input, "--plan", relative_plan, "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        stored = read_json(ralplan_dest)
        if stored["repository"] != str(subdir) or stored["working_directory"] != str(subdir):
            failures.append(f"the subdirectory-relative fixture did not actually store the subdirectory as its own repository and working_directory; this case proves nothing: {stored}")
        if stored["input"]["reference"] != relative_input:
            failures.append(f"the subdirectory-relative fixture did not store --input exactly as typed; this case proves nothing: {stored['input']}")

        must("attaching the subdirectory-started ralplan run with a relative --input", fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)))
        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["ralplan"]["association"] != "kept" or status_after["stages"]["ralplan"]["run"] != str(ralplan_dest):
            failures.append(f"attach refused a ralplan run started from a subdirectory with a relative --input typed relative to that same subdirectory: {status_after['stages']['ralplan']}")

# ---------------------------------------------------------------------------
# Section registry and CLI driver -- `--list` prints the section names below in the order they run; `--only <name>[,<name>...]` runs just those sections (plus whatever earlier ones a dependency map names, though every scenario here is self-contained and needs none); neither flag runs every section in order exactly as running this file always has.

SECTIONS = [
    ("scenario1-input-classification", (), _section_scenario1_input_classification),
    ("scenario1b-relative-input-resolves-against-worktree", (), _section_scenario1b_relative_input_resolves_against_worktree),
    ("scenario2-full-drive-lifecycle", (), _section_scenario2_full_drive_lifecycle),
    ("scenario3-agentsmd-drift-across-pause", (), _section_scenario3_agentsmd_drift_across_pause),
    ("scenario4-guard-scope-violations", (), _section_scenario4_guard_scope_violations),
    ("scenario5-blocked-null-decision-ref", (), _section_scenario5_blocked_null_decision_ref),
    ("scenario6d-path-spelling-relative-vs-absolute", (), _section_scenario6d_path_spelling_relative_vs_absolute),
    ("scenario6e-no-expected-reference-yet", (), _section_scenario6e_no_expected_reference_yet),
    ("scenario6f-unresolved-worktree-symlink-spelling", (), _section_scenario6f_unresolved_worktree_symlink_spelling),
    ("scenario7-ralplan-non-convergence-deferrals", (), _section_scenario7_ralplan_non_convergence_deferrals),
    ("scenario8-guard-action-clears-failure-restart", (), _section_scenario8_guard_action_clears_failure_restart),
    ("scenario8d-guard-action-literal-recovery-text", (), _section_scenario8d_guard_action_literal_recovery_text),
    ("scenario9-guard-clean-no-run-yet-then-unreadable", (), _section_scenario9_guard_clean_no_run_yet_then_unreadable),
    ("scenario10-gap-status-tolerate-unreadable-evidence", (), _section_scenario10_gap_status_tolerate_unreadable_evidence),
    ("scenario11-interview-aborted-closeout-row", (), _section_scenario11_interview_aborted_closeout_row),
    ("scenario12-execute-aborted-receipt-closeout-row", (), _section_scenario12_execute_aborted_receipt_closeout_row),
    ("scenario12-blocked-no-parked-whole-run-question-row", (), _section_scenario12_blocked_no_parked_whole_run_question_row),
    ("scenario13-nonterminal-lifecycle-short-circuit", (), _section_scenario13_nonterminal_lifecycle_short_circuit),
    ("scenario14-write-active-alongside-parked", (), _section_scenario14_write_active_alongside_parked),
    ("scenario15-retro-location-enforced", (), _section_scenario15_retro_location_enforced),
    ("scenario16-execute-never-started-precedence", (), _section_scenario16_execute_never_started_precedence),
    ("scenario17-retro-already-at-durable-path", (), _section_scenario17_retro_already_at_durable_path),
    ("scenario18-blocked-rows-mutually-exclusive-a", (), _section_scenario18_blocked_rows_mutually_exclusive_a),
    ("scenario18-blocked-rows-mutually-exclusive-b", (), _section_scenario18_blocked_rows_mutually_exclusive_b),
    ("scenario19-ralplan-pre-existing-run-never-auto-associated", (), _section_scenario19_ralplan_pre_existing_run_never_auto_associated),
    ("scenario19b-ralplan-mismatched-run-never-associated", (), _section_scenario19b_ralplan_mismatched_run_never_associated),
    ("scenario20-guard-normalizes-scope-entries", (), _section_scenario20_guard_normalizes_scope_entries),
    ("scenario21-unresolved-worktree-symlink-scope", (), _section_scenario21_unresolved_worktree_symlink_scope),
    ("scenario22-execute-aborted-unanswered-question-pauses", (), _section_scenario22_execute_aborted_unanswered_question_pauses),
    ("scenario23-unrelated-run-never-associated", (), _section_scenario23_unrelated_run_never_associated),
    ("scenario23b-brief-kind-stranger-never-belongs", (), _section_scenario23b_brief_kind_stranger_never_belongs),
    ("scenario24-attach-refuses-completed-foreign-plan-receipt", (), _section_scenario24_attach_refuses_completed_foreign_plan_receipt),
    ("scenario24b-attach-refuses-completed-matching-plan-receipt", (), _section_scenario24b_attach_refuses_completed_matching_plan_receipt),
    ("scenario25-attach-refuses-aborted-receipt-other-repository", (), _section_scenario25_attach_refuses_aborted_receipt_other_repository),
    ("scenario26-ralplan-same-relative-name-second-repository", (), _section_scenario26_ralplan_same_relative_name_second_repository),
    ("scenario27-ralplan-no-input-status-names-association-reason", (), _section_scenario27_ralplan_no_input_status_names_association_reason),
    ("scenario28-ralplan-completed-matching-receipt-refused", (), _section_scenario28_ralplan_completed_matching_receipt_refused),
    ("scenario29-interview-other-repository-not-linked", (), _section_scenario29_interview_other_repository_not_linked),
    ("scenario29b-interview-completed-matching-ledger-refused", (), _section_scenario29b_interview_completed_matching_ledger_refused),
    ("scenario30-interview-second-ledger-never-replaces-kept-link", (), _section_scenario30_interview_second_ledger_never_replaces_kept_link),
    ("scenario31-ralplan-subdirectory-cwd-links", (), _section_scenario31_ralplan_subdirectory_cwd_links),
    ("scenario32-resumed-kept-occupant-strict-test-failure-no-occupant-row", (), _section_scenario32_resumed_kept_occupant_strict_test_failure_no_occupant_row),
    ("scenario33-attach-same-kept-path-after-terminal-is-noop", (), _section_scenario33_attach_same_kept_path_after_terminal_is_noop),
    ("scenario34-ralplan-subdirectory-relative-input-links", (), _section_scenario34_ralplan_subdirectory_relative_input_links),
]
SECTION_NAMES = [name for name, _, _ in SECTIONS]
SECTION_DEPS = {name: deps for name, deps, _ in SECTIONS}
SECTION_FUNCS = {name: func for name, _, func in SECTIONS}
SCRIPT_NAME = "check-fsd-state"


def _section_closure(requested):
    # A dependency always appears earlier in `SECTIONS` than whatever names it, so filtering `SECTION_NAMES` down to the requested sections plus their dependencies keeps a valid run order on its own, with no separate topological sort needed.
    needed = set()
    stack = list(requested)
    while stack:
        name = stack.pop()
        if name in needed:
            continue
        needed.add(name)
        stack.extend(SECTION_DEPS[name])
    return [name for name in SECTION_NAMES if name in needed]


def _parse_argv(argv):
    if not argv:
        return None, None
    if argv == ["--list"]:
        return "list", None
    if len(argv) == 2 and argv[0] == "--only":
        return "only", [n.strip() for n in argv[1].split(",") if n.strip()]
    print(f"{SCRIPT_NAME}: usage: {SCRIPT_NAME} [--list | --only <name>[,<name>...]]", file=sys.stderr)
    raise SystemExit(2)


def main():
    mode, names = _parse_argv(sys.argv[1:])

    if mode == "list":
        for name in SECTION_NAMES:
            print(name)
        return

    if mode == "only":
        unknown = [n for n in names if n not in SECTION_DEPS]
        if not names or unknown:
            if unknown:
                print(f"{SCRIPT_NAME}: unknown section(s): {', '.join(unknown)}", file=sys.stderr)
            else:
                print(f"{SCRIPT_NAME}: --only needs at least one section name", file=sys.stderr)
            print(f"{SCRIPT_NAME}: valid sections: {', '.join(SECTION_NAMES)}", file=sys.stderr)
            raise SystemExit(1)
        run_order = _section_closure(names)
    else:
        run_order = list(SECTION_NAMES)

    for name in run_order:
        SECTION_FUNCS[name]()

    if failures:
        for failure in failures:
            print(f"{SCRIPT_NAME}: {failure}", file=sys.stderr)
        raise SystemExit(1)
    if mode == "only":
        print(f"{SCRIPT_NAME}: ran {', '.join(run_order)}")
    else:
        print("check-fsd-state: classification, gap, guard, close/resume precedence over an unanswered "
      "question and a still-blocked execute run, the retrospective staying out of execute's "
      "fingerprint until completion, and the ralplan non-convergence exit all hold")


if __name__ == "__main__":
    main()
