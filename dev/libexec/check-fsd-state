        crosscheck_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-attachterm-crosscheck"
        crosscheck_dir.mkdir(parents=True)
        crosscheck_ledger = crosscheck_dir / "ledger.md"
        crosscheck_requirements = work / "req-attachterm-crosscheck.md"
        write_active_ledger(crosscheck_ledger, "260101-000000-attachterm-crosscheck", work, work, crosscheck_requirements)
        must("attaching the live ledger that pins resolved_reference for the crosscheck case",
             fsd(work, "attach", str(state_path), "interview", str(crosscheck_ledger)))
        pinned_reference = read_json(state_path)["stages"]["interview"].get("resolved_reference")
        if not pinned_reference:
            failures.append("attach did not pin interview's own resolved_reference for the crosscheck case; this case proves nothing")

        match_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-attachterm-crosscheck-match"
        match_dir.mkdir(parents=True)
        match_ledger = match_dir / "ledger.md"
        write_completed_ledger(match_ledger, crosscheck_requirements)
        must("validating the matching completed ledger for the crosscheck case", interview_validate(work, "ledger", match_ledger))
        match_refused = refuse("attaching a completed ledger naming the same requirements path already pinned",
                                fsd(work, "attach", str(state_path), "interview", str(match_ledger)), reason="does not belong")
        match_message = match_refused.stderr
        kept_crosscheck_run = read_json(state_path)["stages"]["interview"].get("run")
        if not kept_crosscheck_run:
            failures.append("interview's own kept run was not on record before the match case ran; this case proves nothing")
        if "unlinked for the rest of this run" in match_message or "invoke the next stage directly" in match_message:
            failures.append(f"a completed ledger naming the same requirements path already pinned wrongly claimed interview goes unlinked, though interview already has a kept, live link at {kept_crosscheck_run}: {match_message!r}")
        if f"stays linked to the run already kept at {kept_crosscheck_run}" not in match_message:
            failures.append(f"a completed ledger naming the same requirements path already pinned did not get the stays-linked sentence naming interview's own kept run: {match_message!r}")

        mismatch_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-attachterm-crosscheck-mismatch"
        mismatch_dir.mkdir(parents=True)
        mismatch_own_ledger = mismatch_dir / "ledger.md"
        different_requirements = work / "req-attachterm-crosscheck-different.md"
        write_completed_ledger(mismatch_own_ledger, different_requirements)
        must("validating the mismatching completed ledger for the crosscheck case", interview_validate(work, "ledger", mismatch_own_ledger))
        crosscheck_mismatch_refused = refuse("attaching a completed ledger naming a different requirements path than the one already pinned",
                                              fsd(work, "attach", str(state_path), "interview", str(mismatch_own_ledger)), reason="does not belong")
        crosscheck_mismatch_message = crosscheck_mismatch_refused.stderr
        if "unlinked for the rest of this run" in crosscheck_mismatch_message or "invoke the next stage directly" in crosscheck_mismatch_message:
            failures.append(f"a completed ledger naming a different requirements path than the one already pinned wrongly carried the consequence-and-way-forward sentence: {crosscheck_mismatch_message!r}")
        if f"stays linked to the run already kept at {kept_crosscheck_run}" in crosscheck_mismatch_message:
            failures.append(f"a completed ledger naming a different requirements path than the one already pinned wrongly earned the stays-linked sentence the match case above already earns for the identical document, though this one names a different requirements path entirely: {crosscheck_mismatch_message!r}")

        # Finding 1 (blocking, corrected on round 4): a ralplan run started from a subdirectory of the repository, with `--input` and `--plan` given relative to that subdirectory's own cwd, driven straight to a completed receipt without ever being attached while it was still live -- so `stages.ralplan.resolved_reference` is still null when this call is made, and the completed receipt's own surviving `plan.path` is the bare subdirectory-relative spelling `ralplan start` was given, with no `working_directory` left in the compacted shape to resolve it against. `_resolved_reference_for_attach` returns `None` for this candidate, since the live field it needs is already gone, so the old fallback joined that raw relative path onto this flow's own worktree root instead of the subdirectory it was actually typed relative to, and named the wrong, nonexistent file with full confidence. Mutation proof: reverting the trustworthiness gate in `_attach_refusal_follow_up` back to trusting any non-empty raw value turns this assertion RED, naming a path under `work` this fixture never wrote.
        ralplan_run_root_sub = work / ".agents" / "kein" / "runs" / "ralplan"
        sub = work / "sub-attachterm"
        sub.mkdir()
        sub_requirements = sub / "req-attachterm-sub.md"
        write_requirements(sub_requirements, "Approved")
        sub_plan = sub / "plan-attachterm-sub.md"
        write_plan(sub_plan, "Draft", "first cut", "v0")
        sub_ralplan_dest = ralplan_run_root_sub / "260101-000000-attachterm-sub" / "state.json"
        relative_sub_input = os.path.relpath(sub_requirements, sub)
        relative_sub_plan = os.path.relpath(sub_plan, sub)
        must("starting the subdirectory ralplan run for the pathless-fallback case",
             ralplan(sub, "start", str(sub_ralplan_dest), "--input", relative_sub_input, "--plan", relative_sub_plan, "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        must("opening the subdirectory ralplan run's round 1", ralplan(sub, "open", str(sub_ralplan_dest)))
        write_plan(sub_plan, "Approved", "good", "v0")
        must("approving the subdirectory ralplan run's round 1", ralplan(sub, "approve", str(sub_ralplan_dest)))
        must("completing the subdirectory ralplan run, never attached while it was live", ralplan(sub, "complete", str(sub_ralplan_dest)))
        completed_sub = read_json(sub_ralplan_dest)
        if completed_sub.get("plan", {}).get("path") != relative_sub_plan:
            failures.append(f"the subdirectory-completed-ralplan fixture did not preserve the bare relative plan.path this case needs; this case proves nothing: {completed_sub.get('plan')}")
        if (work / relative_sub_plan).exists():
            failures.append(f"joining the bare relative plan.path onto this flow's own worktree root coincidentally resolves to a real file, so this fixture cannot prove the wrong-root join is untrustworthy: {work / relative_sub_plan}")

        sub_refused = refuse("attaching a completed ralplan receipt started from a subdirectory, never attached while live",
                              fsd(work, "attach", str(state_path), "ralplan", str(sub_ralplan_dest)), reason="does not belong")
        sub_message = sub_refused.stderr
        if "unlinked for the rest of this run" not in sub_message:
            failures.append(f"the subdirectory-completed-ralplan refusal did not name the consequence -- the stage staying unlinked for the rest of this run: {sub_message!r}")
        if "invoke the next stage directly with the document this run produced, not this run's own path" not in sub_message:
            failures.append(f"the subdirectory-completed-ralplan refusal did not fall back to the pathless prose, though its own surviving plan.path cannot be trusted without the working_directory compaction dropped: {sub_message!r}")
        if str(work / relative_sub_plan) in sub_message:
            failures.append(f"the subdirectory-completed-ralplan refusal confidently named a path built by joining the bare relative plan.path onto this flow's own worktree root, which is not where that file lives: {sub_message!r}")

        # Finding 5: `_terminal_candidate_document`'s ralplan branch -- the completed receipt's own surviving `plan.path` -- is otherwise exercised only by the subdirectory pathless-fallback case just above, which never actually reads the field's value, only that it fails to resolve trustworthily. A genuine match needs a completed ralplan receipt whose own `plan.path` a lead really could invoke: started with an absolute `--plan`, driven to completed without ever being attached while live (so `stages.ralplan.run` is still null, the same precondition the subdirectory case establishes), and never attached against this same `state_path` before now (ralplan's own kept `run` has been null for `state_path` throughout this whole section -- every earlier ralplan attach against it was a `refuse`, never a `must`). `_resolved_reference_for_attach` still returns `None` for it (the completed shape has already dropped `working_directory`, the field that function needs), so the refusal has to fall back to `_terminal_candidate_document` alone, and this fixture's own plan file is never deleted, so the trustworthiness check (finding 4) clears it too. Mutation proof: replacing `_terminal_candidate_document`'s ralplan branch with `return None` turns this assertion RED, since the refusal would then fall back to the pathless prose instead of naming the plan this ralplan run actually completed against.
        genuine_ralplan_requirements = work / "req-attachterm-ralplan-genuine.md"
        write_requirements(genuine_ralplan_requirements, "Approved")
        genuine_ralplan_plan = work / "plan-attachterm-ralplan-genuine.md"
        write_plan(genuine_ralplan_plan, "Draft", "first cut", "v0")
        genuine_ralplan_dest = work / ".agents" / "kein" / "runs" / "ralplan" / "260101-000000-attachterm-ralplan-genuine" / "state.json"
        must("starting the genuine completed ralplan run for the named-document case",
             ralplan(work, "start", str(genuine_ralplan_dest), "--input", str(genuine_ralplan_requirements), "--plan", str(genuine_ralplan_plan), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        must("opening the genuine completed ralplan run's round 1", ralplan(work, "open", str(genuine_ralplan_dest)))
        write_plan(genuine_ralplan_plan, "Approved", "good", "v0")
        must("approving the genuine completed ralplan run's round 1", ralplan(work, "approve", str(genuine_ralplan_dest)))
        must("completing the genuine completed ralplan run, never attached while it was live", ralplan(work, "complete", str(genuine_ralplan_dest)))
        completed_genuine = read_json(genuine_ralplan_dest)
        if completed_genuine.get("plan", {}).get("path") != str(genuine_ralplan_plan):
            failures.append(f"the genuine-completed-ralplan fixture did not preserve the absolute plan.path this case needs; this case proves nothing: {completed_genuine.get('plan')}")
        if not genuine_ralplan_plan.is_file():
            failures.append(f"the genuine-completed-ralplan fixture's own plan file went missing; this case proves nothing: {genuine_ralplan_plan}")

        genuine_refused = refuse("attaching a genuine completed ralplan receipt, never attached while live",
                                  fsd(work, "attach", str(state_path), "ralplan", str(genuine_ralplan_dest)), reason="does not belong")
        genuine_message = genuine_refused.stderr
        expected_genuine_document = str(genuine_ralplan_plan.resolve())
        if f"invoke the next stage directly with {expected_genuine_document}, the document this run produced" not in genuine_message:
            failures.append(f"the genuine completed ralplan refusal did not name its own surviving plan.path as the document: {genuine_message!r}")

        # Finding 3: a deliberately skipped stage's own attach refusal has to name the skip itself, not the terminal-candidate follow-up sentence a candidate that merely looks like a completed match would otherwise earn -- the skipped check has to run before `_candidate_belongs` ever gets a chance to call `_candidate_terminal_but_matches`. A skipped stage's own `resolved_reference` is always null, since it was never linked at all, so a genuinely completed, in-worktree ledger reads as a `_candidate_terminal_but_matches` yes regardless of the stage's own status unless the skipped check pre-empts it -- this needs a fresh worktree of its own, since fsd itself allows only one nonterminal run per worktree and `state_path`'s own flow above never reaches a terminal lifecycle within this section. Mutation proof: moving the skipped check back below the belonging-refusal block in `attach` turns this assertion RED, since the completed ledger below is genuinely inside this flow's own worktree with no `resolved_reference` pinned yet, so `_candidate_terminal_but_matches` reads it as a match and `_attach_refusal_follow_up` fires.
        skipped_work = (tmp / "repo-skipped").resolve()
        init_repo(skipped_work)
        skipped_fsd_run_root = skipped_work / ".agents" / "kein" / "runs" / "fsd"
        skipped_plan_path = skipped_work / "plan-attachterm-skipped.md"
        write_plan(skipped_plan_path, "Draft")
        skipped_result = must("starting the skipped-interview-stage case",
                              fsd(skipped_work, "start", "--run-root", str(skipped_fsd_run_root), "--slug", "attachtermskip", "--input", str(skipped_plan_path), "--worktree", str(skipped_work)))
        skipped_state_path = require_path(skipped_result)
        skipped_state = read_json(skipped_state_path)
        if skipped_state["entry"] != "ralplan" or skipped_state["stages"]["interview"]["status"] != "skipped":
            failures.append(f"the skipped-interview fixture did not skip interview; this case proves nothing: entry {skipped_state['entry']!r}, interview {skipped_state['stages']['interview']}")

        skipped_interview_dir = skipped_work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-attachtermskip"
        skipped_interview_dir.mkdir(parents=True)
        skipped_ledger = skipped_interview_dir / "ledger.md"
        write_completed_ledger(skipped_ledger, skipped_work / "req-attachtermskip.md")
        must("validating the completed ledger offered to a deliberately skipped interview stage", interview_validate(skipped_work, "ledger", skipped_ledger))
        skipped_refused = refuse("attaching a completed ledger to a deliberately skipped interview stage",
                                  fsd(skipped_work, "attach", str(skipped_state_path), "interview", str(skipped_ledger)), reason="interview is skipped for this run")
        skipped_message = skipped_refused.stderr
        if "unlinked for the rest of this run" in skipped_message or "invoke the next stage directly" in skipped_message:
            failures.append(f"a skipped stage's attach refusal wrongly carried the terminal-candidate follow-up sentence instead of naming the skip itself: {skipped_message!r}")

# ---------------------------------------------------------------------------
# Occupant: `_execute_occupant_block` prints the facts decision-policy.md's occupying-execute-run rule judges a foreign occupant on -- run id, start, last checkpoint, phase, and task statuses -- before its abort command, so a lead has more than the occupant's bare path and lifecycle to tell "mine, stale" from "someone else's, live" (issue 4's diagnosis half: the message used to print neither, framing the whole thing as "decisions for whoever owns that occupant"). A readable occupant prints every fact; a fact this cannot read is left out of the block entirely rather than guessed, and the block still fires, over a genuinely foreign occupant (a brief-kind execute run with no plan at all, so `_execute_candidate_matches` refuses it outright: a `None` reference from `_execute_candidate_reference` never compares equal to anything), a hand-authored one that never went through `execute start` (a run id with no YYMMDD-HHMMSS prefix to parse, a payload with no `phase` or `tasks` key at all -- the minimal shape `find_occupying_run` itself needs to discover an occupant, `lifecycle` and `worktree.root`, and nothing past it), and a hand-authored one whose `phase` and `tasks` are present but empty rather than missing (an empty string, an empty list) -- the shape that tells a guard relaxed to a bare `is None`/`return` from the correct type-and-nonempty check apart from one that still reads `None` either way. The readable occupant's own run id is renamed onto a `YYMMDD-HHMMSS` prefix three days back, and its own last checkpoint separately aged two days back with `os.utime`, both before `gap` ever reads it, and the assertions below check the printed start and last-checkpoint against those two exact stamps rather than against a window or against each other: aging only the file's mtime, as an earlier round of this section did, never touches the run id `_execute_occupant_started_at` actually parses, so `started` and "now" stayed the same fixture instant regardless of the mtime move, and a reader that ignored `run_id` entirely and returned `datetime.now()` passed unnoticed; renaming the directory is what a reader has to actually consult the run id for, and aging the checkpoint to a different day than the renamed start is what stops a reader that swapped one source for the other -- mtime for started, the run id's prefix for last checkpoint -- from landing on the right value by accident. `os.utime` also takes atime and mtime as separate values here rather than the same instant twice, so a reader of `st_atime` (which `os.utime` would otherwise always agree with `st_mtime` on, and which a `noatime` mount may never advance past creation) prints the wrong stamp rather than passing by coincidence. Required cases: every fact fires on a readable occupant, before the abort command, with last checkpoint matching its aged mtime exactly and start matching its renamed run id's own prefix, and the accepted count read as `== "accepted"` and not as any other predicate over the same payload (two accepted against one pending and one implementing is the smallest distribution where every other reading prints a different count); a malformed run id and a missing phase or tasks key are each left out on their own rather than guessed, with the block still firing and every other fact still present; an empty phase and an empty tasks list are each left out the same way, rather than printed as `phase ` or `tasks 0/0 accepted`; the block names where git log and git status settle what the facts cannot, right after the fact list; the parked branch names the closeout step in full.

def _occupant_facts_list(action):
    """The occupant block's own comma-joined fact list, pulled out by the separators `_execute_occupant_block` itself writes around it -- `"), "` opening and `"; these facts identify the run and say how far it got"` closing -- rather than by any bare substring or an ordering-dependent regex on the fact text itself, so a reword of the surrounding prose or a reordering of the facts cannot turn this extraction into a false match the way `"started " in action` or `re.search(r"started (\\S+?)[,;]", action)` each could. `None` when the block's own wrapping prose is not present at all."""
    match = re.search(r"\), (.*?); these facts identify the run and say how far it got", action)
    return match.group(1).split(", ") if match else None


def _section_occupant_facts():
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        work = (tmp / "repo").resolve()
        init_repo(work)
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"

        # A foreign occupant: a brief-kind execute run against no plan at all, so it can never strictly belong to any plan-driven fsd flow. Its own phase is moved off the `start`-opened `initializing` so the phase assertion below cannot pass merely because `initializing` happens to be both the fixture's starting phase and a plausible guess. Four tasks, hand-written directly onto the occupant's own file on disk (bypassing execute's own checkpoint validation entirely, the same way scenario 32 hand-corrupts a live occupant's `input.reference`): two `accepted`, one left at its opening `pending`, and one moved to `implementing`. The counts are what make the assertion discriminate, and they have to differ from each other in both directions: two statuses alone (`accepted`, `pending`) cannot tell `status == "accepted"` apart from a looser `status != "pending"`, and one task of each status cannot tell it apart from `== "pending"` or `== "implementing"` either, since every such reading would print the same count. Two accepted against one of each of the others is the smallest distribution where the correct guard prints `2/4` and every other predicate over this payload prints something else.
        occupant_state = execute_start(work, execute_run_root, "occupant-readable",
                                        [execute_task("task-001", ["README.md"]), execute_task("task-002", ["OTHER.md"]), execute_task("task-003", ["THIRD.md"]), execute_task("task-004", ["FOURTH.md"])])
        must("moving the readable occupant to its task phase", execute_checkpoint(work, occupant_state, lambda s: s.update({"phase": "task"})))
        occupant_payload = read_json(occupant_state)
        occupant_payload["tasks"][0]["status"] = "accepted"
        occupant_payload["tasks"][1]["status"] = "accepted"
        occupant_payload["tasks"][3]["status"] = "implementing"
        write(occupant_state, occupant_payload)

        # Renamed onto a run id whose own `YYMMDD-HHMMSS` prefix reads three days back, before `gap` ever reads it: `_execute_occupant_started_at` parses that prefix straight off the directory name, never off the file's own mtime, so this is the one move that actually shifts what it reads. Aging only the file's mtime, as an earlier round of this section did, never touches the run id at all -- `started` and "now" stayed the same fixture instant regardless, which is what let a reader that ignored `run_id` entirely and returned `datetime.now()` (or a fixed offset from it) pass unnoticed. The last checkpoint is aged separately, two days back rather than three, so the two facts land on different days and a reader that swapped one source for the other -- mtime for started, the run id's own prefix for last checkpoint -- prints a value that matches neither assertion rather than passing by coincidence.
        now = datetime.now().astimezone().replace(microsecond=0)
        aged_start = now - timedelta(days=3)
        aged_checkpoint = now - timedelta(days=2)
        old_occupant_dir = occupant_state.parent
        slug_suffix = old_occupant_dir.name.split("-", 2)[2]
        renamed_occupant_dir = old_occupant_dir.parent / f"{aged_start.strftime('%y%m%d-%H%M%S')}-{slug_suffix}"
        old_occupant_dir.rename(renamed_occupant_dir)
        occupant_state = renamed_occupant_dir / "state.json"
        occupant_run_id = renamed_occupant_dir.name

        # `os.utime` takes atime and mtime as two separate values rather than the same instant twice: giving atime the untouched "now" and mtime the aged checkpoint stamp is what stops a reader of `st_atime` -- which `os.utime` would otherwise always leave agreeing with `st_mtime`, and which a `noatime` mount may never advance past creation -- from passing by coincidence.
        aged_checkpoint_ts = aged_checkpoint.timestamp()
        os.utime(occupant_state, (now.timestamp(), aged_checkpoint_ts))
        expected_last_checkpoint = aged_checkpoint.isoformat(timespec="seconds")

        # A separate fsd flow, entered directly at execute over a plan the occupant does not execute, its own execute stage left `pending`: `enter` refuses outright over a non-belonging occupant (see `enter`'s own docstring), so the entry-stage gap row is where `_execute_occupant_block` fires without ever calling it.
        plan_path = work / "plan-occupant-readable.md"
        write_plan(plan_path, "Approved")
        result = must("starting the occupant-readable fsd case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "occreadable", "--input", str(plan_path), "--worktree", str(work)))
        state_path = require_path(result)
        if read_json(state_path)["entry"] != "execute":
            failures.append("the occupant-readable fixture did not enter directly at execute; this case proves nothing")

        gap_payload = json.loads(must("gap over the occupant-readable fsd case", fsd(work, "gap", str(state_path))).stdout)
        action = gap_payload.get("action", "")
        if not gap_payload["gap"] or gap_payload["next"] != "execute":
            failures.append(f"gap did not report the entry-stage row while blocked on a foreign occupant: {gap_payload}")
        if "occupies the worktree" not in action or "python3 -c" not in action:
            failures.append(f"gap's action did not read as the occupant block at all: {action!r}")

        facts = _occupant_facts_list(action)
        if facts is None:
            failures.append(f"the occupant block's own fact list could not be found between its wrapping prose: {action!r}")
        else:
            # `occupant_run_id`'s own YYMMDD-HHMMSS prefix, parsed by slicing rather than by the regex-and-strptime read `_execute_occupant_started_at` itself applies, so this assertion cannot share a bug with the implementation it checks.
            prefix = occupant_run_id[:13]
            expected_started = f"20{prefix[0:2]}-{prefix[2:4]}-{prefix[4:6]}T{prefix[7:9]}:{prefix[9:11]}:{prefix[11:13]}"
            expected_facts = [
                f"run id {occupant_run_id}",
                f"started {expected_started} (the run id's own local wall clock)",
                f"last checkpoint {expected_last_checkpoint}",
                "phase task",
                "tasks 2/4 accepted",
            ]
            if facts != expected_facts:
                failures.append(f"the readable occupant's facts did not read as expected, in order: got {facts!r}, expected {expected_facts!r}")

        # Finding 3: right after the fact list, before the "it is not this flow's own run" prose, the block has to say that these facts do not settle whether the occupant's work is committed and pushed, and name git log and git status as where that reads from -- decision-policy.md's own occupying-execute-run rule carries that sentence, and this message is the only text guaranteed in front of the lead at the moment the row fires.
        facts_end = action.find("; these facts identify the run and say how far it got")
        git_pointer_index = action.find("git log")
        not_this_flow_index = action.find("It is not this flow's own run")
        if facts_end == -1 or git_pointer_index == -1 or not_this_flow_index == -1:
            failures.append(f"the occupant block did not point at git log and git status for whether the run's work is committed and pushed: {action!r}")
        elif not (facts_end < git_pointer_index < not_this_flow_index):
            failures.append(f"the git log/git status pointer did not sit right after the fact list and before the rest of the message: {action!r}")
        if "git status" not in action:
            failures.append(f"the occupant block named git log but not git status for whether the run's work is committed and pushed: {action!r}")

        if "with --parks 'whole run', then run ocs state fsd closeout <state>." not in action:
            failures.append(f"the occupant block's parked branch did not name the closeout step decision-policy.md continues with: {action!r}")

        abort_index = action.find("python3 -c")
        for label in (f"run id {occupant_run_id}", "started ", "last checkpoint ", "phase task", "tasks 2/4 accepted"):
            fact_index = action.find(label)
            if fact_index == -1 or fact_index > abort_index:
                failures.append(f"the occupant block did not print {label!r} before its abort command: {action!r}")

        # A second, separate worktree for the partial-occupant half below, rather than reusing `work`: the first occupant above is still `active` (this section never aborts it -- there is no `execute abort` builder, and doing it by hand would only be proving this same block against a run this section already exercised), and `find_occupying_run` would otherwise keep finding it ahead of the hand-authored one this half needs to be the sole occupant of its own worktree.
        work_partial = (tmp / "repo-partial").resolve()
        init_repo(work_partial)
        execute_run_root_partial = work_partial / ".agents" / "kein" / "runs" / "execute"
        fsd_run_root_partial = work_partial / ".agents" / "kein" / "runs" / "fsd"

        # A hand-authored occupant, never run through `execute start` at all: its own directory name carries no YYMMDD-HHMMSS prefix for `_execute_occupant_started_at` to parse, and its payload carries no `phase` or `tasks` key at all -- nothing past the two fields `find_occupying_run` itself needs to discover it (`lifecycle`, `worktree.root`). This exercises only the missing-key branch of each guard: `payload.get(...)` reads `None` here regardless of how strict the guard around it is, so it cannot by itself tell a correct guard apart from one relaxed to a bare `is None`/`return` -- the empty-but-present occupant below closes that gap. Mutation proof: reverting `_execute_occupant_phase`, `_execute_occupant_started_at`, or `_execute_occupant_tasks` to return a placeholder instead of `None` on their own failure turns the matching assertion below RED; reverting `_execute_occupant_last_checkpoint` to `datetime.now()` instead of its own mtime read turns the readable occupant's exact-facts assertion above RED, since the printed value would then land two days off the aged checkpoint stamp; reverting `_execute_occupant_started_at` to `datetime.now()` (or any fixed offset from it) instead of parsing the run id's own prefix turns that same assertion RED, since the printed value would then land three days off the renamed run id's own prefix; reverting `_execute_occupant_block` to drop `_execute_occupant_facts` from its message entirely turns every assertion in this section RED, including this one's `run id` and `last checkpoint` checks.
        occupant_dir = execute_run_root_partial / "hand-authored-occupant"
        occupant_dir.mkdir(parents=True)
        occupant_state_partial = occupant_dir / "state.json"
        write(occupant_state_partial, {"lifecycle": "active", "worktree": {"root": str(work_partial)}})

        plan_path_partial = work_partial / "plan-occupant-partial.md"
        write_plan(plan_path_partial, "Approved")
        result_partial = must("starting the occupant-partial fsd case", fsd(work_partial, "start", "--run-root", str(fsd_run_root_partial), "--slug", "occpartial", "--input", str(plan_path_partial), "--worktree", str(work_partial)))
        state_path_partial = require_path(result_partial)
        if read_json(state_path_partial)["entry"] != "execute":
            failures.append("the occupant-partial fixture did not enter directly at execute; this case proves nothing")

        gap_payload_partial = json.loads(must("gap over the occupant-partial fsd case", fsd(work_partial, "gap", str(state_path_partial))).stdout)
        action_partial = gap_payload_partial.get("action", "")
        if not gap_payload_partial["gap"] or gap_payload_partial["next"] != "execute":
            failures.append(f"gap did not still block on the hand-authored occupant: {gap_payload_partial}")
        if "occupies the worktree" not in action_partial or "python3 -c" not in action_partial:
            failures.append(f"a hand-authored occupant did not still produce the occupant block: {action_partial!r}")

        facts_partial = _occupant_facts_list(action_partial)
        if facts_partial is None:
            failures.append(f"the hand-authored occupant block's own fact list could not be found between its wrapping prose: {action_partial!r}")
        else:
            if facts_partial[0] != "run id hand-authored-occupant":
                failures.append(f"the occupant block did not name the hand-authored occupant's own directory name as its run id: {facts_partial!r}")
            if any(fact.startswith("started ") for fact in facts_partial):
                failures.append(f"the occupant block guessed a start for a run id with no YYMMDD-HHMMSS prefix to parse: {facts_partial!r}")
            if any(fact.startswith("phase ") for fact in facts_partial):
                failures.append(f"the occupant block guessed a phase for a payload that never carried one: {facts_partial!r}")
            if any(fact.startswith("tasks ") for fact in facts_partial):
                failures.append(f"the occupant block guessed task statuses for a payload that never carried a tasks list: {facts_partial!r}")
            if not any(fact.startswith("last checkpoint ") for fact in facts_partial):
                failures.append(f"the occupant block did not name the last checkpoint of a hand-authored file that is, itself, perfectly stat-able: {facts_partial!r}")

        if "with --parks 'whole run', then run ocs state fsd closeout <state>." not in action_partial:
            failures.append(f"the partial occupant block's parked branch did not name the closeout step decision-policy.md continues with: {action_partial!r}")

        # A third, separate worktree: a hand-authored occupant whose `phase` and `tasks` are present, not missing -- an empty string and an empty list. The missing-key occupant above reads `None` for both regardless of how strict the guard around it is, so it cannot tell a correct guard apart from `_execute_occupant_phase`'s string-and-nonempty check relaxed to a bare `return phase`, or `_execute_occupant_tasks`'s list-and-nonempty check relaxed to `is None`: both relaxed forms still read `None` off a missing key and stay green. An empty string and an empty list are each present, so a relaxed guard reads past them where the correct one does not. Mutation proof: relaxing `_execute_occupant_phase` to `return phase` turns the phase assertion below RED, since it would then print `phase ` for this occupant's empty string; relaxing `_execute_occupant_tasks`'s guard to `if tasks is None: return None` turns the tasks assertion below RED, since it would then print `tasks 0/0 accepted` for this occupant's empty list.
        work_partial_empty = (tmp / "repo-partial-empty").resolve()
        init_repo(work_partial_empty)
        execute_run_root_partial_empty = work_partial_empty / ".agents" / "kein" / "runs" / "execute"
        fsd_run_root_partial_empty = work_partial_empty / ".agents" / "kein" / "runs" / "fsd"

        occupant_dir_empty = execute_run_root_partial_empty / "hand-authored-occupant-empty"
        occupant_dir_empty.mkdir(parents=True)
        occupant_state_partial_empty = occupant_dir_empty / "state.json"
        write(occupant_state_partial_empty, {"lifecycle": "active", "worktree": {"root": str(work_partial_empty)}, "phase": "", "tasks": []})

        plan_path_partial_empty = work_partial_empty / "plan-occupant-partial-empty.md"
        write_plan(plan_path_partial_empty, "Approved")
        result_partial_empty = must("starting the occupant-partial-empty fsd case", fsd(work_partial_empty, "start", "--run-root", str(fsd_run_root_partial_empty), "--slug", "occpartialempty", "--input", str(plan_path_partial_empty), "--worktree", str(work_partial_empty)))
        state_path_partial_empty = require_path(result_partial_empty)
        if read_json(state_path_partial_empty)["entry"] != "execute":
            failures.append("the occupant-partial-empty fixture did not enter directly at execute; this case proves nothing")

        gap_payload_partial_empty = json.loads(must("gap over the occupant-partial-empty fsd case", fsd(work_partial_empty, "gap", str(state_path_partial_empty))).stdout)
        action_partial_empty = gap_payload_partial_empty.get("action", "")
        if not gap_payload_partial_empty["gap"] or gap_payload_partial_empty["next"] != "execute":
            failures.append(f"gap did not still block on the empty-typed hand-authored occupant: {gap_payload_partial_empty}")
        if "occupies the worktree" not in action_partial_empty or "python3 -c" not in action_partial_empty:
            failures.append(f"an empty-typed hand-authored occupant did not still produce the occupant block: {action_partial_empty!r}")

        facts_partial_empty = _occupant_facts_list(action_partial_empty)
        if facts_partial_empty is None:
            failures.append(f"the empty-typed occupant block's own fact list could not be found between its wrapping prose: {action_partial_empty!r}")
        else:
            if any(fact.startswith("phase ") for fact in facts_partial_empty):
                failures.append(f"the occupant block printed a phase fact for an empty, present-but-blank phase string: {facts_partial_empty!r}")
            if any(fact.startswith("tasks ") for fact in facts_partial_empty):
                failures.append(f"the occupant block printed a task-status fact for an empty, present-but-blank tasks list: {facts_partial_empty!r}")

        if "with --parks 'whole run', then run ocs state fsd closeout <state>." not in action_partial_empty:
            failures.append(f"the empty-typed occupant block's parked branch did not name the closeout step decision-policy.md continues with: {action_partial_empty!r}")

        # Finding 7: `_execute_occupant_started_at`'s anchoring -- `re.match(r"^(\d{6}-\d{6})-", run_id)` is already anchored at the string's own start, but nothing above proves that anchoring is load-bearing: both negative fixtures so far ("hand-authored-occupant", "hand-authored-occupant-empty") carry no digits in their directory name at all, so an unanchored `re.search` in its place would read `None` from either one too, for the same reason the correct anchored `re.match` does, and that mutation would pass unnoticed. A directory name carrying a `YYMMDD-HHMMSS` stamp after its own start, never at position 0, is what tells the two readings apart: `re.match` still refuses it (nothing at the very start is a stamp), while an unanchored `re.search` would find the embedded stamp and print a guessed start for a run id this flow never wrote as one. Mutation proof: replacing the anchored `re.match` with an unanchored `re.search` over the identical pattern turns this assertion RED, printing a `started ` fact for the directory name below.
        work_partial_unanchored = (tmp / "repo-partial-unanchored").resolve()
        init_repo(work_partial_unanchored)
        execute_run_root_partial_unanchored = work_partial_unanchored / ".agents" / "kein" / "runs" / "execute"
        fsd_run_root_partial_unanchored = work_partial_unanchored / ".agents" / "kein" / "runs" / "fsd"

        occupant_dir_unanchored = execute_run_root_partial_unanchored / "hand-authored-occupant-260101-000000-not-at-start"
        occupant_dir_unanchored.mkdir(parents=True)
        occupant_state_partial_unanchored = occupant_dir_unanchored / "state.json"
        write(occupant_state_partial_unanchored, {"lifecycle": "active", "worktree": {"root": str(work_partial_unanchored)}})

        plan_path_partial_unanchored = work_partial_unanchored / "plan-occupant-partial-unanchored.md"
        write_plan(plan_path_partial_unanchored, "Approved")
        result_partial_unanchored = must("starting the occupant-partial-unanchored fsd case",
                                          fsd(work_partial_unanchored, "start", "--run-root", str(fsd_run_root_partial_unanchored), "--slug", "occpartialunanchored", "--input", str(plan_path_partial_unanchored), "--worktree", str(work_partial_unanchored)))
        state_path_partial_unanchored = require_path(result_partial_unanchored)
        if read_json(state_path_partial_unanchored)["entry"] != "execute":
            failures.append("the occupant-partial-unanchored fixture did not enter directly at execute; this case proves nothing")

        gap_payload_partial_unanchored = json.loads(must("gap over the occupant-partial-unanchored fsd case", fsd(work_partial_unanchored, "gap", str(state_path_partial_unanchored))).stdout)
        action_partial_unanchored = gap_payload_partial_unanchored.get("action", "")
        if not gap_payload_partial_unanchored["gap"] or gap_payload_partial_unanchored["next"] != "execute":
            failures.append(f"gap did not still block on the unanchored-stamp hand-authored occupant: {gap_payload_partial_unanchored}")
        if "occupies the worktree" not in action_partial_unanchored or "python3 -c" not in action_partial_unanchored:
            failures.append(f"an unanchored-stamp hand-authored occupant did not still produce the occupant block: {action_partial_unanchored!r}")

        facts_partial_unanchored = _occupant_facts_list(action_partial_unanchored)
        if facts_partial_unanchored is None:
            failures.append(f"the unanchored-stamp occupant block's own fact list could not be found between its wrapping prose: {action_partial_unanchored!r}")
        elif any(fact.startswith("started ") for fact in facts_partial_unanchored):
            failures.append(f"the occupant block guessed a start from a YYMMDD-HHMMSS stamp that sits after the run id's own start, not at it: {facts_partial_unanchored!r}")

        if "with --parks 'whole run', then run ocs state fsd closeout <state>." not in action_partial_unanchored:
            failures.append(f"the unanchored-stamp occupant block's parked branch did not name the closeout step decision-policy.md continues with: {action_partial_unanchored!r}")

