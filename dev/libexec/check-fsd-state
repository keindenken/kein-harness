# Scenario 19: the resumed-rather-than-created association for a stage with no worktree claim of its own -- ralplan's scan-based branch, which reads its `repository` field rather than execute's claim file.
# A pre-existing, nonterminal ralplan run for this repository is associated directly at `enter`, the same as scenario 6 proved for execute through a different mechanism.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
    pre_existing_plan = work / "plan-preexisting.md"
    write_plan(pre_existing_plan, "Draft", "drafted", "v0")
    pre_existing_dest = ralplan_run_root / "260101-000000-preexisting" / "state.json"
    must("starting the pre-existing ralplan run", ralplan(work, "start", str(pre_existing_dest), "--plan", str(pre_existing_plan), "--summary", "check", "--lanes", "architect@claude,critic@claude"))

    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    approved_requirements = work / "req-preexisting.md"
    write_requirements(approved_requirements, "Approved")
    result = must("starting the ralplan-resumed-run case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "ralplanresumed", "--input", str(approved_requirements), "--worktree", str(work)))
    state_path = require_path(result)
    if read_json(state_path)["entry"] != "ralplan":
        failures.append("the ralplan-resumed-run fixture did not enter at ralplan")
    must("entering ralplan over a pre-existing run", fsd(work, "enter", str(state_path), "ralplan"))
    status_ralplan_resumed = json.loads(fsd(work, "status", str(state_path)).stdout)
