        state_path = require_path(result)
        must("entering execute for the retro-location case", fsd(work, "enter", str(state_path), "execute"))
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "retroloc", [execute_task("task-001", ["README.md"])], plan_path=plan_path)
        must("attaching the retro-location case's execute run while still nonterminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        must("dispatching task-001 for the retro-location case", execute(work, "dispatch", str(execute_state), "task-001"))
        qid = must("recording the parking question for the retro-location case", fsd(work, "question", str(state_path),
            "--stage", "execute", "--question", "q", "--options", "a,b", "--recommended", "a",
            "--why-irreversible", "list item 1", "--parks", "task-001")).stdout.strip()
        must("parking task-001 for the retro-location case", execute(work, "park", str(execute_state), "task-001", "--question", "q", "--ref", qid))
