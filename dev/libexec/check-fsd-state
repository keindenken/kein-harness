# ---------------------------------------------------------------------------
# Scenario 12: the execute aborted-receipt -> closeout gap row, and the blocked-with-no-parked-task, unanswered-whole-run-question -> closeout gap row.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    plan_path = work / "plan-execaborted.md"
    write_plan(plan_path, "Approved")
    result = must("starting the execute-aborted case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "execaborted", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering execute for the execute-aborted case", fsd(work, "enter", str(state_path), "execute"))
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    execute_state = execute_start(work, execute_run_root, "execaborted", [execute_task("task-001", ["README.md"])])
    aborted_source = read_json(execute_state)
    aborted_candidate = {
        "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": aborted_source["run_id"],
        "lifecycle": "aborted", "aborted_at": STAMP,
        "worktree_root": aborted_source["worktree"]["root"], "reason": "the fixture aborts this run outright",
    }
    aborted_path = tmp / "aborted.json"
    write(aborted_path, aborted_candidate)
    must("aborting the execute run", execute(work, "checkpoint", str(execute_state), str(aborted_path)))
    gap_exec_aborted = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if not gap_exec_aborted["gap"] or gap_exec_aborted["next"] != "closeout" or gap_exec_aborted["completed"] != "execute":
        failures.append(f"gap did not report the execute-aborted-receipt -> closeout row: {gap_exec_aborted}")
    # close does not treat an aborted execute run as done: fsd's own completion means the change was actually delivered, which an aborted execute run did not do.
    must("recording an assumption so the retrospective has something to cite", fsd(work, "assume", str(state_path),
         "--stage", "execute", "--decision", "d", "--chosen", "c", "--alternatives", "x", "--reversal-cost", "r", "--where", "w"))
    retro_for_aborted = state_path.parent / "retro.md"
    retro_for_aborted.write_text("A1 covered; nothing else to close over here.\n")
    refuse("closing over an aborted (not completed) execute run", fsd(work, "close", str(state_path), "--retro", str(retro_for_aborted)),
           reason="execute is aborted, not completed")

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    plan_path = work / "plan-wholerun.md"
    write_plan(plan_path, "Approved")
    result = must("starting the whole-run-blocked case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "wholerun", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering execute for the whole-run-blocked case", fsd(work, "enter", str(state_path), "execute"))
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    # A single pending task is neither write-active nor parked, so "no task is write-active" and "no parked task" both hold trivially once the run is checkpointed blocked.
    execute_state = execute_start(work, execute_run_root, "wholerun", [execute_task("task-001", ["README.md"])])
    must("checkpointing to blocked with nothing dispatched", execute_checkpoint(work, execute_state, lambda s: s.update(
        {"lifecycle": "blocked", "phase": "blocked", "next_action": "blocked: a whole-run decision is needed before anything can be dispatched"})))
    must("recording the whole-run question", fsd(work, "question", str(state_path), "--stage", "execute",
         "--question", "which downstream format does the whole change need to target?", "--options", "a,b",
         "--recommended", "a", "--why-irreversible", "list item 2: a public interface downstream consumers read",
         "--parks", "whole run"))
    gap_wholerun = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if not gap_wholerun["gap"] or gap_wholerun["next"] != "closeout" or gap_wholerun["completed"] != "execute":
        failures.append(f"gap did not report the blocked-no-parked-task-whole-run-question -> closeout row: {gap_wholerun}")

# ---------------------------------------------------------------------------
# Scenario 13: the nonterminal-lifecycle short-circuit actually matters.
# A freshly paused run whose underlying blocked-execute evidence would otherwise satisfy the closeout row must still report no gap -- closeout is deliberately left `pending` here (never entered) so the only thing keeping the row from firing is `gap` checking fsd's own lifecycle first.
# Deleting that check would leave this case green for the wrong reason if the row's own evidence were also false; it is not, here.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    plan_path = work / "plan-shortcircuit.md"
    write_plan(plan_path, "Approved")
    result = must("starting the short-circuit case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "shortcircuit", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering execute for the short-circuit case", fsd(work, "enter", str(state_path), "execute"))
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    execute_state = execute_start(work, execute_run_root, "shortcircuit", [execute_task("task-001", ["README.md"])])
    must("dispatching task-001 for the short-circuit case", execute(work, "dispatch", str(execute_state), "task-001"))
    qid = must("recording the parking question for the short-circuit case", fsd(work, "question", str(state_path),
        "--stage", "execute", "--question", "q", "--options", "a,b", "--recommended", "a",
        "--why-irreversible", "list item 1", "--parks", "task-001")).stdout.strip()
    must("parking task-001 for the short-circuit case", execute(work, "park", str(execute_state), "task-001", "--question", "q", "--ref", qid))
    must("checkpointing to blocked for the short-circuit case", execute_checkpoint(work, execute_state, lambda s: s.update(
        {"lifecycle": "blocked", "phase": "blocked", "next_action": f"blocked on {qid}"})))

    gap_before_pause = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if not gap_before_pause["gap"] or gap_before_pause["next"] != "closeout":
        failures.append(f"the fixture's own evidence did not satisfy the closeout row before pausing, so this case proves nothing: {gap_before_pause}")

    # `close` needs no prior `closeout` entry -- it does not itself check `stages.closeout.status` -- so calling it directly leaves `closeout` still `pending` while the run becomes `paused`.
    draft_retro = state_path.parent / "retro-draft.md"
    draft_retro.write_text(f"{qid} pending.\n")
    must("pausing directly without ever entering closeout", fsd(work, "close", str(state_path), "--retro", str(draft_retro)))
    paused = read_json(state_path)
    if paused["lifecycle"] != "paused":
        failures.append(f"the short-circuit fixture did not pause: {paused['lifecycle']}")
    if paused["stages"]["closeout"]["status"] != "pending":
        failures.append("closeout was entered somewhere in this fixture, so it no longer isolates the lifecycle short-circuit")

    gap_after_pause = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_after_pause["gap"]:
        failures.append(f"gap reported true on a paused run whose blocked-execute evidence would satisfy the closeout row: {gap_after_pause}")

# ---------------------------------------------------------------------------
# Scenario 14: a write-active task alongside a parked, unanswered one keeps the blocked-row's "no task is write-active" clause from being vacuous.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    plan_path = work / "plan-writeactive.md"
    write_plan(plan_path, "Approved")
    result = must("starting the write-active case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "writeactive", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering execute for the write-active case", fsd(work, "enter", str(state_path), "execute"))
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    execute_state = execute_start(work, execute_run_root, "writeactive",
        [execute_task("task-a", ["README.md"]), execute_task("task-b", ["src/b.py"])])
    must("dispatching task-a", execute(work, "dispatch", str(execute_state), "task-a"))
    must("verifying task-a, leaving it write-active", execute_checkpoint(work, execute_state, lambda s: by_id(s, "task-a").update(
        {"status": "verifying", "round": 0, "latest_verification": [verification("true", 0)]})))
    qid = must("recording task-b's parking question", fsd(work, "question", str(state_path),
        "--stage", "execute", "--question", "q", "--options", "a,b", "--recommended", "a",
        "--why-irreversible", "list item 1", "--parks", "task-b")).stdout.strip()
    must("parking task-b", execute(work, "park", str(execute_state), "task-b", "--question", "q", "--ref", qid))
    must("checkpointing to blocked while task-a is still write-active", execute_checkpoint(work, execute_state, lambda s: s.update(
        {"lifecycle": "blocked", "phase": "blocked", "next_action": f"blocked on {qid}, though task-a is still being verified"})))

    gap_write_active = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_write_active["gap"]:
        failures.append(f"gap reported true for a blocked run with a write-active task alongside a parked, unanswered one: {gap_write_active}")

# ---------------------------------------------------------------------------
# Scenario 15: the retrospective location is enforced mechanically, not left to the caller's discipline -- `close` refuses a `--retro` path outside `.agents/kein/runs/` while pausing over an unanswered question with execute still nonterminal.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    plan_path = work / "plan-retroloc.md"
    write_plan(plan_path, "Approved")
    result = must("starting the retro-location case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "retroloc", "--input", str(plan_path), "--worktree", str(work)))
    state_path = require_path(result)
    must("entering execute for the retro-location case", fsd(work, "enter", str(state_path), "execute"))
    execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
    execute_state = execute_start(work, execute_run_root, "retroloc", [execute_task("task-001", ["README.md"])])
    must("dispatching task-001 for the retro-location case", execute(work, "dispatch", str(execute_state), "task-001"))
    qid = must("recording the parking question for the retro-location case", fsd(work, "question", str(state_path),
        "--stage", "execute", "--question", "q", "--options", "a,b", "--recommended", "a",
        "--why-irreversible", "list item 1", "--parks", "task-001")).stdout.strip()
    must("parking task-001 for the retro-location case", execute(work, "park", str(execute_state), "task-001", "--question", "q", "--ref", qid))
    must("checkpointing to blocked for the retro-location case", execute_checkpoint(work, execute_state, lambda s: s.update(
        {"lifecycle": "blocked", "phase": "blocked", "next_action": f"blocked on {qid}"})))

    outside_retro = work / "retro-outside.md"
    outside_retro.write_text(f"{qid} pending.\n")
    refuse("pausing with a retrospective outside .agents/kein/runs/ while execute is still blocked",
           fsd(work, "close", str(state_path), "--retro", str(outside_retro)), reason="must be a path under")
    if read_json(state_path)["lifecycle"] != "active":
        failures.append("the refused close still moved the run out of active")

    inside_retro = state_path.parent / "retro-inside.md"
    inside_retro.write_text(f"{qid} pending.\n")
    must("pausing with a retrospective under runs/fsd", fsd(work, "close", str(state_path), "--retro", str(inside_retro)))

# ---------------------------------------------------------------------------
# Scenario 16: the precedence settlement's "execute never started" branch.
# `ralplan` aborts before `execute` is ever entered; a whole-run question is recorded; `close` pauses on it (not "execute is not started, not completed" -- unanswered is checked first); after answer + resume the association fsd keeps for `execute` is untouched (there was never one), only `closeout` resets, and `gap` reads the same interview/ralplan-aborted row again; `close` then reaches `completed` once nothing is unanswered, since `ralplan` aborting first means the flow was never going to reach `execute` at all.

with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    work = (tmp / "repo").resolve()
    init_repo(work)
    fsd_run_root = work / ".agents" / "kein" / "runs" / "fsd"
    approved_requirements = work / "req-neverexec.md"
    write_requirements(approved_requirements, "Approved")
    result = must("starting the execute-never-started case", fsd(work, "start", "--run-root", str(fsd_run_root), "--slug", "neverexec", "--input", str(approved_requirements), "--worktree", str(work)))
    state_path = require_path(result)
    if read_json(state_path)["entry"] != "ralplan":
        failures.append("the execute-never-started fixture did not enter at ralplan")
    must("entering ralplan for the execute-never-started case", fsd(work, "enter", str(state_path), "ralplan"))

    plan_path = work / "plan-neverexec.md"
    write_plan(plan_path, "Draft", "drafted", "v0")
    ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
    ralplan_dest = ralplan_run_root / "260101-000000-neverexec" / "state.json"
    must("starting the ralplan run for the execute-never-started case",
         ralplan(work, "start", str(ralplan_dest), "--plan", str(plan_path), "--summary", "check", "--lanes", "architect@claude,critic@claude"))
    must("aborting the ralplan run", ralplan(work, "abort", str(ralplan_dest), "--reason", "a blocking ground the owner has to rule on"))

    gap_ralplan_aborted = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if not gap_ralplan_aborted["gap"] or gap_ralplan_aborted["next"] != "closeout" or gap_ralplan_aborted["completed"] != "ralplan":
        failures.append(f"gap did not report the ralplan-aborted -> closeout row: {gap_ralplan_aborted}")
    if read_json(state_path)["stages"]["execute"]["status"] != "pending":
        failures.append("execute's stage status moved even though it was never entered")

    must("entering closeout for the execute-never-started case", fsd(work, "closeout", str(state_path)))
    gap_neverexec_closeout_entered = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_neverexec_closeout_entered["gap"]:
        failures.append(f"gap reported true right after closeout was entered in the execute-never-started case: {gap_neverexec_closeout_entered}")
    qid = must("recording the whole-run question before execute ever started", fsd(work, "question", str(state_path),
        "--stage", "closeout", "--question", "does the owner want to retry with different constraints?",
        "--options", "retry,abandon", "--recommended", "retry",
        "--why-irreversible", "the owner's ruling is not something the flow can infer", "--parks", "whole run")).stdout.strip()

    draft_retro = state_path.parent / "retro-draft.md"
    draft_retro.write_text(f"{qid} pending; execute never started.\n")
    must("pausing on the whole-run question with execute never started", fsd(work, "close", str(state_path), "--retro", str(draft_retro)))
    paused = read_json(state_path)
    if paused["lifecycle"] != "paused":
        failures.append(f"close did not pause with execute never started and a question unanswered: {paused['lifecycle']}")

    must("answering the whole-run question", fsd(work, "answer", str(state_path), qid, "--text", "retry"))
    must("resuming with execute never started", fsd(work, "resume", str(state_path)))
    resumed = read_json(state_path)
    if resumed["lifecycle"] != "active":
        failures.append(f"resume did not move the run back to active: {resumed['lifecycle']}")
    if resumed["stages"]["execute"] != {"status": "pending", "snapshot": [], "run": None}:
        failures.append(f"resume touched execute's stage even though its association was absent: {resumed['stages']['execute']}")
    if resumed["stages"]["closeout"]["status"] != "pending":
        failures.append("resume did not reset closeout back to pending")
    if len(resumed["agents_md"]) != 2:
        failures.append("resume did not open a second agents_md span")

    gap_after_resume = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if not gap_after_resume["gap"] or gap_after_resume["next"] != "closeout" or gap_after_resume["completed"] != "ralplan":
        failures.append(f"gap after resume did not read the same ralplan-aborted -> closeout row: {gap_after_resume}")

    must("re-entering closeout after resume", fsd(work, "closeout", str(state_path)))
    gap_neverexec_closeout_reentered = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_neverexec_closeout_reentered["gap"]:
        failures.append(f"gap reported true right after closeout was re-entered in the execute-never-started case: {gap_neverexec_closeout_reentered}")
    final_retro = state_path.parent / "retro-final.md"
    final_retro.write_text(f"{qid} answered retry; execute was never reached.\n")
    must("closing now that nothing is unanswered and execute was never reached", fsd(work, "close", str(state_path), "--retro", str(final_retro)))
    closed = read_json(state_path)
    if closed["lifecycle"] != "completed":
        failures.append(f"close did not complete once ralplan aborted, execute was never reached, and nothing was left unanswered: {closed['lifecycle']}")
    if not closed["retrospective"] or "retros" not in closed["retrospective"]:
        failures.append(f"close did not relocate the retrospective on this completion: {closed['retrospective']}")
    gap_after_completed = json.loads(fsd(work, "gap", str(state_path)).stdout)
    if gap_after_completed["gap"]:
        failures.append(f"gap reported true on a completed run: {gap_after_completed}")

