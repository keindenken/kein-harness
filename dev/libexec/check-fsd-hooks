        assert_pretool_allows("pre-write off-switch marker present allows Write despite a real gap", work, "Write", config_dir=config_dir)

# ---------------------------------------------------------------------------
# Case: post-skill for `kein:interview` (and the bare `interview` form, in a separate fixture) records the interview stage entry from a fresh run whose entry stage is still pending, and the next Stop allows -- the same shape as the ralplan case above, but for the entry stage itself, where the gap row post-skill has to clear is row 1, not row 2.

def _section_postskill_interview_forms():
    for slug, skill_name in (("ps-interview-qualified", "kein:interview"), ("ps-interview-bare", "interview")):
        with tempfile.TemporaryDirectory() as tmp:
            work = (Path(tmp) / "repo").resolve()
            init_repo(work)
            run_root = work / ".agents" / "kein" / "runs" / "fsd"
            state_path = fsd_start(work, run_root, slug, "an idea")

            assert_stop_blocks(f"{slug} before post-skill", work, "invoke /kein:interview")
            assert_postskill_silent(f"{slug} post-skill {skill_name!r}", work, skill_name)

            after = read_json(state_path)
            if after["stages"]["interview"]["status"] != "entered":
                failures.append(f"{slug}: post-skill {skill_name!r} did not record the interview stage entry")

            assert_stop_allows(f"{slug} next stop after post-skill", work)

# ---------------------------------------------------------------------------
# Case: the closeout path end to end. A completed execute receipt (the other half of the closeout row -- row5 above covers the blocked-with-parked-task half) blocks Stop and denies pre-write Write, both naming the same substituted closeout command; entering closeout then clears the gap and both hooks allow.

def _section_closeout_path_end_to_end():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-closeout.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "closeout-path", str(approved_plan))
        must("entering execute for closeout-path", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "closeout-path", [execute_task("task-001", ["README.md"])], plan_path=approved_plan)
        # Attached explicitly while the run is still nonterminal -- the completed receipt this drives toward next is free to leave `input.reference` null, so nothing would otherwise confirm this same run belongs afterward.
        must("attaching closeout-path's execute run while still nonterminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        drive_task_to_acceptance(work, execute_state, "task-001")
        must("entering final_audit for closeout-path", execute_to_final_audit(work, execute_state))
        must("completing execute for closeout-path", execute_complete(work, execute_state, ["task-001"]))

        closeout_action = f"run ocs state fsd closeout {state_path}"
        assert_stop_blocks("closeout-path: execute completed, stop blocks naming closeout", work, closeout_action)
        assert_pretool_denies("closeout-path: execute completed, pre-write denies Write naming closeout", work, closeout_action, "Write")

        must("entering closeout for closeout-path", fsd(work, "closeout", str(state_path)))
        assert_stop_allows("closeout-path: after entering closeout, stop allows", work)
        assert_pretool_allows("closeout-path: after entering closeout, pre-write allows Write", work, "Write")

# ---------------------------------------------------------------------------
# Case: the ordinary interview -> ralplan -> execute path associates every stage's run purely from the post-bash hook watching the real start/validate commands and their own real stdout -- no manual `attach` call anywhere -- and the flow reaches closeout. Also proves, along the way, that a completed ralplan (a receipt with no `input` field left) stays associated once post-bash has pinned it. Both are required cases.

def _section_postbash_ordinary_path_associates_without_attach():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "postbash-ordinary", "an idea")
        must("entering interview", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-postbash-ordinary"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / ".agents" / "kein" / "requirements" / "postbash-ordinary.md"
        requirements_path.parent.mkdir(parents=True)
        write_requirements(requirements_path, "Draft")
        write_active_ledger(ledger, "260101-000000-postbash-ordinary", work, work, requirements_path)

        # `interview/SKILL.md`'s own `<Ledger>` section: `ocs validate interview ledger <path>` runs before relying on an active ledger. Post-bash watches that exact command and attaches from its own argument, since a successful validation prints nothing to stdout.
        assert_postbash_silent("postbash-ordinary: validate interview ledger (active)", work, f"ocs validate interview ledger {ledger}")
        after_validate_active = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after_validate_active["stages"]["interview"]["association"] != "kept" or after_validate_active["stages"]["interview"]["run"] != str(ledger):
            failures.append(f"post-bash did not attach the interview ledger from `ocs validate interview ledger`: {after_validate_active['stages']['interview']}")

        write_requirements(requirements_path, "Approved")
        write_completed_ledger(ledger, requirements_path)
        # The same command runs again before accepting the terminal receipt (`interview/SKILL.md`'s own `<Ledger>` section), now over a ledger that has since completed: the belonging test only ever accepts an active ledger, so this second call is a genuine no-op rather than a re-confirmation -- the kept link set by the first, still-active call above stays exactly where it was, and a kept link is never replaced anyway.
        assert_postbash_silent("postbash-ordinary: validate interview ledger (completed)", work, f"ocs validate interview ledger {ledger}")

        assert_stop_blocks("postbash-ordinary: interview completed, ralplan not yet entered", work, "invoke /kein:ralplan")
        assert_postskill_silent("postbash-ordinary: post-skill kein:ralplan", work, "kein:ralplan")

        plan_path = work / ".agents" / "kein" / "plans" / "postbash-ordinary.md"
        plan_path.parent.mkdir(parents=True)
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_run_root = work / ".agents" / "kein" / "runs" / "ralplan"
        ralplan_result = must("starting the ralplan run for postbash-ordinary",
                              ralplan(work, "start", "--run-root", str(ralplan_run_root), "--slug", "postbash-ordinary",
                                      "--input", str(requirements_path), "--plan", str(plan_path), "--summary", "check",
                                      "--lanes", "architect@claude,critic@claude"))
        ralplan_dest = Path(ralplan_result.stdout.strip())

        # `ralplan start`'s own real stdout -- exactly what a live Bash tool call's `tool_response.stdout` would carry -- fed straight into post-bash.
        assert_postbash_silent("postbash-ordinary: ocs state ralplan start", work,
                                f"ocs state ralplan start --run-root {ralplan_run_root} --slug postbash-ordinary "
                                f"--input {requirements_path} --plan {plan_path} --summary check --lanes architect@claude,critic@claude",
                                stdout=ralplan_result.stdout)
        after_ralplan_start = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after_ralplan_start["stages"]["ralplan"]["association"] != "kept" or after_ralplan_start["stages"]["ralplan"]["run"] != str(ralplan_dest):
            failures.append(f"post-bash did not attach the ralplan run from `ocs state ralplan start`'s own stdout: {after_ralplan_start['stages']['ralplan']}")

        must("opening ralplan round 1", ralplan(work, "open", str(ralplan_dest)))
        write_plan(plan_path, "Approved", "good", "v0")
        must("approving ralplan round 1", ralplan(work, "approve", str(ralplan_dest)))
        must("completing ralplan", ralplan(work, "complete", str(ralplan_dest)))

        after_ralplan_complete = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after_ralplan_complete["stages"]["ralplan"]["association"] != "kept" or after_ralplan_complete["stages"]["ralplan"]["run"] != str(ralplan_dest):
            failures.append(f"the completed ralplan run's association was lost once its receipt compacted: {after_ralplan_complete['stages']['ralplan']}")
        if "input" in read_json(ralplan_dest):
            failures.append("the completed ralplan receipt still carries input; this case does not actually exercise compaction")

        assert_stop_blocks("postbash-ordinary: ralplan completed, execute not yet entered", work, "invoke /kein:execute")
        assert_postskill_silent("postbash-ordinary: post-skill kein:execute", work, "kein:execute")

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        tasks_path = Path(tmp) / "postbash-ordinary-tasks.json"
        tasks_path.write_text(json.dumps([execute_task("task-001", ["README.md"])]))
        execute_result = must("starting the execute run for postbash-ordinary",
                              execute(work, "start", "--run-root", str(execute_run_root), "--slug", "postbash-ordinary",
                                      "--kind", "plan", "--input", str(plan_path), "--worktree", str(work), "--tasks", str(tasks_path)))
        execute_dest = Path(execute_result.stdout.strip())

        assert_postbash_silent("postbash-ordinary: ocs state execute start", work,
                                f"ocs state execute start --run-root {execute_run_root} --slug postbash-ordinary "
                                f"--kind plan --input {plan_path} --worktree {work} --tasks {tasks_path}",
                                stdout=execute_result.stdout)
        after_execute_start = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after_execute_start["stages"]["execute"]["association"] != "kept" or after_execute_start["stages"]["execute"]["run"] != str(execute_dest):
            failures.append(f"post-bash did not attach the execute run from `ocs state execute start`'s own stdout: {after_execute_start['stages']['execute']}")

        drive_task_to_acceptance(work, execute_dest, "task-001")
        must("entering final_audit for postbash-ordinary", execute_to_final_audit(work, execute_dest))
        must("completing execute for postbash-ordinary", execute_complete(work, execute_dest, ["task-001"]))

        closeout_action = f"run ocs state fsd closeout {state_path}"
        assert_stop_blocks("postbash-ordinary: execute completed, stop blocks naming closeout", work, closeout_action)
        must("entering closeout for postbash-ordinary", fsd(work, "closeout", str(state_path)))
        retro_path = state_path.parent / "retro.md"
        retro_path.write_text("# Retrospective\n\nNothing recorded.\n")
        must("closing the ordinary-path run through post-bash associations alone", fsd(work, "close", str(state_path), "--retro", str(retro_path)))
        if read_json(state_path)["lifecycle"] != "completed":
            failures.append("close did not complete the ordinary-path run despite every association coming from post-bash alone")

# ---------------------------------------------------------------------------
# Case: an interview ledger validated by post-bash for the first time only after it has already completed -- never attached while it was active, the way the ordinary path above always does first -- is never linked at all: a completed ledger is terminal, and the belonging test only ever accepts an active one. Required case: attach of any terminal run is refused, interview included, and `attach`'s own explicit call is refused the identical way.

def _section_postbash_interview_completed_never_linked():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "postbash-completed-only", "an idea")
        must("entering interview for postbash-completed-only", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-postbash-completed-only"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / ".agents" / "kein" / "requirements" / "postbash-completed-only.md"
        requirements_path.parent.mkdir(parents=True)
        write_requirements(requirements_path, "Approved")
        # Written straight to its completed shape -- post-bash never sees this ledger while active at all, unlike the ordinary path, which always validates it once active first.
        write_completed_ledger(ledger, requirements_path)

        assert_postbash_silent("postbash-completed-only: validate interview ledger (completed, never seen active)", work, f"ocs validate interview ledger {ledger}")
        after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after["stages"]["interview"]["association"] != "none" or after["stages"]["interview"]["run"] is not None:
            failures.append(f"post-bash attached a completed interview ledger, which is terminal and never belongs: {after['stages']['interview']}")

        refuse("attaching a completed interview ledger explicitly", fsd(work, "attach", str(state_path), "interview", str(ledger)),
               reason="does not belong")

# ---------------------------------------------------------------------------
# Case: post-bash never attaches a run that does not strictly belong -- a plan-kind execute run for a different plan, and a brief-kind execute run with no reference at all -- even though each one's own real `ocs state execute start` command and its own real stdout are fed to it exactly as a live Bash call would produce them. Required case.

def _section_postbash_unrelated_run_never_attached():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-postbash-unrelated.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "postbash-unrelated", str(approved_plan))
        must("entering execute", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"

        other_plan = work / "plan-postbash-other.md"
        write_plan(other_plan, "Approved", "a different plan entirely")
        tasks_path_plan = Path(tmp) / "tasks-plan.json"
        tasks_path_plan.write_text(json.dumps([execute_task("task-x", ["README.md"])]))
        plan_result = must("starting an unrelated plan-kind execute run",
                           execute(work, "start", "--run-root", str(execute_run_root), "--slug", "postbash-unrelated-plan",
                                   "--kind", "plan", "--input", str(other_plan), "--worktree", str(work), "--tasks", str(tasks_path_plan)))
        assert_postbash_silent("postbash-unrelated: ocs state execute start (unrelated plan)", work,
                                f"ocs state execute start --run-root {execute_run_root} --slug postbash-unrelated-plan "
                                f"--kind plan --input {other_plan} --worktree {work} --tasks {tasks_path_plan}",
                                stdout=plan_result.stdout)
        after_plan = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after_plan["stages"]["execute"]["association"] != "none" or after_plan["stages"]["execute"]["run"] is not None:
            failures.append(f"post-bash attached an unrelated plan-kind run for a different plan: {after_plan['stages']['execute']}")

        # The plan-kind run above still holds execute's own per-worktree claim; abort it (execute's own escape hatch, `checkpoint`) so the brief-kind run below can start in the same worktree at all.
        plan_dest = Path(plan_result.stdout.strip())
        plan_source = read_json(plan_dest)
        plan_aborted = {
            "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": plan_source["run_id"],
            "lifecycle": "aborted", "aborted_at": "2026-01-01T00:00:00+09:00",
            "worktree_root": plan_source["worktree"]["root"], "reason": "freeing the worktree claim for the next fixture run",
        }
        plan_aborted_path = Path(tmp) / "postbash-unrelated-plan-aborted.json"
        write(plan_aborted_path, plan_aborted)
        must("aborting the unrelated plan-kind run to free the worktree claim", execute(work, "checkpoint", str(plan_dest), str(plan_aborted_path)))

        tasks_path_brief = Path(tmp) / "tasks-brief.json"
        tasks_path_brief.write_text(json.dumps([execute_task("task-y", ["README.md"])]))
        brief_result = must("starting an unrelated brief-kind execute run",
                            execute(work, "start", "--run-root", str(execute_run_root), "--slug", "postbash-unrelated-brief",
                                    "--kind", "brief", "--summary", "an unrelated brief", "--worktree", str(work), "--tasks", str(tasks_path_brief)))
        assert_postbash_silent("postbash-unrelated: ocs state execute start (brief)", work,
                                f"ocs state execute start --run-root {execute_run_root} --slug postbash-unrelated-brief "
                                f"--kind brief --summary an-unrelated-brief --worktree {work} --tasks {tasks_path_brief}",
                                stdout=brief_result.stdout)
        after_brief = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after_brief["stages"]["execute"]["association"] != "none" or after_brief["stages"]["execute"]["run"] is not None:
            failures.append(f"post-bash attached an unrelated brief-kind run with no reference at all: {after_brief['stages']['execute']}")

# ---------------------------------------------------------------------------
# Case: `_same_plan_reference` resolves each side against its own root, not both against the flow's own worktree -- a ralplan run started in a second repository, against a plan with the identical *relative* filename this flow's own plan happens to have, fed to post-bash from this flow's own session (`CLAUDE_PROJECT_DIR` pinned to the first repository, exactly as a stray or misdirected Bash call would hand it over), must not be attached purely because the filenames coincide.

def _section_postbash_same_relative_name_second_repository_not_attached():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        other = (Path(tmp) / "other-repo").resolve()
        init_repo(other)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"

        write_plan(work / "plan-samename.md", "Draft", "first cut", "v0")
        state_path = fsd_start(work, run_root, "postbash-samename", str(work / "plan-samename.md"))
        if read_json(state_path)["entry"] != "ralplan" or read_json(state_path)["input"]["kind"] != "plan":
            failures.append("postbash-samename: fixture did not enter ralplan over a plan-kind input; this case proves nothing")
        must("entering ralplan for postbash-samename", fsd(work, "enter", str(state_path), "ralplan"))

        # A different repository, holding a *different* file that happens to share the same relative filename.
        write_plan(other / "plan-samename.md", "Draft", "an unrelated plan in a different repository", "v0")
        ralplan_run_root = other / ".agents" / "kein" / "runs" / "ralplan"
        ralplan_result = must("starting a ralplan run in the second repository with the same relative plan filename",
                              ralplan(other, "start", "--run-root", str(ralplan_run_root), "--slug", "postbash-samename",
                                      "--plan", "plan-samename.md", "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        ralplan_dest = Path(ralplan_result.stdout.strip())
        if read_json(ralplan_dest)["plan"]["path"] != "plan-samename.md":
            failures.append("postbash-samename: the second repository's own fixture did not store an unresolved relative plan.path; this case proves nothing")

        assert_postbash_silent("postbash-samename: ocs state ralplan start (second repository, identical relative filename)", work,
                                f"ocs state ralplan start --run-root {ralplan_run_root} --slug postbash-samename "
                                f"--plan plan-samename.md --summary check --lanes architect@claude,critic@claude",
                                stdout=ralplan_result.stdout)
        after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after["stages"]["ralplan"]["association"] != "none" or after["stages"]["ralplan"]["run"] is not None:
            failures.append(f"post-bash attached a second repository's own run purely on an identical relative plan filename: {after['stages']['ralplan']}")

# ---------------------------------------------------------------------------
# Case: post-bash does nothing for a Bash command that is none of the three it watches -- state.json is left byte-for-byte as it read it, not merely "does not block" (which a no-op and a silently-broken match would both satisfy).

def _section_postbash_non_start_command_noop():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-postbash-noop.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "postbash-noop", str(approved_plan))
        must("entering execute", fsd(work, "enter", str(state_path), "execute"))
        before = read_json(state_path)

        # A genuinely matching execute run's own real stdout -- one `ocs state execute start` itself would have printed -- is handed to each non-matching command below too, so an over-broad command match (not merely a blank-stdout one) would actually be caught attaching it.
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        matching_run = execute_start(work, execute_run_root, "postbash-noop", [execute_task("task-001", ["README.md"])], plan_path=approved_plan)

        for command in ("echo hello", "git status", "ocs state execute dispatch state.json task-001", "ocs state ralplan open state.json"):
            assert_postbash_silent(f"postbash-noop: {command!r}", work, command, stdout=str(matching_run))
            after = read_json(state_path)
            if after != before:
                failures.append(f"post-bash changed state.json for a command it should not have matched: {command!r}")

# ---------------------------------------------------------------------------
# Case: an interview ledger path holding a space, quoted the way a real shell call must quote it, still attaches -- post-bash tokenizes the command with `shlex.split`, which un-quotes the argument back to its own literal text (space intact), rather than the old bare `(\S+)` capture that would have stopped at the first space.

def _section_postbash_ledger_path_with_space_attaches():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "postbash-space-ledger", "an idea")
        must("entering interview for postbash-space-ledger", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-with space"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / ".agents" / "kein" / "requirements" / "postbash-space-ledger.md"
        requirements_path.parent.mkdir(parents=True)
        write_requirements(requirements_path, "Draft")
        write_active_ledger(ledger, "260101-000000-with space", work, work, requirements_path)
        if " " not in str(ledger):
            failures.append("postbash-space-ledger: the fixture's own ledger path carries no space; this case proves nothing")

        assert_postbash_silent("postbash-space-ledger: validate interview ledger (quoted path holding a space)", work,
                                f"ocs validate interview ledger {shlex.quote(str(ledger))}")
        after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after["stages"]["interview"]["association"] != "kept" or after["stages"]["interview"]["run"] != str(ledger):
            failures.append(f"post-bash did not attach an interview ledger path holding a space: {after['stages']['interview']}")

# ---------------------------------------------------------------------------
# Case: a chained `ocs state execute start ... && ocs state execute dispatch ...` still attaches from the `start` segment's own destination -- post-bash tokenizes the whole line and splits it on the literal `&&` token `shlex.split` leaves behind, matching each segment against the command prefixes it watches rather than searching the raw text for a lookalike substring, and reads the candidate off the stdout line that actually names an existing state.json rather than unconditionally the chain's last line.

def _section_postbash_chained_start_then_dispatch_attaches():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-postbash-chained.md"
        write_plan(plan_path, "Approved")
        state_path = fsd_start(work, run_root, "postbash-chained", str(plan_path))
        must("entering execute for postbash-chained", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        tasks_path = Path(tmp) / "postbash-chained-tasks.json"
        tasks_path.write_text(json.dumps([execute_task("task-001", ["README.md"])]))
        start_result = must("starting the execute run for postbash-chained",
                            execute(work, "start", "--run-root", str(execute_run_root), "--slug", "postbash-chained",
                                    "--kind", "plan", "--input", str(plan_path), "--worktree", str(work), "--tasks", str(tasks_path)))
        execute_dest = Path(start_result.stdout.strip())

        # `dispatch` is a real, separate CLI call here too -- its own printed stdout is genuinely captured, not assumed -- so the combined stdout below is exactly what one Bash tool call running both chained commands would have captured.
        dispatch_result = must("dispatching task-001 for postbash-chained", execute(work, "dispatch", str(execute_dest), "task-001"))

        chained_command = (
            f"ocs state execute start --run-root {execute_run_root} --slug postbash-chained "
            f"--kind plan --input {plan_path} --worktree {work} --tasks {tasks_path} "
            f"&& ocs state execute dispatch {execute_dest} task-001"
        )
        combined_stdout = start_result.stdout + dispatch_result.stdout

        assert_postbash_silent("postbash-chained: ocs state execute start && ocs state execute dispatch", work,
                                chained_command, stdout=combined_stdout)
        after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after["stages"]["execute"]["association"] != "kept" or after["stages"]["execute"]["run"] != str(execute_dest):
            failures.append(f"post-bash did not attach the execute run from the start segment of a chained command: {after['stages']['execute']}")

# ---------------------------------------------------------------------------
# Case: a `;` glued straight onto the previous word (`cd <work>;` with no space before it, unlike every other case here which always writes `cd <work>; ...`) still separates `cd <work>` from the `ocs state execute start ...` segment that follows -- post-bash tokenizes the command with a punctuation-aware `shlex.shlex` pass rather than a plain `shlex.split`, which would otherwise leave the glued `;` stuck to `<work>` as one token that matches nothing.

def _section_postbash_glued_semicolon_before_start_attaches():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-postbash-glued.md"
        write_plan(plan_path, "Approved")
        state_path = fsd_start(work, run_root, "postbash-glued", str(plan_path))
        must("entering execute for postbash-glued", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        tasks_path = Path(tmp) / "postbash-glued-tasks.json"
        tasks_path.write_text(json.dumps([execute_task("task-001", ["README.md"])]))
        start_result = must("starting the execute run for postbash-glued",
                            execute(work, "start", "--run-root", str(execute_run_root), "--slug", "postbash-glued",
                                    "--kind", "plan", "--input", str(plan_path), "--worktree", str(work), "--tasks", str(tasks_path)))
        execute_dest = Path(start_result.stdout.strip())

        # No space before the `;` -- it sits glued straight onto `{work}`, the way `cd x; command` is ordinarily typed, rather than `{work} ; ocs ...` with a space on both sides.
        glued_command = (
            f"cd {work}; ocs state execute start --run-root {execute_run_root} --slug postbash-glued "
            f"--kind plan --input {plan_path} --worktree {work} --tasks {tasks_path}"
        )
        if f"{work}; ocs" not in glued_command or f"{work} ;" in glued_command:
            failures.append(f"postbash-glued: the fixture's own command does not actually glue ; onto the previous word; this case proves nothing: {glued_command!r}")

        assert_postbash_silent("postbash-glued: cd <work>; ocs state execute start (; glued to the previous word)", work,
                                glued_command, stdout=start_result.stdout)
        after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after["stages"]["execute"]["association"] != "kept" or after["stages"]["execute"]["run"] != str(execute_dest):
            failures.append(f"post-bash did not attach the execute run from a start segment following a ; glued to the previous word: {after['stages']['execute']}")

# ---------------------------------------------------------------------------
# Case: `ocs validate interview ledger <path>` on its own later line -- not the first line of the Bash call, and joined to nothing before it by `&&`/`;`/`|` at all -- still attaches, since post-bash splits the command text on its own literal newlines before tokenizing each line for the commands it watches.

def _section_postbash_newline_separated_validate_attaches():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "postbash-newline", "an idea")
        must("entering interview for postbash-newline", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-postbash-newline"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / ".agents" / "kein" / "requirements" / "postbash-newline.md"
        requirements_path.parent.mkdir(parents=True)
        write_requirements(requirements_path, "Draft")
        write_active_ledger(ledger, "260101-000000-postbash-newline", work, work, requirements_path)

        newline_command = f"echo about to validate the ledger\nocs validate interview ledger {ledger}"
        if "\n" not in newline_command:
            failures.append("postbash-newline: the fixture's own command carries no newline at all; this case proves nothing")

        assert_postbash_silent("postbash-newline: ocs validate interview ledger on a later line, no chaining operator at all", work, newline_command)
        after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after["stages"]["interview"]["association"] != "kept" or after["stages"]["interview"]["run"] != str(ledger):
            failures.append(f"post-bash did not attach the interview ledger validated on a later, newline-separated line: {after['stages']['interview']}")

# ---------------------------------------------------------------------------
# Case: a heredoc whose own body happens to contain text that would otherwise look like a watched command (`ocs state execute start ...`, verbatim) does not attach from that body line -- post-bash skips every line of a heredoc body (`<<'EOF'` through its own terminator) before tokenizing anything, so only the real `ocs state execute start ...` on the line after the heredoc's own terminator is ever considered.

def _section_postbash_heredoc_then_start_attaches():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-postbash-heredoc.md"
        write_plan(plan_path, "Approved")
        state_path = fsd_start(work, run_root, "postbash-heredoc", str(plan_path))
        must("entering execute for postbash-heredoc", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        tasks_path = Path(tmp) / "postbash-heredoc-tasks.json"
        tasks_path.write_text(json.dumps([execute_task("task-001", ["README.md"])]))
        start_result = must("starting the execute run for postbash-heredoc",
                            execute(work, "start", "--run-root", str(execute_run_root), "--slug", "postbash-heredoc",
                                    "--kind", "plan", "--input", str(plan_path), "--worktree", str(work), "--tasks", str(tasks_path)))
        execute_dest = Path(start_result.stdout.strip())

        heredoc_command = (
            "cat <<'EOF'\n"
            "ocs state execute start --run-root fake --slug fake-from-heredoc-body --kind plan --input fake --worktree fake --tasks fake\n"
            "EOF\n"
            f"ocs state execute start --run-root {execute_run_root} --slug postbash-heredoc "
            f"--kind plan --input {plan_path} --worktree {work} --tasks {tasks_path}"
        )

        assert_postbash_silent("postbash-heredoc: heredoc body line looks like a watched command, real start follows on a later line", work,
                                heredoc_command, stdout=start_result.stdout)
        after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after["stages"]["execute"]["association"] != "kept" or after["stages"]["execute"]["run"] != str(execute_dest):
            failures.append(f"post-bash did not attach the real execute run started after a heredoc: {after['stages']['execute']}")

# ---------------------------------------------------------------------------
# Case: a heredoc terminator line that only reduces to the delimiter after stripping surrounding whitespace (an indented `  EOF`) does not end a plain `<<EOF` heredoc -- POSIX requires the terminator line to equal the delimiter exactly, with no leading or trailing whitespace tolerated, unlike `<<-EOF`, which alone strips leading tabs -- so a real `ocs validate interview ledger ...` line sitting between that indented false terminator and the heredoc's own genuine (unindented) one is still inside the body and is never read as a command at all.

def _section_postbash_heredoc_indented_false_terminator_not_attached():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "postbash-heredoc-indented", "an idea")
        must("entering interview for postbash-heredoc-indented", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-postbash-heredoc-indented"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / ".agents" / "kein" / "requirements" / "postbash-heredoc-indented.md"
        requirements_path.parent.mkdir(parents=True)
        write_requirements(requirements_path, "Draft")
        write_active_ledger(ledger, "260101-000000-postbash-heredoc-indented", work, work, requirements_path)

        heredoc_command = (
            "cat > README.md <<EOF\n"
            "Documentation body.\n"
            "  EOF\n"
            f"ocs validate interview ledger {ledger}\n"
            "EOF"
        )

        assert_postbash_silent("postbash-heredoc-indented: an indented line that only reduces to the delimiter under stripping does not terminate <<EOF", work, heredoc_command)
        after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after["stages"]["interview"]["association"] != "none" or after["stages"]["interview"]["run"] is not None:
            failures.append(f"post-bash attached an interview ledger from a line still inside a heredoc body, an indented false terminator making it look like a real command: {after['stages']['interview']}")

# ---------------------------------------------------------------------------
# Case: a paused fsd run allows regardless of the evidence underneath it -- `gap()`'s very first check is the run's own lifecycle, ahead of any stage row.

def _section_paused_lifecycle():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-paused.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "paused-case", str(approved_plan))
        must("entering execute for paused-case", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "paused-case", [execute_task("task-001", ["README.md"])])
        drive_task_to_acceptance(work, execute_state, "task-001")
        must("entering final_audit for paused-case", execute_to_final_audit(work, execute_state))
        must("completing execute for paused-case", execute_complete(work, execute_state, ["task-001"]))
        must("recording a whole-run question for paused-case", fsd(work, "question", str(state_path), "--stage", "closeout",
             "--question", "does this lesson belong in AGENTS.md?", "--options", "yes,no", "--recommended", "yes",
             "--why-irreversible", "an AGENTS.md edit is never taken by the flow itself", "--parks", "whole run"))
        must("entering closeout for paused-case", fsd(work, "closeout", str(state_path)))
        retro = state_path.parent / "retro.md"
        retro.write_text("Q1 pending.\n")
        must("pausing paused-case", fsd(work, "close", str(state_path), "--retro", str(retro)))
        paused_state = read_json(state_path)
        if paused_state["lifecycle"] != "paused":
            failures.append(f"paused-case fixture did not actually pause, so the hook assertions below would be vacuous: lifecycle is {paused_state['lifecycle']!r}")

        assert_stop_allows("paused-case: lifecycle paused allows regardless of the evidence underneath", work)
        assert_pretool_allows("paused-case: lifecycle paused allows Write regardless of the evidence underneath", work, "Write")


# ---------------------------------------------------------------------------
# Section registry and CLI driver -- `--list` prints the section names below in the order they run; `--only <name>[,<name>...]` runs just those sections (plus whatever earlier ones a dependency map names, though every section here is self-contained and needs none); neither flag runs every section in order exactly as running this file always has.

SECTIONS = [
    ("entry-stage-pending", (), _section_entry_stage_pending),
    ("interview-completed-approved", (), _section_interview_completed_approved),
    ("ralplan-completed", (), _section_ralplan_completed),
    ("interview-aborted", (), _section_interview_aborted),
    ("execute-blocked-parked", (), _section_execute_blocked_parked),
    ("unrelated-occupant-execute-entry-no-false-instruction", (), _section_unrelated_occupant_execute_entry_no_false_instruction),
    ("occupant-block-action-runs-as-printed", (), _section_occupant_block_action_runs_as_printed),
    ("occupant-block-action-runs-with-space-in-repository-path", (), _section_occupant_block_action_runs_with_space_in_repository_path),
    ("postskill-ralplan-forms", (), _section_postskill_ralplan_forms),
    ("live-running-stages", (), _section_live_running_stages),
    ("postskill-off-switch", (), _section_postskill_off_switch),
    ("postskill-skipped-stage", (), _section_postskill_skipped_stage),
    ("stop-hook-active-bypass", (), _section_stop_hook_active_bypass),
    ("stop-off-switch", (), _section_stop_off_switch),
    ("no-fsd-run", (), _section_no_fsd_run),
    ("corrupt-state-json", (), _section_corrupt_state_json),
    ("gap-raises-hook-guard", (), _section_gap_raises_hook_guard),
    ("garbage-stdin", (), _section_garbage_stdin),
    ("prewrite-off-switch", (), _section_prewrite_off_switch),
    ("postskill-interview-forms", (), _section_postskill_interview_forms),
    ("closeout-path-end-to-end", (), _section_closeout_path_end_to_end),
    ("postbash-ordinary-path-associates-without-attach", (), _section_postbash_ordinary_path_associates_without_attach),
    ("postbash-interview-completed-never-linked", (), _section_postbash_interview_completed_never_linked),
    ("postbash-unrelated-run-never-attached", (), _section_postbash_unrelated_run_never_attached),
    ("postbash-same-relative-name-second-repository-not-attached", (), _section_postbash_same_relative_name_second_repository_not_attached),
    ("postbash-non-start-command-noop", (), _section_postbash_non_start_command_noop),
    ("postbash-ledger-path-with-space-attaches", (), _section_postbash_ledger_path_with_space_attaches),
    ("postbash-chained-start-then-dispatch-attaches", (), _section_postbash_chained_start_then_dispatch_attaches),
    ("postbash-glued-semicolon-before-start-attaches", (), _section_postbash_glued_semicolon_before_start_attaches),
    ("postbash-newline-separated-validate-attaches", (), _section_postbash_newline_separated_validate_attaches),
    ("postbash-heredoc-then-start-attaches", (), _section_postbash_heredoc_then_start_attaches),
    ("postbash-heredoc-indented-false-terminator-not-attached", (), _section_postbash_heredoc_indented_false_terminator_not_attached),
    ("paused-lifecycle", (), _section_paused_lifecycle),
]
SECTION_NAMES = [name for name, _, _ in SECTIONS]
SECTION_DEPS = {name: deps for name, deps, _ in SECTIONS}
SECTION_FUNCS = {name: func for name, _, func in SECTIONS}
SCRIPT_NAME = "check-fsd-hooks"


def _section_closure(requested):
    # A dependency always appears earlier in `SECTIONS` than whatever names it, so filtering `SECTION_NAMES` down to the requested sections plus their dependencies keeps a valid run order on its own, with no separate topological sort needed.
    needed = set()
    stack = list(requested)
    while stack:
        name = stack.pop()
        if name in needed:
            continue
        needed.add(name)
        stack.extend(SECTION_DEPS[name])
    return [name for name in SECTION_NAMES if name in needed]


def _parse_argv(argv):
    if not argv:
        return None, None
    if argv == ["--list"]:
        return "list", None
    if len(argv) == 2 and argv[0] == "--only":
        return "only", [n.strip() for n in argv[1].split(",") if n.strip()]
    print(f"{SCRIPT_NAME}: usage: {SCRIPT_NAME} [--list | --only <name>[,<name>...]]", file=sys.stderr)
    raise SystemExit(2)


def main():
    mode, names = _parse_argv(sys.argv[1:])

    if mode == "list":
        for name in SECTION_NAMES:
            print(name)
        return

    if mode == "only":
        unknown = [n for n in names if n not in SECTION_DEPS]
        if not names or unknown:
            if unknown:
                print(f"{SCRIPT_NAME}: unknown section(s): {', '.join(unknown)}", file=sys.stderr)
            else:
                print(f"{SCRIPT_NAME}: --only needs at least one section name", file=sys.stderr)
            print(f"{SCRIPT_NAME}: valid sections: {', '.join(SECTION_NAMES)}", file=sys.stderr)
            raise SystemExit(1)
        run_order = _section_closure(names)
    else:
        run_order = list(SECTION_NAMES)

    for name in run_order:
        SECTION_FUNCS[name]()

    if failures:
        for failure in failures:
            print(f"{SCRIPT_NAME}: {failure}", file=sys.stderr)
        raise SystemExit(1)
    if mode == "only":
        print(f"{SCRIPT_NAME}: ran {', '.join(run_order)}")
    else:
        print("check-fsd-hooks: stop blocks on every gap row -- both flavors of the closeout row, execute completed and execute blocked with a parked task -- with the resolved state path substituted into the reason, and allows in every running stage, a freshly entered one, one with a live nonterminal run behind it, and a paused lifecycle regardless of the evidence underneath; unparseable or non-object stdin allows outright rather than falling through to an under-specified payload; pre-write denies only the write tools on a gap and names the same gap action the paired Stop assertion does, and its own off-switch allows a Write despite a real gap; post-skill records both the qualified and bare skill-name forms for both the entry stage and a downstream one, never blocks including through a skipped stage, and its own off-switch leaves state.json untouched; and the pause -> answer -> resume -> post-skill(execute) sequence with the run still blocked allows both hooks")


if __name__ == "__main__":
    main()
