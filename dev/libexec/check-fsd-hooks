#!/usr/bin/env python3
#: Feed fsd's stage-transition hook synthetic Stop/PreToolUse/PostToolUse JSON against fixture states built with the real `ocs state fsd` and `ocs state execute` commands, and fail if any case U4's Acceptance lists stops holding; --list prints its cases and --only <name>[,<name>...] runs just those.
#
# `hook.py` reads a live `fsd` `state.json` and calls `fsd`'s own `gap()`; nothing here re-derives what counts as a gap (`check-fsd-state` already owns that). This check drives real fixtures the way a live run would produce them -- `fsd start`/`enter`, `execute`'s CLI, `ralplan`'s CLI, and a couple of hand-authored ledgers for shapes neither CLI builds -- then pipes synthetic hook stdin into `hook.py` as a subprocess (never by importing it: a hook only ever runs as a subprocess, and its own top-level exception guard is part of what this check has to prove). `CLAUDE_PROJECT_DIR` and `CLAUDE_CONFIG_DIR` are pinned into each subprocess's environment so the check never reads or writes this machine's real `~/.claude`, and every fixture is disposed of with its own `tempfile.TemporaryDirectory()` -- every scratch path this file creates, including `run_hook`'s default config directory and `execute_start`/`execute_checkpoint`'s candidate files, is minted under that same enclosing directory rather than the system temp root, so nothing here leaks. Nothing here weakens a case to make it pass; a failure here means `hook.py` is wrong, not the fixture. Every case below is an independent, self-contained function -- its own fixture, its own worktree -- registered in the `SECTIONS` list near the end of this file, so `--only` never needs a dependency to name.
import json
import os
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(os.environ["KEIN_ROOT"])
FSD = ROOT / "skills" / "fsd" / "scripts" / "state.py"
EXECUTE = ROOT / "skills" / "execute" / "scripts" / "state.py"
RALPLAN = ROOT / "skills" / "ralplan" / "scripts" / "state.py"
HOOK = ROOT / "skills" / "fsd" / "scripts" / "hook.py"
failures = []
STAMP = "2026-01-01T00:00:00+09:00"

REQUIREMENTS_HEADINGS = (
    "## Context", "## Desired outcome", "## Scope", "### In scope", "### Out of scope",
    "## Requirements", "## Constraints", "## Decision boundaries", "## Acceptance criteria",
    "## Decisions and rationale", "## Relevant system evidence", "## Assumptions and risks", "## Deferred items",
)


# ---------------------------------------------------------------------------
# Fixture helpers -- the same shapes `check-fsd-state` builds, kept local rather than shared because neither `dev/libexec/check-*` script imports another.


def _run(script, work, *args):
    return subprocess.run([sys.executable, str(script), *args], cwd=str(work), capture_output=True, text=True)


def fsd(work, *args):
    return _run(FSD, work, *args)


def execute(work, *args):
    return _run(EXECUTE, work, *args)


def ralplan(work, *args):
    return _run(RALPLAN, work, *args)


def git(work, *args):
    subprocess.run(["git", *args], cwd=str(work), check=True, capture_output=True)


def read_json(path):
    return json.loads(Path(path).read_text())


def write(path, payload):
    Path(path).write_text(json.dumps(payload))


def must(label, result):
    if result.returncode != 0:
        failures.append(f"{label} was refused and should not be: {result.stderr.strip()}")
    return result


def refuse(label, result, reason=None):
    if result.returncode == 0:
        failures.append(f"{label} was accepted and must not be")
    elif reason and reason not in result.stderr:
        failures.append(f"{label} was refused for the wrong reason: {result.stderr.strip()}")
    return result


def init_repo(work):
    work.mkdir(parents=True, exist_ok=True)
    git(work, "init", "-q")
    git(work, "config", "user.email", "check@example.invalid")
    git(work, "config", "user.name", "check")
    (work / "AGENTS.md").write_text("# AGENTS\n")
    (work / "README.md").write_text("hello\n")
    git(work, "add", "-A")
    git(work, "commit", "-qm", "first")


def write_requirements(path, status):
    lines = ["# Check requirements", "", f"Status: {status}", "Date: 2026-01-01", ""]
    for heading in REQUIREMENTS_HEADINGS:
        lines += [heading, "", "- item", ""]
    if status == "Draft":
        lines += ["## Blocking gaps", "", "- something unresolved", ""]
    Path(path).write_text("\n".join(lines) + "\n")


def write_plan(path, status, reason="reason", body="body"):
    Path(path).write_text(f"# Check plan\n\nStatus: {status} — {reason}\n\n---\n\n{body}\n")


def write_active_ledger(path, run_id, working_directory, repository, output_path):
    Path(path).write_text(
        "---\n"
        "status: active\n"
        f'run_id: "{run_id}"\n'
        f'working_directory: "{working_directory}"\n'
        f'repository: "{repository}"\n'
        f'output_path: "{output_path}"\n'
        "---\n\n"
        "# Interview Ledger: check\n\n"
        "## Original request\n\nrequest\n\n"
        "## Confirmed decisions\n\n- d\n\n"
        "## Constraints and non-goals\n\n- c\n\n"
        "## Decision boundaries\n\n- b\n\n"
        "## Repository evidence\n\n- e\n\n"
        "## Open questions\n\n- q\n\n"
        "## Explicit deferrals\n\n- f\n"
    )


def write_completed_ledger(path, requirements_path):
    Path(path).write_text(
        "---\n"
        "status: completed\n"
        f'requirements_path: "{requirements_path}"\n'
        f'completed_at: "{STAMP}"\n'
        "---\n"
    )


def write_aborted_ledger(path):
    Path(path).write_text(f'---\nstatus: aborted\naborted_at: "{STAMP}"\nreason: "cancelled"\n---\n')


def execute_task(task_id, scope):
    return {"id": task_id, "title": task_id, "scope": scope, "completion_condition": f"{task_id} done",
            "verification_path": ["true"], "rationale": "fixture"}


def _scratch_dir(work):
    # A temp directory that lives under this case's own enclosing `tempfile.TemporaryDirectory()`, so it is reclaimed automatically when that case's `with` block exits, rather than being minted in the system temp root where nothing ever cleans it up.
    return Path(tempfile.mkdtemp(dir=str(work.parent)))


def execute_start(work, run_root, slug, tasks, worktree=None, plan_path=None):
    # `plan_path`, when given, starts the run against that plan (`--kind plan --input <plan_path>`) instead of the ordinary brief fixture input -- needed wherever a case means the run's own `input.reference` to line up with an fsd run's plan, since a `--kind brief` run's own `null` reference never strictly belongs to a plan-driven flow.
    tasks_path = _scratch_dir(work) / "tasks.json"
    tasks_path.write_text(json.dumps(tasks))
    input_args = ["--kind", "plan", "--input", str(plan_path)] if plan_path is not None else ["--kind", "brief", "--summary", f"check {slug}"]
    result = must(f"starting execute run {slug}",
                  execute(work, "start", "--run-root", str(run_root), "--slug", slug, *input_args,
                          "--worktree", str(worktree or work), "--tasks", str(tasks_path)))
    return Path(result.stdout.strip())


def execute_checkpoint(work, state_path, mutate):
    state = read_json(state_path)
    state["revision"] = "auto"
    state["worktree"]["observed"] = "auto"
    mutate(state)
    candidate_path = _scratch_dir(work) / "candidate.json"
    write(candidate_path, state)
    return execute(work, "checkpoint", str(state_path), str(candidate_path))


def by_id(state, task_id):
    return next(t for t in state["tasks"] if t["id"] == task_id)


def verdict(role, word, task_id, round_number, fingerprint="auto"):
    return {"reviewer_role": role, "verdict": word, "task_id": task_id, "round": round_number,
            "worktree_fingerprint": fingerprint, "reviewed_at": STAMP, "fresh": True, "independent": True}


def verification(command, round_number, fingerprint="auto"):
    return {"command": command, "exit_code": 0, "observed_at": STAMP, "round": round_number, "worktree_fingerprint": fingerprint}


def drive_task_to_acceptance(work, state_path, task_id):
    must(f"dispatching {task_id}", execute(work, "dispatch", str(state_path), task_id))
    must(f"verifying {task_id}", execute_checkpoint(work, state_path, lambda s: by_id(s, task_id).update(
        {"status": "verifying", "round": 0, "latest_verification": [verification("true", 0)]})))
    must(f"reviewing {task_id}", execute_checkpoint(work, state_path, lambda s: by_id(s, task_id).update({"status": "reviewing"})))
    must(f"accepting {task_id}", execute_checkpoint(work, state_path, lambda s: by_id(s, task_id).update(
        {"status": "accepted", "acceptance": {"round": 0, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "PASS", task_id, 0)]}})))


def execute_to_final_audit(work, state_path):
    def mutate(state):
        state["phase"] = "final_audit"
        state["latest_verification"] = [verification("true", state["current_round"])]
        state["final_audit"] = [verdict("code-reviewer", "PASS", "whole-change", state["current_round"])]
    return execute_checkpoint(work, state_path, mutate)


def execute_complete(work, state_path, task_ids):
    state = read_json(state_path)
    receipt = {
        "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": state["run_id"],
        "lifecycle": "completed", "completed_at": STAMP,
        "input": {"reference": state["input"]["reference"], "sha256": state["input"]["sha256"]},
        "worktree": {"root": state["worktree"]["root"], "final_fingerprint": "auto"},
        "accepted_tasks": [{"id": t["id"], "title": t["title"], "completion_condition": t["completion_condition"], "carried_findings": []}
                           for t in state["tasks"] if t["id"] in task_ids],
        "final_verification": state["latest_verification"], "final_audit": state["final_audit"],
        "carried_findings": [],
    }
    candidate_path = _scratch_dir(work) / "receipt.json"
    write(candidate_path, receipt)
    return execute(work, "checkpoint", str(state_path), str(candidate_path))


def fsd_start(work, run_root, slug, input_text):
    result = must(f"starting fsd run {slug}",
                  fsd(work, "start", "--run-root", str(run_root), "--slug", slug, "--input", input_text, "--worktree", str(work)))
    return Path(result.stdout.strip())


# ---------------------------------------------------------------------------
# hook.py invocation -- always a real subprocess, `CLAUDE_PROJECT_DIR` and an isolated `CLAUDE_CONFIG_DIR` pinned so the check never touches this machine's own `~/.claude`. The default config directory is a fixed path under the case's own enclosing temp directory rather than a fresh `mkdtemp()` per call, since a hook only ever reads a file under it (`is_file()` tolerates a directory that was never created) and dozens of assertions share one case.


def _hook_env(work, config_dir):
    env = dict(os.environ)
    env.pop("KEIN_STATE_ROOT", None)
    env["CLAUDE_PROJECT_DIR"] = str(work)
    env["CLAUDE_CONFIG_DIR"] = str(config_dir) if config_dir is not None else str(work.parent / "_hook_config_default")
    return env


def run_hook(work, mode, payload, config_dir=None):
    return subprocess.run([sys.executable, str(HOOK), mode], input=json.dumps(payload),
                           capture_output=True, text=True, cwd=str(work), env=_hook_env(work, config_dir), timeout=30)


def run_hook_raw(work, mode, raw_stdin, config_dir=None):
    # For stdin that is not even meant to parse as the usual JSON payload -- garbage text, or valid JSON that is not an object -- so a case can drive `hook.py` with exactly what a corrupted or unexpected hook invocation would hand it.
    return subprocess.run([sys.executable, str(HOOK), mode], input=raw_stdin,
                           capture_output=True, text=True, cwd=str(work), env=_hook_env(work, config_dir), timeout=30)


def stop_payload(work, stop_hook_active=False):
    return {"hook_event_name": "Stop", "stop_hook_active": stop_hook_active, "session_id": "s",
            "cwd": str(work), "last_assistant_message": "x", "transcript_path": "/tmp/t.jsonl"}


def pretool_payload(work, tool_name, tool_input=None):
    return {"hook_event_name": "PreToolUse", "tool_name": tool_name, "tool_input": tool_input or {},
            "session_id": "s", "cwd": str(work), "tool_use_id": "t1"}


def postskill_payload(work, skill):
    return {"hook_event_name": "PostToolUse", "tool_name": "Skill", "tool_input": {"skill": skill},
            "tool_response": {"commandName": skill, "success": True}, "session_id": "s",
            "cwd": str(work), "tool_use_id": "t1"}


def postbash_payload(work, command, stdout=""):
    # The shape the 2026-09-19 probe measured for a frontmatter `PostToolUse` `Bash` hook: `tool_input.command` carries the exact shell text run, `tool_response.stdout` its captured stdout.
    return {"hook_event_name": "PostToolUse", "tool_name": "Bash", "tool_input": {"command": command},
            "tool_response": {"stdout": stdout, "stderr": ""}, "session_id": "s",
            "cwd": str(work), "tool_use_id": "t1"}


def assert_stop_blocks(label, work, expected_action_substring, config_dir=None, forbidden_substring=None, required_substrings=()):
    result = run_hook(work, "stop", stop_payload(work), config_dir)
    if result.returncode != 0:
        failures.append(f"{label}: stop hook exited {result.returncode} instead of blocking: {result.stderr!r}")
        return
    try:
        out = json.loads(result.stdout)
    except (ValueError, json.JSONDecodeError):
        failures.append(f"{label}: stop hook did not block: stdout={result.stdout!r} stderr={result.stderr!r}")
        return
    if out.get("decision") != "block":
        failures.append(f"{label}: stop hook did not block: {out}")
        return
    reason = out.get("reason", "")
    if not reason.startswith("fsd:"):
        failures.append(f"{label}: stop block reason is missing the 'fsd:' prefix: {reason!r}")
    if expected_action_substring not in reason:
        failures.append(f"{label}: stop block reason did not name the gap action ({expected_action_substring!r} not in {reason!r})")
    if forbidden_substring is not None and forbidden_substring in reason:
        failures.append(f"{label}: stop block reason wrongly carried {forbidden_substring!r}: {reason!r}")
    for required in required_substrings:
        if required not in reason:
            failures.append(f"{label}: stop block reason did not carry {required!r}: {reason!r}")


def assert_stop_allows(label, work, stop_hook_active=False, config_dir=None):
    result = run_hook(work, "stop", stop_payload(work, stop_hook_active=stop_hook_active), config_dir)
    if result.returncode != 0 or result.stdout.strip():
        failures.append(f"{label}: stop hook did not allow: exit={result.returncode} stdout={result.stdout!r} stderr={result.stderr!r}")


def assert_pretool_denies(label, work, expected_action_substring, tool_name="Write"):
    result = run_hook(work, "pre-write", pretool_payload(work, tool_name))
    if result.returncode != 0:
        failures.append(f"{label}: pre-write hook exited {result.returncode} instead of denying: {result.stderr!r}")
        return
    try:
        out = json.loads(result.stdout)
    except (ValueError, json.JSONDecodeError):
        failures.append(f"{label}: pre-write hook did not deny: stdout={result.stdout!r} stderr={result.stderr!r}")
        return
    decision = (out.get("hookSpecificOutput") or {}).get("permissionDecision")
    if decision != "deny":
        failures.append(f"{label}: pre-write hook did not deny: {out}")
    reason = (out.get("hookSpecificOutput") or {}).get("permissionDecisionReason", "")
    if not reason.startswith("fsd:"):
        failures.append(f"{label}: pre-write deny reason is missing the 'fsd:' prefix: {reason!r}")
    if expected_action_substring not in reason:
        failures.append(f"{label}: pre-write deny reason did not name the gap action ({expected_action_substring!r} not in {reason!r}) -- a hardcoded or stripped reason would slip past a bare 'fsd:' check")


def assert_pretool_allows(label, work, tool_name, config_dir=None):
    result = run_hook(work, "pre-write", pretool_payload(work, tool_name), config_dir)
    if result.returncode != 0 or result.stdout.strip():
        failures.append(f"{label}: pre-write hook did not allow {tool_name}: exit={result.returncode} stdout={result.stdout!r} stderr={result.stderr!r}")


def assert_raw_stdin_allows(label, work, mode, raw_stdin, config_dir=None):
    result = run_hook_raw(work, mode, raw_stdin, config_dir)
    if result.returncode != 0 or result.stdout.strip():
        failures.append(f"{label}: {mode} hook did not allow on raw stdin {raw_stdin!r}: exit={result.returncode} stdout={result.stdout!r} stderr={result.stderr!r}")


def assert_postskill_silent(label, work, skill, config_dir=None):
    result = run_hook(work, "post-skill", postskill_payload(work, skill), config_dir)
    if result.returncode != 0 or result.stdout.strip():
        failures.append(f"{label}: post-skill did not allow silently for {skill!r}: exit={result.returncode} stdout={result.stdout!r} stderr={result.stderr!r}")


def assert_postbash_silent(label, work, command, stdout="", config_dir=None):
    result = run_hook(work, "post-bash", postbash_payload(work, command, stdout), config_dir)
    if result.returncode != 0 or result.stdout.strip():
        failures.append(f"{label}: post-bash did not allow silently for {command!r}: exit={result.returncode} stdout={result.stdout!r} stderr={result.stderr!r}")


def _expected_active_no_gap_closing(quoted_state, running_stage):
    """The exact text `_active_no_gap_reason` prints from "Do not end this turn here" on, for `running_stage` genuinely running and `quoted_state` -- `shlex.quote(str(state_path))` -- already resolved, mirroring `hook.py`'s own construction verbatim. Round 7, finding 3: two mutations survived every earlier check on this section -- a prose off-switch offer with no backticks and no literal marker name, and the marker name in a different casing -- because a whitelist of backticked commands or a blacklist of known spellings can only ever catch spellings someone thought to list. Comparing the real reason's closing section against this exact string instead catches any added sentence, dropped clause, or reworded exit by inequality, whatever it says."""
    closeout_step = "" if running_stage == "closeout" else f"`ocs state fsd closeout {quoted_state}`, then "
    return (
        f"Do not end this turn here: keep the running stage moving -- if you are waiting on another lane, check "
        f"it is still alive before anything else. If the run should not continue, bring it to rest on the record "
        f"instead of ending it unresolved -- two exits that share one tail, differing only in whether a question "
        f"is recorded first. To pause it for the user: first record the open question (`ocs state fsd question "
        f"{quoted_state} --stage {running_stage} --question <text> --recommended <text> --why-irreversible <text> "
        f"--parks 'whole run'`), unless a question parking the whole run is already unanswered. To end it "
        f"outright: skip that. Then, either way: {closeout_step}`ocs state fsd close {quoted_state} --retro "
        f"<path>` with the retrospective placed under this run's own directory and citing every assumption, "
        f"question, and lesson id. If close refuses, run `ocs state fsd halt {quoted_state} --reason <text>` "
        f"naming close's own refusal as the reason; if halt itself says close would succeed, fix whatever close's "
        f"own message named and close again. Ending changes only this run's own state: a stage run still live "
        f"underneath it -- execute's own worktree claim, most concretely -- stays active and keeps occupying the "
        f"worktree for the next flow, so prefer pausing while a stage run is genuinely live."
    )


def _expected_active_no_gap_reason(quoted_state, running_stage, next_action, diagnosis_named=None):
    """The full exact `"fsd: ..."` reason text `_active_no_gap_reason` prints, not only its closing section -- `running_stage` and `next_action` already known from the fixture, and `diagnosis_named` the fully-formed `"stage: text"` diagnosis clause with `<state>` already resolved to `quoted_state`, or `None` when the running stage carries no diagnosis at all. Built the same way `_expected_active_no_gap_closing` already is: hand-typed here, never derived from or imported through `hook.py`, so a mutation in `hook.py` cannot move both sides of a comparison together. Round 8, finding 1: comparing only `reason[reason.find("Do not end this turn here"):]` left the leading clause and the diagnosis clause open to a mutation that inserted an extra way out earlier in the string -- a third exit folded into the leading sentence, say -- since nothing compared that span at all. Comparing the whole reason against this whole expected string closes that window; every fixture that already asserts a piece of this reason by substring keeps doing so alongside this equality check, since a substring check and an equality check catch different mutations and neither subsumes the other for the pieces this function does not itself rebuild independently (the substring checks still prove a mutation could not have produced this exact text by coincidence)."""
    leading = (
        f"this run is active and {running_stage} is the stage genuinely running; its next_action is the run's "
        f"last recorded intent, which may already be done: {next_action}."
    )
    diagnosis_clause = ""
    if diagnosis_named is not None:
        diagnosis_clause = (
            f" Diagnosis, explaining why that stage has no run linked yet rather than naming a step to run as "
            f"printed -- it can carry its own unresolved argument template, or name a command another flow's own "
            f"claim would refuse outright while this stage is the one genuinely running: {diagnosis_named}."
        )
    closing = _expected_active_no_gap_closing(quoted_state, running_stage)
    return f"fsd: {leading}{diagnosis_clause} {closing}"


# ---------------------------------------------------------------------------
# Case: entry stage still pending (gap row 1) blocks Stop and denies pre-write Write, naming the same gap action in both reasons; every other tool is allowed on the same gap; entering the stage clears the gap and both hooks allow.

def _section_entry_stage_pending():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "row1", "an idea")
        row1_action = "invoke /kein:interview"

        assert_stop_blocks("row1 entry stage still pending", work, row1_action)
        assert_pretool_denies("row1 pre-write denies Write on the same gap", work, row1_action, "Write")
        assert_pretool_denies("row1 pre-write denies Edit on the same gap", work, row1_action, "Edit")
        assert_pretool_denies("row1 pre-write denies MultiEdit on the same gap", work, row1_action, "MultiEdit")
        assert_pretool_denies("row1 pre-write denies NotebookEdit on the same gap", work, row1_action, "NotebookEdit")
        for other_tool in ("Bash", "Read", "Skill", "Agent"):
            assert_pretool_allows(f"row1 pre-write allows {other_tool} on the same gap", work, other_tool)

        must("entering interview for row1", fsd(work, "enter", str(state_path), "interview"))
        assert_stop_allows("row1 interview entered, running stage, no gap evidence", work)
        assert_pretool_allows("row1 pre-write allows Write once the stage is running", work, "Write")

# ---------------------------------------------------------------------------
# Case: interview completed with an Approved requirements document (gap row 2) blocks Stop naming ralplan.

def _section_interview_completed_approved():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "row2", "an idea")
        must("entering interview for row2", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-row2"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / ".agents" / "kein" / "requirements" / "row2.md"
        requirements_path.parent.mkdir(parents=True)
        write_requirements(requirements_path, "Approved")
        # Attached explicitly while still active, simulating what the post-bash hook does automatically from `ocs validate interview ledger <path>` (proven end to end in the ordinary-path case below): interview's own completed shape drops `output_path` entirely, so nothing would otherwise confirm this same ledger belongs once it completes.
        write_active_ledger(ledger, "260101-000000-row2", work, work, requirements_path)
        must("attaching the interview ledger for row2 while still active", fsd(work, "attach", str(state_path), "interview", str(ledger)))
        write_completed_ledger(ledger, requirements_path)

        assert_stop_blocks("row2 interview completed, requirements Approved", work, "invoke /kein:ralplan")

# ---------------------------------------------------------------------------
# Case: a completed ralplan run (gap row 3) blocks Stop naming execute.

def _section_ralplan_completed():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "row3", "an idea")
        # entry is `interview` for an idea input, so its own row (gap row 1) is checked before ralplan's.
        must("entering interview for row3", fsd(work, "enter", str(state_path), "interview"))

        # This flow's own expected ralplan reference (`_expected_ralplan_reference`) is read off interview's own completed receipt, so ralplan's own attach below has nothing to match against until interview is genuinely linked and completed -- entering ralplan with no ledger evidence at all, the way an earlier fixture here did, clears row 2 (which only fires while ralplan is still pending) but leaves attach with an unknowable expected reference.
        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-row3"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        requirements_path = work / ".agents" / "kein" / "requirements" / "row3.md"
        requirements_path.parent.mkdir(parents=True)
        write_requirements(requirements_path, "Approved")
        write_active_ledger(ledger, "260101-000000-row3", work, work, requirements_path)
        must("attaching the interview ledger for row3 while still active", fsd(work, "attach", str(state_path), "interview", str(ledger)))
        write_completed_ledger(ledger, requirements_path)

        must("entering ralplan for row3", fsd(work, "enter", str(state_path), "ralplan"))

        plan_path = work / ".agents" / "kein" / "plans" / "row3.md"
        plan_path.parent.mkdir(parents=True)
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_dest = work / ".agents" / "kein" / "runs" / "ralplan" / "260101-000000-row3" / "state.json"
        must("starting the ralplan run for row3", ralplan(work, "start", str(ralplan_dest), "--input", str(requirements_path), "--plan", str(plan_path),
             "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        # Pinned explicitly while still nonterminal: ralplan's own completed receipt drops `input` entirely, so nothing would otherwise confirm this same run belongs once it completes.
        must("attaching the ralplan run for row3 while still nonterminal", fsd(work, "attach", str(state_path), "ralplan", str(ralplan_dest)))
        must("opening ralplan round 1 for row3", ralplan(work, "open", str(ralplan_dest)))
        write_plan(plan_path, "Approved", "good", "v0")
        must("approving ralplan round 1 for row3", ralplan(work, "approve", str(ralplan_dest)))
        must("completing ralplan for row3", ralplan(work, "complete", str(ralplan_dest)))

        assert_stop_blocks("row3 ralplan completed", work, "invoke /kein:execute")

# ---------------------------------------------------------------------------
# Case: an aborted interview ledger (gap row 4) blocks Stop naming closeout, with the resolved state.json path substituted for the `<state>` placeholder `fsd`'s own `gap()` writes.

def _section_interview_aborted():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "row4", "an idea")
        must("entering interview for row4", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-row4"
        interview_dir.mkdir(parents=True)
        ledger = interview_dir / "ledger.md"
        # Attached explicitly while still active -- interview's own aborted shape drops `output_path` entirely, so nothing would otherwise confirm this same ledger belongs once it aborts.
        write_active_ledger(ledger, "260101-000000-row4", work, work, work / "req-row4.md")
        must("attaching the interview ledger for row4 while still active", fsd(work, "attach", str(state_path), "interview", str(ledger)))
        write_aborted_ledger(ledger)

        assert_stop_blocks("row4 interview aborted", work, f"run ocs state fsd closeout {state_path}")

# ---------------------------------------------------------------------------
# Case: execute blocked with a parked, unanswered task (gap row 5) blocks Stop naming closeout, with the same `<state>` substitution. Then closeout, pause, answer, resume, and a post-skill `kein:execute` call: the execute run is still blocked, since its lead has not yet written the checkpoint that leaves it, so `gap()` itself reports no gap -- but the run is still `active` and `execute`, not `interview`, is the stage that is running, so the new no-gap block (S1) fires here too: Stop blocks once, naming `next_action`, and pre-write still allows Write, since `mode_pre_write` reads only the existing gap check and this row never was one.

def _section_execute_blocked_parked():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-row5.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "row5", str(approved_plan))
        must("entering execute for row5", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "row5", [execute_task("task-001", ["README.md"])], plan_path=approved_plan)
        must("attaching the execute run for row5 while still nonterminal", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        must("dispatching task-001 for row5", execute(work, "dispatch", str(execute_state), "task-001"))
        q = must("recording the irreversible question for row5",
                 fsd(work, "question", str(state_path), "--stage", "execute", "--question", "which persisted format?",
                     "--options", "json,csv", "--recommended", "json",
                     "--why-irreversible", "list item 1: a persisted format read outside the repo", "--parks", "task-001"))
        question_id = q.stdout.strip()
        must("parking task-001 for row5", execute(work, "park", str(execute_state), "task-001", "--question", "which format?", "--ref", question_id))
        must("checkpointing execute to blocked for row5", execute_checkpoint(work, execute_state, lambda s: s.update(
            {"lifecycle": "blocked", "phase": "blocked", "next_action": f"blocked on {question_id}: task-001 parked"})))

        assert_stop_blocks("row5 execute blocked, task parked and unanswered", work, f"run ocs state fsd closeout {state_path}")

        must("entering closeout for row5", fsd(work, "closeout", str(state_path)))
        retro = state_path.parent / "retro.md"
        retro.write_text(f"{question_id} pending.\n")
        must("pausing row5 on the unanswered question", fsd(work, "close", str(state_path), "--retro", str(retro)))
        must("answering row5's question", fsd(work, "answer", str(state_path), question_id, "--text", "json"))
        must("resuming row5 once answered", fsd(work, "resume", str(state_path)))

        assert_postskill_silent("row5 post-skill kein:execute after resume", work, "kein:execute")
        after_post_skill = read_json(state_path)
        if after_post_skill["stages"]["execute"]["status"] != "entered" or after_post_skill["stages"]["execute"]["run"] != str(execute_state):
            failures.append("post-skill kein:execute after resume did not re-enter execute with the kept association")

        assert_stop_blocks("row5 post-resume, execute still blocked, no gap -- the new no-gap block fires for a running non-interview stage", work, "reassess the current stage's gap")
        assert_pretool_allows("row5 pre-write allows the lead's checkpoint candidate", work, "Write")

# ---------------------------------------------------------------------------
# Case: execute is the entry stage (an approved plan) and still pending, but an unrelated nonterminal execute run -- a different plan entirely -- already occupies the worktree. Invoking /kein:execute again would only be refused a second time by execute's own per-worktree claim, so gap's row 1 must not name that as the single action that clears it (the binding single-invocation-clears-it constraint); it either allows outright or blocks/denies naming the occupant and a command that actually clears it. The model then invokes the kein:execute skill anyway -- post-skill's own `enter` call is refused by the mismatch and silently swallowed, exactly as it swallows any other `enter` failure -- and the very next Stop/pre-write call must still not carry the false instruction, because gap() itself, not anything post-skill wrote, is what stays honest.

def _section_unrelated_occupant_execute_entry_no_false_instruction():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-occupant-entry.md"
        write_plan(plan_path, "Approved")
        state_path = fsd_start(work, run_root, "occupantentry", str(plan_path))

        # `execute_start` here always starts a `--kind brief` run, whose own `input.reference` is `null` and so can never match a real plan reference -- a guaranteed non-belonging occupant.
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        occupant = execute_start(work, execute_run_root, "occupantentry-other", [execute_task("task-x", ["README.md"])])

        assert_postskill_silent("occupantentry: post-skill kein:execute stays silent over the mismatched occupant", work, "kein:execute")
        if read_json(state_path)["stages"]["execute"]["status"] != "pending":
            failures.append("post-skill kein:execute entered execute despite the occupant not belonging to this flow")

        stop_result = run_hook(work, "stop", stop_payload(work))
        if stop_result.returncode != 0:
            failures.append(f"occupantentry: stop hook exited {stop_result.returncode}: {stop_result.stderr!r}")
        else:
            stdout = stop_result.stdout.strip()
            if stdout:
                reason = json.loads(stdout).get("reason", "")
                if "invoke /kein:execute" in reason and "abort" not in reason and "finish" not in reason:
                    failures.append(f"occupantentry: stop blocked with a false single-invocation instruction to invoke /kein:execute while an unrelated occupant holds the worktree's claim: {reason!r}")
                if str(occupant) not in reason:
                    failures.append(f"occupantentry: stop's block did not name the occupant blocking the entry: {reason!r}")
            # An empty stdout means Stop allowed outright -- also acceptable: the binding constraint only rules out naming an action whose single invocation cannot clear the condition, it does not require a block whenever one cannot be worded that way.

        pretool_result = run_hook(work, "pre-write", pretool_payload(work, "Write"))
        if pretool_result.returncode != 0:
            failures.append(f"occupantentry: pre-write hook exited {pretool_result.returncode}: {pretool_result.stderr!r}")
        else:
            pre_stdout = pretool_result.stdout.strip()
            if pre_stdout:
                pre_reason = (json.loads(pre_stdout).get("hookSpecificOutput") or {}).get("permissionDecisionReason", "")
                if "invoke /kein:execute" in pre_reason and "abort" not in pre_reason and "finish" not in pre_reason:
                    failures.append(f"occupantentry: pre-write denied with a false single-invocation instruction to invoke /kein:execute: {pre_reason!r}")

# ---------------------------------------------------------------------------
# Case: the occupant gap row's own printed action is a single Bash command, runnable exactly as printed even while pre-write is actively denying the Write tool over this same row -- it builds the aborted candidate itself, with no Write tool call at all, and checkpoints it in the same call. Required: running the action as printed clears the row.

def _section_occupant_block_action_runs_as_printed():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-occupant-action.md"
        write_plan(plan_path, "Approved")
        state_path = fsd_start(work, run_root, "occupantaction", str(plan_path))

        # A `--kind brief` occupant, whose own `input.reference` is `null` and so never belongs to this plan-driven flow.
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        occupant = execute_start(work, execute_run_root, "occupantaction-other", [execute_task("task-x", ["README.md"])])

        gap_before = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if not gap_before["gap"]:
            failures.append(f"occupant-block-action: the fixture did not actually produce a gap: {gap_before}")
        action = gap_before.get("action", "")
        if "python3 -c" not in action or "&&" not in action or "ocs state execute checkpoint" not in action:
            failures.append(f"occupant-block-action: gap's own action was not the single chained Bash command expected: {action!r}")
        if str(occupant) not in action:
            failures.append(f"occupant-block-action: gap's own action did not name the occupant: {action!r}")

        # pre-write is actively denying Write over this exact row -- proof that the printed action must not need the Write tool to run.
        assert_pretool_denies("occupant-block-action: pre-write denies Write while the row stands", work, "not this flow's own run")

        # The action is prose naming the row followed by the one runnable command, separated by "in one call: " -- everything after that marker is the command as printed, exactly what a lead would copy and run.
        marker = "in one call: "
        marker_index = action.find(marker)
        if marker_index == -1:
            failures.append(f"occupant-block-action: could not find the runnable command inside gap's own action text: {action!r}")
            command = action
        else:
            command = action[marker_index + len(marker):]

        run_result = subprocess.run(command, shell=True, cwd=str(work), capture_output=True, text=True, timeout=30)
        if run_result.returncode != 0:
            failures.append(f"occupant-block-action: the printed action did not run successfully as a single Bash command: exit={run_result.returncode} stdout={run_result.stdout!r} stderr={run_result.stderr!r}")

        occupant_after = read_json(occupant)
        if occupant_after.get("lifecycle") != "aborted":
            failures.append(f"occupant-block-action: the printed action did not actually abort the occupant: {occupant_after}")

        gap_after = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if gap_after.get("action", "") == action or "own run" in gap_after.get("action", ""):
            failures.append(f"occupant-block-action: the row did not clear after running the printed action: {gap_after}")
        if "invoke /kein:execute" not in gap_after.get("action", ""):
            failures.append(f"occupant-block-action: clearing the occupant did not restore the ordinary invoke-execute row: {gap_after}")

# ---------------------------------------------------------------------------
# Case: the occupant gap row's own printed action still runs as one Bash command when the repository itself lives at a path containing a space -- the inline `python3 -c` script is passed as a single `shlex.quote`d argument, and the occupant's and the candidate's own paths are each `shlex.quote`d again in the trailing `checkpoint` call, so the whole line stays valid shell syntax end to end. Required case: the occupant abort command runs as printed from a repository path containing a space.

def _section_occupant_block_action_runs_with_space_in_repository_path():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo with space").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        plan_path = work / "plan-occupant-space.md"
        write_plan(plan_path, "Approved")
        state_path = fsd_start(work, run_root, "occupantspace", str(plan_path))

        # A `--kind brief` occupant, whose own `input.reference` is `null` and so never belongs to this plan-driven flow.
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        occupant = execute_start(work, execute_run_root, "occupantspace-other", [execute_task("task-x", ["README.md"])])

        gap_before = json.loads(fsd(work, "gap", str(state_path)).stdout)
        if not gap_before["gap"]:
            failures.append(f"occupant-block-action-space: the fixture did not actually produce a gap: {gap_before}")
        action = gap_before.get("action", "")

        marker = "in one call: "
        marker_index = action.find(marker)
        if marker_index == -1:
            failures.append(f"occupant-block-action-space: could not find the runnable command inside gap's own action text: {action!r}")
            command = action
        else:
            command = action[marker_index + len(marker):]

        run_result = subprocess.run(command, shell=True, cwd=str(work), capture_output=True, text=True, timeout=30)
        if run_result.returncode != 0:
            failures.append(f"occupant-block-action-space: the printed action did not run as one Bash command from a repository path containing a space: exit={run_result.returncode} stdout={run_result.stdout!r} stderr={run_result.stderr!r} command={command!r}")

        occupant_after = read_json(occupant)
        if occupant_after.get("lifecycle") != "aborted":
            failures.append(f"occupant-block-action-space: the printed action did not actually abort the occupant: {occupant_after}")

# ---------------------------------------------------------------------------
# Case: post-skill for `kein:ralplan` records the stage entry, and the next Stop blocks again -- ralplan, not interview, is the stage now running, so S1's no-gap block picks the run right back up and names next_action. Run twice -- the qualified form and the bare form -- since a real Skill-tool call was measured to leave either one verbatim in the hook's `tool_input.skill` (docs/skills/fsd/260919-hook-probe.md).

def _section_postskill_ralplan_forms():
    for slug, skill_name in (("ps-ralplan-qualified", "kein:ralplan"), ("ps-ralplan-bare", "ralplan")):
        with tempfile.TemporaryDirectory() as tmp:
            work = (Path(tmp) / "repo").resolve()
            init_repo(work)
            run_root = work / ".agents" / "kein" / "runs" / "fsd"
            state_path = fsd_start(work, run_root, slug, "an idea")
            must(f"entering interview for {slug}", fsd(work, "enter", str(state_path), "interview"))

            interview_dir = work / ".agents" / "kein" / "runs" / "interview" / f"260101-000000-{slug}"
            interview_dir.mkdir(parents=True)
            ledger = interview_dir / "ledger.md"
            requirements_path = work / ".agents" / "kein" / "requirements" / f"{slug}.md"
            requirements_path.parent.mkdir(parents=True)
            write_requirements(requirements_path, "Approved")
            # Attached explicitly while still active -- interview's own completed shape drops `output_path` entirely.
            write_active_ledger(ledger, f"260101-000000-{slug}", work, work, requirements_path)
            must(f"attaching the interview ledger for {slug} while still active", fsd(work, "attach", str(state_path), "interview", str(ledger)))
            write_completed_ledger(ledger, requirements_path)

            assert_stop_blocks(f"{slug} before post-skill", work, "invoke /kein:ralplan")
            assert_postskill_silent(f"{slug} post-skill {skill_name!r}", work, skill_name)

            after = read_json(state_path)
            if after["stages"]["ralplan"]["status"] != "entered":
                failures.append(f"{slug}: post-skill {skill_name!r} did not record the ralplan stage entry")

            # ralplan is now the stage running -- interview's own `status` is still `entered` too, from before, but `ralplan` is the *later* entered stage, so it is the one `_running_stage` reads as current -- and ralplan is not `interview`, so the new no-gap block fires: Stop blocks again, naming next_action.
            assert_stop_blocks(f"{slug} next stop after post-skill -- ralplan is now running, not interview", work, after["next_action"])

# ---------------------------------------------------------------------------
# Case: three genuinely live, running stages -- not merely "entered with no association yet" the way row1's second half is, but a real nonterminal run sitting in the stage's own run root -- all give no gap, and none of the three ever calls `attach`: no association is ever formed here at all, which is the point -- `gap`'s own reading of a genuinely running stage does not depend on anything having attached it. Since S1, "no gap" while the run is still `active` no longer means Stop stays quiet on its own: `execute` and `ralplan` genuinely running now block Stop once, naming the run's own `next_action` and `gap`'s own `diagnosis` for the unlinked stage (both present here, since none of the three ever attaches); pre-write is unaffected either way, since `mode_pre_write` never grew this check. `interview` stays the one exception -- a turn ending there is still correct, so it keeps allowing outright. Together these are what "blocks in a running non-interview stage, allows in a running interview" means for a stage that already has a live run behind it, as opposed to one that was just entered pending (covered in entry-stage-pending above).

def _section_live_running_stages():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-live-execute.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "live-execute", str(approved_plan))
        must("entering execute for live-execute", fsd(work, "enter", str(state_path), "execute"))
        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "live-execute", [execute_task("task-001", ["README.md"])])
        must("dispatching task-001 for live-execute", execute(work, "dispatch", str(execute_state), "task-001"))

        next_action = read_json(state_path)["next_action"]
        assert_stop_blocks("live-execute: active run, task-001 implementing, no gap -- execute is running and not interview, so the new block fires", work, next_action)
        assert_stop_blocks("live-execute: the same block also names gap's own diagnosis for the unlinked stage", work, "execute: no run linked yet")
        assert_pretool_allows("live-execute: pre-write still allows Write while execute is genuinely running (mode_pre_write is unchanged)", work, "Write")

    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "live-ralplan", "an idea")
        must("entering interview for live-ralplan", fsd(work, "enter", str(state_path), "interview"))
        must("entering ralplan for live-ralplan", fsd(work, "enter", str(state_path), "ralplan"))

        plan_path = work / ".agents" / "kein" / "plans" / "live-ralplan.md"
        plan_path.parent.mkdir(parents=True)
        write_plan(plan_path, "Draft", "first cut", "v0")
        ralplan_dest = work / ".agents" / "kein" / "runs" / "ralplan" / "260101-000000-live-ralplan" / "state.json"
        must("starting the ralplan run for live-ralplan", ralplan(work, "start", str(ralplan_dest), "--plan", str(plan_path),
             "--summary", "check", "--lanes", "architect@claude,critic@claude"))
        must("opening ralplan round 1 for live-ralplan", ralplan(work, "open", str(ralplan_dest)))

        next_action = read_json(state_path)["next_action"]
        assert_stop_blocks("live-ralplan: active run, phase reviewing, no gap -- ralplan is running and not interview, so the new block fires", work, next_action)
        assert_stop_blocks("live-ralplan: the same block also names gap's own diagnosis for the unlinked stage", work, "ralplan: no run linked yet")
        assert_pretool_allows("live-ralplan: pre-write still allows Write while ralplan is genuinely running (mode_pre_write is unchanged)", work, "Write")

    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "live-interview", "an idea")
        must("entering interview for live-interview", fsd(work, "enter", str(state_path), "interview"))

        interview_dir = work / ".agents" / "kein" / "runs" / "interview" / "260101-000000-live-interview"
        interview_dir.mkdir(parents=True)
        requirements_path = work / ".agents" / "kein" / "requirements" / "live-interview.md"
        write_active_ledger(interview_dir / "ledger.md", "260101-000000-live-interview", work, work, requirements_path)

        assert_stop_allows("live-interview: active ledger present, unassociated, no gap evidence", work)
        assert_pretool_allows("live-interview: pre-write allows Write while interview is genuinely running", work, "Write")

# ---------------------------------------------------------------------------
# Case: post-skill's own off-switch guard. With the marker present, a skill name that would otherwise enter a real stage changes nothing at all -- not just "does not block", but leaves `state.json` byte-for-byte the state it read. Deleting the guard from `mode_post_skill` would still exit 0 and print nothing, so the silence alone cannot catch its absence; only the unchanged state can.

def _section_postskill_off_switch():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        state_path = fsd_start(work, run_root, "post-skill-off-switch", "an idea")
        before = read_json(state_path)

        config_dir = Path(tmp) / "config"
        (config_dir / "kein" / "fsd").mkdir(parents=True)
        (config_dir / "kein" / "fsd" / "hooks-off").touch()

        assert_postskill_silent("post-skill off-switch: allows silently", work, "kein:interview", config_dir=config_dir)
        after = read_json(state_path)
        if after != before:
            failures.append("post-skill off-switch: state.json changed although the off-switch marker was present -- the marker did not suppress `enter`")
        if after["stages"]["interview"]["status"] != "pending":
            failures.append(f"post-skill off-switch: interview status moved off pending despite the marker: {after['stages']['interview']['status']}")

# ---------------------------------------------------------------------------
# Case: post-skill never blocks even when `enter` itself would refuse -- a skill named for a stage that is `skipped` for this run (entry=execute skips interview and ralplan). Silent allow, and the skipped stage's status is untouched.

def _section_postskill_skipped_stage():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-skip.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "skip-case", str(approved_plan))

        assert_postskill_silent("post-skill on a skipped stage still allows silently", work, "kein:interview")
        after = read_json(state_path)
        if after["stages"]["interview"]["status"] != "skipped":
            failures.append("post-skill on a skipped stage changed its status; it must never block or mutate on refusal")

        assert_postskill_silent("post-skill on an unrecognized skill name is a no-op", work, "kein:explore")

