        write_requirements(requirements_path, "Draft")
        write_active_ledger(ledger, "260101-000000-postbash-heredoc-indented", work, work, requirements_path)

        heredoc_command = (
            "cat > README.md <<EOF\n"
            "Documentation body.\n"
            "  EOF\n"
            f"ocs validate interview ledger {ledger}\n"
            "EOF"
        )

        assert_postbash_silent("postbash-heredoc-indented: an indented line that only reduces to the delimiter under stripping does not terminate <<EOF", work, heredoc_command)
        after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if after["stages"]["interview"]["association"] != "none" or after["stages"]["interview"]["run"] is not None:
            failures.append(f"post-bash attached an interview ledger from a line still inside a heredoc body, an indented false terminator making it look like a real command: {after['stages']['interview']}")

# ---------------------------------------------------------------------------
# Case: a paused fsd run allows regardless of the evidence underneath it -- `gap()`'s very first check is the run's own lifecycle, ahead of any stage row.

def _section_paused_lifecycle():
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-paused.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "paused-case", str(approved_plan))
        must("entering execute for paused-case", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "paused-case", [execute_task("task-001", ["README.md"])])
        drive_task_to_acceptance(work, execute_state, "task-001")
        must("entering final_audit for paused-case", execute_to_final_audit(work, execute_state))
        must("completing execute for paused-case", execute_complete(work, execute_state, ["task-001"]))
        must("recording a whole-run question for paused-case", fsd(work, "question", str(state_path), "--stage", "closeout",
             "--question", "does this lesson belong in AGENTS.md?", "--options", "yes,no", "--recommended", "yes",
             "--why-irreversible", "an AGENTS.md edit is never taken by the flow itself", "--parks", "whole run"))
        must("entering closeout for paused-case", fsd(work, "closeout", str(state_path)))
        retro = state_path.parent / "retro.md"
        retro.write_text("Q1 pending.\n")
        must("pausing paused-case", fsd(work, "close", str(state_path), "--retro", str(retro)))
        paused_state = read_json(state_path)
        if paused_state["lifecycle"] != "paused":
            failures.append(f"paused-case fixture did not actually pause, so the hook assertions below would be vacuous: lifecycle is {paused_state['lifecycle']!r}")

        assert_stop_allows("paused-case: lifecycle paused allows regardless of the evidence underneath", work)
        assert_pretool_allows("paused-case: lifecycle paused allows Write regardless of the evidence underneath", work, "Write")

# ---------------------------------------------------------------------------
# Case: the S1 no-gap block itself, isolated from the fixtures above that exercise it along the way. An active run with `execute` entered and no association at all (so `gap()` reports no gap, with a `diagnosis`) blocks Stop exactly once: the block itself, naming `next_action`, the diagnosis, the demand to keep the running stage moving with its lane-liveness check, and the two ways to bring a run that should not continue to rest on the record instead -- pause it for the user (a question parked against the whole run) or end it outright, each sharing one `closeout`/`close`/`halt` tail rather than predicting its own refusal (round 7, finding 1); the machine-wide off-switch is deliberately not offered, since it silently disables every hook mode for every fsd run -- then the identical payload with `stop_hook_active: true` allows, which is the guarantee that keeps the block from looping (`mode_stop` checks `stop_hook_active` before either block, and a comment beside the new one says so). The off-switch marker allows outright too, over the same no-gap active state. `halted` and `aborted` -- the two terminal lifecycles `paused-lifecycle` above does not already cover -- allow regardless of which stage is entered, the same as `completed` (proved in postbash-ordinary-path-associates-without-attach) and `paused` (proved just above): all four are `_find_nonterminal_fsd_run`'s job to keep out of `_resolve` in the first place, `paused` aside, which is why the new block's own `lifecycle == "active"` guard never even has cause to fire for them. Three further fixtures below walk the real CLI to rest along that shared tail: a structural refusal (a task scoped to AGENTS.md) where `close` refuses and `halt` succeeds, ending `halted`; a fixable refusal (a retrospective missing an id) where `halt` itself answers that `close` would succeed, and fixing the retrospective -- not halting -- is what actually pauses the run; and the end exit with no question at all, where `close` refuses because execute is still live and `halt` ends it.

def _section_active_no_gap_block():
    with tempfile.TemporaryDirectory() as tmp:
        # Round 8, finding 2: this fixture's own repository lives at a path containing a space, so the reason's `shlex.quote`d state path -- otherwise unexercised by any fixture feeding `_active_no_gap_reason` -- actually appears in its quoted form below, in both the diagnosis clause and the closing.
        work = (Path(tmp) / "repo with space").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-active-no-gap.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "active-no-gap", str(approved_plan))
        must("entering execute for active-no-gap", fsd(work, "enter", str(state_path), "execute"))
        next_action = read_json(state_path)["next_action"]
        # `fsd`'s own `gap()`, read through the real CLI exactly as the running hook subprocess reads it -- the ground truth this check already trusts for what counts as a gap -- rather than this file re-deriving `_none_association_reason`'s own text for the `execute` stage by hand, which would duplicate `state.py`'s own wording and drift the moment that wording changes for a reason unrelated to `hook.py`.
        gap_before = json.loads(fsd(work, "gap", str(state_path)).stdout)
        quoted_state = shlex.quote(str(state_path))
        diagnosis_named = f"execute: {gap_before['diagnosis']['execute'].replace('<state>', quoted_state)}"

        result = run_hook(work, "stop", stop_payload(work))
        if result.returncode != 0:
            failures.append(f"active-no-gap: stop hook exited {result.returncode} instead of blocking on a genuinely running, unlinked stage: {result.stderr!r}")
        else:
            try:
                out = json.loads(result.stdout)
            except (ValueError, json.JSONDecodeError):
                out = None
            if out is None or out.get("decision") != "block":
                failures.append(f"active-no-gap: stop hook did not block on a genuinely running, unlinked stage: stdout={result.stdout!r}")
            else:
                reason = out.get("reason", "")
                if not reason.startswith("fsd:"):
                    failures.append(f"active-no-gap: block reason is missing the 'fsd:' prefix: {reason!r}")
                if next_action not in reason:
                    failures.append(f"active-no-gap: block reason did not name next_action ({next_action!r} not in {reason!r})")
                if "execute: no run linked yet" not in reason:
                    failures.append(f"active-no-gap: block reason did not carry gap()'s own diagnosis for the unlinked running stage: {reason!r}")
                if "ocs state fsd closeout" not in reason:
                    failures.append(f"active-no-gap: block reason did not name the closeout step of the terminal-outcome way out: {reason!r}")
                if "<state>" in reason:
                    failures.append(f"active-no-gap: block reason left the literal <state> placeholder unresolved inside the joined diagnosis text: {reason!r}")
                # The running stage's own name, not a hardcoded literal -- a mutation that swaps `running_stage` for a bogus literal in `_active_no_gap_reason`'s leading clause must fail this, even though the diagnosis clause elsewhere in the same reason already carries the literal word "execute" regardless.
                if "execute is the stage genuinely running" not in reason:
                    failures.append(f"active-no-gap: block reason did not name execute as the stage genuinely running: {reason!r}")
                # The staleness framing `_active_no_gap_reason`'s own docstring names for next_action -- a mutation that deletes the leading clause outright, or replaces this framing with a bare `next_action: ...` label, must fail this.
                if "last recorded intent, which may already be done" not in reason:
                    failures.append(f"active-no-gap: block reason dropped the staleness framing around next_action: {reason!r}")
                # Round 7, finding 3 checked only the closing section -- everything from "Do not end this turn here" on -- against its own exact expected text, rather than a whitelist of allowed backticked commands or a blacklist of known off-switch phrasings, both of which a paraphrased or differently-cased off-switch offer survived that round. Round 8, finding 1: that window left the leading clause and the diagnosis clause open to a mutation that inserted an extra way out earlier in the string -- a third exit folded into the leading sentence, say -- since nothing compared that span at all. Comparing the whole reason against its own hand-typed expected text, not only the closing, is what catches an added sentence, dropped clause, or reworded exit anywhere in the message, by inequality against `_expected_active_no_gap_reason`.
                expected_reason = _expected_active_no_gap_reason(quoted_state, "execute", next_action, diagnosis_named)
                if reason != expected_reason:
                    failures.append(
                        "active-no-gap: block reason did not match its expected text exactly.\n"
                        f"  got:      {reason!r}\n"
                        f"  expected: {expected_reason!r}"
                    )

        # Identical payload, `stop_hook_active: true`: allows. This is the guarantee that keeps the block from looping -- proved here for the new block specifically, not only for the pre-existing gap block (stop-hook-active-bypass above).
        assert_stop_allows("active-no-gap: identical payload with stop_hook_active allows", work, stop_hook_active=True)

        # The off-switch marker allows outright too, over the identical no-gap active state -- proved here for the new block specifically, not only for the pre-existing gap block (stop-off-switch above).
        config_dir = Path(tmp) / "config"
        (config_dir / "kein" / "fsd").mkdir(parents=True)
        (config_dir / "kein" / "fsd" / "hooks-off").touch()
        assert_stop_allows("active-no-gap: off-switch marker allows despite the same no-gap active state", work, config_dir=config_dir)

    # `execute` -- not `interview` -- is entered before halting and before aborting below: `_find_nonterminal_fsd_run` excludes `halted`/`aborted` lifecycles from `_resolve` before `mode_stop` ever reads which stage is running, so neither fixture actually needs the `running_stage in (None, "interview")` exception to allow -- entering the one stage that exception does NOT cover is what keeps a reader from mistaking "it allows" for "because interview is running" when the real reason is the terminal lifecycle.
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-active-no-gap-halted.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "active-no-gap-halted", str(approved_plan))
        must("entering execute for active-no-gap-halted", fsd(work, "enter", str(state_path), "execute"))
        must("halting active-no-gap-halted", fsd(work, "halt", str(state_path), "--reason", "giving up on this one"))
        halted_state = read_json(state_path)
        if halted_state["lifecycle"] != "halted" or halted_state["stages"]["execute"]["status"] != "entered":
            failures.append(f"active-no-gap-halted fixture did not actually halt with execute entered, so the stop assertion below would be vacuous: {halted_state}")
        assert_stop_allows("active-no-gap-halted: halted lifecycle allows regardless of stage evidence, execute (not interview) entered", work)

    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-active-no-gap-aborted.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "active-no-gap-aborted", str(approved_plan))
        must("entering execute for active-no-gap-aborted", fsd(work, "enter", str(state_path), "execute"))
        must("aborting active-no-gap-aborted", fsd(work, "abort", str(state_path), "--reason", "cancelled"))
        aborted_state = read_json(state_path)
        if aborted_state["lifecycle"] != "aborted" or aborted_state["stages"]["execute"]["status"] != "entered":
            failures.append(f"active-no-gap-aborted fixture did not actually abort with execute entered, so the stop assertion below would be vacuous: {aborted_state}")
        assert_stop_allows("active-no-gap-aborted: aborted lifecycle allows regardless of stage evidence, execute (not interview) entered", work)

    # Case (round 6, finding 5): the pause exit's own printed recovery followed to the letter -- record a whole-run question, closeout, then close with the retrospective in this run's own directory citing the question's id -- actually reaches a Stop that allows, with execute still genuinely running and linked the whole time beforehand (the shape the block itself fires on).
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-pause-exit.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "pause-exit", str(approved_plan))
        must("entering execute for pause-exit", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "pause-exit", [execute_task("task-001", ["README.md"])], plan_path=approved_plan)
        must("attaching the execute run for pause-exit", fsd(work, "attach", str(state_path), "execute", str(execute_state)))
        must("dispatching task-001 for pause-exit", execute(work, "dispatch", str(execute_state), "task-001"))

        assert_stop_blocks("pause-exit: active run, execute running and linked, no gap -- the block fires before its own pause exit is followed", work,
                            read_json(state_path)["next_action"])

        q = must("recording the whole-run question for pause-exit",
                 fsd(work, "question", str(state_path), "--stage", "execute", "--question", "does this change the release date?",
                     "--options", "yes,no", "--recommended", "no",
                     "--why-irreversible", "a missed release date cannot be undone", "--parks", "whole run"))
        question_id = q.stdout.strip()
        must("entering closeout for pause-exit", fsd(work, "closeout", str(state_path)))
        retro = state_path.parent / "retro.md"
        retro.write_text(f"{question_id} pending.\n")
        must("pausing pause-exit by following the block's own pause exit -- retrospective inside this run's own directory, citing the question id",
             fsd(work, "close", str(state_path), "--retro", str(retro)))
        paused_state = read_json(state_path)
        if paused_state["lifecycle"] != "paused":
            failures.append(f"pause-exit fixture did not actually pause by following the printed exit, so the stop assertion below would be vacuous: lifecycle is {paused_state['lifecycle']!r}")

        assert_stop_allows("pause-exit: following the block's own pause exit to the letter reaches a Stop that allows", work)

    # Case: the running stage (execute) is already linked, but another entered stage (interview) is not -- `gap_result["diagnosis"]` names every entered-but-unlinked stage, not only the one running, so this is the one shape that actually distinguishes "diagnosis filtered to running_stage" from "diagnosis left as gap() returns it": the two readings only ever differ once the running stage itself has no diagnosis of its own to carry. The fsd run enters at `execute` directly (an approved plan input), which leaves interview `skipped`, not `entered` -- `enter` itself refuses a skipped stage, so interview's own `entered` status here is hand-authored, the same way the all-`skipped` shape below is, to reach a shape `enter`'s own ordering has no way to produce live: an entered-but-unlinked interview sitting beside an entered-and-linked execute, the stage `_running_stage` reports as running since it is the last one entered.
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-active-no-gap-running-linked.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "active-no-gap-running-linked", str(approved_plan))
        state = read_json(state_path)
        if state["entry"] != "execute" or state["stages"]["interview"]["status"] != "skipped":
            failures.append(f"active-no-gap-running-linked fixture's own starting shape was not what this case assumes: entry={state['entry']!r}, interview={state['stages']['interview']}")
        state["stages"]["interview"]["status"] = "entered"
        write(state_path, state)
        must("entering execute for active-no-gap-running-linked", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "active-no-gap-running-linked",
                                       [execute_task("task-001", ["README.md"])], plan_path=approved_plan)
        must("attaching the running stage's own live execute run", fsd(work, "attach", str(state_path), "execute", str(execute_state)))

        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["stages"]["interview"]["association"] != "none":
            failures.append(f"active-no-gap-running-linked fixture did not leave interview entered-but-unlinked, so this case would be vacuous: {status_after['stages']['interview']}")
        if status_after["stages"]["execute"]["association"] != "kept":
            failures.append(f"active-no-gap-running-linked fixture did not leave execute entered-and-linked, so this case would be vacuous: {status_after['stages']['execute']}")
        if status_after["gap"] is not False or not status_after.get("diagnosis") or "interview" not in status_after["diagnosis"]:
            failures.append(f"active-no-gap-running-linked fixture's own gap() did not report no-gap with interview named in its diagnosis, so this case does not actually exercise the two-reading difference: {status_after}")

        assert_stop_blocks("active-no-gap-running-linked: execute is running and already linked, interview is entered but unlinked", work,
                            "execute is the stage genuinely running",
                            forbidden_substring="interview: no run linked yet")

    # Case: `running_stage` genuinely `None` -- every stage `skipped`, `lifecycle` still `active`, `gap()` reporting no gap. No builder writes this: `start`'s own entry-index rule only skips a stage strictly earlier than `entry`, and nothing marks `entry` itself `skipped`. Hand-authored, the same way the unparseable- and gap()-raises cases above are, to reach `mode_stop` with a shape no live run can produce (issue: `None != "interview"` would otherwise admit this past the interview exception and call `_active_no_gap_reason` with a `None` `running_stage`, which reads back as "None is the stage genuinely running").
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-active-no-gap-none-running.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "active-no-gap-none-running", str(approved_plan))
        state = read_json(state_path)
        if state["entry"] != "execute" or state["stages"]["execute"]["status"] != "pending":
            failures.append(f"active-no-gap-none-running fixture's own starting shape was not what this case assumes: entry={state['entry']!r}, execute={state['stages']['execute']}")
        state["stages"]["execute"]["status"] = "skipped"
        write(state_path, state)

        status_after = json.loads(fsd(work, "status", str(state_path)).stdout)
        if status_after["gap"] is not False or status_after["lifecycle"] != "active":
            failures.append(f"active-no-gap-none-running fixture did not actually reach lifecycle active with no gap, so this case would be vacuous: {status_after}")
        if any(status_after["stages"][stage]["status"] == "entered" for stage in ("interview", "ralplan", "execute", "closeout")):
            failures.append(f"active-no-gap-none-running fixture left a stage entered, so running_stage would not actually be None: {status_after['stages']}")

        assert_stop_allows("active-no-gap-none-running: every stage skipped, active, no gap -- a None running_stage must never reach the reason", work)

    # Case (round 7, finding 1): the pause exit's own structural dead end, walked with the real CLI. A task scoped to AGENTS.md is a guard violation, and `_structural_close_blocker` returns that blocker before `close` ever reaches the retrospective, so `close` refuses over the guard and `halt` -- checking the identical blocker -- is the only command that actually works; the run ends `halted`.
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-halt-guard.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "halt-guard", str(approved_plan))
        must("entering execute for halt-guard", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "halt-guard", [execute_task("task-001", ["AGENTS.md"])], plan_path=approved_plan)
        must("attaching halt-guard's execute run", fsd(work, "attach", str(state_path), "execute", str(execute_state)))

        q = must("recording the whole-run question for halt-guard",
                 fsd(work, "question", str(state_path), "--stage", "execute", "--question", "does this change the release date?",
                     "--recommended", "no", "--why-irreversible", "a missed release date cannot be undone", "--parks", "whole run"))
        question_id = q.stdout.strip()
        must("entering closeout for halt-guard", fsd(work, "closeout", str(state_path)))
        retro = state_path.parent / "retro.md"
        retro.write_text(f"{question_id} pending.\n")
        refuse("closing halt-guard while a task scopes AGENTS.md", fsd(work, "close", str(state_path), "--retro", str(retro)),
               reason="scope AGENTS.md")
        must("halting halt-guard once close refuses structurally over the guard violation",
             fsd(work, "halt", str(state_path), "--reason", "guard failed: task-001 scopes AGENTS.md"))
        halted_state = read_json(state_path)
        if halted_state["lifecycle"] != "halted":
            failures.append(f"halt-guard fixture did not actually reach halted: {halted_state['lifecycle']!r}")

        assert_stop_allows("halt-guard: run ends halted after close refuses structurally and halt succeeds", work)

    # Case (round 7, finding 1): the pause exit's tail followed to the letter, but the retrospective is missing an id. `close` refuses over the retrospective itself, not structurally, so `_structural_close_blocker` returns `None` and `halt` answers "close would succeed" -- the signal that fixing the retrospective, not halting, is what actually gets this run to rest.
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-halt-fixable.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "halt-fixable", str(approved_plan))
        must("entering execute for halt-fixable", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "halt-fixable", [execute_task("task-001", ["README.md"])], plan_path=approved_plan)
        must("attaching halt-fixable's execute run", fsd(work, "attach", str(state_path), "execute", str(execute_state)))

        q = must("recording the whole-run question for halt-fixable",
                 fsd(work, "question", str(state_path), "--stage", "execute", "--question", "does this change the release date?",
                     "--recommended", "no", "--why-irreversible", "a missed release date cannot be undone", "--parks", "whole run"))
        question_id = q.stdout.strip()
        must("entering closeout for halt-fixable", fsd(work, "closeout", str(state_path)))
        retro = state_path.parent / "retro.md"
        retro.write_text("Nothing recorded.\n")
        refuse("closing halt-fixable with a retrospective missing the question id", fsd(work, "close", str(state_path), "--retro", str(retro)),
               reason="does not cite every assumption, question, and lesson id")
        refuse("halting halt-fixable when close would actually succeed once the retrospective is fixed",
               fsd(work, "halt", str(state_path), "--reason", "retrospective missing an id"), reason="close would succeed")

        retro.write_text(f"{question_id} pending.\n")
        must("closing halt-fixable once the retrospective is fixed, as halt's own refusal implied", fsd(work, "close", str(state_path), "--retro", str(retro)))
        fixed_state = read_json(state_path)
        if fixed_state["lifecycle"] != "paused":
            failures.append(f"halt-fixable fixture did not actually pause once the retrospective was fixed: {fixed_state['lifecycle']!r}")

        assert_stop_allows("halt-fixable: run pauses once the retrospective is fixed rather than halted", work)

    # Case (round 7, finding 1): the end exit with no question recorded at all. `close` refuses because execute is still live and nothing is unanswered to pause it on -- structural (`_structural_close_blocker` returns the identical message), so `halt` succeeds outright.
    with tempfile.TemporaryDirectory() as tmp:
        work = (Path(tmp) / "repo").resolve()
        init_repo(work)
        run_root = work / ".agents" / "kein" / "runs" / "fsd"
        approved_plan = work / "plan-halt-end.md"
        write_plan(approved_plan, "Approved")
        state_path = fsd_start(work, run_root, "halt-end", str(approved_plan))
        must("entering execute for halt-end", fsd(work, "enter", str(state_path), "execute"))

        execute_run_root = work / ".agents" / "kein" / "runs" / "execute"
        execute_state = execute_start(work, execute_run_root, "halt-end", [execute_task("task-001", ["README.md"])], plan_path=approved_plan)
        must("attaching halt-end's execute run", fsd(work, "attach", str(state_path), "execute", str(execute_state)))

        must("entering closeout for halt-end", fsd(work, "closeout", str(state_path)))
        retro = state_path.parent / "retro.md"
        retro.write_text("Nothing recorded.\n")
        refuse("closing halt-end with execute still live and no question to pause on", fsd(work, "close", str(state_path), "--retro", str(retro)),
               reason="not completed")
        must("ending halt-end outright once close refuses", fsd(work, "halt", str(state_path), "--reason", "execute still live, ending outright"))
        ended_state = read_json(state_path)
        if ended_state["lifecycle"] != "halted":
            failures.append(f"halt-end fixture did not actually end halted: {ended_state['lifecycle']!r}")

        assert_stop_allows("halt-end: run ends halted via the end exit with no question recorded", work)

# ---------------------------------------------------------------------------
# Section registry and CLI driver -- `--list` prints the section names below in the order they run; `--only <name>[,<name>...]` runs just those sections (plus whatever earlier ones a dependency map names, though every section here is self-contained and needs none); neither flag runs every section in order exactly as running this file always has.

SECTIONS = [
    ("entry-stage-pending", (), _section_entry_stage_pending),
    ("interview-completed-approved", (), _section_interview_completed_approved),
    ("ralplan-completed", (), _section_ralplan_completed),
    ("interview-aborted", (), _section_interview_aborted),
    ("execute-blocked-parked", (), _section_execute_blocked_parked),
    ("unrelated-occupant-execute-entry-no-false-instruction", (), _section_unrelated_occupant_execute_entry_no_false_instruction),
    ("occupant-block-action-runs-as-printed", (), _section_occupant_block_action_runs_as_printed),
    ("occupant-block-action-runs-with-space-in-repository-path", (), _section_occupant_block_action_runs_with_space_in_repository_path),
    ("postskill-ralplan-forms", (), _section_postskill_ralplan_forms),
    ("live-running-stages", (), _section_live_running_stages),
    ("postskill-off-switch", (), _section_postskill_off_switch),
    ("postskill-skipped-stage", (), _section_postskill_skipped_stage),
    ("stop-hook-active-bypass", (), _section_stop_hook_active_bypass),
    ("stop-off-switch", (), _section_stop_off_switch),
    ("no-fsd-run", (), _section_no_fsd_run),
    ("corrupt-state-json", (), _section_corrupt_state_json),
    ("gap-raises-hook-guard", (), _section_gap_raises_hook_guard),
    ("garbage-stdin", (), _section_garbage_stdin),
    ("prewrite-off-switch", (), _section_prewrite_off_switch),
    ("postskill-interview-forms", (), _section_postskill_interview_forms),
    ("closeout-path-end-to-end", (), _section_closeout_path_end_to_end),
    ("postbash-ordinary-path-associates-without-attach", (), _section_postbash_ordinary_path_associates_without_attach),
    ("postbash-interview-completed-never-linked", (), _section_postbash_interview_completed_never_linked),
    ("postbash-unrelated-run-never-attached", (), _section_postbash_unrelated_run_never_attached),
    ("postbash-same-relative-name-second-repository-not-attached", (), _section_postbash_same_relative_name_second_repository_not_attached),
    ("postbash-non-start-command-noop", (), _section_postbash_non_start_command_noop),
    ("postbash-ledger-path-with-space-attaches", (), _section_postbash_ledger_path_with_space_attaches),
    ("postbash-chained-start-then-dispatch-attaches", (), _section_postbash_chained_start_then_dispatch_attaches),
    ("postbash-glued-semicolon-before-start-attaches", (), _section_postbash_glued_semicolon_before_start_attaches),
    ("postbash-newline-separated-validate-attaches", (), _section_postbash_newline_separated_validate_attaches),
    ("postbash-heredoc-then-start-attaches", (), _section_postbash_heredoc_then_start_attaches),
    ("postbash-heredoc-indented-false-terminator-not-attached", (), _section_postbash_heredoc_indented_false_terminator_not_attached),
    ("paused-lifecycle", (), _section_paused_lifecycle),
    ("active-no-gap-block", (), _section_active_no_gap_block),
]
SECTION_NAMES = [name for name, _, _ in SECTIONS]
SECTION_DEPS = {name: deps for name, deps, _ in SECTIONS}
SECTION_FUNCS = {name: func for name, _, func in SECTIONS}
SCRIPT_NAME = "check-fsd-hooks"


def _section_closure(requested):
    # A dependency always appears earlier in `SECTIONS` than whatever names it, so filtering `SECTION_NAMES` down to the requested sections plus their dependencies keeps a valid run order on its own, with no separate topological sort needed.
    needed = set()
    stack = list(requested)
    while stack:
        name = stack.pop()
        if name in needed:
            continue
        needed.add(name)
        stack.extend(SECTION_DEPS[name])
    return [name for name in SECTION_NAMES if name in needed]


def _parse_argv(argv):
    if not argv:
        return None, None
    if argv == ["--list"]:
        return "list", None
    if len(argv) == 2 and argv[0] == "--only":
        return "only", [n.strip() for n in argv[1].split(",") if n.strip()]
    print(f"{SCRIPT_NAME}: usage: {SCRIPT_NAME} [--list | --only <name>[,<name>...]]", file=sys.stderr)
    raise SystemExit(2)


def main():
    mode, names = _parse_argv(sys.argv[1:])

    if mode == "list":
        for name in SECTION_NAMES:
            print(name)
        return

    if mode == "only":
        unknown = [n for n in names if n not in SECTION_DEPS]
        if not names or unknown:
            if unknown:
                print(f"{SCRIPT_NAME}: unknown section(s): {', '.join(unknown)}", file=sys.stderr)
            else:
                print(f"{SCRIPT_NAME}: --only needs at least one section name", file=sys.stderr)
            print(f"{SCRIPT_NAME}: valid sections: {', '.join(SECTION_NAMES)}", file=sys.stderr)
            raise SystemExit(1)
        run_order = _section_closure(names)
    else:
        run_order = list(SECTION_NAMES)

    for name in run_order:
        SECTION_FUNCS[name]()

    if failures:
        for failure in failures:
            print(f"{SCRIPT_NAME}: {failure}", file=sys.stderr)
        raise SystemExit(1)
    if mode == "only":
        print(f"{SCRIPT_NAME}: ran {', '.join(run_order)}")
    else:
        print("check-fsd-hooks: stop blocks on every gap row -- both flavors of the closeout row, execute completed and execute blocked with a parked task -- with the resolved state path substituted into the reason; once a run is active with no gap, stop blocks again on whichever stage is genuinely running -- ralplan, execute, or closeout -- naming next_action, gap's own diagnosis when the stage has no run linked yet, the demand to keep that stage moving and check a waited-on lane is still alive, and the two ways to bring the run to rest on the record instead -- pause it for the user or end it outright, except while interview is the one running, which still allows outright, the same as a freshly entered stage still pending, a paused lifecycle, and a completed, halted, or aborted one, regardless of the evidence underneath; stop_hook_active and the off-switch both allow through either block, old or new, and neither block ever loops; unparseable or non-object stdin allows outright rather than falling through to an under-specified payload; pre-write denies only the write tools on the existing gap and names the same gap action the paired Stop assertion does, is never touched by the new active-no-gap block, and its own off-switch allows a Write despite a real gap; post-skill records both the qualified and bare skill-name forms for both the entry stage and a downstream one, never blocks including through a skipped stage, and its own off-switch leaves state.json untouched; and the pause -> answer -> resume -> post-skill(execute) sequence with the run still blocked now blocks Stop too, naming next_action, since execute is the stage genuinely running")


if __name__ == "__main__":
    main()
