#!/usr/bin/env python3
#: Prove the execute state machine derives what it can and still refuses a stale candidate.
#
# `checkpoint` recomputes the revision counter and every worktree fingerprint in order to check the
# candidate against them, so a candidate may write `"auto"` and let it fill them in. What must not
# follow from that is a lost update: the counter's whole job is to refuse content authored against a
# state that has since moved, and an autofill that re-derived it under the lock would defeat it.
#
# Written because nothing else exercises this file. The one recorded execute run is a compacted
# receipt, so no leftover candidate shows what a live loop actually costs.
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(os.environ["KEIN_ROOT"])
STATE = ROOT / "skills" / "execute" / "scripts" / "state.py"
failures = []


def run(work, *args):
    return subprocess.run([sys.executable, str(STATE), *args], cwd=work, capture_output=True, text=True)


def git(work, *args):
    subprocess.run(["git", *args], cwd=work, check=True, capture_output=True)


SUMMARY = "check"
TASK = {
    "id": "task-001", "title": "the only task", "scope": ["one file"],
    "completion_condition": "it does the thing", "verification_path": ["run the check"],
    "rationale": "the fixture needs one", "status": "pending", "round": 0,
    "latest_verification": [], "unresolved_findings": [], "acceptance": None,
}


def state_for(work, revision, phase="task", next_action="dispatch task-001"):
    common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            cwd=work, capture_output=True, text=True).stdout.strip()
    common = str(Path(common).resolve())
    return {
        "schema_version": 1, "revision": revision, "workflow": "execute", "run_id": "260101-000000-check",
        "lifecycle": "active",
        "input": {"kind": "brief", "reference": None, "summary": SUMMARY,
                  "sha256": hashlib.sha256(SUMMARY.encode()).hexdigest(), "declared_status": None},
        "worktree": {"root": str(work), "git_common_dir": common, "baseline": "auto", "observed": "auto"},
        "phase": phase, "tasks": [dict(TASK)], "current_task_id": "task-001", "current_round": 0,
        "latest_verification": [], "unresolved_findings": [], "final_audit": [],
        "next_action": next_action,
    }


def _load_json(path):
    return json.loads(path.read_text())


def write(path, payload):
    path.write_text(json.dumps(payload, indent=2))


with tempfile.TemporaryDirectory() as tmp:
    # Resolved, because `canonical_worktree` resolves both paths and macOS puts the temp directory
    # behind a symlink; an unresolved root here fails as "does not match the canonical worktree".
    work = Path(tmp) / "repo"
    work.mkdir()
    work = work.resolve()
    git(work, "init", "-q")
    git(work, "config", "user.email", "check@example.invalid")
    git(work, "config", "user.name", "check")
    (work / "file.txt").write_text("one\n")
    git(work, "add", "-A")
    git(work, "commit", "-qm", "first")

    runs = work / ".agents" / "kein" / "runs" / "execute" / "260101-000000-check"
    runs.mkdir(parents=True)
    destination = runs / "state.json"
    candidate = runs / "candidate.json"

    # 1 - the initial checkpoint fills the counter and both fingerprints from `"auto"`.
    first = state_for(work, "auto")
    first["worktree"]["baseline"] = "auto"
    write(candidate, first)
    result = run(work, "checkpoint", str(destination), str(candidate))
    if result.returncode != 0:
        failures.append(f"initial checkpoint refused: {result.stderr.strip()}")
    else:
        saved = json.loads(destination.read_text())
        if saved["revision"] != 0:
            failures.append(f"initial revision is {saved['revision']!r}, expected 0")
        observed = saved["worktree"]["observed"]
        if not isinstance(observed, dict) or len(observed.get("fingerprint", "")) != 64:
            failures.append(f"observed fingerprint was not filled: {observed!r}")

    if failures:
        for failure in failures:
            print(f"check-execute-state: {failure}", file=sys.stderr)
        raise SystemExit(1)

    # 1b - and reconciling straight after it reports no drift, because none happened.
    #
    #      This repository never saw this fail. Its own `.gitignore` hides `.agents/kein/runs/`, so the
    #      ledger a checkpoint writes is invisible to `git ls-files --others` here and the fingerprint
    #      came out stable by accident of the host repository. In a repository that tracks that path --
    #      the descvi fixture is one -- writing `state.json` changed the untracked set the fingerprint
    #      had just recorded, and the first reconcile after a clean checkpoint demanded inspection with
    #      no work done at all. There is no `.gitignore` in this fixture on purpose: it is the case that
    #      was never exercised.
    reconciled = json.loads(run(work, "reconcile", str(destination)).stdout or "{}")
    if not reconciled.get("worktree_matches"):
        failures.append("a checkpoint's own ledger write counted as worktree drift, so reconcile can never come back clean")
    if reconciled.get("required_action") != "dispatch task-001":
        failures.append(f"reconcile diverted a clean run: {reconciled.get('required_action')!r}")

    # 1c - drift that is not the ledger is still drift. An exclusion wide enough to swallow this one
    #      would leave the fingerprint reporting clean over a lane that rewrote the tree.
    (work / "stray.txt").write_text("a lane wrote this\n")
    diverged = json.loads(run(work, "reconcile", str(destination)).stdout or "{}")
    if diverged.get("worktree_matches"):
        failures.append("an untracked file outside the ledger did not register as drift")
    (work / "stray.txt").unlink()

    # 2 - the next one derives revision 1 without being told.
    second = state_for(work, "auto", next_action="dispatch task-002")
    second["worktree"]["baseline"] = json.loads(destination.read_text())["worktree"]["baseline"]
    write(candidate, second)
    result = run(work, "checkpoint", str(destination), str(candidate))
    if result.returncode != 0:
        failures.append(f"second checkpoint refused: {result.stderr.strip()}")
    elif json.loads(destination.read_text())["revision"] != 1:
        failures.append("second checkpoint did not advance the revision")

    # 3 - a candidate authored against the older state is still refused. This is the one that matters:
    #     autofill must not turn a lost update into a silent overwrite.
    stale = state_for(work, 1, next_action="written against revision 0")
    stale["worktree"]["baseline"] = second["worktree"]["baseline"]
    write(candidate, stale)
    result = run(work, "checkpoint", str(destination), str(candidate))
    if result.returncode == 0:
        failures.append("a stale revision was accepted and must not be")
    elif "revision" not in result.stderr:
        failures.append(f"stale candidate was refused for the wrong reason: {result.stderr.strip()}")

    # 4 - `"auto"` on the baseline after the run has started is refused, not re-derived. Re-deriving it
    #     would erase the drift the baseline exists to expose.
    rederive = state_for(work, "auto", next_action="tries to re-derive the baseline")
    write(candidate, rederive)
    result = run(work, "checkpoint", str(destination), str(candidate))
    if result.returncode == 0:
        failures.append("an `auto` baseline was re-derived after the run started and must not be")

    # 5 - a fingerprint that does not match the worktree is still refused when written by hand.
    (work / "file.txt").write_text("two\n")
    drifted = state_for(work, "auto")
    drifted["worktree"]["baseline"] = second["worktree"]["baseline"]
    drifted["worktree"]["observed"] = json.loads(destination.read_text())["worktree"]["observed"]
    write(candidate, drifted)
    result = run(work, "checkpoint", str(destination), str(candidate))
    if result.returncode == 0:
        failures.append("a stale observed fingerprint was accepted and must not be")

    # 6 - what a review may say, and what acceptance may stand over.
    #
    #     `severity` is the role's calibration and was never read; `blocks` is the workflow's question and cites the task's own completion condition. A `REVISE` accepts and carries its findings; a `BLOCK` does not accept; the verdict word has to agree with the role's own findings; and a carried `critical` owes a reason for not becoming a task.
    STAMP = "2026-01-01T00:00:00+09:00"

    def current():
        return json.loads(destination.read_text())

    def attempt(mutate):
        state = current()
        state["revision"] = "auto"
        state["worktree"]["observed"] = "auto"
        mutate(state)
        write(candidate, state)
        return run(work, "checkpoint", str(destination), str(candidate))

    def must(label, mutate):
        result = attempt(mutate)
        if result.returncode != 0:
            failures.append(f"{label} was refused and should not be: {result.stderr.strip()}")

    def refuse(label, mutate, reason=None):
        result = attempt(mutate)
        if result.returncode == 0:
            failures.append(f"{label} was accepted and must not be")
        elif reason and reason not in result.stderr:
            failures.append(f"{label} was refused for the wrong reason: {result.stderr.strip()}")

    def task(state):
        return state["tasks"][0]

    def finding(role, severity, blocks, **extra):
        return {"reviewer_role": role, "claim": "c", "evidence": "e", "impact": "i", "required_correction": "r",
                "severity": severity, "confidence": "high", "blocks": blocks, **extra}

    def verdict(role, word):
        return {"reviewer_role": role, "verdict": word, "task_id": "task-001", "round": 1, "worktree_fingerprint": "auto",
                "reviewed_at": STAMP, "fresh": True, "independent": True}

    verification = {"command": "run the check", "exit_code": 0, "observed_at": STAMP, "round": 1, "worktree_fingerprint": "auto"}

    def to_status(status, **fields):
        def mutate(state):
            state["phase"] = "task"
            task(state).update({"status": status, "round": 1, **fields})
        return mutate

    must("dispatching the task", to_status("implementing"))
    must("recording verification", to_status("verifying", latest_verification=[verification]))
    must("entering review", to_status("reviewing"))

    refuse("a MUST_FIX verdict", to_status("accepted",
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "MUST_FIX")]}),
        reason="one of BLOCK, PASS, REVISE")
    refuse("a finding with no blocks field", to_status("reviewing",
        unresolved_findings=[{k: v for k, v in finding("code-reviewer", "minor", None).items() if k != "blocks"}]),
        reason="missing ['blocks']")
    refuse("a blocks citation the completion condition does not contain", to_status("reviewing",
        unresolved_findings=[finding("code-reviewer", "minor", "it does the other thing")]),
        reason="not in this task's completion condition")
    must("a blocks citation the completion condition does contain", to_status("reviewing",
        unresolved_findings=[finding("code-reviewer", "minor", "does the thing")]))
    refuse("acceptance over a finding that blocks the completion condition", to_status("accepted",
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "BLOCK")]}),
        reason="cannot retain a current BLOCK")
    refuse("a PASS over the role's own finding", to_status("accepted",
        unresolved_findings=[finding("code-reviewer", "minor", None)],
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "PASS")]}),
        reason="returned PASS over its own recorded finding")
    refuse("a REVISE with nothing of its own", to_status("accepted",
        unresolved_findings=[],
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "REVISE")]}),
        reason="returned REVISE with no finding of its own")
    refuse("a carried critical with no reason for not becoming a task", to_status("accepted",
        unresolved_findings=[finding("code-reviewer", "critical", None)],
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "REVISE")]}),
        reason="carried_because")
    refuse("a carried important with no reason either", to_status("accepted",
        unresolved_findings=[finding("code-reviewer", "important", None)],
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "REVISE")]}),
        reason="carried_because")
    carried = [finding("code-reviewer", "minor", None),
               finding("code-reviewer", "important", None, carried_because="a wording defect in a docblock the next task rewrites"),
               finding("code-reviewer", "critical", None, carried_because="outside this task's scope; task-002 appended for it")]
    must("acceptance carrying a REVISE lane's findings", to_status("accepted",
        unresolved_findings=carried,
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "REVISE")]}))

    # 6b - `blocks` landed while a run was live. A finding that run recorded in the older shape stands where it stood, unchanged, until something is accepted over it; anything written new carries the field, and acceptance requires it.
    settled = current()
    legacy = {k: v for k, v in finding("code-reviewer", "minor", None).items() if k != "blocks"}
    older = current()
    older["phase"] = "task"
    task(older).update({"status": "reviewing", "round": 1, "acceptance": None, "unresolved_findings": [legacy]})
    write(destination, older)
    result = run(work, "validate", str(destination))
    if result.returncode != 0:
        failures.append(f"a state written before blocks existed no longer validates: {result.stderr.strip()}")
    def correcting(findings):
        def mutate(state):
            state["phase"] = "task"
            task(state).update({"status": "correcting", "round": 2, "latest_verification": [], "unresolved_findings": findings})
        return mutate

    must("carrying a finding written before blocks existed, unchanged", correcting([legacy]))
    refuse("acceptance over a finding written before blocks existed", to_status("accepted",
        unresolved_findings=[legacy],
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "REVISE")]}),
        reason="missing ['blocks']")
    refuse("a new finding in the older shape", correcting([legacy, {**legacy, "claim": "a second claim"}]),
        reason="Finding 1 must use the exact field set; missing ['blocks']")
    write(destination, settled)

    # 6d - the third disposition: fix it before acceptance. The reviewers read one tree, the executor corrected a non-blocking finding within its required_correction, the task's verification path re-ran on the corrected tree, and acceptance stands there with the finding recorded as fixed. No fresh lane: the finding never touched whether the task is done, and the final audit reads the whole change again.
    reviewing = current()
    reviewing["phase"] = "task"
    task(reviewing).update({"status": "reviewing", "round": 1, "acceptance": None, "unresolved_findings": []})
    write(destination, reviewing)
    reviewed_at = reviewing["worktree"]["observed"]["fingerprint"]
    fixed_minor = finding("code-reviewer", "minor", None)

    def reviewed(word):
        return dict(verdict("code-reviewer", word), worktree_fingerprint=reviewed_at)

    refuse("fixed findings recorded with nothing changed", to_status("accepted",
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [verdict("code-reviewer", "REVISE")], "fixed": [fixed_minor]}),
        reason="nothing was fixed")
    (work / "file.txt").write_text("two, corrected\n")
    refuse("acceptance on a moved tree with no fixed finding", to_status("accepted",
        latest_verification=[verification],
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [reviewed("REVISE")]}),
        reason="fingerprint does not match")
    refuse("a fix over a finding that cites the completion condition", to_status("accepted",
        latest_verification=[verification],
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [reviewed("BLOCK")], "fixed": [finding("code-reviewer", "minor", "does the thing")]}),
        reason="correction round")
    must("acceptance over a fix the gates re-ran", to_status("accepted",
        latest_verification=[verification],
        acceptance={"round": 1, "worktree_fingerprint": "auto", "reviewers": [reviewed("REVISE")], "fixed": [fixed_minor]}))
    if current()["tasks"][0]["acceptance"].get("fixed") != [fixed_minor]:
        failures.append("the acceptance did not record the fixed finding")
    (work / "file.txt").write_text("two\n")
    write(destination, settled)

    # 6c - the plan moves under the run. An owner ruling or a factual correction lands in the input; the run keeps its ledger and records why the hash moved. Three runs were aborted and reopened on the same tree before this existed.
    before = current()["input"]["sha256"]
    if run(work, "amend", str(destination), "--summary", SUMMARY, "--reason", "nothing moved").returncode == 0:
        failures.append("an amendment with an unchanged input was accepted and must not be")
    result = run(work, "amend", str(destination), "--summary", SUMMARY + ", amended", "--reason", "owner ruling U-1 moved the acceptance clause")
    if result.returncode != 0:
        failures.append(f"an amendment with a reason was refused: {result.stderr.strip()}")
    else:
        amended = current()["input"]
        entries = amended.get("amendments", [])
        if amended["sha256"] == before or len(entries) != 1 or entries[0]["from"] != before or entries[0]["to"] != amended["sha256"]:
            failures.append("the amendment did not record the move")

    def silently(state):
        moved = SUMMARY + ", moved silently"
        state["input"]["summary"] = moved
        state["input"]["sha256"] = hashlib.sha256(moved.encode()).hexdigest()
    refuse("an input change with no amendment recorded", silently, reason="amend --reason")

    # 7 - the receipt carries what the run carried, so the reader who inherits the tree inherits the findings.
    def to_final_audit(state):
        # The whole-change audit binds to the run's own round, not the task's.
        state["phase"] = "final_audit"
        state["latest_verification"] = [dict(verification, round=state["current_round"])]
        state["final_audit"] = [dict(verdict("code-reviewer", "PASS"), task_id="whole-change", round=state["current_round"])]
    must("entering final audit", to_final_audit)
    accepted = current()
    receipt = {
        "schema_version": 1, "revision": "auto", "workflow": "execute", "run_id": accepted["run_id"],
        "lifecycle": "completed", "completed_at": STAMP,
        "input": {"reference": None, "sha256": accepted["input"]["sha256"]},
        "worktree": {"root": accepted["worktree"]["root"], "final_fingerprint": "auto"},
        "accepted_tasks": [{"id": "task-001", "title": "the only task", "completion_condition": "it does the thing", "carried_findings": []}],
        "final_verification": accepted["latest_verification"], "final_audit": accepted["final_audit"],
        "carried_findings": [],
    }
    write(candidate, receipt)
    if run(work, "checkpoint", str(destination), str(candidate)).returncode == 0:
        failures.append("a receipt that dropped the task's carried findings was accepted and must not be")
    receipt["accepted_tasks"][0]["carried_findings"] = carried
    write(candidate, receipt)
    if run(work, "checkpoint", str(destination), str(candidate)).returncode == 0:
        failures.append("a receipt that dropped the input's amendments was accepted and must not be")
    receipt["input"]["amendments"] = accepted["input"]["amendments"]
    write(candidate, receipt)
    result = run(work, "checkpoint", str(destination), str(candidate))
    if result.returncode != 0:
        failures.append(f"the receipt carrying the findings was refused: {result.stderr.strip()}")

    # 7 - split-check measures scopes as the ledger wrote them: a directory covers what is under it, a
    # pending task still to be done here counts, an accepted one does not, and a task already active
    # cannot be sent out. It reports; it does not decide.
    split_root = work / ".agents" / "kein" / "runs" / "execute" / "260101-000001-split"
    split_root.mkdir(parents=True)
    split_tasks = candidate.parent / "split-tasks.json"
    write(split_tasks, [
        {"id": "task-001", "title": "a", "scope": ["src/a.py"], "completion_condition": "a", "verification_path": ["check a"], "rationale": "fixture"},
        {"id": "task-002", "title": "b", "scope": ["src/b/"], "completion_condition": "b", "verification_path": ["check b"], "rationale": "fixture"},
        {"id": "task-003", "title": "c", "scope": ["src/b/x.py"], "completion_condition": "c", "verification_path": ["check c"], "rationale": "fixture"},
        {"id": "task-004", "title": "d", "scope": ["docs/"], "completion_condition": "d", "verification_path": ["check d"], "rationale": "fixture"},
        {"id": "task-005", "title": "e", "scope": ["src/bx.py"], "completion_condition": "e", "verification_path": ["check e"], "rationale": "fixture"},
    ])
    split_state = split_root / "state.json"
    result = run(work, "start", str(split_state), "--kind", "brief", "--summary", "split fixture", "--worktree", str(work), "--tasks", str(split_tasks))
    if result.returncode != 0:
        failures.append(f"the split fixture run did not start: {result.stderr.strip()}")
    else:
        result = run(work, "split-check", str(split_state), "task-004", "task-005")
        if result.returncode != 0 or not json.loads(result.stdout)["disjoint"]:
            failures.append("two tasks whose scopes meet nothing were reported as colliding")
        result = run(work, "split-check", str(split_state), "task-002", "task-004")
        report = json.loads(result.stdout) if result.stdout else {}
        if result.returncode == 0 or not any(o["tasks"] == ["task-002", "task-003"] and "src/b/ ~ src/b/x.py" in o["paths"] for o in report.get("overlaps", [])):
            failures.append("a directory scope over a remaining task's file was not reported as a collision")
        if any("task-005" in o["tasks"] for o in report.get("overlaps", [])):
            failures.append("`src/b/` was read as covering `src/bx.py`, which it does not")
        result = run(work, "split-check", str(split_state), "task-001", "task-001")
        if result.returncode == 0:
            failures.append("naming a task twice was accepted")
        result = run(work, "split-check", str(split_state), "task-009")
        if result.returncode == 0:
            failures.append("an unknown task id was accepted")
        # Dispatch task-001, then it is no longer a task that can go out; and once accepted its scope no longer counts.
        active = _load_json(split_state)
        active["revision"] = "auto"; active["worktree"]["observed"] = "auto"
        active["tasks"][0]["status"] = "implementing"; active["tasks"][0]["round"] = 1; active["current_round"] = 1
        active["next_action"] = "implement task-001"
        write(candidate, active)
        result = run(work, "checkpoint", str(split_state), str(candidate))
        if result.returncode != 0:
            failures.append(f"the split fixture could not dispatch its first task: {result.stderr.strip()}")
        result = run(work, "split-check", str(split_state), "task-001")
        if result.returncode == 0:
            failures.append("an active task was allowed out of the ledger")

if failures:
    for failure in failures:
        print(f"check-execute-state: {failure}", file=sys.stderr)
    raise SystemExit(1)
print("check-execute-state: derived values fill in, neither a stale revision nor a stale fingerprint passes, and acceptance carries what a REVISE found and refuses what a BLOCK cites, and split-check reads scopes as written")
