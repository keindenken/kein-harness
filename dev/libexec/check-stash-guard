#!/usr/bin/env sh
#: Feed the stash guard the calls it must refuse and the ones it must not, and fail if either side moved.
#
# The guard is a PreToolUse hook on Bash. It reads one thing to decide whose call it is -- the `agent_id` / `agent_type` fields a subagent's tool events carry -- and one thing to decide what the call does. Both halves are driven here from synthetic hook input, because the hook only loads at session start and a live probe cannot run inside the session that edits it.
set -eu

GUARD="${KEIN_ROOT:?}/hooks/stash-guard.py"
failures=0

run() { printf '%s' "$2" | python3 -c '
import json,sys
agent, cmd = sys.argv[1], sys.stdin.read()
payload = {"tool_name": "Bash", "tool_input": {"command": cmd}, "session_id": "s", "cwd": "/tmp", "hook_event_name": "PreToolUse"}
if agent == "sub":
    payload["agent_id"] = "a1"; payload["agent_type"] = "kein:executor"
print(json.dumps(payload))' "$1" | python3 "$GUARD" 2>/dev/null; }

refuse() { label=$1; shift; if run "$@"; then printf 'check-stash-guard: %s was allowed and must not be\n' "$label" >&2; failures=$((failures + 1)); fi; }
allow()  { label=$1; shift; if ! run "$@"; then printf 'check-stash-guard: %s was refused and should not be\n' "$label" >&2; failures=$((failures + 1)); fi; }

refuse "a subagent's bare git stash"            sub  'git stash'
refuse "a subagent's git stash pop"             sub  'git status && git stash pop'
refuse "a subagent's tagged push"               sub  'git stash push -u -m "wip-x"'
refuse "a subagent's stash through -C"          sub  'git -C /some/tree stash drop'
refuse "a subagent's stash after cd"            sub  'cd pkg; git stash; ls'
allow  "a subagent's git stash list"            sub  'git stash list --format="%H %gs"'
allow  "a subagent's git stash show"            sub  'git stash show -p stash@{0}'
allow  "a subagent's unrelated git"             sub  'git status --short && git diff --stat'
allow  "a subagent mentioning stash in a string" sub  'grep -rn "git stash" docs/'
allow  "the lead's git stash pop"               main 'git stash pop'
allow  "the lead's bare git stash"              main 'git stash'

if [ "$failures" -ne 0 ]; then
  printf 'check-stash-guard: %d check(s) failed\n' "$failures" >&2
  exit 1
fi
printf 'check-stash-guard: a worker cannot move the shared stash stack, can still read it, and the lead is untouched\n'
