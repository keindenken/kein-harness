#!/usr/bin/env python3
#: Prove a finished eval run drops its scaffolding and keeps every transcript.
#
# Two things a run leaves behind are not evidence, and until now neither had a test. A `--variant`
# arm registers a worktree on the harness's own repository and nothing removed it; a pinned config
# home is vendor scaffolding wrapped around the one directory in a run that holds each lane's own
# transcript. Both are cleaned when a run ends, and the danger in cleaning is asymmetric: leaving a
# worktree registered is clutter, deleting `projects/` is a silent loss of the only copy of what an
# architect or a critic actually said. Nothing else reads these paths, so nothing else would notice.
import contextlib
import importlib.util
import io
import os
import subprocess
import sys
import tempfile
from pathlib import Path

DEV_ROOT = Path(os.environ["KEIN_DEV_ROOT"])
spec = importlib.util.spec_from_file_location("kein_eval_run", DEV_ROOT / "eval" / "run.py")
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)

failures = []


def git(work, *args):
    return subprocess.run(["git", *args], cwd=work, capture_output=True, text=True, check=True)


def registered(repo):
    listing = git(repo, "worktree", "list", "--porcelain").stdout
    return [line.split(" ", 1)[1] for line in listing.splitlines() if line.startswith("worktree ")]


with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)

    # --- a --variant run's checkouts ---------------------------------------------------------
    repo = tmp / "harness"
    repo.mkdir()
    git(repo, "init", "--quiet", "--initial-branch", "main")
    (repo / "plugin").mkdir()
    (repo / "plugin" / "marker.md").write_text("a plugin\n")
    git(repo, "add", "-A")
    git(repo, "-c", "user.email=c@k", "-c", "user.name=c", "commit", "--quiet", "-m", "one")

    run_dir = tmp / "run"
    (run_dir / "refs").mkdir(parents=True)
    for name in ("before", "after"):
        git(repo, "worktree", "add", "--detach", "--quiet", str(run_dir / "refs" / name), "HEAD")
    if len(registered(repo)) != 3:
        failures.append("the fixture did not register two variant checkouts, so nothing was tested")

    # A removal that cannot succeed has to be reported rather than swallowed, or a run announces a
    # clean finish while a worktree stays registered.
    stray = tmp / "not-a-repo"
    (stray / "before").mkdir(parents=True)
    complaint = io.StringIO()
    with contextlib.redirect_stderr(complaint):
        module.retire_worktrees(stray, stray)
    if not (stray / "before").is_dir():
        failures.append("a directory was dropped by a git call that could not have succeeded")
    if "still a registered worktree" not in complaint.getvalue():
        failures.append("a failed removal said nothing, so a run would report a clean finish over it")

    # An arm whose run raised is registered like any other and named by no record, so the sweep has
    # to read the directory rather than a list of what the run thinks it finished.
    git(repo, "worktree", "add", "--detach", "--quiet", str(run_dir / "worktrees" / "with-skill"), "HEAD")

    # The function derives the repository from KEIN_ROOT, which is the plugin directory inside it.
    module.KEIN_ROOT = repo / "plugin"
    module.retire_variant_checkouts(run_dir)
    module.retire_worktrees(run_dir / "worktrees", repo)

    if (run_dir / "refs" / "before").exists() or (run_dir / "refs" / "after").exists():
        failures.append("a variant checkout survived retirement")
    if (run_dir / "worktrees" / "with-skill").exists():
        failures.append("an arm worktree no record names survived retirement")
    if len(registered(repo)) != 1:
        failures.append(f"a checkout is still a registered worktree: {registered(repo)}")

    # A run that never used --variant has no refs/ at all, and must not be an error.
    module.retire_variant_checkouts(tmp / "run-without-variants")
    module.retire_worktrees(tmp / "run-without-variants" / "worktrees", repo)

    # --- a replicate's config home ------------------------------------------------------------
    home = tmp / "config-homes" / "with-skill-0"
    slug = "-Users-someone-worktrees-with-skill-0"
    session = home / "projects" / slug / "5f71a5f7"
    (session / "subagents").mkdir(parents=True)
    lead = home / "projects" / slug / "5f71a5f7.jsonl"
    lead.write_text('{"type":"assistant"}\n')
    lane = session / "subagents" / "agent-aa95f89b.jsonl"
    lane_text = '{"type":"assistant","isSidechain":true}\n'
    lane.write_text(lane_text)
    (home / "backups").mkdir()
    (home / "backups" / ".claude.json.backup.1786714538099").write_text("{}\n")
    (home / ".claude.json").write_text("{}\n")
    (home / ".last-cleanup").write_text("0\n")

    destination = run_dir / "transcripts" / "with-skill-0"
    module.retire_config_home(home, destination)

    if home.exists():
        failures.append("the config home survived retirement")
    # The lane transcript is the whole point. The event stream carries the lead's turns only, so
    # this file is the only record anywhere of what the subagent was asked and what it answered.
    promoted_lane = destination / slug / "5f71a5f7" / "subagents" / "agent-aa95f89b.jsonl"
    if not promoted_lane.is_file():
        failures.append("a lane transcript did not survive retirement, which is the only copy there is")
    elif promoted_lane.read_text() != lane_text:
        failures.append("a lane transcript was altered in transit")
    if not (destination / slug / "5f71a5f7.jsonl").is_file():
        failures.append("the lead transcript did not survive retirement")
    # The project-slug directory names are the record of every working directory the run opened a
    # session in, which is how a lane pointed at live work was caught once. Flattening loses it.
    if not (destination / slug).is_dir():
        failures.append("the project slug was flattened away, and with it the record of where lanes ran")

    # A config home that never opened a session leaves nothing to promote and must still be removed.
    bare = tmp / "config-homes" / "bare"
    bare.mkdir(parents=True)
    (bare / ".claude.json").write_text("{}\n")
    module.retire_config_home(bare, run_dir / "transcripts" / "bare")
    if bare.exists():
        failures.append("a config home with no transcripts survived retirement")
    if (run_dir / "transcripts" / "bare").exists():
        failures.append("an empty transcript directory was created for a home that had none")

if failures:
    for failure in failures:
        print(f"check-eval-retire: {failure}", file=sys.stderr)
    raise SystemExit(1)
print("check-eval-retire: variant checkouts and config homes are retired, transcripts and their slugs survive")
