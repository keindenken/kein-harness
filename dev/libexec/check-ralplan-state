#!/usr/bin/env sh
#: Drive a full RALPLAN run through the state machine and fail if any invariant stopped holding.
#
# The state machine owns the only thing that makes the consensus gate more than ceremony: a blocking finding cannot be skipped, findings cannot be dropped without changing the plan, and a round cannot be re-reviewed without advancing.
# It also owns the half that keeps the gate from becoming a wall: a non-blocking finding reaches approval instead of being spent on a round, and a blocking one can be deferred only with a written reason and a named catcher beside it.
# Those rules are enforced across `validate_transition` and the transition builders, and nothing else in this repository exercises them.
#
# Written after a change to those rules shipped with a hole in it: `approve` ran happily from a `drafted` phase because the approval branch keyed on the artifact's own `Status`, and only driving a whole run end to end surfaced it.
set -eu

CMD="python3 ${KEIN_ROOT:?}/skills/ralplan/scripts/state.py"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
RUN="$WORK/260101-000000-check"
mkdir -p "$RUN"
ST="$RUN/state.json"
PLAN="$WORK/plan.md"
failures=0

header() { printf '# Check plan\n\nStatus: %s — %s\n\n---\n\n%s\n' "$1" "$2" "$3" > "$PLAN"; }
must()   { if ! $CMD "$@" >/dev/null 2>&1; then printf 'check-ralplan-state: %s was refused and should not be\n' "$1" >&2; failures=$((failures + 1)); fi; }
refuse() { label=$1; shift; if $CMD "$@" >/dev/null 2>&1; then printf 'check-ralplan-state: %s was accepted and must not be\n' "$label" >&2; failures=$((failures + 1)); fi; }

header Draft "Drafted." "body v0"
must start "$ST" --plan "$PLAN" --summary "Check task" --lanes architect@claude,critic@claude

refuse "a second start over a live run" start "$ST" --plan "$PLAN" --summary "Check task" --lanes architect@claude,critic@claude
refuse "approval before any round opened" approve "$ST"

header "In Review" "Reviewing round 1." "body v0"
must open "$ST"

F='"claim":"c","evidence":"e","impact":"i","required_correction":"r"'
printf '[{"lane":"critic@claude",%s,"blocking":"architecture"}]\n' "$F" > "$WORK/f.json"

# Severity is a claim against the contract's five grounds, not a free word, and a deferral answers a ground -- so a finding that named none has nothing to defer.
printf '[{"lane":"critic@claude",%s,"blocking":"vibes"}]\n' "$F" > "$WORK/f-ground.json"
printf '[{"lane":"critic@claude",%s,"blocking":null,"deferral":{"reason":"r","caught_by":"S1"}}]\n' "$F" > "$WORK/f-nogroup.json"
refuse "a blocking ground outside the vocabulary" block "$ST" --findings "$WORK/f-ground.json"
refuse "a deferral over a finding that named no ground" block "$ST" --findings "$WORK/f-nogroup.json"

must block "$ST" --findings "$WORK/f.json"

refuse "clearing findings without a review-content change" revised "$ST"
refuse "opening a round while findings are unresolved" open "$ST"

header "In Review" "Drafted." "body v1, revised"

# The closure slot the review contract described and the state had nowhere to put. Both directions:
# a negative disposition has to reach `approve`, and the field has to refuse a word outside its set.
printf '[{"lane":"critic@claude","finding":"c","disposition":"NOT CLOSED","evidence":"still there"}]\n' > "$WORK/c-open.json"
printf '[{"lane":"critic@claude","finding":"c","disposition":"CLOSED","evidence":"gone"}]\n' > "$WORK/c-done.json"
printf '[{"lane":"critic@claude","finding":"c","disposition":"MAYBE","evidence":"e"}]\n' > "$WORK/c-bad.json"

refuse "a closure disposition outside the vocabulary" revised "$ST" --closure "$WORK/c-bad.json"
must revised "$ST" --closure "$WORK/c-open.json"

refuse "approval from a drafted phase" approve "$ST"

header "In Review" "Reviewing round 2." "body v1, revised"
must open "$ST"
header Approved "Approved at round 2." "body v1, revised"
refuse "approval over an unclosed closure disposition" approve "$ST"

# A later revision replaces the disposition rather than inheriting it, which is why `revised` writes
# on every call. Back through a round so the closed reading is the one approval sees.
header "In Review" "Drafted." "body v2, closed"
must revised "$ST" --closure "$WORK/c-done.json"
header "In Review" "Reviewing round 3." "body v2, closed"
must open "$ST"
header Approved "Approved at round 3." "body v2, closed"

# What approval may stand over. The blocking half needs a deferral; the non-blocking half needs the lane to have said so, which is the one severity call the state can re-derive instead of trusting.
DEFER='"deferral":{"reason":"the ground does not hold: the gate reads it after the port lands","caught_by":"S1a, whose gate drives it"}'
printf '[{"lane":"architect@claude",%s,"blocking":"safety"}]\n' "$F" > "$WORK/f-bare.json"
printf '[{"lane":"architect@claude",%s,"blocking":"safety","deferral":{"reason":"r"}}]\n' "$F" > "$WORK/f-halfdefer.json"
printf '[{"lane":"critic@claude",%s,"blocking":null}]\n' "$F" > "$WORK/f-carry.json"
printf '[{"lane":"critic@claude",%s,"blocking":null},{"lane":"architect@claude",%s,"blocking":"safety",%s}]\n' "$F" "$F" "$DEFER" > "$WORK/f-approved.json"

refuse "approval over a blocking finding with no deferral" approve "$ST" --findings "$WORK/f-bare.json"
refuse "a deferral with no named catcher" approve "$ST" --findings "$WORK/f-halfdefer.json"
refuse "a PASS standing over the same lane's own finding" approve "$ST" --findings "$WORK/f-carry.json"
refuse "a BLOCK with nothing blocking behind it" approve "$ST" --verdict architect@claude=BLOCK

must approve "$ST" --findings "$WORK/f-approved.json" --verdict critic@claude=REVISE --verdict architect@claude=BLOCK
must complete "$ST"

if ! $CMD reconcile "$ST" >/dev/null 2>&1; then
  printf 'check-ralplan-state: the completed receipt does not reconcile\n' >&2
  failures=$((failures + 1))
fi
refuse "a transition out of a terminal receipt" open "$ST"

if [ "$failures" -ne 0 ]; then
  printf 'check-ralplan-state: %d check(s) failed\n' "$failures" >&2
  exit 1
fi
printf 'check-ralplan-state: the run drove clean and every refusal held\n'
