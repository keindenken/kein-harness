#!/usr/bin/env sh
#: Drive a full RALPLAN run through the state machine and fail if any invariant stopped holding.
#
# The state machine owns the only thing that makes the consensus gate more than ceremony: a blocking finding cannot be skipped, findings cannot be dropped without changing the plan, and a round cannot be re-reviewed without advancing.
# It also owns the half that keeps the gate from becoming a wall: a non-blocking finding reaches approval instead of being spent on a round, and a blocking one can be deferred only with a written reason and a named catcher beside it.
# Those rules are enforced across `validate_transition` and the transition builders, and nothing else in this repository exercises them.
#
# Written after a change to those rules shipped with a hole in it: `approve` ran happily from a `drafted` phase because the approval branch keyed on the artifact's own `Status`, and only driving a whole run end to end surfaced it.
set -eu

CMD="python3 ${KEIN_ROOT:?}/skills/ralplan/scripts/state.py"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
RUN="$WORK/260101-000000-check"
mkdir -p "$RUN"
ST="$RUN/state.json"
PLAN="$WORK/plan.md"
failures=0

# An empty reason writes the bare `Status: <word>` line, which is the only shape `In Review` takes.
header() { if [ -n "$2" ]; then line="$1 — $2"; else line="$1"; fi; printf '# Check plan\n\nStatus: %s\n\n---\n\n%s\n' "$line" "$3" > "$PLAN"; }
must()   { if ! $CMD "$@" >/dev/null 2>&1; then printf 'check-ralplan-state: %s was refused and should not be\n' "$1" >&2; failures=$((failures + 1)); fi; }
refuse() { label=$1; shift; if $CMD "$@" >/dev/null 2>&1; then printf 'check-ralplan-state: %s was accepted and must not be\n' "$label" >&2; failures=$((failures + 1)); fi; }

header Draft "Drafted." "body v0"
must start "$ST" --plan "$PLAN" --summary "Check task" --lanes architect@claude,critic@claude

refuse "a second start over a live run" start "$ST" --plan "$PLAN" --summary "Check task" --lanes architect@claude,critic@claude
refuse "approval before any round opened" approve "$ST"

header "In Review" "" "body v0"
must open "$ST"

F='"claim":"c","evidence":"e","impact":"i","required_correction":"r"'
printf '[{"lane":"critic@claude",%s,"blocking":"architecture"}]\n' "$F" > "$WORK/f.json"

# Severity is a claim against the contract's five grounds, not a free word, and a deferral answers a ground -- so a finding that named none has nothing to defer.
printf '[{"lane":"critic@claude",%s,"blocking":"vibes"}]\n' "$F" > "$WORK/f-ground.json"
printf '[{"lane":"critic@claude",%s,"blocking":null,"deferral":{"reason":"r","caught_by":"S1"}}]\n' "$F" > "$WORK/f-nogroup.json"
refuse "a blocking ground outside the vocabulary" block "$ST" --findings "$WORK/f-ground.json"
refuse "a deferral over a finding that named no ground" block "$ST" --findings "$WORK/f-nogroup.json"

must block "$ST" --findings "$WORK/f.json"

refuse "clearing findings without a review-content change" revised "$ST"
refuse "opening a round while findings are unresolved" open "$ST"

header "In Review" "" "body v1, revised"

# The closure slot the review contract described and the state had nowhere to put. Both directions:
# a negative disposition has to reach `approve`, and the field has to refuse a word outside its set.
printf '[{"lane":"critic@claude","finding":"c","disposition":"NOT CLOSED","evidence":"still there"}]\n' > "$WORK/c-open.json"
printf '[{"lane":"critic@claude","finding":"c","disposition":"CLOSED","evidence":"gone"}]\n' > "$WORK/c-done.json"
printf '[{"lane":"critic@claude","finding":"c","disposition":"MAYBE","evidence":"e"}]\n' > "$WORK/c-bad.json"

refuse "a closure disposition outside the vocabulary" revised "$ST" --closure "$WORK/c-bad.json"
must revised "$ST" --closure "$WORK/c-open.json"

refuse "approval from a drafted phase" approve "$ST"

header "In Review" "" "body v1, revised"
# A vendor fallback is a roster change at round open. The role has to survive it, or a lane that blocked could be dropped and the plan approved without it.
refuse "opening a round with a blocking role dropped" open "$ST" --lanes architect@claude
must open "$ST" --lanes architect@claude,critic@codex
header Approved "Approved at round 2." "body v1, revised"
refuse "approval over an unclosed closure disposition" approve "$ST"

# A later revision replaces the disposition rather than inheriting it, which is why `revised` writes
# on every call. Back through a round so the closed reading is the one approval sees.
header "In Review" "" "body v2, closed"
must revised "$ST" --closure "$WORK/c-done.json"
header "In Review" "" "body v2, closed"
refuse "changing the roster outside a round open" approve "$ST" --verdict critic@claude=PASS
must open "$ST" --lanes architect@claude,critic@claude
header Approved "Approved at round 3." "body v2, closed"

# What approval may stand over. The blocking half needs a deferral; the non-blocking half needs the lane to have said so, which is the one severity call the state can re-derive instead of trusting.
DEFER='"deferral":{"reason":"the ground does not hold: the gate reads it after the port lands","caught_by":"S1a, whose gate drives it"}'
printf '[{"lane":"architect@claude",%s,"blocking":"safety"}]\n' "$F" > "$WORK/f-bare.json"
printf '[{"lane":"architect@claude",%s,"blocking":"safety","deferral":{"reason":"r"}}]\n' "$F" > "$WORK/f-halfdefer.json"
printf '[{"lane":"critic@claude",%s,"blocking":null}]\n' "$F" > "$WORK/f-carry.json"
printf '[{"lane":"critic@claude",%s,"blocking":null},{"lane":"architect@claude",%s,"blocking":"safety",%s}]\n' "$F" "$F" "$DEFER" > "$WORK/f-approved.json"

refuse "approval over a blocking finding with no deferral" approve "$ST" --findings "$WORK/f-bare.json"
refuse "a deferral with no named catcher" approve "$ST" --findings "$WORK/f-halfdefer.json"
refuse "a PASS standing over the same lane's own finding" approve "$ST" --findings "$WORK/f-carry.json" --verdict critic@claude=PASS
refuse "a BLOCK with nothing blocking behind it" approve "$ST" --verdict architect@claude=BLOCK
printf '[{"lane":"critic@codex",%s,"blocking":null}]\n' "$F" > "$WORK/f-stranger.json"
refuse "a finding from a lane outside the roster" approve "$ST" --findings "$WORK/f-stranger.json"

# The word is checked the moment it is recorded, whatever the artifact's Status says. The run that found this approved under `In Review` and learned at `close` that nothing could rewrite the word.
header "In Review" "" "body v2, closed"
refuse "a PASS over the lane's own finding while Status is still In Review" approve "$ST" --findings "$WORK/f-carry.json" --verdict critic@claude=PASS
header Approved "Approved at round 3." "body v2, closed"

# The word is derived from the findings, so an approval needs no --verdict to say REVISE or BLOCK; and an approval standing on the same round and hash may be restated, findings and words together.
must approve "$ST" --findings "$WORK/f-approved.json"
if [ "$(grep -c '"verdict": "REVISE"' "$ST")" -ne 1 ] || [ "$(grep -c '"verdict": "BLOCK"' "$ST")" -ne 1 ]; then
  printf 'check-ralplan-state: approve did not derive REVISE and BLOCK from the findings it was handed\n' >&2
  failures=$((failures + 1))
fi
refuse "a PASS overriding the lane's own finding on re-approval" approve "$ST" --findings "$WORK/f-approved.json" --verdict critic@claude=PASS
refuse "re-approval that drops the findings it stood over" approve "$ST"
must approve "$ST" --findings "$WORK/f-approved.json" --verdict critic@claude=REVISE --verdict architect@claude=BLOCK
must close "$ST"
# `complete` is kept as an alias for callers that learned it before the rename; the receipt above came from `close`, so only the name is checked here.
if ! $CMD complete --help >/dev/null 2>&1; then
  printf 'check-ralplan-state: the complete alias no longer parses\n' >&2
  failures=$((failures + 1))
fi

if ! $CMD reconcile "$ST" >/dev/null 2>&1; then
  printf 'check-ralplan-state: the completed receipt does not reconcile\n' >&2
  failures=$((failures + 1))
fi
refuse "a transition out of a terminal receipt" open "$ST"

# The Status line a lane can read. While a gate is open it carries nothing about the run, and an approval says why in one line.
header "In Review" "round 2 blocked on architecture" "body"
refuse "an In Review Status line carrying the run's account" validate-plan "$PLAN"
header Approved "" "body"
refuse "an Approved Status line with no reason" validate-plan "$PLAN"
header Draft "" "body"
must validate-plan "$PLAN"

# Fix-it: approve over a REVISE finding, correct it in the text, and reach the receipt with no further round.
# The verdicts stay bound to the text the lanes read, the fix records the move, and only a finding that named no ground can be fixed.
ST2="$WORK/260101-000001-fix/state.json"
header Draft "Drafted." "fix body v0"
must start "$ST2" --plan "$PLAN" --summary "Fix task" --lanes architect@claude,critic@claude --primed
header "In Review" "" "fix body v0"
must open "$ST2"
header Approved "Two lanes, one REVISE carried." "fix body v0"
printf '[{"lane":"critic@claude",%s,"blocking":null}]\n' "$F" > "$WORK/fx-revise.json"
printf '[{"lane":"critic@claude",%s,"blocking":null},{"lane":"architect@claude",%s,"blocking":"safety",%s}]\n' "$F" "$F" "$DEFER" > "$WORK/fx-both.json"
printf '[{"lane":"architect@claude",%s,"blocking":"safety",%s}]\n' "$F" "$DEFER" > "$WORK/fx-deferred.json"
must approve "$ST2" --findings "$WORK/fx-both.json"
refuse "a fix with no content change" fix "$ST2" --findings "$WORK/fx-revise.json"
header Approved "Two lanes, one REVISE carried." "fix body v1, the REVISE item corrected"
refuse "a fix naming a deferred BLOCK finding" fix "$ST2" --findings "$WORK/fx-deferred.json"
printf '[{"lane":"critic@claude","claim":"never raised","evidence":"e","impact":"i","required_correction":"r","blocking":null}]\n' > "$WORK/fx-stranger.json"
refuse "a fix naming a finding the approval did not stand over" fix "$ST2" --findings "$WORK/fx-stranger.json"
must fix "$ST2" --findings "$WORK/fx-revise.json"
refuse "re-approving over a fixed plan at the corrected hash" approve "$ST2" --findings "$WORK/fx-deferred.json"
if $CMD approve "$ST2" --findings "$WORK/fx-deferred.json" 2>&1 | grep -q "not restated after a fix"; then :; else
  printf 'check-ralplan-state: a restated approval after a fix is not refused for that reason\n' >&2
  failures=$((failures + 1))
fi
must close "$ST2"
if ! grep -q '"fixes"' "$ST2" || ! grep -q '"primed": true' "$ST2" || ! grep -q '"round": 1' "$ST2"; then
  printf 'check-ralplan-state: the receipt dropped the fix record, the primed flag or the round\n' >&2
  failures=$((failures + 1))
fi
if ! $CMD reconcile "$ST2" >/dev/null 2>&1; then
  printf 'check-ralplan-state: a receipt with a fix does not reconcile\n' >&2
  failures=$((failures + 1))
fi

# --max-rounds: a BLOCK standing at the bound stops the run blocked instead of revising, and the next round opens only by raising the bound.
ST3="$WORK/260101-000002-bound/state.json"
header Draft "Drafted." "bound body v0"
must start "$ST3" --plan "$PLAN" --summary "Bound task" --lanes architect@claude,critic@claude --max-rounds 1
header "In Review" "" "bound body v0"
must open "$ST3"
refuse "a stop at --max-rounds while the artifact still reads In Review" block "$ST3" --findings "$WORK/f.json"
header Draft "" "bound body v0"
must block "$ST3" --findings "$WORK/f.json"
if [ ! -s "$(dirname "$ST3")/round-1-plan.md" ] || [ ! -s "$(dirname "$ST3")/round-1-findings.json" ]; then
  printf 'check-ralplan-state: block did not leave the reviewed text and findings beside the run\n' >&2
  failures=$((failures + 1))
fi
if ! grep -q '"phase": "blocked"' "$ST3"; then
  printf 'check-ralplan-state: a BLOCK at --max-rounds did not stop the run blocked\n' >&2
  failures=$((failures + 1))
fi
header Draft "" "bound body v1"
must revised "$ST3"
header "In Review" "" "bound body v1"
refuse "a round past --max-rounds" open "$ST3"
must open "$ST3" --max-rounds 2

ST4="$WORK/260101-000003-lower/state.json"
header Draft "Drafted." "lower body v0"
must start "$ST4" --plan "$PLAN" --summary "Lower task" --lanes architect@claude,critic@claude --max-rounds 3
header "In Review" "" "lower body v0"
refuse "lowering --max-rounds" open "$ST4" --max-rounds 2

if [ "$failures" -ne 0 ]; then
  printf 'check-ralplan-state: %d check(s) failed\n' "$failures" >&2
  exit 1
fi
printf 'check-ralplan-state: the run drove clean and every refusal held\n'
