#!/usr/bin/env sh
# kein-dev — the commands that build and gate the harness, rather than run under it.
#
# These were `ocs` subcommands. They came out because `ocs --help` is a surface an agent
# reads mid-task, and half of what it listed was maintenance the agent has no reason to
# run -- two entries of which (`sync-prompts`, `render-agents`) overwrite generated
# artifacts. The split is by audience, not by layer: `ocs` is what an agent doing work
# calls, and this is what a person building the harness calls.
#
# The whole tree lives at `dev/` and NOT under `plugin/`, because a plugin folder is loaded
# whole and installed wholesale: every file here would ship to anyone who installs the
# harness, and anything in `plugin/bin/` would additionally become a bare command on the
# Bash tool's PATH wherever the plugin is enabled.
set -eu

# Three roots, because these commands operate ON the plugin from OUTSIDE it.
# KEIN_ROOT is the plugin they read and write: agents/, libexec/lib/.
# KEIN_REPO_ROOT holds what is NOT shipped, and the role library at `agents/` is the part of that
# these commands render from -- a plugin carries the rendered copy, never the source.
# KEIN_DEV_ROOT is this tree, and is how a subcommand reaches a sibling without assuming
# it was copied along with the plugin -- `eval` builds a variant arm from an arbitrary
# older commit, whose plugin has no dev tooling in it at all.
# No CLAUDE_PLUGIN_ROOT fallback: this runs from a clone, never from an installed plugin.
KEIN_DEV_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
KEIN_REPO_ROOT=$(CDPATH= cd -- "$KEIN_DEV_ROOT/.." && pwd)
KEIN_ROOT="$KEIN_REPO_ROOT/plugin"
export KEIN_DEV_ROOT KEIN_REPO_ROOT KEIN_ROOT

KEIN_VERSION=$(
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$KEIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null | head -1
)
KEIN_VERSION=${KEIN_VERSION:-unknown}

usage() {
  cat <<EOF
kein-dev — harness development CLI (v${KEIN_VERSION})

Usage:
  kein-dev <command> [args...]
  kein-dev help
  kein-dev version

Commands:
$(list_commands)
EOF
}

list_commands() {
  found=0
  for f in "$KEIN_DEV_ROOT"/libexec/*; do
    [ -f "$f" ] && [ -x "$f" ] || continue
    found=1
    name=${f##*/}
    # First `#:` comment line in a subcommand is its one-line summary.
    summary=$(sed -n 's/^#:[[:space:]]*//p' "$f" 2>/dev/null | head -1)
    printf '  %-14s %s\n' "$name" "$summary"
  done
  [ "$found" -eq 1 ] || printf '  (none yet — add an executable at dev/libexec/<name>)\n'
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
  help | -h | --help)
    usage
    ;;
  version | -v | --version)
    printf '%s\n' "$KEIN_VERSION"
    ;;
  *)
    sub="$KEIN_DEV_ROOT/libexec/$cmd"
    if [ -x "$sub" ]; then
      exec "$sub" "$@"
    fi
    printf 'kein-dev: unknown command '\''%s'\''\n\n' "$cmd" >&2
    usage >&2
    exit 1
    ;;
esac
