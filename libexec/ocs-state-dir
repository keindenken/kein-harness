#!/usr/bin/env sh
#: Print (and create) a kein state directory for the current project.
#
# State lives in the repository, not in a vendor's config home, so a run
# started from Claude can be resumed from Codex and the reverse. A ledger
# parked under ~/.claude would be invisible to half the harness.
#
# `.agents/` is the vendor-neutral namespace already in use at both the project
# and home level, so kein takes a subdirectory there rather than claiming
# another top-level dotdir.
set -eu

sub=${1:-}

if root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -n "$root" ]; then
  base="$root/.agents/kein"
else
  # No repository in scope. Fall back to the config home, following
  # CLAUDE_CONFIG_DIR so separated environments keep separated state.
  base="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kein"
fi

[ -n "$sub" ] && base="$base/$sub"

mkdir -p "$base"
printf '%s\n' "$base"
