+          else if (owner === null) empty++;
+          else if (CORNER_COMPASSES.includes(owner)) otherCorner++;
+          else edge++;
+        }
+      }
+      report[compass] = { diagonal, edge, otherCorner, empty, total };
+    }
+    return report;
+  }
