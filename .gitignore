.DS_Store
node_modules/

# Bytecode the checks themselves produce: they import the state machines under test, so without this the run's own verification moves the worktree fingerprint it just sealed.
__pycache__/

# Transient run state. Deliverables under .agents/kein/ are tracked.
.agents/kein/runs/

# Harvested corpora are tens of megabytes of other people's files; the scripts and derived JSON are what is kept.
references/corpora/*/corpus/
references/corpora/*/results/
references/corpora/*/results-*/
